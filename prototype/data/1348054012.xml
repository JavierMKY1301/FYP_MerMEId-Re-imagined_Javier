      <workList xml:id="workDesc_N20327">
         <work xml:id="work_d1e225222">
            <identifier label="HartW" xml:id="identifier_N2032B">359</identifier>
            <title xml:id="title_2613d05c" xml:lang="da">Skriveren og Keiserens Datter</title>
            <title xml:id="title_c3143d9c" xml:lang="en">The Scribe and the Emperor's Daughter</title>
            <title type="alternative" xml:id="title_cd66bc47" xml:lang="da">Jeg stod en Vinteraften</title>
            <contributor xml:id="respStmt_N2033C">
               <persName role="composer" xml:id="persName_beb698e5">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_48651d40">B.S. Ingemann</persName>
            </contributor>
            <creation xml:id="creation_bda1c2d1">
               <date isodate="1851-08-17" xml:id="date_N20349">1851-08-17</date>
            </creation>
            <history xml:id="history_12ce2220">
               <p xml:id="idm68">The text is part of B.S. Ingemann's "Hogler Danske" from 1837, which consists of 67 poems. Hartmann also set music to three other poems from this collection: "Holger Danskes Vugge" (HartW 351); "Holgers Sang til Livet" (HartW 457); and "Hilsen til Frænderne" (HartW 158), being the introductory poem. The cycle of poems tells the story of the legendary Danish National hero Holger Danske (Ogier the Dane) who appears for the first time in the mid-12th century as one of the knights of Charles the Great.</p>
            </history>
            <langUsage xml:id="langUsage_N2034E">
               <language xml:id="da">Danish</language>
               <language xml:id="en">English</language>
            </langUsage>
            <classification xml:id="classification_N20359">
               <termList xml:id="termList_N2036C">
                  <term xml:id="term_N2036D">Vocal music</term>
                  <term xml:id="term_N2036F">Song</term>
               </termList>
            </classification>
            <expressionList xml:id="expressionList_N20371">
               <expression xml:id="expression_1">
                  <title xml:id="title_28e8310a" xml:lang="da"/>
