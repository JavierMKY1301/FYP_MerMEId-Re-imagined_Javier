            <title type="text_source" xml:id="title_4e755673" xml:lang="de">Grundlage einer Ehren-Pforte</title>
            <contributor xml:id="respStmt_34b0eb10">
               <persName role="editor" xml:id="persName_9deebeb8">Johann Mattheson</persName>
               <persName role="author" xml:id="persName_cd044330">Johann Adolph Scheibe</persName>
            </contributor>
            <creation xml:id="creation_528262e7">
