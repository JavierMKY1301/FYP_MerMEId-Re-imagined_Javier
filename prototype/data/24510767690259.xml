                  <creation xml:id="creation_fd78851e">
                     <date isodate="1741-08-21" xml:id="date_cdd7b4fb">1741-08-21</date>
                     <geogName xml:id="geogName_a4e3428b">Hamburg</geogName>
                  </creation>
                  <physLoc xml:id="physLoc_6928934f">
                     <repository xml:id="repository_7987f22c">
