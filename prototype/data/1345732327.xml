         <manifestation label="" xml:id="source_ce3e8e11">
            <titleStmt xml:id="titleStmt_N20321">
               <title xml:id="title_b853d497">Parts, manuscript copies</title>
            </titleStmt>
            <physDesc xml:id="physDesc_N2032B">
               <extent xml:id="extent_N2032C">36 parts</extent>
               <dimensions unit="cm" xml:id="dimensions_N2032F">33.5 x 24</dimensions>
               <physMedium xml:id="physMedium_N20332">Written in brown ink. Paper: 10 staves (vocal parts and organ) and 12 staves (instrumental parts). On Voce 1<rend xml:id="idm58" rend="sup">mo</rend>: "Til Jubelfesten". On Voce 2<rend xml:id="idm59" rend="sup">do</rend>: "Til Anskarius Festen 1825 af P. Hartmann og H. Timm". On of the bass parts: "Til Jubelfesten 1825 af H. Timm og P. Hartmann." The vocal parts are in two different hands.</physMedium>
            </physDesc>
            <notesStmt xml:id="notesStmt_N2033C">
               <annot type="source_description" xml:id="annot_39b8fefe">
                  <p xml:id="idm62">Parts: Voce 1<rend xml:id="idm63" rend="sup">mo</rend> (2); Voce 2<rend xml:id="idm64" rend="sup">do</rend> (2); S. (10); A. (5); T. (3); B. (4); cor.1 in B<rend xml:id="idm65" rend="sup">b</rend>; cor.2 in B<rend xml:id="idm66" rend="sup">b</rend>; cor.1 in E flat; cor.2 in E flat; trb.t; trb.a; trb.b; Klaphorn; timp.; org. The organ part is notated in D because the organ of Garnisons Kirke was tuned in choir pitch.</p>
               </annot>
            </notesStmt>
