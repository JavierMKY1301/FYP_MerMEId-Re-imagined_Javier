               <date isodate="1826" xml:id="date_N203C3">1826</date>
            </creation>
            <history xml:id="history_235N200CF">
               <p xml:id="idm128">The year "1825" on two of the parts must be a later addition, as the millennium celebration of the christening of the Danes by the Germanic monk Anskar, later archbishop of Hamburg-Bremen, took place in 1826. Richard Hove uses the title "Til Tusindaarsfesten Pintsedag 1826" without mentioning his source.</p>
               <eventList type="performances" xml:id="eventList_3530fe2e">
                  <event xml:id="event_d1e363357">
                     <date isodate="1826-05-14" xml:id="date_N20423">1826-05-14</date>
                     <geogName role="venue" xml:id="geogName_235N2014A">Garnisons Kirke</geogName>
                     <geogName role="place" xml:id="geogName_235N2014E">Copenhagen</geogName>
                     <desc xml:id="desc_8ef71303">The performance took place on Hartmann's 21st birthday.</desc>
                  </event>
               </eventList>
            </history>
