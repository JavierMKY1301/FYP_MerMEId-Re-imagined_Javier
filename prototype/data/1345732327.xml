            <physDesc xml:id="physDesc_N202DC">
               <extent xml:id="extent_N202DD">42 pages</extent>
               <dimensions unit="cm" xml:id="dimensions_N202E0">25.6 x 36</dimensions>
               <physMedium xml:id="physMedium_N202E3">Bound in marbled paper cover. Written in brown ink. Paper: 12 staves. Above the music on p. 1: "Motetto til Jubelfesten opført 1ste Pintsedag 1826". Original pagination on each folio trimmed due to binding. Later paginating added at the bottom of pages. Last three pages blank.</physMedium>
            </physDesc>
            <notesStmt xml:id="notesStmt_N202E5">
               <annot type="source_description" xml:id="annot_4f611b3f">
                  <p xml:id="idm36">The organ in Garnisons Kirke was tuned in choir pitch, and so Hartmann had to notate the organ part half a tone lower.</p>
               </annot>
            </notesStmt>
