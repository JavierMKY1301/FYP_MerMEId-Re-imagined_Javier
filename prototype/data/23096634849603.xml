            <physDesc xml:id="physDesc_N202DB">
               <titlePage label="" xml:id="titlePage_f94829d7">
                  <p xml:id="idm38">Misogynis | wohlgegründete Ursachen, | das | weibliche Geschlecht zu verachten, | besonders aber die, | von Arglist, Bosheit, Eyfersucht, Falschheit, | Grausamkeit, Hochmuth, Lästerung, Neid, Rach= | gier, Schmähsucht, Treulosigkeit, Undanck, Verschwendung, | Wanckelmuth, Wollust, Zorn und andern unzähligen | Lastern angefüllte | Böse Weiber, | dem | männlichen Geschlecht zur Warnung | ans Licht gestellt von einem, | der |<rend xml:id="idm39" fontstyle="italic"> I</rend>n <rend xml:id="idm40" fontstyle="italic">A</rend>llem <rend xml:id="idm41" fontstyle="italic">S</rend>chon | ganzer siebenzehen Jahre | in den grausamen Banden eines solchen | weiblichen Unthiers seuffzen müssen, | und | durch derselben Bosheit, Verschwendung | und Rachgier in den äussersten Ruin und | Verderben gesetzet worden. | ___ | <rend xml:id="idm42" fontstyle="italic">IM I</rend>ahr, | <rend xml:id="idm43" fontstyle="italic">D</rend>a e<rend xml:id="idm44" fontstyle="italic">I</rend>nes <rend xml:id="idm45" fontstyle="italic">V</rend>ns<rend xml:id="idm46" fontstyle="italic">I</rend>nn<rend xml:id="idm47" fontstyle="italic">I</rend>gen <rend xml:id="idm48" fontstyle="italic">VV</rend>e<rend xml:id="idm49" fontstyle="italic">I</rend>bes Ra<rend xml:id="idm50" fontstyle="italic">C</rend>hg<rend xml:id="idm51" fontstyle="italic">I</rend>er gegen <rend xml:id="idm52" fontstyle="italic">I</rend>hren | an<rend xml:id="idm53" fontstyle="italic">V</rend>ertra<rend xml:id="idm54" fontstyle="italic">V</rend>ten H<rend xml:id="idm55" fontstyle="italic">I</rend>ob a<rend xml:id="idm56" fontstyle="italic">V</rend>fs hö<rend xml:id="idm57" fontstyle="italic">C</rend>hste gest<rend xml:id="idm58" fontstyle="italic">I</rend>egen <rend xml:id="idm59" fontstyle="italic">VV</rend>ar.| ___ | Zum drittenmal gedruckt, 1764.</p>
               </titlePage>
               <extent xml:id="extent_N20336">8 + 72 pages </extent>
               <physMedium xml:id="physMedium_N20339">In 8<rend xml:id="idm62" rend="sup">o</rend>; front flyleaf, blank page (unsigned), frontispiece (titled: 'effigies matiosae foreminae'; woman with fan; unsigned), title page (sig. [)(1r]), blank page (sig. [)(1v]), author's foreword (sigs. )(2r–)(3v), text (pp. [1]–72), end flyleaf; in all 80 pages.</physMedium>
            </physDesc>
            <notesStmt xml:id="notesStmt_085da8fc">
               <annot type="source_description" xml:id="annot_af578d0e">
                  <p xml:id="idm65">This is a third edition with a new text setting. To the introduction, 'Kurzer Vorbericht', Scheibe has added a note (sig. )(3v).</p>
               </annot>
            </notesStmt>
