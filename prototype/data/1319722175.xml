                           </imprint>
                           <title level="a" xml:id="title_741a5543"/>
                           <title level="j" xml:id="title_8dae5dec">Neue Berliner Musikzeitung</title>
                           <biblScope unit="vol" xml:id="biblScope_b2629673">32</biblScope>
                           <biblScope unit="issue" xml:id="biblScope_d719d75e">27</biblScope>
                           <biblScope unit="page" xml:id="biblScope_1e1dd48e">213</biblScope>
