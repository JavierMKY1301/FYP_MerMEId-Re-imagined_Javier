      <workList xml:id="workDesc_N20370">
         <work xml:id="work_d1e228225">
            <identifier label="HartW" xml:id="identifier_N20374">351</identifier>
            <title xml:id="title_b6a4577c" xml:lang="da">Holger Danskes Vugge</title>
            <title xml:id="title_a47dfc58" xml:lang="en">The Cradle of Ogier the Dane</title>
            <title type="alternative" xml:id="title_f5393c0d" xml:lang="da">Ved Leire græsse nu Faar paa Vold</title>
            <contributor xml:id="respStmt_N20385">
               <persName role="composer" xml:id="persName_145fad25">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_975a52b3">B.S. Ingemann</persName>
            </contributor>
            <creation xml:id="creation_994f8cb0">
               <date enddate="1847-11-16" startdate="1847-11-14" xml:id="date_N20392">14 Nov. to 16 Nov. 1847</date>
            </creation>
            <history xml:id="history_0554fbfd">
               <eventList type="performances" xml:id="eventList_b0621750">
                  <event xml:id="event_d1e438431">
                     <persName role="" xml:id="persName_d1ecef71">Christian Hansen, baritone</persName>
                     <date isodate="1847-11-24" xml:id="date_N20431">1847-11-24</date>
                     <geogName role="venue" xml:id="geogName_971e7139">The Royal Theatre (Det Kongelige Teater)</geogName>
                     <geogName role="place" xml:id="geogName_0f5fb432">Copenhagen</geogName>
                     <desc xml:id="idm100">First performance.</desc>
                  </event>
               </eventList>
               <p xml:id="idm101">In November 1847 B.S. Ingemann sent Hartmann a copy of the third edition of his "Holger Danske, et  Digt i fem Sangkredse", published that year. Hartmann immediately set music to "Holger Danskes Vugge", and a few days later the song was performed at a concert in The Royal Theatre by the singer Christian Hansen, who had been present when Hartmann composed the song.</p>
            </history>
