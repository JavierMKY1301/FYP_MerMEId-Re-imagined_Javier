                           <biblScope unit="page" xml:id="biblScope_e86d9c4d">50-51</biblScope>
                           <imprint xml:id="imprint_4e992215">
                              <date isodate="1828-02-12" xml:id="date_295da640">1828-02-12</date>
                              <pubPlace xml:id="pubPlace_7b1a65d3">Copenhagen</pubPlace>
                           </imprint>
                        </bibl>
                     </biblList>
