                     <geogName role="place" xml:id="geogName_b295c5b3">Copenhagen</geogName>
                     <desc xml:id="idm118">First performance. The concert was a benefit concert for Siboni's Academy of music. One of the soloists was the famous Italian soprano Angelica Catalani.</desc>
                     <biblList xml:id="biblList_612ad9d3">
