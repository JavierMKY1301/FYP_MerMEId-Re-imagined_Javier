            <physDesc xml:id="physDesc_20b7c148">
               <titlePage label="" xml:id="titlePage_d22feead">
                  <p xml:id="idm24">Fest <rend xml:id="idm25" rend="underline">Entschließung eines</rend> Christen. | Mel. <rend xml:id="idm26" rend="underline">Schwing dich auf zu</rend> deinem Gott</p>
               </titlePage>
               <extent xml:id="extent_8f4d425e">2 bifolios</extent>
               <dimensions unit="cm" xml:id="dimensions_63b8c24d">22.6x37.7</dimensions>
               <watermark xml:id="watermark_1e3b0037">Watermark partly visible; countermark has 'J Honig | &amp; | Zoonen' corresponding to Heawood:2748 (not dated).</watermark>
               <physMedium xml:id="physMedium_93a3c1e9">In 2<rend xml:id="idm31" rend="sup">o</rend>; 2 folded bifolios, trimmed; fols. 3r–v contains the text for <rend xml:id="idm32" fontstyle="italic">Feste Entschließung eines Christen</rend> ('Sollt ich itzt noch, da mir schon'); written in black ink. The source has seven stanzas though there are differences in the text. The source contains also other texts by Münter.</physMedium>
            </physDesc>
            <notesStmt xml:id="notesStmt_6e3fcc52">
               <annot type="source_description" xml:id="annot_fbf2ae5d">
                  <p xml:id="idm35">Presumably Balthasar Münter's autograph.</p>
