      <workList xml:id="workDesc_5edbf009">
         <work xml:id="work_d1e184181">
            <identifier label="SchW" xml:id="identifier_96ec03dd">B2:419</identifier>
            <title xml:id="title_613a1bad" xml:lang="da">Hans kongelige Majestæts, vores allernaadigste Konges høye Fødsels Fest</title>
            <contributor xml:id="respStmt_e3c8edfd">
               <persName role="composer" xml:id="persName_c9f54a49">Johann Adolph Scheibe</persName>
               <persName role="author" xml:id="persName_2af56c1d">Johann Adolph Scheibe</persName>
               <persName role="dedicatee" xml:id="persName_ea6abcbd">King Frederik V</persName>
            </contributor>
            <creation xml:id="creation_ebaa5dad">
               <date isodate="1762" xml:id="date_73a48e90">1762</date>
               <geogName xml:id="geogName_3748e8ae">Copenhagen,</geogName>
            </creation>
            <history xml:id="history_d56b44ee">
               <p xml:id="idm95">In 1762, Scheibe composed a cantata for the celebration of <persName xml:id="idm96" auth.uri="http://www.viaf.org" auth="VIAF" role="">Frederik V</persName>’s birthday. The work was performed at The Musical Society in April following the Lent concerts. According to tradition a prelude to the cantata, consisting of a piece for trumpets and kettledrum, was played. Neither text nor music seems to have survived.</p>
            </history>
            <langUsage xml:id="langUsage_68e4b6a1">
               <language xml:id="da">Danish</language>
            </langUsage>
            <biblList xml:id="listBibl_b04aef9f-0d09-47b0-ac0a-4c749efd46f2226">
               <head xml:id="head_6d55b698">Bibliography</head>
               <bibl label="" xml:id="bibl_8ef2e7c9">
                  <genre xml:id="genre_06c771d9">article</genre>
                  <genre xml:id="genre_fb2e158f">newspaper</genre>
                  <annot xml:id="annot_a7ac4af1">
                     <p xml:id="idm105">
                        <lb xml:id="idm106"/>‘Hans Kongelige Majestæts, vores allernaadigste Konges høye Fødsels Fest, som for dette Aar indfaldt paa en Onsdag i Fasten, og formedelst samme var udsat, at celebreres af det Musikalske Selskab næste Onsdag efter Paaske, blev i Følge heraf sidstleden Onsdag glædeligen under Paukkers og Trompeters Lyd, i underdanigste Frihed af det Musikalske Selskab her i Staden celebreret. Poesien saavel som Musiqven var forfærdiget af Hr. Capelmester Scheibe.’</p>
                  </annot>
                  <title level="a" xml:id="title_b2293c50"/>
                  <title level="j" xml:id="title_475955f9">Kiøbenhavns Adresse-Contoirs Efterretninger</title>
                  <imprint xml:id="imprint_75c3fd27">
                     <date isodate="1762-04-16" xml:id="date_917c21a7">1762-04-16</date>
                  </imprint>
               </bibl>
            </biblList>
            <classification xml:id="classification_9478f984">
               <termList xml:id="termList_9be3a2ff">
                  <term xml:id="term_ca13c40a">Cantata</term>
                  <term xml:id="term_30747a6d">Music for vocal soloists and instruments with or without choir</term>
