            <title xml:id="title_c5d64b39" xml:lang="en">Cantata on the Occasion of His Majesty the King's High Birth Feast</title>
            <title type="alternative" xml:id="title_be406340" xml:lang="da">Saa dunkel var den danske Sommerhimmel</title>
            <contributor xml:id="respStmt_N203D3">
               <persName role="composer" xml:id="persName_343N2016A">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_343N2016E">Carl Borgaard</persName>
            </contributor>
            <creation xml:id="creation_343N20173">
               <date isodate="1841-09-17" xml:id="date_N203E0">1841-09-17</date>
            </creation>
            <history xml:id="history_343N20171">
               <eventList type="performances" xml:id="eventList_ca1f0733">
                  <event xml:id="event_d1e540529">
                     <persName role="" xml:id="persName_343N201E8">Vilhelmine Østerberg, soprano</persName>
                     <persName role="" xml:id="persName_343N201EC">Frederikke Berg, soprano</persName>
                     <persName role="" xml:id="persName_9c305a2e">Rasmus Faaborg, tenor</persName>
                     <persName role="" xml:id="persName_16c3277c">Ludvig Bernhard Sahlgreen, tenor</persName>
                     <persName role="" xml:id="persName_370e7243">H. Lund, bass</persName>
                     <persName role="" xml:id="persName_cc4bc490">Peter Schram, bass</persName>
                     <date isodate="1841-09-18" xml:id="date_N2043F">1841-09-18</date>
                     <geogName role="venue" xml:id="geogName_343N201F7">Sorgenfri Slot</geogName>
                     <geogName role="place" xml:id="geogName_343N201FB">Sorgenfri</geogName>
                     <corpName role="ensemble" xml:id="corpName_343N201FF">Royal Danish Orchestra (Det Kongelige Kapel)</corpName>
                     <desc xml:id="idm125">First performance.</desc>
                  </event>
               </eventList>
               <p xml:id="idm126">The cantata was written for the forty-fifth birthday of King Christian VIII. Hartmann had known the king since his childhood, as his mother had been a governess for the king's son, the later Frederik VII and Hartmann's playmate. Furthermore Christian VIII supported Giuseppe Siboni's music academyy, where Hartmann was a teacher, and whose pupils performed the cantata.</p>
            </history>
