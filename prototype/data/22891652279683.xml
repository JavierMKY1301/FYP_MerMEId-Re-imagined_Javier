      <workList xml:id="workDesc_475f78b0">
         <work xml:id="work_id228dde09">
            <identifier label="SchW" xml:id="identifier_2a33248d">B2:441</identifier>
            <title xml:id="title_idac06962f" xml:lang="de">Trauungs-Cantate</title>
            <title type="alternative" xml:id="title_fc1276d9" xml:lang="de">Wohl dem, der [...]</title>
            <contributor xml:id="respStmt_16e4b201">
               <persName role="composer" xml:id="persName_id9353ac35">Johann Adolph Scheibe </persName>
            </contributor>
            <history xml:id="history_id6fb17ef6">
               <p xml:id="idm61">The present occasional cantata, presumably composed for a wedding, has been lost. It appears only in the Breitkopf catalogue of 1761, thus suggesting that it may have been acquired by the publishers from the estate of <persName xml:id="idm62" auth.uri="http://www.viaf.org" auth="VIAF" role="">Carl Gotthelf Gerlach</persName>, the cantor of Neukirche in Leipzig who had died earlier that year. In that case it was probably performed there and might have been commissioned by Gerlach.</p>
            </history>
            <langUsage xml:id="langUsage_360357bb">
               <language xml:id="en">English</language>
               <language xml:id="de">German</language>
            </langUsage>
            <biblList xml:id="biblList_197N200FA">
