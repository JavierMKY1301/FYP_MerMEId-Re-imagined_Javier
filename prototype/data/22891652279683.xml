               <bibl label="" xml:id="bibl_e671b005">
                  <genre xml:id="genre_2c99a982">book</genre>
                  <author xml:id="author_243566a8">Johann Gottlob Immanuel Breitkopf</author>
                  <annot xml:id="annot_d6581411">
                     <p xml:id="idm72">
                        <lb xml:id="idm73"/>(I.A.6.a. ‘Brautmessen und Trauungs-Cantaten’): '[Scheibe, Joh. Adolph, Königl. Dänischer Capellmeister, Trauungs-Cantate: Wohl dem, der etc. à 2 Clarini, Tymp. Flauto trav. 2 Oboi, 2 Violini, Viola, 4 Voci, Basso ed Organo. a 6 thl.'; ‘NB. In Partitur sind die Preiße etwas geringer.’</p>
                  </annot>
                  <ptr label="Digitisation"
                       target="http://digital.staatsbibliothek-berlin.de/werkansicht?PPN=PPN778562883&amp;PHYSID=PHYS_0027&amp;DMDID=DMDLOG_0002"
                       xml:id="ptr_3025a111"/>
                  <title level="m" xml:id="title_f5987c9c">Verzeichniß Musikalischer Werke, allein zur Praxis, sowohl zum Singen, als für alle Instrumente, welche nicht durch den Druck bekannt gemacht worden</title>
