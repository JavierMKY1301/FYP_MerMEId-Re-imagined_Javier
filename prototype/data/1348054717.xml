      <workList xml:id="workDesc_fcda2bbf">
         <work xml:id="work_d1e227224">
            <identifier label="HartW" xml:id="identifier_800d774b">158</identifier>
            <title xml:id="title_162N200CB" xml:lang="da">Hilsen til Frænderne</title>
            <title xml:id="title_c254e149" xml:lang="en">Salutation to the Kinslayer</title>
            <title type="alternative" xml:id="title_52209d02" xml:lang="da">Vær hilset mit gamle Fædreneland</title>
            <contributor xml:id="respStmt_ee2f7ecb">
               <persName role="composer" xml:id="persName_162N200D1">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_162N200D5">B.S. Ingemann</persName>
            </contributor>
            <creation xml:id="creation_162N200DA">
               <date isodate="1848-05-15" xml:id="date_5a9f7b98">1848-05-15</date>
            </creation>
            <history xml:id="history_162N200D8">
               <p xml:id="idm73">The text is part of B.S. Ingemann's "Holger Danske" from 1837, which consists of 67 poems. Hartmann also set music to three others: "Holger Danskes Vugge" (HartW 351), "Skriveren og Kejserens Datter" (HartW 359) and "Holgers Sang om Livet" (HartW 457). The cycle of poems tells the story of the legendary Danish national hero Holger Danske (Ogier the Dane) who appears for the first time in "The Song of Roland" from the mid-twelfth century as one of the knights of Charles the Great.</p>
            </history>
            <langUsage xml:id="langUsage_54657cf3">
               <language xml:id="da">Danish</language>
               <language xml:id="en">English</language>
            </langUsage>
            <classification xml:id="classification_d75ab73e">
               <termList xml:id="termList_f15b010e">
                  <term xml:id="term_2256edd5">Vocal music</term>
                  <term xml:id="term_7afbb41b">Music for vocal soloists and instruments with or without choir</term>
                  <term xml:id="term_c0ccbbc4">Male choir</term>
               </termList>
            </classification>
