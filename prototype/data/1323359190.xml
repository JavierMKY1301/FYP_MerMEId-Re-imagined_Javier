            <title type="alternative" xml:id="title_7817a20a" xml:lang="da">Hvad kan os komme til for Nød</title>
            <contributor xml:id="respStmt_N2032D">
               <persName role="composer" xml:id="persName_82b08e5f">J.P.E. Hartmann</persName>
