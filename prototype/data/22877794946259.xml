      <workList xml:id="workDesc_8793960b">
         <work xml:id="work_id98d0984b">
            <identifier label="SchW" xml:id="identifier_f4754129">B2:013</identifier>
            <title xml:id="title_id17814990" xml:lang="de">Cantate: In Festo Epiphanias</title>
            <title type="alternative" xml:id="title_588167fe" xml:lang="de">Mache dich auf, werde Licht</title>
            <contributor xml:id="respStmt_3c027e39">
               <persName role="composer" xml:id="persName_id10f8857a">Johann Adolph Scheibe</persName>
            </contributor>
            <history xml:id="history_ida682a4cf">
               <p xml:id="idm61">The church cantata for Epiphany, which is one of three (the other two being SchW B2:012, B2:014), has presumably not survived. It is listed in the Breitkopf house catalogue of 1761 as well as in their auction catalogue of 1836. It should be noted that it does not occur in the earlier sales catalogues. It is likely that the cantata was obtained from the estate of the cantor of Neukirche in Leipzig, <persName xml:id="idm62" auth.uri="http://www.viaf.org" auth="VIAF" role="">Carl Gotthelf Gerlach</persName>, in 1761, and hence may originally have been a work commissioned by the cantor.</p>
            </history>
            <langUsage xml:id="langUsage_690aee64">
               <language xml:id="en">English</language>
               <language xml:id="de">German</language>
            </langUsage>
            <biblList xml:id="biblList_211N200FA">
               <head xml:id="head_4ff9da70">Bibliography</head>
               <bibl label="" xml:id="bibl_e28b964c">
                  <genre xml:id="genre_bead220d">book</genre>
                  <author xml:id="author_4c63a7cc">Johann Gottlob Immanuel Breitkopf</author>
                  <annot xml:id="annot_aba57016">
                     <p xml:id="idm72">
                        <lb xml:id="idm73"/>(I.A.5.b. ‘Fest. Jahrgänge, nebst einigen Sonntags-Cantaten’): '[Scheibens, Joh. Adolph,] Cantate: In Fest. Epiph. Mache dich auf, werde Licht, à 2 Corni, 2 Oboi, 2 Violini, Viola, 4 Voci, Basso ed Organo. a 2 thl. 8 gl.'; ‘NB. In Partitur sind die Preiße etwas geringer.’</p>
                  </annot>
                  <ptr label="Digitisation"
                       target="http://digital.staatsbibliothek-berlin.de/werkansicht?PPN=PPN778562883&amp;PHYSID=PHYS_0020&amp;DMDID=DMDLOG_0002"
                       xml:id="ptr_473ed650"/>
