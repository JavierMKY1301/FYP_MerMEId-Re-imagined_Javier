            </pubStmt>
            <physDesc xml:id="physDesc_e799afa0">
               <titlePage label="Title page" xml:id="titlePage_24a02650">
                  <p xml:id="idm81">KOMPOSITIONER / FOR / PIANOFORTE / AF / J.P.E. HARTMANN. / [...] Op. 48. Sonatine / Allegro - Romance - Rondo - Scherzo. / Forlæggerens Eiendom. / KJØBENHAVN. WILHELM HANSENS MUSIK-FORLAG.</p>
               </titlePage>
