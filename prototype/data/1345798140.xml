                  <term class="#DcmAuthorityClass" xml:id="term_14ba765b">autograph</term>
                  <term class="#DcmScoringClass" xml:id="term_506706a2">short score</term>
                  <term class="#DcmStateClass" xml:id="term_d269b1e1">fair copy</term>
                  <term class="#DcmCompletenessClass" xml:id="term_244645fc">complete</term>
               </termList>
            </classification>
            <itemList xml:id="itemList_1ae54480">
