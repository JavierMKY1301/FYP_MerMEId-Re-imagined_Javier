         </manifestation>
         <manifestation label="" xml:id="source_d1e30">
            <titleStmt xml:id="titleStmt_beb6c76f">
               <title xml:id="title_85da5d24">Piano score, autograph, printer's copy</title>
            </titleStmt>
            <physDesc xml:id="physDesc_1bf954be">
               <extent xml:id="extent_03a30037">4 pages</extent>
               <dimensions unit="cm" xml:id="dimensions_84f6f785">34.5 x 26</dimensions>
               <physMedium xml:id="physMedium_ba2c535d">1 bifolio. Written in purple ink. Paper: 12 staves. Title above the first stave: "Ved Afsløringen af / Mindesmærket for Niels W. Gade 24/6 97". Above the third bar on p. 3 Hartmann has written: "Ossian Ouverturen" referring to a citation from Gade's work. On staves 9-10: "o.s.v. DC indtil foranstaaende *; derpaa videre til nedenstaaende / NB udskrives."</physMedium>
            </physDesc>
            <notesStmt xml:id="notesStmt_c0f3899e">
               <annot type="source_description" xml:id="annot_1b50e9b5">
                  <p xml:id="idm64">Being end-dated "16/8 97." (almost two months after the unveiling of the monument) and containing instructions for the copyist / printer, this piano arrangement was probably meant for publication but was never published.</p>
               </annot>
            </notesStmt>
            <classification xml:id="classification_ee7acad7">
               <termList xml:id="termList_acc3d1c1">
                  <term class="#DcmContentClass" xml:id="term_375f1bed">notated music</term>
                  <term class="#DcmPresentationClass" xml:id="term_927c301e">manuscript</term>
                  <term class="#DcmAuthorityClass" xml:id="term_551a9ee4">autograph</term>
                  <term class="#DcmScoringClass" xml:id="term_ffa2df58">piano score</term>
                  <term class="#DcmStateClass" xml:id="term_209162c7">printer's copy</term>
                  <term class="#DcmCompletenessClass" xml:id="term_128a9b44"/>
               </termList>
            </classification>
