      <workList xml:id="workDesc_N20375">
         <work xml:id="work_d1e226223">
            <identifier label="HartW" xml:id="identifier_N20379">328</identifier>
            <title xml:id="title_9e93bce7" xml:lang="da">Sang paa Strandveien</title>
            <title xml:id="title_cf264592" xml:lang="en">Song on Strandvejen</title>
            <title type="alternative" xml:id="title_ef3153f4" xml:lang="da">Rullende hen ad de støvede Veie</title>
            <title type="alternative" xml:id="title_57e72250" xml:lang="da">Langsad Strandveien</title>
            <contributor xml:id="respStmt_N2038A">
               <persName role="composer" xml:id="persName_172N200C7">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_172N200CB">Johan Ludvig Heiberg</persName>
            </contributor>
            <creation xml:id="creation_172N200D0">
               <date isodate="1837" xml:id="date_N20397">1837</date>
            </creation>
            <history xml:id="history_172N200CE">
               <p xml:id="idm97">In 1837 Hartmann participated in Musikforeningens competition on "den bedste Samling af 6 Sange over forskjellige nærmere bestemte Texter." His contributions were: No. 1 "Indvielsen"; No. 2 "Hvad toner gjennem Skoven"; No. 3 "Langsad Strandveien"; No. 4 "Til de Døde"; No. 5 "Lille Cathrine" and No. 6. "Flyv, Fugl, flyv". Nos. 1 &amp; 4-6 were chosen for publication by the jury, Nos. 2 &amp; 3 remained unpublished.</p>
            </history>
            <langUsage xml:id="langUsage_N2039C">
               <language xml:id="da">Danish</language>
               <language xml:id="en_0">English</language>
            </langUsage>
