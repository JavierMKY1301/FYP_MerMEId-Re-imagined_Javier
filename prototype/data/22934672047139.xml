            <componentList xml:id="componentGrp_ea11818c">
               <manifestation label="" xml:id="source_0af8dab7">
                  <titleStmt xml:id="titleStmt_88767bf3">
                     <title xml:id="title_e8dbfd2f">Flauto traverso</title>
                  </titleStmt>
                  <physDesc xml:id="physDesc_47ee2899">
                     <extent xml:id="extent_ece66fd9">11 folios</extent>
                     <dimensions unit="cm" xml:id="dimensions_982b3a43">21.7x31.3</dimensions>
                     <watermark xml:id="watermark_3089927d">a partly visible watermark with the countermark 'W V' (?) and a crown, perhaps as part of an emblem.</watermark>
                     <physMedium xml:id="physMedium_c1edd38d">In 2<rend xml:id="idm192" rend="sup">o</rend>; oblong format, consisting of 3 and 2 nested bifolios; music (fols. 21r–31r), blank page with staves (fol. 31v); pages numbered 1–21 in pencil in a library hand, in all 11 folios. Hand-ruled paper, 12 staves (7 mm; presumably a 12-stave rastrum used) in light brown ink and music in same ink as well as black ink; bottom staves on various pages have not been used due to new sections or movements. A clean copy with a few additions and changes made in black ink. The source includes three sonatas of which 'Sonata I<rend xml:id="idm193" rend="sup">
                           <rend xml:id="idm194" rend="underline">mo</rend>
                        </rend>' appears on pp. 1–5; 'Sonata II.' on pp. 6–13; and 'Sonata III.' on pp. 14–21.<lb xml:id="idm195"/>Paper of a fairly dense quality.</physMedium>
                  </physDesc>
               </manifestation>
               <manifestation label="" xml:id="source_d259cdf8">
                  <titleStmt xml:id="titleStmt_07aa0ad9">
                     <title xml:id="title_fabb18b7">Cembalo</title>
                  </titleStmt>
                  <physDesc xml:id="physDesc_54d82631">
                     <titlePage label="" xml:id="titlePage_6cd6ef0f">
                        <p xml:id="idm201">III. Sonate | Per il Cembalo Obligato | e | Flauto Traverso | ô | Violino Concertato | Composte | dal Signor | Giovani Adolfo Scheibe | Maestro di Capella di Sua Maesta il Re | di Danimarca etc: | Alle Spese di Giovanni Ulrico Haffner | Sonatore di Liuto in Norimberga | pag xxxv.</p>
                     </titlePage>
                     <extent xml:id="extent_2d035f63">20 folios</extent>
                     <dimensions unit="cm" xml:id="dimensions_79ba433d">21.7x31.3</dimensions>
                     <watermark xml:id="watermark_57e36ca4">a partly visible watermark with the countermark consisting of 'W V' (?) and a crown perhaps as part of an emblem.</watermark>
                     <physMedium xml:id="physMedium_78c88290">In 2<rend xml:id="idm206" rend="sup">o</rend>; oblong format consisting of nested bifolios; title page (fol. 1r), music (fols. 1v–20r), blank page with staves (fol. 20v); pages numbered 1–38 in various hands and ink and pencil, in all 20 folios. Hand-ruled paper, 12 staves (7 mm; presumably a 12-stave rastrum used) in light brown ink and  music in same brown ink; bottom staves on various pages have not been used. A clean copy with a few additions and changes. 'Sonata I.' appears on pp. 1–12; 'Sonata II.' on pp. 13–26; and 'Sonata III.' on pp. 27–38.<lb xml:id="idm207"/>Paper of a fairly dense quality.</physMedium>
                  </physDesc>
               </manifestation>
