            <physDesc xml:id="physDesc_e7bf12e0">
               <titlePage label="" xml:id="titlePage_a9675537">
                  <p xml:id="idm31">Reiter-Leben. / 6 / Lieder für Männerstimmen. / (Gedichtet v. Carl Schultes) / Componirt / von / Niels W: Gade. / Op. 16. / Leipzig bei Fr Kistner.</p>
               </titlePage>
               <extent xml:id="extent_d24e54a0">16 pages</extent>
               <dimensions unit="cm" xml:id="dimensions_1a68f526">17.5 x 29,5</dimensions>
               <physMedium xml:id="physMedium_a1d81d08">4 bifolios. Written in ink. Paper: 9 staves. Paginated 2-15. Last page unnumbered and blank. Heading on p. 2: "No. I <rend xml:id="idm35" rend="underline">Reiters Morgenlied.</rend>"; heading on p. 4: "No. II. <rend xml:id="idm36" rend="underline">Einkehr.</rend>"; heading on p. 6: "No. III. <rend xml:id="idm37" rend="underline">Einquartierung.</rend>"; heading on p. 8: "No. III. <rend xml:id="idm38" rend="underline">Abschied.</rend>"; heading on p. 10: "No. V. Angriff."; heading on p. 14: "No. VI. <rend xml:id="idm39" rend="underline">Reiters End</rend>." At the end of the music on p. 15 dated "Leipzig April 1848." and Gade's musical signature.</physMedium>
            </physDesc>
