      <manifestationList xml:id="sourceDesc_N202D0">
         <manifestation label="" xml:id="source_d1e31">
            <titleStmt xml:id="titleStmt_N202D5">
               <title xml:id="title_204N2004A">Score, autograph, fair copy</title>
            </titleStmt>
            <physDesc xml:id="physDesc_N202DB">
               <extent xml:id="extent_N202DC">4 pages</extent>
               <dimensions unit="cm" xml:id="dimensions_N202DF">35.5 x 25</dimensions>
               <physMedium xml:id="physMedium_N202E2">1 bifolio. Written in brown ink. Paper: 12 staves. Title above the first stave: "Ved Axel Liebmanns Kiste". Bar lines added later in pencil. At the end of the music on the third page signed and dated: "I:P:E:H: 26/1 76.". Beneath Hartmann has written: "En særskildt Orgelstemme bedes udskreven." Last page blank.</physMedium>
            </physDesc>
