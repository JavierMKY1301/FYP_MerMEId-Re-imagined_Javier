            <title xml:id="title_abc83a14" xml:lang="en">At the Coffin of Axel Liebmann</title>
            <title type="alternative" xml:id="title_eba6a7bc" xml:lang="da">Endnu engang, vor tabte Ven</title>
            <contributor xml:id="respStmt_N20386">
