      <manifestationList xml:id="sourceDesc_d30cca8c">
         <manifestation label="" xml:id="source_d1e34">
            <titleStmt xml:id="titleStmt_386adcf6">
               <title xml:id="title_279N2004A">Score, autograph, fair copy</title>
            </titleStmt>
            <physDesc xml:id="physDesc_2cee06da">
               <extent xml:id="extent_a907441b">32 pages</extent>
               <dimensions unit="cm" xml:id="dimensions_a2efe51e">35.5 x 25.5</dimensions>
               <physMedium xml:id="physMedium_24bf2a30">Bound in faded purple cardboard with a handwritten label in Hartmann's hand: "Sonate for Piano-/ forte til 4 Hænder / 1826 - Partitur". Written in brown ink. Paper: 12 staves. Pagination in pencil added later. Title on first music page: "Sonate a 4 mains N<rend xml:id="idm34" rend="sup">o</rend> 1. Op: 4". On p. 11 above the second movement, Hartmann has written "duer slet ikke" (no good at all) in 1888. While the first three movements are almost without corrections, the final Rondeau (pp. 22-32) has numerous corrections and emendations in purple ink made in 1888 when this movement was published separately. Most of these have been implemented in the printed edition.</physMedium>
            </physDesc>
