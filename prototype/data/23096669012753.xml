      <manifestationList xml:id="sourceDesc_faf3dbd8">
         <manifestation label="" xml:id="source_idffa5b0d9">
            <titleStmt xml:id="titleStmt_6cc2ac6c">
               <title xml:id="title_idb6959d1a">Text, print</title>
            </titleStmt>
            <pubStmt xml:id="pubStmt_e74b2924">
               <publisher xml:id="publisher_id3bc2865a">s.n.</publisher>
               <pubPlace xml:id="pubPlace_idb896089b">s.l.</pubPlace>
               <date isodate="1753" xml:id="date_711a21be">(1753)</date>
            </pubStmt>
            <physDesc xml:id="physDesc_e73a8031">
               <titlePage label="" xml:id="titlePage_3dfa5005">
                  <p xml:id="idm39">Die | Allerneueste erfundene Art,| nach Morgenländischer Weise, | mit guter Manier | ein | Böses Weib | los zu werden, | wodurch zugleich theils Weiber | Bosheit entdecket, und deren ungewissenhafte | Kunstgriffe, welche ihnen ihre Eigenschaft, | Temperament und Müßiggang | eingeben, | Mit natürlichen Farben | abgeschildert werden. | Zum Trost dererjenigen, so unter | diesem unerträglichen Joche seuffzen, | an das Licht gestellet | von einem | <rend xml:id="idm40" fontstyle="italic">I</rend>n <rend xml:id="idm41" fontstyle="italic">A</rend>llen <rend xml:id="idm42" fontstyle="italic">S</rend>tücken | wahrhaften Francken. | **** | IM Iahr, | Da eInes VntreVen VVeIbes VngeheVre InnIge | RaChgIer aVfs höChste gestlegen VVar.</p>
               </titlePage>
               <titlePage label="Second title page (p. [55])" xml:id="titlePage_70127cab">
                  <p xml:id="idm44">Die böse Sieben, | von welcher heut zu Tage die unglücksee= | ligen Männer grausamlich geplaget werden. | Fürgestellt | in einem wunderbaren Gesichte, | durch ein Mitglied | des Hochlöblichen Schwanen = Ordens. | Nun von neuem wieder aufgelegt, | von einem |<rend xml:id="idm45" fontstyle="italic"> Audacter Conjugium Barbaricum</rend> | <rend xml:id="idm46" fontstyle="italic">Rumpente Sapiente</rend>. | **** | </p>
               </titlePage>
               <titlePage label="Afterword (p. [113])" xml:id="titlePage_8858c101">
                  <p xml:id="idm48">'Nachrede | an den | verständigen und unpartheyischen Leser!'; p. 120: 'aus Schuldigkeit aufgesetzt | in Wittenberg. | von | Johann Georg Möllern, | der H. Schrift Beflissenen, K. C. Poe= | ten, und Gesellschaftern des Hochl. | Schwanen=Ordens <rend xml:id="idm49" fontstyle="italic">Thromylas</rend>.'</p>
               </titlePage>
               <extent xml:id="extent_d81d2bb3">8 + 120 pages </extent>
               <physMedium xml:id="physMedium_2cc2fbfb">In 8<rend xml:id="idm52" rend="sup">o</rend>; blank page, frontispiece (titled: 'Ein teutscher | Scheide Brief'; consisting of a couple: a young man turning away from an unsightly, warty woman), title page (sig. [a1r]), epigraph (sig. [a1v]), short introduction signed by 'In Aerumnis Sapiam' (sigs. a2r–a3v), text (pp. [1]–54); title page, epigraph and foreword (p. [55]–56), text (pp. 57–112); afterword by Johann Georg Möller (pp. [113]–20).</physMedium>
            </physDesc>
