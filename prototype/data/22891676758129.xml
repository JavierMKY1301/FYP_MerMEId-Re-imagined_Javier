      <workList xml:id="workDesc_bd3317f6">
         <work xml:id="work_id69be3507">
            <identifier label="SchW" xml:id="identifier_d68200cc">B2:101</identifier>
            <title xml:id="title_id1abd0407" xml:lang="de">Communion-Cantate</title>
            <title type="alternative" xml:id="title_cbb08814" xml:lang="de">Was fühlest du mein Herz in dir</title>
            <contributor xml:id="respStmt_25a6b547">
               <persName role="composer" xml:id="persName_idf89418c3">Johann Adolph Scheibe</persName>
            </contributor>
            <history xml:id="history_idcce33fa4">
               <p xml:id="idm61">The communion cantata, which is one of two (see also SchW B2:100), has presumably been lost. It appears only in the Breitkopf catalogue of 1761, thus suggesting that it may have been acquired by the publishers from the estate of <persName xml:id="idm62" auth.uri="http://www.viaf.org" auth="VIAF" role="">Carl Gotthelf Gerlach</persName>, the cantor of Neukirche in Leipzig who had died earlier that year. In that case it was probably performed there and might have been commissioned by Gerlach. It is not listed in the Breitkopf auction catalogue of 1836.</p>
            </history>
            <langUsage xml:id="langUsage_b7707d79">
               <language xml:id="en">English</language>
               <language xml:id="de">German</language>
            </langUsage>
            <biblList xml:id="biblList_200N200FA">
               <head xml:id="head_69568983">Bibliography</head>
               <bibl label="" xml:id="bibl_9ac149aa">
                  <genre xml:id="genre_7a9ca830">book</genre>
                  <author xml:id="author_370beb37">Johann Gottlob Immanuel Breitkopf</author>
                  <annot xml:id="annot_2bbdf95d">
                     <p xml:id="idm72">
                        <lb xml:id="idm73"/>(I.A.6.c. ‘Communions-Cantaten’): 'Scheibe, Joh. Ad. Königl. Dän. Capellmeister, Communion-Cantate: Was fühlest du mein Herz in dir, à 2 Flauti, 2 Violini,  Viola, Alto solo, Basso ed Organo. a 1 thl. 4 gl.'; ‘NB. In Partitur sind die Preiße etwas geringer.’</p>
                  </annot>
                  <ptr label="Digitisation"
                       target="http://digital.staatsbibliothek-berlin.de/werkansicht?PPN=PPN778562883&amp;PHYSID=PHYS_0028&amp;DMDID=DMDLOG_0002"
                       xml:id="ptr_13780d00"/>
                  <title level="m" xml:id="title_2dda9395">Verzeichniß Musikalischer Werke, allein zur Praxis, sowohl zum Singen, als für alle Instrumente, welche nicht durch den Druck bekannt gemacht worden</title>
                  <title level="s" xml:id="title_95cb2a4a"/>
