      <workList xml:id="workDesc_2b560e86">
         <work xml:id="work_d1e227224">
            <identifier label="HartW" xml:id="identifier_b934ee6e">148</identifier>
            <title xml:id="title_7d56e2a5" xml:lang="da">Chor ved Sibonis Begravelse</title>
            <title xml:id="title_b6692428" xml:lang="en">Chorus at Siboni's Funeral</title>
            <title type="alternative" xml:id="title_e69bb01b" xml:lang="da">Han lyttede med sydlig Ild</title>
            <contributor xml:id="respStmt_efce9494">
               <persName role="composer" xml:id="persName_ff66ae8b">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_3b3e2642">Hans Christian Andersen</persName>
            </contributor>
            <creation xml:id="creation_463e4469">
               <date isodate="1839-04-01" xml:id="date_bae441a4">1839-04-01</date>
            </creation>
            <history xml:id="history_305e54eb">
               <eventList type="performances" xml:id="eventList_eb225932">
                  <event xml:id="event_d1e364358">
                     <date isodate="1839-04-02" xml:id="date_7a8ec85b">1839-04-02</date>
                     <geogName role="venue" xml:id="geogName_aba87667">Giuseppe Siboni's home in Vingaardsstræde</geogName>
                     <geogName role="place" xml:id="geogName_a12ed9ef">Copenhagen</geogName>
                     <corpName role="ensemble" xml:id="corpName_ca1387b6">Singers from The Royal Theatre (Det Kongelige Teater)</corpName>
                     <desc xml:id="idm74">First performance.</desc>
                  </event>
               </eventList>
               <p xml:id="idm75">Giuseppe Siboni (1780-1839) was an Italian operatic tenor, opera director, choir conductor, and singing teacher. In 1819 he joined The Royal Theatre in Copenhagen where he worked first as an opera singer and later as director of the singing school. In 1827 he founded the first academy of music in Copenhagen where Hartmann was a teacher right from the very beginning. Siboni had been a mentor for Hans Christian Andersen when he first came to Copenhagen as a fourteen-year old boy.</p>
            </history>
