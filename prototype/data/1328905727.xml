      <workList xml:id="idm62">
         <work xml:id="work_d1e176173">
            <identifier label="SchW" xml:id="identifier_9b893b5f">B5:001</identifier>
            <title xml:id="_12" xml:lang="it">Aria</title>
            <title type="alternative" xml:id="title_8deedc0b" xml:lang="it">Da me apprendate</title>
            <contributor xml:id="respStmt_0fd4cdc7">
               <persName role="composer" xml:id="_13">Johann Adolph Scheibe</persName>
            </contributor>
            <history xml:id="history_14_0">
               <p xml:id="idm71">A single Italian aria which presumably has been lost. The work is listed in the auction catalogue of the collection of <persName xml:id="idm72" auth.uri="http://www.viaf.org" auth="VIAF" role="">Count Frederik Danneskiold-Samsøe</persName>; the auction took place in 1771. The manuscript was bought by 'Hr. Amtsforvalter <persName xml:id="idm73" auth.uri="http://www.viaf.org" auth="VIAF" role="">Thygesen</persName>' for '1 Mk' (value: '6 Sk'). Count Danneskiold-Samsøe held weekly concerts at his town residence in Aarhus and was a great lover of foreign music, especially of the Italian kind. Each year the count also had Passion music performed at Lent.</p>
            </history>
