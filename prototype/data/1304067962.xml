            <history xml:id="history_8a4dd9fd">
               <eventList type="performances" xml:id="eventList_923ed042">
                  <event xml:id="event_d1e798779">
                     <persName role="" xml:id="persName_84ba0f8d">Louis Spohr, violin</persName>
                     <persName role="" xml:id="persName_74aa6b60">Marianne Spohr, piano</persName>
                     <date isodate="1846" xml:id="date_dbbef117">1846</date>
                     <geogName role="place" xml:id="geogName_5a64ca76">Kassel</geogName>
                     <desc xml:id="desc_205317f6">Private performance</desc>
                  </event>
                  <event xml:id="event_f5c2f6e3">
                     <date isodate="1846-03-19" xml:id="date_4aa98760">1846-03-19</date>
                     <geogName role="venue" xml:id="geogName_b8ed6893">Hôtel d'Angleterre</geogName>
                     <geogName role="place" xml:id="geogName_46f93474">Copenhagen</geogName>
                     <persName role="" xml:id="persName_c37ee867">Albert Moeser, violin</persName>
                     <persName role="" xml:id="persName_755c1875">Bernhard Courländer, piano</persName>
                     <desc xml:id="desc_ba5bd8e9">In the advertiement the sonata is announced as new.</desc>
                     <biblList xml:id="biblList_f5c6a5c1">
                        <head xml:id="head_1547f2a1">Reviews</head>
                     </biblList>
                     <biblList xml:id="biblList_454ae4c7">
