            <title xml:id="title_0af9631a" xml:lang="en">Cantata for the Jubilee Feast of The Society for the Posterity</title>
            <title type="alternative" xml:id="title_b98ea760" xml:lang="da">Knap gryer den næste Morgenstund</title>
            <contributor xml:id="respStmt_ef988c3d">
               <persName role="composer" xml:id="persName_356N2016C">J.P.E. Hartmann</persName>
