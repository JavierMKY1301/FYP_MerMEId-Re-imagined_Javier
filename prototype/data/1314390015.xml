            </creation>
            <history xml:id="history_356N20173">
               <eventList type="performances" xml:id="eventList_44c6be75">
                  <event xml:id="event_d1e533524">
                     <date isodate="1836-03-04" xml:id="date_911c0b35">1836-03-04</date>
                     <geogName role="venue" xml:id="geogName_356N20208">Gaarden Nr. 225 paa Hjørnet af Boldhuusgaden og Admiralgaden</geogName>
                     <geogName role="place" xml:id="geogName_356N2020C">Copenhagen</geogName>
                     <persName role="conductor" xml:id="persName_131c5993">Johannes Frederik Frøhlich</persName>
                     <desc xml:id="idm112">First performance.</desc>
                  </event>
                  <event xml:id="event_d1e549540">
                     <corpName role="ensemble" xml:id="corpName_b4de3ccb">Royal Danish Orchestra (Det Kongelige Kapel)</corpName>
                     <persName role="conductor" xml:id="persName_eace8832">Ivar Bredal</persName>
                     <date isodate="1837-01-28" xml:id="date_e31e171a">1837-01-28</date>
                     <geogName role="venue" xml:id="geogName_356N2021E">Hofteatret</geogName>
                     <geogName role="place" xml:id="geogName_356N20222">Copenhagen</geogName>
                     <desc xml:id="idm119">Musikforeningen's first concert.</desc>
                  </event>
               </eventList>
               <p xml:id="idm120">In the spring of 1836 Selskabet for Efterslægten (The Society for the Posterity) celebrated its 50th anniversary. It was founded in order to educate children and young people through lectures and publications. One of the most important activities was to run a secondary school. The most distinguished pupil was Adam Oehlenschläger, who wrote the text of the cantata.</p>
            </history>
