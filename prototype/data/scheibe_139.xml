            </titleStmt>
            <pubStmt xml:id="pubStmt_b23bdbc5">
               <publisher xml:id="publisher_36e75031">Johan Jørgen Høpfner</publisher>
               <pubPlace xml:id="pubPlace_26279ff3">Copenhagen</pubPlace>
               <date isodate="1743" xml:id="date_11f2b6bd">(1743)</date>
            </pubStmt>
            <physDesc xml:id="physDesc_4cce2396">
               <titlePage label="Title page" xml:id="titlePage_355c1a06">
                  <p xml:id="idm103">An dem | Hohen | Geburtsfeste | Der | Durchlauchtigsten Fürstin | und Frau | Louise | Vermählten Kronprinzeßin zu Dännemark | und Norwegen &amp;c. | Ward | Auf Allergnädigsten Befehl | Folgende | Cantate | In die Musik gesetzt und aufgeführet | Von | Johann Adolph Scheibe | Königl. Dän. Capellmeister. | ___ | Copenhagen, den 18 December, 1743. | ___ | Gedruckt in Ihro Königl. Majest. und Universit. Buchdruckerey, | von Johann Georg Höpffner. </p>
               </titlePage>
               <extent xml:id="extent_96eec265">4 pages</extent>
               <watermark xml:id="watermark_28143d5d">two distinct watermarks: bifolio has a partly visible emblem, presumably from a Dutch paper mill; flyleaves and pastedown of the volume have an emblem consisting of a coat-of-arms with a horn on a cord and below the base 'N Pannekoek' and the countermark 'IV' thus dating the paper and hence the binding to the beginning of the nineteenth century.</watermark>
               <physMedium xml:id="physMedium_ee1923eb">In 2<rend xml:id="idm107" rend="sup">o</rend>; title page (fol. 1r; no sig.), text. (fols. 1v–2v; no sig.); in all 4 unnumbered pages. Bound with other work relating to Queen Louise.</physMedium>
            </physDesc>
