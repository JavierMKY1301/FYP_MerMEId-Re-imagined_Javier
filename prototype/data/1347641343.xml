      <workList xml:id="workDesc_N2032B">
         <work xml:id="work_d1e225222">
            <identifier label="HartW" xml:id="identifier_N2032F">227</identifier>
            <title xml:id="title_6c8b2b31" xml:lang="da">Danmark, mit Fædreland!</title>
            <title xml:id="title_70ad9081" xml:lang="en">Denmark, my Fatherland</title>
            <title type="alternative" xml:id="title_b4a1d939" xml:lang="da">I Danmark er jeg født</title>
            <contributor xml:id="respStmt_N20340">
               <persName role="composer" xml:id="persName_b725a712">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_1208d148">Hans Christian Andersen</persName>
            </contributor>
            <creation xml:id="creation_adf82552">
               <date notafter="1900" notbefore="1850" xml:id="date_N2034D">After 1850</date>
            </creation>
            <history xml:id="history_93334a7a">
               <p xml:id="idm68">Hans Christian Andersen wrote the poem in 1850 during the German-Danish war. It was published on 5 March in the newspaper <rend xml:id="idm69" fontstyle="italic">Fædrelandet</rend> and had its first performance with music by Henrik Rung at a concert conducted by the composer on 8 May. In 1926 Poul Schierbeck wrote a new tune to this text, and today both tunes are used; Hartmann's on the other hand, is virtually unknown.</p>
            </history>
