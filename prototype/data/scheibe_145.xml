      <workList xml:id="workDesc_dd73d5d7">
         <work xml:id="work_d1e180177">
            <identifier label="SchW" xml:id="identifier_2499d328">B2:442</identifier>
            <title xml:id="title_f4e5c033" xml:lang="de">Der Triumph der Ehre</title>
            <title xml:id="title_287e9113" xml:lang="de">Der Tempel der Ehre</title>
            <title type="uniform" xml:id="title_08df0cb0" xml:lang="de">Kantate: Der Triumph der Ehre</title>
            <title type="uniform" xml:id="title_9c387a3d" xml:lang="de">Kantate: Der Tempel der Ehre</title>
            <contributor xml:id="respStmt_da2d5aab">
               <persName role="composer" xml:id="persName_57eb954e">Johann Adolph Scheibe</persName>
               <persName role="author" xml:id="persName_963c8249">Pietro Metastasio</persName>
               <persName role="translator" xml:id="persName_bc039b08">Johann Elias Schlegel</persName>
            </contributor>
            <creation xml:id="creation_9d6058f3">
               <date isodate="1747" xml:id="date_e2d665c8">1747</date>
               <geogName xml:id="geogName_df911579">Copenhagen,</geogName>
            </creation>
            <history xml:id="history_f42666b6">
               <p xml:id="idm118">According to Scheibe, he received the text to this ‘little cantata’ together with another one (‘Prokris und Cephalus’; SchW B2:432) as a present from <persName xml:id="idm119" auth.uri="http://www.viaf.org" auth="VIAF" role="">Johann Elias Schlegel</persName> in 1746. The texts were not published during Schlegel's lifetime. In 1747, Scheibe composed music to the texts for ‘various instruments’ and both works were performed at The Musical Society in Copenhagen and elsewhere. According to Scheibe the title of the cantata was ‘Der Tempel der Ehre’, but according the introduction to the collected works of Schlegel published in 1766, the title was ‘Der Triumph der Ehre’.</p>
            </history>
            <langUsage xml:id="langUsage_80f32b33">
               <language xml:id="da">Danish</language>
               <language xml:id="de">German</language>
            </langUsage>
            <biblList xml:id="listBibl_e613bfc4-6cb1-4b64-83da-d358e79c2222225">
               <head xml:id="head_3ea51195">Bibliography</head>
               <bibl label="" xml:id="bibl_e66d0454">
                  <genre xml:id="genre_8b356a42">book</genre>
                  <title level="m" xml:id="title_57429d18">Johann Elias Schlegels Werke</title>
                  <title level="s" xml:id="title_64a7d454"/>
                  <editor xml:id="editor_b8dfd8cf">Johann Heinrich Schlegel</editor>
                  <biblScope unit="vol" xml:id="biblScope_49b75010">4</biblScope>
                  <biblScope unit="page" xml:id="biblScope_458b6a9b">206</biblScope>
                  <imprint xml:id="imprint_7ce13a99">
                     <date isodate="1766" xml:id="date_d1e65c3a">1766</date>
                     <pubPlace xml:id="pubPlace_f7b446e4">Copenhagen &amp; Leipzig</pubPlace>
                  </imprint>
               </bibl>
               <bibl label="" xml:id="bibl_4478c4a0">
                  <biblScope xml:id="biblScope_0a179946">sig. *v</biblScope>
                  <genre xml:id="genre_479b86f1">book</genre>
                  <author xml:id="author_4ebb541b">Johann Adolph Scheibe</author>
                  <annot xml:id="annot_682b8fe4">
                     <p xml:id="idm140">
                        <lb xml:id="idm141"/>'Dieser für das deutsche Trauerspiel zu früh gestorbene wahre Dichter [Schlegel] machte mir schon im Jahre 1746. ein Geschenck mit dieser ["Prokris und Cephalus"] und noch mit einer andern kleinen Kantate, die den Nahmen "der Tempel der Ehre" fürhrte, und aus dem Metastasio sehr glücklich übersetzet war; und diese beyden Kantaten sind meines Wissens durch den Druck noch nicht bekannt gemacht worden. Sie wurden auch schon im Jahre 1747. von mir in die Musick, aber mit verschiedenen Instrumenten begleitet, gesetzt, und hier in Kopenhagen und auch anderwärts verschiedene Male aufgeführet.'</p>
                  </annot>
                  <title level="m" xml:id="title_88bd63a1">Tragische Kantaten für eine oder zwo Singestimmen und das Clavier</title>
                  <title level="s" xml:id="title_ac912871"/>
                  <imprint xml:id="imprint_15f25204">
                     <date isodate="1765" xml:id="date_93ac704f">1765</date>
                     <pubPlace xml:id="pubPlace_3bf1858a">Copenhagen &amp; Leipzig</pubPlace>
                  </imprint>
               </bibl>
            </biblList>
