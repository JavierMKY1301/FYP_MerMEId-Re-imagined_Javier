      <workList xml:id="workDesc_N20381">
         <work xml:id="work_d1e225222">
            <identifier label="HartW" xml:id="identifier_N20385">329</identifier>
            <title xml:id="title_162N200BD" xml:lang="da">Hvad toner gjennem Skoven i Nattens Vind?</title>
            <contributor xml:id="respStmt_N2038D">
               <persName role="composer" xml:id="persName_162N200C3">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_162N200C7">Johan Ludvig Heiberg</persName>
            </contributor>
            <creation xml:id="creation_162N200CC">
               <date isodate="1837" xml:id="date_N2039A">1837</date>
            </creation>
            <history xml:id="history_162N200CA">
               <p xml:id="idm93">In 1837 Hartmann participated in Musikforeningen's song contest on "den bedste Samling af 6 Sange over forskjellige nærmere bestemte Texter." His contribution was: No. 1 "Indvielsen"; No. 2. "Hvad toner gjennem Skoven"; No. 3 "Langsad Strandveien"; No. 4 "Til de Døde"; No. 5 "Lille Cathrine"; and No. 6 "Flyv, Fugl, flyv". Nos. 1 &amp; 4-6 were chosen by the jury to be published, while Nos. 2 &amp;. 3 remained unpublished. Hartmann was member of Musikforeningen's board.</p>
            </history>
            <langUsage xml:id="langUsage_N203A1">
               <language xml:id="da">Danish</language>
            </langUsage>
            <biblList xml:id="listBibl_abace8c5-498a-4d2f-8d92-d70d97f23388262">
