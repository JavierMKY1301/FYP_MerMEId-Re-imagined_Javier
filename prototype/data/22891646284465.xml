            <title type="subordinate" xml:id="title_dddd9803" xml:lang="fr">Introduzione imposante, Valse grazioso è Trio languente composta per Pianoforte (à quattro Mani) due, Violini, Alto è due Violoncelli è Triangolo</title>
            <contributor xml:id="respStmt_a39d5bbd">
               <persName role="composer" xml:id="persName_idd84d6090">Niels W. Gade</persName>
               <persName role="dedicatee" xml:id="persName_1d1de7be">Sophia Dorothea Thalbitzer</persName>
