            <physDesc xml:id="physDesc_N202DB">
               <extent xml:id="extent_N202DC">2 pages</extent>
               <dimensions unit="cm" xml:id="dimensions_N202DF">35.5 x 30</dimensions>
               <physMedium xml:id="physMedium_N202E2">1 folio. Written in brown ink. Paper: 24 staves. Title above the first stave: "Collect til Julefesten 1847. samtlige / Collecter <rend xml:id="idm34" rend="underline">Op</rend> 46. [Corrected in pencil in foreign hand to:] 49", which is incorrect. At the end of the music on the verso dated: "d: 4 Novbr. 1847."</physMedium>
            </physDesc>
            <notesStmt xml:id="notesStmt_N202E8">
               <annot type="source_description" xml:id="annot_364N2006B">
                  <p xml:id="idm37">The two last sentences "Opløfter eders Hoveder, I Porte" and "Hellig er Gud Fader" are missing in the autograph. They were probably added later, when the collect was published in "Liturgisk Musik" in 1881.</p>
               </annot>
            </notesStmt>
