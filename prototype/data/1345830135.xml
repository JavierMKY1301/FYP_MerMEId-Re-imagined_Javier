            <identifier label="HartW" xml:id="identifier_N203DC">192</identifier>
            <title xml:id="title_206N20122" xml:lang="da">Ryges Minde</title>
            <title xml:id="title_2b5a845b" xml:lang="en">In Memory of Ryge</title>
            <title type="alternative" xml:id="title_3aa21bdd" xml:lang="da">Dagen er oprunden</title>
            <contributor xml:id="respStmt_N203ED">
               <persName role="composer" xml:id="persName_206N20128">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_552b6ccd">Adam Oehlenschläger</persName>
            </contributor>
            <creation xml:id="creation_206N2012D">
               <date isodate="1842" xml:id="date_N203FA">1842</date>
            </creation>
            <history xml:id="history_206N2012B">
               <eventList type="performances" xml:id="eventList_b490a71c">
                  <event xml:id="event_df5a28f9">
                     <date isodate="1842-09-11" xml:id="date_N20404">1842-09-11</date>
                     <geogName role="venue" xml:id="geogName_69970418">The Royal Theatre (Det Kongelige Teater)</geogName>
                     <geogName role="place" xml:id="geogName_da8ce108">Copenhagen</geogName>
                     <corpName role="ensemble" xml:id="corpName_7b4ab69f">Royal Danish Orchestra (Det Kongelige Kapel)</corpName>
                     <desc xml:id="desc_6e20aa0a">At this memorial performance for Ryge, "Ryges Minde" was performed as a prelude and followed by Oehlenschlägers play "Tordenskjold", in which Ryge had had one of his best parts.</desc>
                     <biblList xml:id="biblList_8691f738">
                        <head xml:id="head_N2041B">Reviews</head>
                        <bibl label="" xml:id="bibl_a10ebdcf">
                           <genre xml:id="genre_N20420">article</genre>
                           <genre xml:id="genre_N20422">newspaper</genre>
                           <imprint xml:id="imprint_270db0b9">
                              <date isodate="1842-09-12" xml:id="date_6537092f">1842-09-12</date>
                              <pubPlace xml:id="pubPlace_dfd62038">Copenhagen</pubPlace>
                           </imprint>
                           <title level="a" xml:id="title_N20426">Theatret</title>
                           <title level="j" xml:id="title_N20428">Berlingske Politiske og Avertissements-Tidende</title>
                           <biblScope unit="issue" xml:id="biblScope_N2042D">242</biblScope>
                           <biblScope unit="page" xml:id="biblScope_N2042F">1</biblScope>
                        </bibl>
                     </biblList>
                     <biblList xml:id="biblList_862f9ffe">
                        <head xml:id="head_N20437">Evidence</head>
                     </biblList>
                  </event>
               </eventList>
               <p xml:id="idm145">The music was written in memory of the famous Danish actor Johan Christian Ryge who died on  29 June 1842. Being the foremost interpreter of the tragedies of Adam Oehlenschlæger, parts of the music are based on Hartmann's music for his "Olaf den Hellige" (HartW 11).</p>
            </history>
