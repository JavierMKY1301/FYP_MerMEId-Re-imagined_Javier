            </contributor>
            <creation xml:id="creation_idf42a9586">
               <date notafter="1854" notbefore="1833" xml:id="date_11c29ead">Between 1833 and 1854</date>
            </creation>
            <history xml:id="history_idc456ea53">
               <p xml:id="idm65">Johannes Ferdinand Fenger (1805-1861) was vicar at the church in Liunge [Lynge] from 1833 to 1854. He was a friend of B.S. Ingemann. In A.P. Berggreen's: "Danske Folke-Sange og Melodier" (1860), the song is called "Barnesjælen" and has a slightly different text.</p>
            </history>
            <langUsage xml:id="langUsage_aa5e7c28">
               <language xml:id="en">English</language>
               <language xml:id="da">Danish</language>
            </langUsage>
