      <workList xml:id="workDesc_f9ead6f1">
         <work xml:id="work_id14c53343">
            <identifier label="SchW" xml:id="identifier_caceab7b">A2:001</identifier>
            <title xml:id="title_id7281313e" xml:lang="it">I Sinfonia</title>
            <contributor xml:id="respStmt_096be597">
               <persName role="composer" xml:id="persName_id325a9b99">Johann Adolph Scheibe </persName>
            </contributor>
            <history xml:id="history_id375c65a3">
               <p xml:id="idm60">The sinfonia which appears in the Breitkopf catalogue of 1764 seems to have been lost, though it is possible that it might be among one of the works SchW A1:100–A1:105. Whether Scheibe sent the work directly to Breitkopf, or whether they acquired it from the collegium musicum in Leipzig or from the estate of <persName xml:id="idm61" auth.uri="http://www.viaf.org" auth="VIAF" role="">Carl Gotthelf Gerlach</persName>, the cantor at Neukirche, is an open question. In 1836 the work appears in the Breitkopf auction catalogue together with sinfonias by 'Schaffarost' (possibly <persName xml:id="idm62" auth.uri="http://www.viaf.org" auth="VIAF" role="">Christoph Schaffrath</persName>), <persName xml:id="idm63" auth.uri="http://www.viaf.org" auth="VIAF" role="">Schlick</persName> and <persName xml:id="idm64" auth.uri="http://www.viaf.org" auth="VIAF" role="">Schlöger</persName>.</p>
            </history>
            <langUsage xml:id="langUsage_43495da3">
               <language xml:id="en">English</language>
               <language xml:id="it">Italian</language>
            </langUsage>
            <biblList xml:id="biblList_204N200F5">
               <head xml:id="head_811b6d0a">Bibliography</head>
               <bibl label="" xml:id="bibl_ddb43977">
                  <genre xml:id="genre_a66e527d">book</genre>
                  <author xml:id="author_7632b86f">Johann Gottlob Immanuel Breitkopf</author>
                  <annot xml:id="annot_8ef31d4f">
                     <p xml:id="idm74">
                        <lb xml:id="idm75"/>(III.6. ‘Sinfonien mit 2 Violinen, Viole und Baß. Andere Instrumente sind besonders angemerkt.’); transcripts: 'Scheibe, Giov. Adolf. I. Sinfonia. 16 gl.'</p>
                  </annot>
                  <ptr label="Digitisation"
                       target="http://digital.staatsbibliothek-berlin.de/werkansicht?PPN=PPN778563847&amp;PHYSID=PHYS_0050&amp;DMDID=DMDLOG_0003"
                       xml:id="ptr_01e557a3"/>
                  <title level="m" xml:id="title_8ae1fcc3">Verzeichniß Musikalischer Werke</title>
                  <title level="s" xml:id="title_bad78fa1"/>
