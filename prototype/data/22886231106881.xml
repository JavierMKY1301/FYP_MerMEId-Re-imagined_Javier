      <manifestationList xml:id="sourceDesc_6dcdc8db">
         <manifestation label="" xml:id="source_9bb6c558">
            <identifier label="" xml:id="identifier_ca624590"/>
            <titleStmt xml:id="titleStmt_cfbbb2c3">
               <title xml:id="title_e1e02fd2">Piano score, autograph, sketch</title>
            </titleStmt>
            <pubStmt xml:id="pubStmt_b6a28e7f">
               <publisher xml:id="publisher_b92dec39"/>
               <pubPlace xml:id="pubPlace_d5f482ff"/>
               <date xml:id="date_50149285"/>
            </pubStmt>
            <physDesc xml:id="physDesc_5097fecf">
               <extent xml:id="extent_25a38266">10 pages</extent>
               <dimensions unit="cm" xml:id="dimensions_7f61264e">27 x 37.5</dimensions>
               <physMedium xml:id="physMedium_f87c225b">Bound in brown cardboard cover with library label. Written in ink. Paper: 14 staves. Paginated 1-9. Last page unnumbered and blank. In upper left-hand corner of p. 1 dated "16/10-38. / Stokholm". With sporadic indication of instruments. At the end of the music on p. 9 Gade has written: "Fine d 17 December 1838. Stockholm." and a list of the instruments identical with those in the autograph score.</physMedium>
            </physDesc>
