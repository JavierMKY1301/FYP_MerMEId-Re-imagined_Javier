            <title xml:id="title_id45db1a78" xml:lang="da">Lindormen og Jomfruen</title>
            <title xml:id="title_3747dd48" xml:lang="en">The Lindworm and the Maiden</title>
            <title type="alternative" xml:id="title_caebd16c" xml:lang="da">Jomfruens Hjemgang</title>
            <title type="alternative" xml:id="title_3aa4d6a8" xml:lang="da">List imod List</title>
            <contributor xml:id="respStmt_ed200f4e">
               <persName role="arranger" xml:id="persName_id1e593525">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_f728921b">Danish folk song</persName>
            </contributor>
            <creation xml:id="creation_id8024b98c">
               <date notafter="1854" notbefore="1833" xml:id="date_b10f9e16">Between 1833 and 1854</date>
            </creation>
            <history xml:id="history_id9ea8a8ca">
               <p xml:id="idm66">Johannes Ferdinand Fenger (1805-1861) was vicar at the church in Liunge [Lynge] from 1833 to 1854. He was a friend of B.S. Ingemann. A.P. Berggreen incorporated the song in his "Danske Folke-Sange og Melodier" (1855) with a slightly different text and without the refrain: "Mig kjedes ved at leve, saa længe nu mig".</p>
            </history>
            <langUsage xml:id="langUsage_c3ce1fea">
               <language xml:id="en">English</language>
               <language xml:id="da">Danish</language>
            </langUsage>
            <classification xml:id="classification_40b6e579">
               <termList xml:id="termList_9884f91a">
                  <term xml:id="term_4d64c46f">Vocal music</term>
                  <term xml:id="term_f8323293">Song</term>
               </termList>
            </classification>
