                     <incipText xml:id="incipText_8ef5c04a">
                        <p xml:id="p_508c156f" xml:lang="da">Skjøn Jomfru, skjøn Jomfru trolov dig med mig</p>
                     </incipText>
                     <graphic target="/dcm/assets/udgivelser/hartw/incipits/lowres/hartw_B_34.png" label=""
                              targettype="lowres"
                              xml:id="graphic_b2d120f0"/>
