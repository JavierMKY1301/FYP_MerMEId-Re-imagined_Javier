            <title xml:id="title_7b239547" xml:lang="en">The Music Loving Village Girl</title>
            <title type="alternative" xml:id="title_25010337" xml:lang="da">Jeg vandrer her allene</title>
            <title type="subordinate" xml:id="title_f50ad215" xml:lang="da">Romance af Øhlenschlæger med Musik af Hartmann</title>
            <contributor xml:id="respStmt_efb0a7ba">
               <persName role="composer" xml:id="persName_1f06750e">J.P.E. Hartmann</persName>
