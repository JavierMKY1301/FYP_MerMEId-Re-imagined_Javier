            </creation>
            <history xml:id="history_0e75468e">
               <eventList type="performances" xml:id="eventList_b33de934">
                  <event xml:id="event_b244617f">
                     <date isodate="1833-03-10" xml:id="date_6a925a79">1833-03-10</date>
                     <geogName role="venue" xml:id="geogName_b6e1d972">The Royal Theatre (Det Kongelige Teater)</geogName>
                     <geogName role="place" xml:id="geogName_46b14437">Copenhagen</geogName>
                     <corpName role="ensemble" xml:id="corpName_71338454">Royal Danish Orchestra (Det Kongelige Kapel)</corpName>
                     <persName role="" xml:id="persName_ba2e0c48">Charlotte Phister, soprano</persName>
                     <desc xml:id="desc_2cefb2e8">The concert was a soirée arranged by the flutist Niels Petersen.</desc>
                     <biblList xml:id="biblList_becc10ba">
                        <head xml:id="head_762284b4">Reviews</head>
                        <bibl label="" xml:id="bibl_e2e3c27f">
                           <genre xml:id="genre_b24bf3ff">article</genre>
                           <genre xml:id="genre_c64d6411">newspaper</genre>
                           <imprint xml:id="imprint_e5246277">
                              <date isodate="1833-03-11" xml:id="date_289a2046">1833-03-11</date>
                              <pubPlace xml:id="pubPlace_bc7a9175">Copenhagen</pubPlace>
                           </imprint>
                           <title level="a" xml:id="title_5b5202d5"/>
                           <title level="j" xml:id="title_c2f0e40c">Kiøbenhavnsposten</title>
                           <biblScope unit="vol" xml:id="biblScope_90ca171f">7</biblScope>
                           <biblScope unit="issue" xml:id="biblScope_79007d95">50</biblScope>
                           <biblScope unit="page" xml:id="biblScope_ad2be4b7">199</biblScope>
                        </bibl>
                     </biblList>
                     <biblList xml:id="biblList_56c6f797">
                        <head xml:id="head_e6f2d862">Evidence</head>
                     </biblList>
                  </event>
               </eventList>
               <p xml:id="idm119">Hartmann's collaboration with Adam Oehlenschläger was instigated in 1825, when the latter wrote the text to Hartmann's cantata "Orgelets Priis" (HartW 138), and continued in 1832 with "Guldhornene" (HartW 25). The soloist in the first performance was Oehlenschläger's daugther Charlotte Phister (1811-1835), who was married to the well-known Danish actor Ludvig Phister. She was a pupil of Giuseppe Siboni.</p>
            </history>
