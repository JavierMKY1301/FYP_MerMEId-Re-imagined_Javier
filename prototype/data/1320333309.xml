            <title xml:id="title_c99f1bd4" xml:lang="da">Indvielsen</title>
            <title xml:id="title_6dbc80d4" xml:lang="en">The Initiation</title>
            <title type="alternative" xml:id="title_a572cc43" xml:lang="da">Jeg sad paa Pynten</title>
            <contributor xml:id="respStmt_N20464">
               <persName role="composer" xml:id="persName_1da7b767">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_b6271a71">Adolph Wilhelm Schack von Staffeldt</persName>
            </contributor>
            <creation xml:id="creation_da64ce5a">
               <date isodate="1837" xml:id="date_N20471">1837</date>
            </creation>
            <history xml:id="history_df82bc35">
               <p xml:id="idm196">In 1837 Hartmann participated in Musikforeningen's competition on "den bedste Samling af 6 Sange over forskjellige nærmere bestemte Texter." His contributions were: No. 1. "Indvielsen"; No. 2. "Hvad toner gjennem Skoven"; No. 3. "Langsad Strandveien"; No. 4 "Til de Døde"; No. 5. "Lille Cathrine" and No. 6. "Flyv, Fugl, flyv". Nos. 1 and 4-6 were chosen for publication by the jury, whereas Nos. 2 &amp; 3 remained unpublished.</p>
            </history>
            <langUsage xml:id="langUsage_N20477">
               <language xml:id="da">Danish</language>
               <language xml:id="en">English</language>
            </langUsage>
