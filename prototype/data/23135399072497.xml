            </pubStmt>
            <physDesc xml:id="physDesc_91735001">
               <titlePage label="" xml:id="titlePage_f2b7d217">
                  <p xml:id="idm40">Gültige | Zeugnisse | über die jüngste | Matthesonisch = Musicalische | Kern = Schrifft, | Als ein | Füglicher Anhang derselben, | zum Druck befördert | von | Aristoxen, dem jüngern. | ___ | <rend xml:id="idm41" fontstyle="italic">Neque enim sum tam sapiens, ut nihil mea intersit, an iis, quæ hone-</rend> | <rend xml:id="idm42" fontstyle="italic">ste fecisse me credo, TESTIFICATIO quædam &amp; quasi</rend> | <rend xml:id="idm43" fontstyle="italic">præmium accedat. PLIN. L. V. EP. I.</rend> | ___ | Hamburg, 1738.</p>
               </titlePage>
               <titlePage label="Secondary title (p. 6)" xml:id="titlePage_8c404a29">
                  <p xml:id="idm45">III. | Sendschreiben an Sr. HochEdl. Herrn Capellmeister Mattheson, | über | den Kern melodischer Wissenschaft, von dem Verfasser | des sogenannten Critischen Musici abgelassen.</p>
               </titlePage>
               <titlePage label="Text (p. 15)" xml:id="titlePage_ec82bca6">
                  <p xml:id="idm47">dated 'Hamburg im Jenner 1738 | ergebenster Diener | Johann Adolph Scheibe.'</p>
               </titlePage>
               <extent xml:id="extent_ec9423b3">16 pages </extent>
               <physMedium xml:id="physMedium_630107df">In 4<rend xml:id="idm50" rend="sup">o</rend>; title page (sig. [a1r]), blank page (sig. [a1v]), text (pp. [3]–15), blank page (p. [16]); in all 16 pages. Scheibe's letter appears on pp. 6–15.</physMedium>
            </physDesc>
