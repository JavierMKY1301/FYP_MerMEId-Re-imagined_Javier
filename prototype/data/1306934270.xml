            <title xml:id="title_191N20104" xml:lang="da">Sørgemarsch ved N.P. Nielsens Begravelse fra Frue Kirke</title>
            <title xml:id="title_4cc1c84c" xml:lang="en">Funeral March at N.P. Nielsen's Funeral from The Church of Our Lady</title>
            <contributor xml:id="respStmt_20d12385">
               <persName role="composer" xml:id="persName_191N2010A">J.P.E. Hartmann</persName>
            </contributor>
            <creation xml:id="creation_191N2010F">
