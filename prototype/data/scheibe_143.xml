            <physDesc xml:id="physDesc_bd7b49c4">
               <titlePage label="Title page" xml:id="_8">
                  <p xml:id="idm70">Ved Graven, | Hvor i bliver hensat | Fordum | Den | Stormægtigste Monarch, | Nu hos GUD Høyst = Salige | Konge og Herre, | Kong | <rend xml:id="idm71" fontstyle="italic">CHRISTIAN</rend> | den Siette, | Konge til Danmark og Norge, de Venders | og Gothers; | Hertug til Slesvig, Holsteen, Stormarn og Ditmarsken; | Greve udi Oldenborg og Delmenhorst &amp;c. &amp;c. &amp;c. | Paa den Dag | Det Høy = Kongelige Liig | Blev nedsat blant | De Høy = Kongelige Forfædre | i De Høyst = Salige Kongers Begravelse | i <rend xml:id="idm72" fontstyle="italic">Roëskilde</rend> | den 5<rend xml:id="idm73" rend="sup">te</rend>
                     <rend xml:id="idm74" fontstyle="italic">Octobr. Anno</rend> 1746. | Blev dette allervæmodigst frembaaren af | <rend xml:id="idm75" fontstyle="italic">SPARKIÆR</rend>, | Og i <rend xml:id="idm76" fontstyle="italic">Musiquen</rend> opført af <rend xml:id="idm77" fontstyle="italic">JOHANN ADOLPH SCHEIBE</rend>, | Kongelig Capellmester. | ___ | Kiøbenhavn, trykt hos Ernst Henrich Berling.</p>
               </titlePage>
               <extent xml:id="extent_e9d0f570">6 pages</extent>
               <watermark xml:id="watermark_86c8cd42">two different watermarks: 1) coat-of-arms and band, with a fleur-de-lis on top and 'C &amp; I H' (C. and J. Honig) below; 2) crowned coat-of-arms with a post horn, and a '4' below the base of the emblem and 'NPannekoek', presumably dating the end of the eighteenth century or the beginning of the nineteenth century (same as SchW B2:425).</watermark>
               <physMedium xml:id="physMedium_a02986a7">In 2<rend xml:id="idm81" rend="sup">o</rend>; title page, blank page, text, blank page; no signatures; in all 6 unnumbered pages. Work bound with other works from the event.</physMedium>
            </physDesc>
