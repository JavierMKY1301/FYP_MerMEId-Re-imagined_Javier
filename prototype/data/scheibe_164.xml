      <workList xml:id="workDesc_4a0c4dad">
         <work xml:id="work_d1e223220">
            <identifier label="SchW" xml:id="identifier_30426021">B2:424</identifier>
            <title xml:id="title_4059a127" xml:lang="da">Kantate til Friderichs tydske Kirkes Taarn paa Christianshavn</title>
            <title type="uniform" xml:id="title_26c52455" xml:lang="en">Cantata on the occasion of the inauguration of the church tower of 'Friderichs tydske Kirke' </title>
            <contributor xml:id="respStmt_85fcfad9">
               <persName role="composer" xml:id="persName_27ccfd51">Johann Adolph Scheibe</persName>
            </contributor>
            <creation xml:id="creation_1f2e5856">
               <date isodate="1770" xml:id="date_e4b19ebb">1770</date>
               <geogName xml:id="geogName_139cd4a1">Copenhagen,</geogName>
            </creation>
            <history xml:id="history_640d2e83">
               <p xml:id="idm80">The only reference to the present work is a short notice in the newspaper <rend xml:id="idm81" fontstyle="italic">Kiøbenhavns Adresse-Contoirs Efterretninger </rend>of 30 November 1770. For the inauguration of the new church tower and clock of Frederiks tyske Kirke on Christianshavn, Scheibe composed the cantata which was performed on the first Sunday in Advent.</p>
            </history>
            <langUsage xml:id="langUsage_de49ff8c">
               <language xml:id="da">Danish</language>
               <language xml:id="en">English</language>
            </langUsage>
            <biblList xml:id="listBibl_b9cc6e02-73b2-4550-b869-b2c36087e776261">
               <head xml:id="head_754ebb61">Bibliography</head>
               <bibl label="" xml:id="bibl_0a17ff7b">
                  <genre xml:id="genre_4501fa93">article</genre>
                  <genre xml:id="genre_f1b83fc3">newspaper</genre>
                  <annot xml:id="annot_dd00b426">
                     <p xml:id="idm91">
                        <lb xml:id="idm92"/>'Da nu Friderichs tydske Kirkes Taarn paa Christianshavn er færdig, saa kommer sammes Slag-Uhr til at slaae første Gang paa Søndag, som er 1ste Advent Søndag, Kl. 8. og til Guds Tienesten bliver ligeledes første Gang ringet med de 3 nye Klokker. Til Meenighedens Opbyggelse og Opmuntring bliver for Prædiken en hertil indrettet Cantate opført af Hr. Capel-Mester Scheibe, og efter Prædiken under Pauker og Trompeter siunget: O store Gud vi love dig.'</p>
                  </annot>
                  <title level="a" xml:id="title_c8bed902"/>
                  <title level="j" xml:id="title_66c29576">Kiøbenhavns Adresse-Contoirs Efterretninger</title>
                  <imprint xml:id="imprint_8b586e4d">
                     <date isodate="1770-11-30" xml:id="date_b2bc6723">1770-11-30</date>
                  </imprint>
               </bibl>
            </biblList>
