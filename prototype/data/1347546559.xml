            <title xml:id="title_a741ba76" xml:lang="en">At the 100th Anniversary Feast of The Society for Civic Virtue's Schools on 1 May 1887</title>
            <title type="alternative" xml:id="title_290169d1" xml:lang="da">Nærsynet var hin svundne Old</title>
