               <titlePage label="Title page" xml:id="titlePage_201N2005A">
                  <p xml:id="idm54">Ved / Borgerdyd-Skolernes / Jubelfest 1/5 87 / af Chr. Richardt / Musik af I:P:E:Hartmann / Partituret indrettet af / Bohlmann.</p>
               </titlePage>
               <extent xml:id="extent_N20324">24 pages</extent>
