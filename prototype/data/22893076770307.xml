      <workList xml:id="workDesc_3d7f6c0b">
         <work xml:id="work_id25736587">
            <identifier label="SchW" xml:id="identifier_19486a6d">B2:309</identifier>
            <title xml:id="title_id1e6b82b6" xml:lang="de">Paßions-Cantate</title>
            <title type="alternative" xml:id="title_f35ecf39" xml:lang="de">Der durch Jesu Leiden erlöste Sünder: Unsere Seele ist entronnen</title>
            <contributor xml:id="respStmt_f3262520">
               <persName role="composer" xml:id="persName_idbcbcb499">Johann Adolph Scheibe </persName>
            </contributor>
            <history xml:id="history_id8061d7ef">
               <p xml:id="idm61">The Passion cantata has presumably been lost. It appears only in the Breitkopf catalogue of 1761, thus suggesting that it may have been acquired by the publishers from the estate of <persName xml:id="idm62" auth.uri="http://www.viaf.org" auth="VIAF" role="">Carl Gotthelf Gerlach</persName>, the cantor of Neukirche in Leipzig who had died earlier that year. In that case it was probably performed there and might have been commissioned by Gerlach. It is possible that the cantata was one of his early works mentioned in Scheibe’s autobiography (Mattheson's <rend xml:id="idm63" fontstyle="italic">Grundlage</rend>,1740; SchW C5:001). It is not listed in the Breitkopf auction catalogue of 1836.</p>
            </history>
            <langUsage xml:id="langUsage_30fc174b">
               <language xml:id="en">English</language>
               <language xml:id="de">German</language>
            </langUsage>
