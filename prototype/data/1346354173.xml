            <title xml:id="title_53f93d2d" xml:lang="da">Cantate i Anledning af hendes Majestæt Dronning Caroline Amalias høie Fødselsfest den 28. Juni 1842</title>
            <title xml:id="title_7b98144f" xml:lang="en">Cantata on the Occasion of Her Majesty Queen Caroline Amalia´s Birth Feast on 28 June 1842</title>
            <title type="alternative" xml:id="title_76ccd4ba" xml:lang="da">Et dejligt Skov- og Kornland</title>
            <contributor xml:id="respStmt_b7f5b1bc">
               <persName role="composer" xml:id="persName_eeb95ef5">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_83696eee">Hans Christian Andersen</persName>
            </contributor>
            <creation xml:id="creation_d9fac7b7">
               <date isodate="1842-06-26" xml:id="date_75f31cf6">1842-06-26</date>
            </creation>
            <history xml:id="history_e62894af">
               <eventList type="performances" xml:id="eventList_d32ef857">
                  <event xml:id="event_d1e484476">
                     <date isodate="1842-06-28" xml:id="date_fe6a99e6">1842-06-28</date>
                     <geogName role="venue" xml:id="geogName_5c51dffd">Sorgenfri Slot</geogName>
                     <corpName role="ensemble" xml:id="corpName_fae1175c">Royal Danish Orchestra (Det Kongelige Kapel))</corpName>
                     <persName role="" xml:id="persName_7dec1488">Jfr: Hansen, soprano</persName>
                     <persName role="" xml:id="persName_18a7574b">Vilhelmine Østerberg, soprano</persName>
                     <persName role="" xml:id="persName_d341a942">Ida Liebert, soprano</persName>
                     <persName role="" xml:id="persName_a668028d">Julie or Ida da Fonseca, soprano</persName>
                     <persName role="" xml:id="persName_549ad77b">Rasmus Faaborg, tenor</persName>
                     <persName role="" xml:id="persName_27e48360">Ludvig Bernhard Sahlgreen, tenor</persName>
                     <persName role="" xml:id="persName_91faa979">Wilhelm Traugott Naumann, bass</persName>
                     <persName role="" xml:id="persName_f794592a">H. Lund, bass</persName>
                     <desc xml:id="idm167">First performance.</desc>
                  </event>
               </eventList>
               <p xml:id="idm168">Caroline Amalie (1796-1881) was the daughter of the Duke of Slesvig-Holsten-Sønderborg-Augustenborg and King Frederik VI´s half sister, Princess Louise Augusta, who was the daugther of Queen Caroline Mathilde and her physician-in-ordinary Johann Friedrich Struensee. In 1815 Caroline Amalie married the later King Christian VIII and became Queen of Denmark 1839-1848.</p>
            </history>
