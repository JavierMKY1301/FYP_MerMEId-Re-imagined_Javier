      <workList xml:id="workDesc_d1963f5a">
         <work xml:id="work_d1e231228">
            <identifier label="SchW" xml:id="identifier_0d6d284e">A4:Coll.003</identifier>
            <title xml:id="title_a2afe690" xml:lang="it">III sonate per il cembalo solo</title>
            <contributor xml:id="respStmt_bca3b58e">
               <persName role="composer" xml:id="persName_d4c0bd1b">Johann Adolph Scheibe</persName>
            </contributor>
            <history xml:id="history_8e0749b7">
               <p xml:id="idm92">The collection contains three sonatas for solo harpsichord. The only surviving source to this collection is possibly a late eighteenth-century transcript. None of the sonatas agree with the incipits of the Breitkopf catalogues of 1762–63 or any of the other solo sonatas which have survived (SchW A4:006, A4:007, A4:008, A4:Coll.005). The watermark suggests that the transcript was produced sometime after 1753.</p>
            </history>
            <langUsage xml:id="langUsage_9839b4bd">
               <language xml:id="en">English</language>
               <language xml:id="it">Italian</language>
            </langUsage>
            <biblList xml:id="listBibl_c6a23c63-d67b-47c9-a15d-688318b41559271">
               <head xml:id="head_0044ffb5">Bibliography</head>
               <bibl label="" xml:id="bibl_90f9cf5f">
                  <genre xml:id="genre_e0496d99">manuscript</genre>
                  <author xml:id="author_d4e4d51f">Andreas Peter Berggreen</author>
                  <title xml:id="title_1584cb6c">Fortegnelse over mine Bøger og Musicalier</title>
                  <creation xml:id="creation_c8560b66">
                     <date isodate="1832" xml:id="date_6550b98d">1832</date>
                  </creation>
                  <physLoc xml:id="physLoc_d72e1274">
                     <repository xml:id="repository_e1090fd3">
                        <identifier auth.uri="http://www.rism.info" auth="RISM" xml:id="identifier_0b82893a">DK-Kk</identifier>
                     </repository>
                     <identifier xml:id="identifier_c01438c9">NKS 1291, 8<rend xml:id="idm108" rend="sup">o</rend>
                     </identifier>
                  </physLoc>
                  <annot xml:id="annot_22aa1a73">
                     <p xml:id="idm110">
                        <lb xml:id="idm111"/>p. 152 lists 'Scheibe: 3 Sonate per il Cembalo. (manuscript)' thus implying that the present MS once belonged to Berggreen.</p>
                  </annot>
               </bibl>
            </biblList>
