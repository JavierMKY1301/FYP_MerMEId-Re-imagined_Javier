      <manifestationList xml:id="sourceDesc_5b1581cb">
         <manifestation label="" xml:id="source_d1e32">
            <titleStmt xml:id="titleStmt_f17d555e">
               <title xml:id="title_fa2519f7">Score, transcript</title>
            </titleStmt>
            <physDesc xml:id="physDesc_edd9a95f">
               <titlePage label="Title page (folder, fol. 1r)" xml:id="titlePage_3d90a06c">
                  <p xml:id="idm36">III Sonate | da Scheibe. | &amp;lt;<rend xml:id="idm37" rend="line-through">N.W. Gade</rend>&amp;gt;</p>
               </titlePage>
               <titlePage label="Secondary title page (fol. 2r)" xml:id="titlePage_a83ca2a2">
                  <p xml:id="idm39">III. Sonate. | per il. | Cembalo Solo. | Composti. | dal. | Sr. Scheibe</p>
               </titlePage>
               <extent xml:id="extent_939d7423">10 folios</extent>
               <dimensions unit="cm" xml:id="dimensions_a10d42d5">32.6x21</dimensions>
               <watermark xml:id="watermark_ee3818ab">two distinct watermarks are found: 1) the folder has a watermark consisting of the countermark 'C &amp; I Honig' and the 'Pro Patria' emblem; and 2) the countermark which is a crowned 'GR' and the emblem consisting of a crowned circle with a lion holding a wand with a hat on top and the text 'libertate propa ejusque' and 'vryheyt' (Heawood:3149), which may be dated to around 1753.</watermark>
               <physMedium xml:id="physMedium_78b500d5">In 2<rend xml:id="idm44" rend="sup">o</rend>; upright format, consisting of 5 nested bifolios of which the first also functions as folder; title page (fol. 1r), blank page (fol. 1v), secondary title page (fol. 2r),  music (fols. 2v–10r), blank page (fol. 10v); in all 10 folios. Hand-ruled paper, 14 staves (9 mm; single rastrum used) in brown ink and music in black ink; on some pages the bottom staves have not been used due to new movements. A clean copy. The source contains three sonatas: 'Sonata 1<rend xml:id="idm45" rend="sup">
                     <rend xml:id="idm46" rend="underline">ma</rend>
                  </rend>' (fols. 2v–4v); 'Sonata 2<rend xml:id="idm47" rend="sup">
                     <rend xml:id="idm48" rend="underline">do</rend>
                  </rend>' (fols. 4v–7r); and 'Sonata' (fols. 7v–10r).</physMedium>
            </physDesc>
