            <creation xml:id="creation_24_0">
               <date isodate="1746" xml:id="date_880b0e47">1746</date>
               <geogName xml:id="geogName_24_0">Copenhagen,</geogName>
            </creation>
            <history xml:id="history_24_0">
               <p xml:id="idm122">The work, which has not survived except for the text book, was performed at The Musical Society in autumn 1746 commemorating the deceased <persName xml:id="idm123" auth.uri="http://www.viaf.org" auth="VIAF" role="">Christian VI</persName>. The text was by <persName xml:id="idm124" auth.uri="http://www.viaf.org" auth="VIAF" role="">Peder Sparkiær</persName> who had often provided texts for official events at the court. The present cantata uses the same text as SchW B2:425, though it includes some additional chorales as well as a motet.</p>
            </history>
