      <workList xml:id="workDesc_13ea9083">
         <work xml:id="work_id92944699">
            <identifier label="SchW" xml:id="identifier_dc039857">B2:009</identifier>
            <title xml:id="title_ida8d68954" xml:lang="de">Cantate: In Festo Circumcisionis Christi</title>
            <title type="alternative" xml:id="title_5f70a44d" xml:lang="de">Preise Jerusalem den Herrn</title>
            <contributor xml:id="respStmt_ca566aeb">
               <persName role="composer" xml:id="persName_id45d8ff8b">Johann Adolph Scheibe</persName>
            </contributor>
            <history xml:id="history_idf16ce479">
               <p xml:id="idm61">The church cantata composed for 1 January (celebration of Jesus’ circumcision) has presumably been lost. It appears only in the Breitkopf catalogue of 1761, thus suggesting that it may have been acquired by the publishers from the estate of <persName xml:id="idm62" auth.uri="http://www.viaf.org" auth="VIAF" role="">Carl Gotthelf Gerlach</persName>, the cantor of Neukirche in Leipzig who had died earlier that year. In that case it was probably performed there and might have been commissioned by Gerlach. Later it was listed in the publishers’ auction catalogue of 1836.</p>
            </history>
            <langUsage xml:id="langUsage_b55587ee">
               <language xml:id="en">English</language>
               <language xml:id="de">German</language>
            </langUsage>
            <biblList xml:id="biblList_212N200FA">
               <head xml:id="head_e0cb1f12">Bibliography</head>
               <bibl label="" xml:id="bibl_936dc3e1">
                  <genre xml:id="genre_5e8e9eb6">book</genre>
                  <author xml:id="author_39770b2e">Johann Gottlob Immanuel Breitkopf</author>
                  <annot xml:id="annot_a38f3dc8">
                     <p xml:id="idm72">
                        <lb xml:id="idm73"/>(I.A.5.b. ‘Fest. Jahrgänge, nebst einigen Sonntags-Cantaten’): '[Scheibens, Joh. Adolph,] Cantate: In Fest. Circumc. Preise Jerusalem den Herrn, à 3 Tromb. Tymp. 2 Oboi, 2 Violini, Viola, 4 Voci, Basso ed Organo. a 2 thl. 16 gl.'; ‘NB. In Partitur sind die Preiße etwas geringer.’</p>
                  </annot>
                  <ptr label="Digitisation"
                       target="http://digital.staatsbibliothek-berlin.de/werkansicht?PPN=PPN778562883&amp;PHYSID=PHYS_0020&amp;DMDID=DMDLOG_0002"
                       xml:id="ptr_59985ad1"/>
