                  <p xml:id="idm35">Concerto per il Cembalo composto da Giovanni Adolfo | Scheibe</p>
               </titlePage>
               <titlePage label="Dating (fol. 35v)" xml:id="titlePage_68c3b54b">
                  <p xml:id="idm37">H. N. Gerber | d. 17 Julii | 1727.</p>
               </titlePage>
               <extent xml:id="extent_cc52a64c">2 folios</extent>
               <dimensions unit="cm" xml:id="dimensions_0051c18e">20x13.5</dimensions>
               <physMedium xml:id="physMedium_bc541fa8">In 2<rend xml:id="idm41" rend="sup">o</rend>; upright format; notes on the organ's Hauptwerk, Rückpositif and Pedal (fol. 1r), blank page (fol. 1v), illustration of the 'circle of fifths' (fol. 2r), blank page (fol. 2v), music (fols. 3r–62r), list of five hymn titles in the volume (fol. 62v), notes on the 'Specificatio derer Gebräulichsten Stimmen einer Orgel' (fol. 63r); Scheibe's concerto appears on fols. 54r–55v; in all 2 folios. Hand-ruled paper, 14 staves on fol. 1r–v and 12 staves on fol. 2r–v (6 mm; single rastrum used but in pairs of two staves) in light brown ink and music in black. A clean copy with a single correction.</physMedium>
            </physDesc>
