            <title xml:id="title_3cf245e4" xml:lang="en">Echo of Fredensborg</title>
            <title type="subordinate" xml:id="title_73512cf5" xml:lang="fr">Pìece d'Orchestre composée pour la chapelle de sa Majesté Alexandre III Empereur de toutes les Russies</title>
            <contributor xml:id="respStmt_fb6bf074">
               <persName role="composer" xml:id="persName_id74ddcfcb">Niels W. Gade</persName>
            </contributor>
            <creation xml:id="creation_id1743baba">
               <date enddate="1890-08-14" startdate="1890-08-10" xml:id="date_a66a1593">10 to 14 August 1890</date>
               <geogName xml:id="geogName_idcdb20129">Fredensborg</geogName>
            </creation>
            <history xml:id="history_id1760b0f7">
               <p xml:id="idm272">Tsar Alexander III of Russia was married to the Danish princess Dagmar (in Russia called Maria Feodorovna), daughter of King Christian IX and Queen Louise. Each summer his parents-in-law held family reunions at the royal palace at Fredensborg, bringing Alexander, Dagmar and their children to Denmark. In 1885 the Tsar acquired a house of his own in Fredensborg. Gade also spent the summers in Fredensborg during his later years.</p>
            </history>
