                  <author xml:id="author_6a0dfc9e">Johann Gottlob Immanuel Breitkopf</author>
                  <annot xml:id="annot_8c01b2a7">
                     <p xml:id="idm98">
                        <lb xml:id="idm99"/>(II.A.4. ‘Die Orgel und das Clavicimbel. Die Orgel. Trios.’): 'Scheibens, Joh. Adolph, Königl. Dän. Capellmeisters, II. Sonaten für zwey Claviere und Pedal. a 1 thl. 12 gl.'</p>
                  </annot>
                  <ptr label="Digitisation"
                       target="http://digital.staatsbibliothek-berlin.de/werkansicht?PPN=PPN778562883&amp;PHYSID=PHYS_0040&amp;DMDID=DMDLOG_0003"
