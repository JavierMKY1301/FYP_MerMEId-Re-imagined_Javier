         <manifestation label="" xml:id="source_a1550cb3">
            <titleStmt xml:id="titleStmt_11c04648">
               <title xml:id="title_acf0522a">Text, transcript</title>
               <respStmt xml:id="respStmt_7796a884">
                  <persName role="author" xml:id="persName_1ff6a0a4">Balthasar Münter</persName>
               </respStmt>
            </titleStmt>
            <physDesc xml:id="physDesc_9d110153">
               <titlePage label="" xml:id="titlePage_a298db1a">
                  <p xml:id="idm24">Gebet bey der <rend xml:id="idm25" rend="underline">Confirmation</rend> junger Christen. | Mel. Mitten wir im Leben sind. | ___ |</p>
               </titlePage>
               <extent xml:id="extent_36f92826">1 fascicle</extent>
               <dimensions unit="cm" xml:id="dimensions_cfe39259">18.7x11.8</dimensions>
               <watermark xml:id="watermark_4ce459d8">partly visible emblem consisting of a crowned coat-of-arms with a post horn on a cord, below 'J Honig | &amp; | Zoonen' corresponding to Heawood:2748 (not dated).</watermark>
               <physMedium xml:id="physMedium_dc3c5a61">A single, trimmed fascicle with one stanza on each page; written in ink, possibly autograph (Balthasar Münter). Paper of a good quality.</physMedium>
            </physDesc>
            <notesStmt xml:id="notesStmt_a7c851a5">
               <annot type="source_description" xml:id="annot_f340ffa8">
                  <p xml:id="idm32">The text which originally belonged to Scheibe was most likely given by Balthasar Münter – presumably an autograph – in connection with Scheibe's contribution to <rend xml:id="idm33" fontstyle="italic">Erste Sammlung geistlicher Lieder</rend>; text also appears in Sturm, <rend xml:id="idm34" fontstyle="italic">Reden bey der Confirmation der Jugend</rend> (Magdeburg, 1774), p. 200.</p>
               </annot>
            </notesStmt>
