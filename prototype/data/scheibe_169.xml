            <physDesc xml:id="idm79">
               <titlePage label="" xml:id="titlePage_7732dad3">
                  <p xml:id="idm81">Erste Sammlung | Geistlicher Lieder | von | Balthasar Münter, | Doktor der Gottesgelahrheit, und | Pastor an der Deutschen Petri Kirche | zu Kopenhagen. [emblem: palm trees and tablet] | ___ | Zwote Auflage. | ___ | Leipzig, | in der Dyckischen Buchhandlung. | 1773.</p>
               </titlePage>
               <titlePage label="Zuschrift (sig. A2r)" xml:id="titlePage_19c0ee3d">
                  <p xml:id="idm83">dated 'Kopenhagen, den 11ten Jänner 1772'.</p>
               </titlePage>
               <titlePage label="Vorberichten zur zwoten Ausgabe (sig. A6v)" xml:id="titlePage_bb2767a5">
                  <p xml:id="idm85">dated 'Kopenhagen, den 9. Februar 1773.'</p>
               </titlePage>
               <extent xml:id="idm86">190 pages</extent>
               <physMedium xml:id="idm87">In 8<rend xml:id="idm88" rend="sup">o</rend>; flyleaf, title page (sig. [A1r]), blank page (sig. [A1v]), 'Zuschrift' (sigs. A2r–A6r), 'Vorbericht zur zwoten Ausgabe' (sig. A6v), hymn texts (pp. [1]–190), indexes (sigs. [N6r]–[N8v]); in all 190 pages. Source bound with <rend xml:id="idm89" fontstyle="italic">Zwote Sammlung Geistlicher Lieder</rend> (Leipzig, 1774).</physMedium>
            </physDesc>
            <notesStmt xml:id="idm90">
               <annot type="source_description" xml:id="annot_51b0cddf">
                  <p xml:id="idm92">The second edition was issued due to the bad print and the low paper quality of the first edition. In the preview to the second edition, Münter lists the composers who have provided new melodies to the collection mentioning 'Bach in Hamburg, Bach in Bückeburg, Benda in Gotha, Hertel in Schwerin, Hiller in Leipzig, Kunzen in Lübeck, Rolle in Magdeburg, Scheibe in Kopenhagen, und Wolf in Weimar'.</p>
               </annot>
            </notesStmt>
