      <workList xml:id="workDesc_5f32b05c">
         <work xml:id="work_idfbd8fa1b">
            <identifier label="SchW" xml:id="identifier_be9519e2">C4:001</identifier>
            <title xml:id="title_idfe34bfdd" xml:lang="de">Ausführlicher Unterricht von der Zucht und Wartung der besten Art von Schafen</title>
            <title type="original" xml:id="title_c6116e0e" xml:lang="sv">Utförlig och Omständelig Underrättelse om fullgoda Fårs Ans och Skjötsel, til det Allmännas tjänst sammanfattad af Fried. W. Hastfer</title>
            <contributor xml:id="respStmt_5ba24110">
               <persName role="author" xml:id="persName_ccb8fd47">Friedrich Wilhelm Hastfer</persName>
               <persName role="translator" xml:id="persName_idcec9e1ef">Johann Adolph Scheibe</persName>
            </contributor>
            <creation xml:id="creation_id54c11275">
               <date isodate="1754" xml:id="date_752d9ca8">1754</date>
            </creation>
            <history xml:id="history_idf498004f">
               <p xml:id="idm83">In 1752, the Swedish <persName xml:id="idm84" auth.uri="http://www.viaf.org" auth="VIAF" role="">Count Friedrich Wilhelm Hastfer</persName> (1722–68) published a treatise on the best way of keeping sheep, and already two years later it was translated into German by Scheibe while he was living in Sønderborg. Returning from Iceland in 1760, Hastfer settled in Copenhagen receiving a pension.That same year an extensive article appeared in <rend xml:id="idm85" fontstyle="italic">Hannoverische Gelehrte Anzeigen</rend> (1754), referring to a review which was issued in <rend xml:id="idm86" fontstyle="italic">Göttingische Anzeigen</rend>. The treatise was translated into French in 1756, the same year that <persName xml:id="idm87" auth.uri="http://www.viaf.org" auth="VIAF" role="">Frederik V</persName> sent Hastfer to Iceland to experiment with sheep-breeding.</p>
            </history>
            <langUsage xml:id="langUsage_bfa82c64">
               <language xml:id="en">English</language>
               <language xml:id="de">German</language>
               <language xml:id="sv">Swedish</language>
            </langUsage>
