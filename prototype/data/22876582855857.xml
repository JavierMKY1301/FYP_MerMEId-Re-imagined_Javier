      <workList xml:id="workDesc_493a7112">
         <work xml:id="work_id69c8f394">
            <identifier label="SchW" xml:id="identifier_8689cc6c">B4:004</identifier>
            <title xml:id="title_idac22b55c" xml:lang="la">Magnificat</title>
            <contributor xml:id="respStmt_e732f526">
               <persName role="composer" xml:id="persName_id5e9c2f4a">Johann Adolph Scheibe</persName>
            </contributor>
            <creation xml:id="creation_idc7365f7c">
               <date isodate="1735" xml:id="date_d0d6d778">1735</date>
               <geogName xml:id="geogName_50ba0869">Leipzig,</geogName>
            </creation>
            <history xml:id="history_idca27af0c">
               <p xml:id="idm63">The Magnificat was most likely composed at the instigation of the cantor of Neukirche in Leipzig, <persName xml:id="idm64" auth.uri="http://www.viaf.org" auth="VIAF" role="">Carl Gotthelf Gerlach</persName>, and was performed there before Scheibe left the town in 1735. In 1761, Breitkopf acquired the work from the estate of Gerlach and included it in his list of master copies from which transcripts could be bought. It is listed again in the publishers’ catalogue of 1769, but does not appear in their auction catalogue of 1836. The Magnificat has not survived.</p>
            </history>
            <langUsage xml:id="langUsage_a6d14607">
               <language xml:id="en">English</language>
               <language xml:id="la">Latin</language>
            </langUsage>
            <biblList xml:id="biblList_212N200D7">
               <head xml:id="head_39db08d9">Bibliography</head>
               <bibl label="" xml:id="bibl_b130f81f">
                  <genre xml:id="genre_497e46af">book</genre>
                  <author xml:id="author_a16f7c01">Johann Gottlob Immanuel Breitkopf</author>
                  <annot xml:id="annot_2959f1ea">
                     <p xml:id="idm74">
                        <lb xml:id="idm75"/>(I.A.2.c. ‘<rend xml:id="idm76" fontstyle="italic">Magnificat</rend>, mit Instrumenten, lateinische’): 'Scheibe, Maestro di Cap. di Ré di Damen. [sic] Magnificat, à 3 Trombe, Tymp. 2 Oboi, 2 Violini, Viola, 4 Voci e Basso. à 1thl. 20 gl.'</p>
                  </annot>
                  <ptr label="Digitisation"
                       target="http://digital.staatsbibliothek-berlin.de/werkansicht?PPN=PPN778562883&amp;PHYSID=PHYS_0011&amp;DMDID=DMDLOG_0002"
                       xml:id="ptr_c22588f4"/>
                  <title level="m" xml:id="title_cddf7cf1">Verzeichniß Musikalischer Werke, allein zur Praxis, sowohl zum Singen, als für alle Instrumente, welche nicht durch den Druck bekannt gemacht worden</title>
