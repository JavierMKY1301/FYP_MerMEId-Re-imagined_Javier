            <physDesc xml:id="physDesc_56894829">
               <titlePage label="Title page" xml:id="titlePage_254N2005A">
                  <p xml:id="idm32">Concert Ouverture / I:P:E:Hartmann op: 51. (?)</p>
               </titlePage>
               <extent xml:id="extent_cac9cb2c">82 pages</extent>
               <dimensions unit="cm" xml:id="dimensions_ce207fb6">33.5 x 25</dimensions>
               <physMedium xml:id="physMedium_2a8fc69a">Bound in green shirting cover with label in Hartmann's hand: "Concert-Ouverture / Partitur." Written in brown ink. Paper: 14 staves. Paginated in pencil in upper corners. On p. 67 Hartmann has added in pencil: "udfyldes efter det gamle Partitur pag 63 og 64 fra x"; and on p. 76: "udfyldes efter det gamle Partitur pag: 71", signifying that this score is not the original one. This is strengthened by the fact that the score contrary to Hartmann's habit, is undated. Last page blank.</physMedium>
            </physDesc>
