                  <annot xml:id="annot_9f519e04">
                     <p xml:id="idm72">
                        <lb xml:id="idm73"/>(I.B.2. ‘Weltliche Cantaten. Einzelne Opern-Arien mit Instrumenten.’): 'Scheibe, Duetto, Vincesti Adraste: à 2 Voci, 2 Violini, Viola, Basso. a 1 thl. 4 gl.'</p>
                  </annot>
                  <ptr label="Digitisation"
                       target="http://digital.staatsbibliothek-berlin.de/werkansicht?PPN=PPN778562883&amp;PHYSID=PHYS_0032&amp;DMDID=DMDLOG_0002"
