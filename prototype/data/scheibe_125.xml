      <workList xml:id="workDesc_f76e2cbe">
         <work xml:id="work_d1e183180">
            <identifier label="SchW" xml:id="identifier_bbdf9559">A4:006</identifier>
            <title xml:id="_13" xml:lang="it">Sonata Vta</title>
            <title type="uniform" xml:id="title_379a2760" xml:lang="it">Sonata per il cembalo</title>
            <title type="uniform" xml:id="title_24bddd59" xml:lang="fr">Sonata V pour le clavecin</title>
            <contributor xml:id="respStmt_70840427">
               <persName role="composer" xml:id="_14">Johann Adolph Scheibe</persName>
            </contributor>
            <creation xml:id="creation_15_0">
               <date notafter="1757" xml:id="date_baa0e6ed">before 1757</date>
               <geogName xml:id="geogName_15_0">Sønderborg (?),</geogName>
            </creation>
            <history xml:id="history_15_0">
               <p xml:id="idm125">The present sonata for solo harpsichord appeared in print in <rend xml:id="idm126" fontstyle="italic">c</rend>. 1759 together with pieces by <persName xml:id="idm127" auth.uri="http://www.viaf.org" auth="VIAF" role="">G.A. Appel</persName>, <persName xml:id="idm128" auth.uri="http://www.viaf.org" auth="VIAF" role="">Carl Philipp Emanuel Bach</persName>, <persName xml:id="idm129" auth.uri="http://www.viaf.org" auth="VIAF" role="">G.E. Eberlin</persName>, <persName xml:id="idm130" auth.uri="http://www.viaf.org" auth="VIAF" role="">G.G. Lang</persName> and <persName xml:id="idm131" auth.uri="http://www.viaf.org" auth="VIAF" role="">G. Umstatt</persName>. The work had been composed a couple of years earlier as Scheibe in a letter to <persName xml:id="idm132" auth.uri="http://www.viaf.org" auth="VIAF" role="">Georg Philipp Telemann</persName> (dated February 1757) mentions that the publisher Haffner is planning his fourth volume of the collection in which the present sonata will be included. A contemporary transcript was originally also in the Breitkopf publisher’s holdings, and it is possible that prior to Haffner’s edition the work was indeed part of the Breitkopf master copies though it does not appear in any of their catalogues.</p>
            </history>
            <langUsage xml:id="langUsage_d3a01929">
               <language xml:id="da">Danish</language>
               <language xml:id="en">English</language>
               <language xml:id="fr">French</language>
               <language xml:id="it">Italian</language>
            </langUsage>
            <biblList xml:id="listBibl_ec722cce-31d7-4dda-9ead-0d51651b290a221">
               <head xml:id="head_7694a457">Bibliography</head>
               <bibl label="" xml:id="bibl_b49f2597">
                  <genre xml:id="genre_17491fff">letter</genre>
                  <author xml:id="author_7d563da7">Johann Adolph Scheibe</author>
                  <recipient xml:id="recipient_8854e949">Georg Philipp Telemann</recipient>
                  <creation xml:id="creation_b61e509b">
                     <date isodate="1757-02-08" xml:id="date_e4bf7204">1757-02-08</date>
                     <geogName xml:id="geogName_ef867a91">Sønderborg</geogName>
                  </creation>
                  <physLoc xml:id="physLoc_aa9a87af">
                     <repository xml:id="repository_1b878bee">
                        <identifier auth.uri="http://www.rism.info" auth="RISM" xml:id="identifier_31ccb131">EV-TAu</identifier>
                     </repository>
                     <identifier xml:id="identifier_ca5c3b5c">Epistolae autographae CC Philosophorum cel. V. F 3, Mrg CCCLIVa [105]</identifier>
                  </physLoc>
                  <annot xml:id="annot_dae0357e">
                     <p xml:id="idm152">'Anitzt habe ich mit Herrn Hafner in Nürnberg einen Briefwechsel. Er hat ins dritte Stück seiner <rend xml:id="idm153" fontstyle="italic">Oeuvres meleés</rend> eine <rend xml:id="idm154" fontstyle="italic">Sonata</rend> von mir eingerückt, und ins 4te Stück soll wieder eine kommen.'</p>
                  </annot>
                  <ptr label="Digitisation"
                       target="http://dspace.ut.ee/handle/10062/4933/browse?type=author&amp;value=Scheibe%2C+Johann+Adolph"
                       xml:id="ptr_804540a8"/>
               </bibl>
               <bibl label="" xml:id="bibl_28115b67">
                  <genre xml:id="genre_c484d489">book</genre>
                  <author xml:id="author_271e06cf">Johann Gottlob Immanuel Breitkopf</author>
                  <annot xml:id="annot_3d0a40db">
                     <p xml:id="idm160"> </p>
                     <p xml:id="idm161">('VII. Die Orgel und das Clavecimbel. 6. Sonaten für das Clavecimbel.'): <rend xml:id="idm162" fontstyle="italic">Oeuvres melées</rend>, contentant VI. Sonates pour le Clavessin de tant de plus celebres Compositeurs, rangeé en ordre alphabetique. | [Oeuvres melées,] Partie I. à Norb. fol. trv. Kupferst. à 1 thl. 12 gl. Partie II. à Norb. fol. trv. Kupferst. à 1 thl. 12 gl. Partie III. à Norb. fol. trv. Kupferst. à 1 thl. 12 gl. Partie IV. à Norb. fol. trv. Kupferst. à 1 thl. 12 gl.'</p>
                  </annot>
                  <ptr label="Digitisation"
