            </creation>
            <history xml:id="history_idbbe85013">
               <eventList type="performances" xml:id="eventList_0ac82fe4">
                  <event xml:id="event_a348515e">
                     <date isodate="1840-12-19" xml:id="date_5746e245">1840-12-19</date>
                     <geogName role="venue" xml:id="geogName_dd6aa8fd">Hotel d'Angleterres Festsal</geogName>
                     <geogName role="place" xml:id="geogName_4f1fb6b8">Copenhagen</geogName>
                     <corpName role="ensemble" xml:id="corpName_179326b7">Studenter-Sangforeningen</corpName>
                     <persName role="conductor" xml:id="persName_3f77fce3">Johan Borup</persName>
                     <desc xml:id="desc_7cc060f7">The very first concert of Studenter-Sangforeningen, founded in 1839.</desc>
                     <biblList xml:id="biblList_f9ad43a9">
                        <head xml:id="head_cf4230ea">Reviews</head>
                     </biblList>
                     <biblList xml:id="biblList_fbfb2f90">
                        <head xml:id="head_32854bce">Evidence</head>
                     </biblList>
                  </event>
               </eventList>
               <p xml:id="idm146">1840-1843 the botanist Frederik Liebmann (1813-1856) took part in a scientific expedition to Mexico. He was a co-founder of Studenter-Sangforeningen and father of the composer Axel Liebmann (1849-1876).</p>
            </history>
