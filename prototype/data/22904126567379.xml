            <title xml:id="title_9979df00" xml:lang="en">On the Occasion of Botanist Liebmann's Departure</title>
            <title type="alternative" xml:id="title_ac94f0bf" xml:lang="da">Naar du nu om ikke længe</title>
            <title type="alternative" xml:id="title_c1bf0438" xml:lang="da">Afskedssang ved Liebmanns Afreise</title>
