      <workList xml:id="workDesc_d6dd4b5a">
         <work xml:id="work_d1e221218">
            <identifier label="SchW" xml:id="identifier_e16637cf">B2:406</identifier>
            <title xml:id="title_a023dabc" xml:lang="it">Cantata à basso solo, 2 violini, viola, cembalo</title>
            <title type="alternative" xml:id="title_5c9d3056" xml:lang="it">Climene anima mia</title>
            <contributor xml:id="respStmt_e1e66dca">
               <persName role="composer" xml:id="persName_9d8f8277">Johann Adolph Scheibe</persName>
            </contributor>
            <history xml:id="history_1d1ee160">
               <p xml:id="idm77">The cantata for bass voice, strings and continuo is one of the very few composed to an Italian text; however, it seems to have been lost. The work might have been composed before Scheibe’s arrival in Copenhagen in 1740. It is listed in Breitkop’s catalogue of 1761 and again in 1765, this time with an incipit. Scheibe mentions in his autobiography (Mattheson's <rend xml:id="idm78" fontstyle="italic">Grundlage</rend>, 1740; SchW C5:001) that he had composed ‘italiänischen Cantaten’.</p>
            </history>
            <langUsage xml:id="langUsage_18dcab4d">
               <language xml:id="da">Danish</language>
               <language xml:id="it">Italian</language>
            </langUsage>
