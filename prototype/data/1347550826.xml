         <work xml:id="work_d1e462455">
            <identifier label="HartW" xml:id="identifier_N20478">221</identifier>
            <title xml:id="title_392N20196" xml:lang="da">Ved de Massmannske Søndags-Skolers 90-Aarsfest 1890</title>
            <title xml:id="title_291dd02a" xml:lang="en">At the 90th Anniversary Feast of the Massmanian Sunday Schools 1890</title>
            <title type="alternative" xml:id="title_031a3816" xml:lang="da">Er Haandens Gjerning end nok saa snild</title>
            <contributor xml:id="respStmt_N20489">
               <persName role="composer" xml:id="persName_392N2019C">J.P.E. Hartmann</persName>
