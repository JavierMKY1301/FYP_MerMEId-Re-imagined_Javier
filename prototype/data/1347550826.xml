            </contributor>
            <creation xml:id="creation_392N201A5">
               <date isodate="1890-03-26" xml:id="date_N20496">1890-03-26</date>
            </creation>
            <history xml:id="history_392N201A3">
               <eventList type="performances" xml:id="eventList_463N2022F">
                  <event xml:id="event_d1e872855">
                     <date isodate="1890-05-04" xml:id="date_N204A0">1890-05-04</date>
                     <geogName role="venue" xml:id="geogName_392N202D2">Vor Frue Kirke</geogName>
                     <geogName role="place" xml:id="geogName_392N202D6">Copenhagen</geogName>
                     <persName role="conductor" xml:id="persName_392N202DD">Axel Guldbrandsen</persName>
                     <desc xml:id="idm185">First performance.</desc>
                     <biblList xml:id="biblList_7fea9324">
                        <head xml:id="head_345ba590">Reviews</head>
                        <bibl label="" xml:id="bibl_1a5c5275">
                           <genre xml:id="genre_4d65ef13">article</genre>
                           <genre xml:id="genre_e31bef0b">newspaper</genre>
                           <imprint xml:id="imprint_e72081c2">
                              <date isodate="1890-05-05" xml:id="date_def5c36d">1890-05-05</date>
                              <pubPlace xml:id="pubPlace_edcad487">Copenhagen</pubPlace>
                           </imprint>
                           <title level="a" xml:id="title_7d5e4bd4"/>
                           <title level="j" xml:id="title_d1a0063b">Nationaltidende</title>
                           <biblScope unit="issue" xml:id="biblScope_d066f5bb">Tillæg til Nr. 5039</biblScope>
                           <biblScope unit="page" xml:id="biblScope_c4150a7f">2</biblScope>
                        </bibl>
                     </biblList>
                  </event>
               </eventList>
               <p xml:id="idm198">De Massmannske Søndagsskoler were founded in 1800 at the instigation of the vicar at Frederiks Tyske Kirke (the present Christianskirke) on Christianshavn in Copenhagen, N.H. Massmann (1766-1816). The purpose was to give young craftsmen free lessons in writing, reading and mathematics. The schools found general approval also outside Copenhagen, but closed down in 1920. Right from the beginning famous composers such as C.E.F. Weyse and Hartmann wrote cantatas for their annual celebrations.</p>
            </history>
