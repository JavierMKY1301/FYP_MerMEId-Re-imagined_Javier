            <contributor xml:id="respStmt_118d43a2">
               <persName role="reviewer" xml:id="persName_d06a4be7">Johann Adolph Scheibe</persName>
               <persName role="translator" xml:id="persName_de9b7fba">Johann Georg Laub</persName>
