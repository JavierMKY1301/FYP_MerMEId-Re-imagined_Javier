      <workList xml:id="workDesc_bc0fcebd">
         <work xml:id="work_id9430ae22">
            <identifier label="SchW" xml:id="identifier_b9d259f3">B2:409</identifier>
            <title xml:id="title_id5d47c69d" xml:lang="de">Cantate</title>
            <title type="alternative" xml:id="title_3f0e00da" xml:lang="de">Mein Herz was kränket</title>
            <contributor xml:id="respStmt_5aa710c0">
               <persName role="composer" xml:id="persName_id44403fd7">Johann Adolph Scheibe</persName>
            </contributor>
            <history xml:id="history_idd49f40b1">
               <p xml:id="idm61">The chamber cantata for voice, harpsichord and violone has presumably been lost. The use of the harpsichord suggests that it was not performed in the church. It appears only in the Breitkopf catalogue of 1761. Whether Scheibe sent the work directly to Breitkopf, or whether they acquired it from the collegium musicum in Leipzig or from the estate of <persName xml:id="idm62" auth.uri="http://www.viaf.org" auth="VIAF" role="">Carl Gotthelf Gerlach</persName>, the cantor at Neukirche, is an open question. It does not appear in any later Breitkopf catalogues or their auction catalogue of 1836 suggesting that it was discarded soon after 1761.</p>
            </history>
            <langUsage xml:id="langUsage_827f0e7b">
               <language xml:id="en">English</language>
               <language xml:id="de">German</language>
            </langUsage>
            <biblList xml:id="biblList_193N200FA">
