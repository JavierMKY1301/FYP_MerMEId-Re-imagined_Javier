      <workList xml:id="workDesc_N2032C">
         <work xml:id="work_d1e226223">
            <identifier label="HartW" xml:id="identifier_N20330">197</identifier>
            <title xml:id="title_fc6a64c3" xml:lang="da">Slag-Sang</title>
            <title xml:id="title_6625c7e0" xml:lang="en">Battle Song</title>
            <title type="alternative" xml:id="title_6ff742ec" xml:lang="da">Det er en stor alvorlig Tid</title>
            <contributor xml:id="respStmt_N20341">
               <persName role="composer" xml:id="persName_ddcc0252">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_ed8327db">Hans Christian Andersen</persName>
            </contributor>
            <creation xml:id="creation_6a2d10de">
               <date isodate="1848-03-05" xml:id="date_N2034E">1848-03-05</date>
            </creation>
            <history xml:id="history_67b965f2">
               <eventList type="performances" xml:id="eventList_0093572a">
                  <event xml:id="event_fab98fb8">
                     <date isodate="1848-05-04" xml:id="date_N20358">1848-05-04</date>
                     <geogName role="venue" xml:id="geogName_964ffd20">The Royal Theatre (Det Kongelige Teater)</geogName>
                     <geogName role="place" xml:id="geogName_0dd6d9d7">Copenhagen</geogName>
                     <corpName role="ensemble" xml:id="corpName_f89d3198">Royal Danish Opera Chours (Det Kongelige Operakor)</corpName>
                     <corpName role="ensemble" xml:id="corpName_a3faeeb3">Royal Danish Orchestra (Det Kongelige Kapel)</corpName>
                     <persName role="conductor" xml:id="persName_2592eec5">Franz Joseph Glæser</persName>
                     <desc xml:id="idm79">Concert to the benefit of the beavered of those killed in the war.</desc>
                     <biblList xml:id="biblList_b6f6a04b">
                        <head xml:id="head_N20374">Reviews</head>
                        <bibl label="" xml:id="bibl_c02644dd">
                           <genre xml:id="genre_N20379">article</genre>
                           <genre xml:id="genre_N2037B">journal</genre>
                           <title level="a" xml:id="title_N2037F"/>
                           <title level="j" xml:id="title_N20381"/>
                        </bibl>
                     </biblList>
                     <biblList xml:id="biblList_9c6ca359">
                        <head xml:id="head_N20390">Evidence</head>
                     </biblList>
                  </event>
               </eventList>
               <p xml:id="idm89">Hans Christian Andersen published his poem in the newspaper "Fædrelandet" on 31 March 1848, but at that time Hartmann had already composed his tune to it. In April Hartmann's wife Emma, née Zinn, wrote her own tune to this text. However, she gave up finishing it because Andersen was curious to find out who the composer was.</p>
            </history>
