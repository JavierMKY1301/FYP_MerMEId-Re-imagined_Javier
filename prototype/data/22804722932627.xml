            <physDesc xml:id="physDesc_81af581c">
               <titlePage label="" xml:id="titlePage_f3c184e5">
                  <p xml:id="idm34">Fr Sophie Hartmann / tilegnet / d. 28 Mai 1850 / Fem Digte / af / Stieglitz "Bilder des Orients" / componerede / for een Stemme med Pianof. accomp. / af / Niels W. Gade.</p>
               </titlePage>
               <extent xml:id="extent_5b78469c">12 pages + cover with title page</extent>
               <dimensions unit="cm" xml:id="dimensions_3c379741">26 x 29.5</dimensions>
               <physMedium xml:id="physMedium_638ccaea">2 bifolios with drafts for nos. 3-5  and 1 bifolio with sketches without text placed in a cover with richly decorated corners and title page. Written in ink. Paper: 17 and 14 staves.  Heading on fol.1<rend xml:id="idm38" rend="sup">r</rend>: "<rend xml:id="idm39" rend="underline">Ali und Fatme</rend> / I. / <rend xml:id="idm40" rend="underline">Fatme am Brunnen</rend>. / Bilder des Orients / vom / H. Stieglitz." Heading on p. 3: "Ali II (Im Garten.)", on p. 4: "III. / <rend xml:id="idm41" rend="underline">Fatme.</rend> (Vom Balcone)" In the left-hand margin: <rend xml:id="idm42" rend="underline">NB. D Dur</rend>. Last 3 pages blank.</physMedium>
            </physDesc>
            <notesStmt xml:id="notesStmt_bc5f8d94">
               <annot type="source_description" xml:id="annot_49598f91">
                  <p xml:id="idm45">On pp. 4-5 in this manuscript. In D flat major with the tempo marking Allegretto scherzando.</p>
