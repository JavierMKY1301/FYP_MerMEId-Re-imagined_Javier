                  <annot xml:id="annot_f5bebfd9">
                     <p xml:id="idm159">
                        <lb xml:id="idm160"/>Mentions <rend xml:id="idm161" fontstyle="italic">Gothaer Theatercalender</rend> 1777.</p>
                  </annot>
                  <title level="m" xml:id="title_8f29a282">Geschichte des Prager Theater</title>
