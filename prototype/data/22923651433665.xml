               <geogName xml:id="geogName_idbaaf9e30"/>
            </creation>
            <history xml:id="history_id55a3605e">
               <p xml:id="idm87">On 20 May 1855 Sophie Gade gave birth to the twins Felix (d. 1928) and Emma (d. 1857). Hans Christian Andersen, who was very fond of Sophie, and whom he had known since her early childhood, wrote this cradle song, which Sophie sang for her children. On 15 June she herself died, apparently as a consequence of a fall.</p>
            </history>
