      <manifestationList xml:id="sourceDesc_1a028404">
         <manifestation label="" xml:id="source_d1e30">
            <titleStmt xml:id="titleStmt_b5826ecf">
               <title xml:id="title_158N2004A">Score, autograph, fair copy</title>
            </titleStmt>
            <physDesc xml:id="physDesc_20b04301">
               <titlePage label="Title page" xml:id="titlePage_158N20054">
                  <p xml:id="idm32">Minder fra Hauserplads 1844.</p>
               </titlePage>
               <extent xml:id="extent_8fbba6ce">7 separate sheets</extent>
               <dimensions unit="cm" xml:id="dimensions_5e3151f5">20.5 x 27.5</dimensions>
               <physMedium xml:id="physMedium_03c00e72">Written in brown ink. Paper: 2 staves.</physMedium>
            </physDesc>
            <notesStmt xml:id="notesStmt_27509968">
               <annot type="source_description" xml:id="annot_158N20066">
                  <p xml:id="idm38">The manuscript  consists of 7 separate folios with compositions: Anonymous: "Fingerøvelses-Caprice"; A.P. Berggreen: "Halleluja" and "Amen" for mixed choir; Niels W. Gade:" I Ørkenen (af Korsfarerne)", signed "Hr. A. Lund til venlig Erindring om Niels W. Gade. Julen 1865"; J.P.E. Hartmann: "Allegro moderato" for for piano, dated "Juul 1865"; Eduard Helsted: "Allegro moderato" for piano, dated "Decbr. 1865"; Joh. Chr. Gebauer: "Kyrie a 6 voci (Fragment)".</p>
               </annot>
            </notesStmt>
