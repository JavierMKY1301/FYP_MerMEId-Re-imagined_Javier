            <title xml:id="title_d6b675e5" xml:lang="en">Cantata for the Wedding of Lord-in-Waiting, Baron C. Bille-Brahe and Countess Marie Moltke-Bregentved on 21 February 1852</title>
            <title type="alternative" xml:id="title_5f82f7ea" xml:lang="da">Hvor Sneen laa paa Marken nys</title>
            <contributor xml:id="respStmt_4547be1e">
               <persName role="composer" xml:id="persName_210N200C6">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_1cfe21bf">Hans Christian Andersen</persName>
            </contributor>
            <creation xml:id="creation_210N200CB">
               <date isodate="1852-02-14" xml:id="date_df1748d2">1852-02-14</date>
            </creation>
            <history xml:id="history_210N200C9">
               <eventList type="performances" xml:id="eventList_afc8fbee">
                  <event xml:id="event_1de6b7e1">
                     <date isodate="1852-02-21" xml:id="date_1fd3ac72">1852-02-21</date>
                     <desc xml:id="idm71">The Wedding of Lord-in-Waiting, Baron C. Bille-Brahe and Comtesse Marie Moltke Bregentved.</desc>
                     <biblList xml:id="biblList_5f1f7143">
                        <head xml:id="head_d37c54a8">Reviews</head>
                        <bibl label="" xml:id="bibl_c86a492e">
                           <genre xml:id="genre_634d9ef1">article</genre>
                           <genre xml:id="genre_825de94f">journal</genre>
                           <title level="a" xml:id="title_afe909f3"/>
                           <title level="j" xml:id="title_049a808f"/>
                        </bibl>
                     </biblList>
                     <biblList xml:id="biblList_c0f80fb7">
                        <head xml:id="head_a61f373e">Evidence</head>
                     </biblList>
                  </event>
               </eventList>
               <p xml:id="idm81">In the 1840s Hans Christian Andersen was a frequent guest at the Bregentved Estate and had known the bride since she was a child. He had also written a song for her fifteenth birthday and a cantata for her confirmation.</p>
            </history>
            <langUsage xml:id="langUsage_eaa623a6">
