                           <imprint xml:id="imprint_f9ad5a89">
                              <date isodate="1825-11-19" xml:id="date_b66b53bc">1825-11-19</date>
                              <pubPlace xml:id="pubPlace_93c7e6c8">Viborg</pubPlace>
                           </imprint>
                           <title level="a" xml:id="title_7677dd1b"/>
                           <title level="j" xml:id="title_0b069d53">Den til Forsendelse med Ridepost Kongelig priviligerede Viborger Samler</title>
                           <biblScope unit="vol" xml:id="biblScope_e3463d96">53</biblScope>
                           <biblScope unit="issue" xml:id="biblScope_c1949eb8">138</biblScope>
                           <biblScope unit="page" xml:id="biblScope_9c9e32a8">3</biblScope>
                        </bibl>
                     </biblList>
                  </event>
               </eventList>
               <p xml:id="idm89">This cantata was the first time Hartmann set music to a text by Adam Oehlenschläger, a collaboration which lasted till the latter's death in 1850.</p>
            </history>
