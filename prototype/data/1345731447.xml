            <history xml:id="history_300N200D8">
               <eventList type="performances" xml:id="eventList_c829517c">
                  <event xml:id="event_d1e426420">
                     <date isodate="1825-11-09" xml:id="date_5e8fae78">1825-11-09</date>
                     <geogName role="venue" xml:id="geogName_300N2017B">Garnisons Kirke</geogName>
                     <geogName role="place" xml:id="geogName_300N2017F">Copenhagen</geogName>
                     <desc xml:id="idm75">At the same concert Hartmann played a prelude and fugue by Johann Sebastian Bach, which is one of the earliest known performances in Denmark of organ works by this composer.</desc>
                     <biblList xml:id="biblList_435f55f4">
                        <head xml:id="head_5e67bf5a">Reviews</head>
                        <bibl label="" xml:id="bibl_507e7f1a">
