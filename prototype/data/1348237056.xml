            <title xml:id="title_e0a05d50" xml:lang="da">Sonate for klaver i g-mol</title>
            <title xml:id="title_311N20146" xml:lang="en">Piano Sonata in G Minor</title>
            <title xml:id="title_a5212d0b" xml:lang="de">Sonate für Klavier in g-Moll</title>
            <contributor xml:id="respStmt_b57d2dfe">
               <persName role="composer" xml:id="persName_311N2014C">J.P.E. Hartmann</persName>
