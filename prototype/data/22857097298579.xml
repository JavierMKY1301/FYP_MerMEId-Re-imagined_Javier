            <identifier xml:id="idm146" label="NWGW">56</identifier>
            <identifier xml:id="idm147" label="GW">III:1</identifier>
            <title xml:id="title_id57916841" xml:lang="de">Dithyrambe</title>
            <contributor xml:id="idm150">
               <persName role="composer" xml:id="persName_id9409c930">Niels W. Gade</persName>
               <persName role="dedicatee" xml:id="persName_b55e0774">Johannes Kreiszler [Carl Helsted]</persName>
            </contributor>
            <creation xml:id="creation_id03ebf7a0">
               <date xml:id="idm154" enddate="1840-01-11" startdate="1840-01-07">7 to 11 January 1840</date>
            </creation>
            <history xml:id="history_id83d146f6">
               <p xml:id="idm156">Just as "Kleine Klaviergeschichte" was written as a birthday present for Edvard Helsted, "Dithyrambe" was written for his brother, Carl Helsted, who was born on 4 January 1818, so Gade was a bit late. The fictive dedicatee Johannes Kreizler was E.T.A. Hoffmann's alter ego. Both titles show the three friends' intense interest in Robert Schumann's universe.</p>
            </history>
