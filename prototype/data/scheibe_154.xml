            <title xml:id="title_88c5a690" xml:lang="de">Kantate auf das Friedensfest in den königl. dänischen Reichen und Landen gefeyert ward</title>
            <contributor xml:id="respStmt_411f1bf2">
               <persName role="composer" xml:id="persName_65a4a36c">Johann Adolph Scheibe</persName>
               <persName role="author" xml:id="persName_ac1f35b0">Johann Adolph Scheibe</persName>
