            <notesStmt xml:id="notesStmt_7d47fc67">
               <annot type="source_description" xml:id="annot_545N2029E">
                  <p xml:id="idm61">No title and no indication of composer nor any other identification of the work. The fragment contains part of the first movement, partly identical and partly different from the fair copy. It begins right in the middle of the movement. Only three of the pages have something to do with the Sonata. The last pages contains unidentified sketches.</p>
               </annot>
            </notesStmt>
