         <manifestation label="" xml:id="source_d1e187">
            <titleStmt xml:id="titleStmt_b8e2b0ef">
               <title xml:id="title_545N20189">Score, autograph, fair copy</title>
            </titleStmt>
            <physDesc xml:id="physDesc_2d0f252c">
               <extent xml:id="extent_ba118d5e">26 pages</extent>
               <dimensions unit="cm" xml:id="dimensions_b5ed340a">34.5 x 25.5</dimensions>
               <physMedium xml:id="physMedium_34787520">6 bifolios and 1 folio. Written in brown ink. Paper: 12 staves. Pagination added in pencil (p. 4 bis). Paper: 12 staves. Above the first stave: "Sonate." Containing: Allegro grazioso (pp. 1-10); Allegretto (Intermezzo) pp. 11-14 with a number of cancellated passages, which are to be substituted by passages in the source above; Allegro comodo (pp. 15-26). As for the missing Andante sostenuto, Hartmann refers on p. 14 to the the above-mentioned fair copy of this movement in the following words: "Derefter Andante sostenuto B dur 6/4, til sidste Takt, ved * derefter V.S." (After this, Andante sostenuto B flat major 6/4 until the last bar at *, and then volti subito.) All pencil corrections in the first movement are meticulously transferred to the later fair copy. At the the end of the music on p. 25 signed and dated:" I:P:E:Hartmann / 9 Octbr: 1854."</physMedium>
            </physDesc>
