            <title xml:id="title_d44ab360" xml:lang="en">To the Dead</title>
            <title type="alternative" xml:id="title_b6110f30" xml:lang="da">Sover sødt i hellig Fred</title>
            <contributor xml:id="respStmt_N20465">
               <persName role="composer" xml:id="persName_236N20153">J.P.E. Hartmann</persName>
               <persName role="author" xml:id="persName_236N20157">Adolph Wilhelm Schack von Staffeldt</persName>
            </contributor>
            <creation xml:id="creation_236N2015C">
