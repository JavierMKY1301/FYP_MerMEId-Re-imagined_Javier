                     <title xml:id="title_38e32ade">Score, autograph</title>
                  </titleStmt>
                  <physDesc xml:id="physDesc_d9694cba">
                     <extent xml:id="extent_a1623794">86 pages</extent>
                     <dimensions unit="cm" xml:id="dimensions_332a3b26">25.5 x 34</dimensions>
                     <physMedium xml:id="physMedium_35ebba71">Bound in purple cardboard with cloth spine. In upper left-hand corner of the cover a handwritten label inscribed: "Qvartet for Piano-/forte, Violin, Alt / og Violoncel / 1825." Paper cut in binding. Written in brown ink. Paper: 13 staves. Above the first stave: "Quatuor pour le P: F:, Viol:, Alto &amp; Basso Op 2 Op: 10". With minor corrections in pencil. On p. 85 after the last bar in Hartmann's hand: "sandsynligvis comp: 1825" corrected from "1823" (possibly composed 1825). Last page blank.</physMedium>
                  </physDesc>
               </manifestation>
               <manifestation label="" xml:id="source_9f696e4e">
