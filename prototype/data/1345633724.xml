            <title xml:id="title_186N200C7" xml:lang="fr">Quatuor pour le pianoforte, violino, alto e basso</title>
            <title xml:id="title_186N200CF" xml:lang="en">Piano Quartet</title>
            <contributor xml:id="respStmt_e3c512bc">
               <persName role="composer" xml:id="persName_186N200D5">J.P.E. Hartmann</persName>
            </contributor>
            <creation xml:id="creation_186N200DA">
               <date xml:id="date_df674282">1823 or 1825</date>
