                     <dimensions unit="cm" xml:id="dimensions_994a9c66">32.5 x 23.5</dimensions>
                     <physMedium xml:id="physMedium_67bedae1">Bound in purple cardboard with cloth spine. In upper left-hand corner of the cover a handwritten label inscribed: "ad Op. 2 / Violin". Written in black ink. Paper: 12 staves.</physMedium>
                  </physDesc>
               </manifestation>
               <manifestation label="" xml:id="source_72f3ea7b">
