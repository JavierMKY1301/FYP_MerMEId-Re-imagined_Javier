      <workList xml:id="workDesc_480e9020">
         <work xml:id="work_d1e177174">
            <identifier label="SchW" xml:id="identifier_bb6ab7ed">B2:308</identifier>
            <title xml:id="title_1aeda69b" xml:lang="de">Paßions-Cantate</title>
            <title type="alternative" xml:id="title_7ec3a5c3" xml:lang="de">Das ist der große Tag</title>
            <contributor xml:id="respStmt_d38cd00f">
               <persName role="composer" xml:id="persName_63567d62">Johann Adolph Scheibe</persName>
            </contributor>
            <history xml:id="history_c3a2ca47">
               <p xml:id="idm75">The Passion cantata has presumably been lost. It appears only in the Breitkopf catalogue of 1761, thus suggesting that it may have been acquired by the publishers from the estate of <persName xml:id="idm76" auth.uri="http://www.viaf.org" auth="VIAF" role="">Carl Gotthelf Gerlach</persName>, the cantor of Neukirche in Leipzig who had died earlier that year. In that case it was probably performed there and might have been commissioned by Gerlach. It is possible that the cantata was one of his early works mentioned in Scheibe’s autobiography (Mattheson's <rend xml:id="idm77" fontstyle="italic">Grundlage</rend>,1740; SchW C5:001). It is not listed in the Breitkopf auction catalogue of 1836.</p>
            </history>
            <langUsage xml:id="langUsage_40e2b1d9">
               <language xml:id="da">Danish</language>
               <language xml:id="de">German</language>
            </langUsage>
