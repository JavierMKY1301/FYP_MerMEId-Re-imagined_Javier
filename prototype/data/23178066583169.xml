            <title xml:id="title_idaf635cb7" xml:lang="da">Karacteerstykker for Strygeorchester No. 1 - 3</title>
            <title xml:id="title_95dc0954" xml:lang="en">Character Pieces Nos. 1-3 for Strings</title>
            <contributor xml:id="respStmt_d6c1e8c4">
               <persName role="composer" xml:id="persName_id282a87f7">J.P.E. Hartmann</persName>
            </contributor>
            <creation xml:id="creation_id6cf609ef">
               <date enddate="1884-09-23" startdate="1884-08-02" xml:id="date_9f7cf22c">2 Aug. to 23 Sep. 1884</date>
            </creation>
            <history xml:id="history_id87bc6d8e">
               <p xml:id="idm108">Among the sketches is a litte waltz motif with the heading: "Pernille og Jeronimus". This might signify that the Three Character Pieces were intended for the Ludvig Holberg festivities later that year as a parallel to Niels W. Gade's "Holbergiana" and Edvard Grieg's "Holberg Suite".</p>
            </history>
