      <workList xml:id="workDesc_c556920a">
         <work xml:id="work_d1e225222">
            <identifier label="SchW" xml:id="identifier_932ed473">B2:412</identifier>
            <title xml:id="title_535e33e8" xml:lang="de">Cantate zur Erinnerung des hohen Vermählungsfestes beyder regierenden königl. Majest. zu Dännemark</title>
            <contributor xml:id="respStmt_43dfaa15">
               <persName role="composer" xml:id="persName_6dc0c3aa">Johann Adolph Scheibe</persName>
               <persName role="author" xml:id="persName_33b2d47b">Johann Adolph Scheibe</persName>
               <persName role="dedicatee" xml:id="persName_d9c763af">King Christian VI</persName>
               <persName role="dedicatee" xml:id="persName_4318b5ef">Queen Sophie Magdalene</persName>
            </contributor>
            <creation xml:id="creation_2ecc43cd">
               <date isodate="1742" xml:id="date_98742326">1742</date>
               <geogName xml:id="geogName_2504dee4">Copenhagen,</geogName>
            </creation>
            <history xml:id="history_71352b22">
               <p xml:id="idm115">Scheibe wrote both text and music for the cantata which was performed at Frederiksborg Castle in August 1742 celebrating the marriage anniversary of the royal couple. In a letter to <persName xml:id="idm116" auth.uri="http://www.viaf.org" auth="VIAF" role="">Johann Christoph Gottsched</persName>, Scheibe mentions having been very busy during summer 1742 composing many instrumental works which must also have included the present work. The amount of court duties Scheibe had at the time meant a delay in his revision of the journal <rend xml:id="idm117" fontstyle="italic">Critischer Musikus</rend>, 1737–40 (SchW C1:008). Unfortunately only the printed text book seems to have survived.</p>
            </history>
            <langUsage xml:id="langUsage_dcd7a7bd">
               <language xml:id="da">Danish</language>
               <language xml:id="de">German</language>
               <language xml:id="en">English</language>
               <language xml:id="it">Italian</language>
            </langUsage>
            <biblList xml:id="listBibl_5d1647eb-1047-4567-9fa8-1a914058ab82272">
               <head xml:id="head_0d37cb59">Bibliography</head>
               <bibl label="" xml:id="bibl_f12ba7e9">
                  <genre xml:id="genre_f9fbd73c">letter</genre>
                  <author xml:id="author_c7dcdd7e">Johann Adolph Scheibe</author>
                  <recipient xml:id="recipient_b14ddfb7">Johann Christoph Gottsched</recipient>
                  <creation xml:id="creation_9fead339">
                     <date isodate="1743-04-18" xml:id="date_8b2a7a17">1743-04-18</date>
                     <geogName xml:id="geogName_dc90cfef">Copenhagen</geogName>
                  </creation>
                  <physLoc xml:id="physLoc_183118fb">
                     <repository xml:id="repository_1676a508">
                        <identifier auth.uri="http://www.rism.info" auth="RISM" xml:id="identifier_5c4d2969"/>
                     </repository>
                     <identifier xml:id="identifier_dd7533a6"/>
                  </physLoc>
                  <annot xml:id="annot_a2bd7410">
                     <p xml:id="idm137">'E. M. werden bald Ursache haben, mich für einen Lügner zu halten, weil ich auch diese Messe nichts von meinem Critischen Musicus übersende, allein ich kann versichern, daß ich seither, sonderlich aber vorigen Sommer, soviel Instrumentsachen zu componieren gehabt habe, daß ich mir auch nicht das geringste Vergnügen habe machen können.'</p>
                  </annot>
