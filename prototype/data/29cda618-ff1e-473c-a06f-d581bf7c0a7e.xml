               <bibl label="" xml:id="bibl_45eb7e71">
                  <genre xml:id="genre_358bb3b8">book</genre>
                  <author xml:id="author_f10fe3ca">Breitkopf</author>
                  <annot xml:id="annot_3f955ee8">
                     <p xml:id="idm112">
                        <lb xml:id="idm113"/>(Lot 949 (1), '23. Solos für Violine'): '<rend xml:id="idm114" fontstyle="italic">Scheibe, </rend>3 [Sonate.] 9 [Bog.]'; the lot also includes compositions by <persName xml:id="idm115" auth="VIAF" auth.uri="http://www.viaf.org" role="">Spadina</persName> and <persName xml:id="idm116" auth="VIAF" auth.uri="http://www.viaf.org" role="">Stamitz</persName>.</p>
                  </annot>
                  <title level="m" xml:id="title_7812bb26">Grosse Musikalien-Auction. Verzeichniss geschriebener und gedruckter Musikalien</title>
                  <title level="s" xml:id="title_330866dd"/>
