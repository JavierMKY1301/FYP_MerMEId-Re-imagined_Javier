      <workList xml:id="workDesc_86045e97">
         <work xml:id="work_id69dea11e">
            <identifier label="SchW" xml:id="identifier_d5904f5d">B2:012</identifier>
            <title xml:id="title_id7872aa66" xml:lang="de">Am Feste Epiphanias</title>
            <title type="uniform" xml:id="title_4680ad41" xml:lang="de">Kantate am Feste Epiphanias</title>
            <contributor xml:id="respStmt_971d6233">
               <persName role="composer" xml:id="persName_id877ef01d">Johann Adolph Scheibe</persName>
            </contributor>
            <history xml:id="history_id50a3980f">
               <p xml:id="idm61">The cantata for Epiphany, which is one of three (the other two being SchW B2:013, B2:014), has presumably not survived. The only indication that Scheibe composed it is that it is listed in the Breitkopf auction catalogue of 1836, though without providing any distinguishing details. It should be noted that it does not occur in the earlier sales catalogues. Nevertheless, it is likely that the cantata was obtained from the estate of <persName xml:id="idm62" auth.uri="http://www.viaf.org" auth="VIAF" role="">Carl Gotthelf Gerlach</persName> in 1761.</p>
            </history>
            <langUsage xml:id="langUsage_10155811">
               <language xml:id="en">English</language>
               <language xml:id="de">German</language>
            </langUsage>
            <biblList xml:id="biblList_203N20139">
               <head xml:id="head_86a75bc1">Bibliography</head>
               <bibl label="" xml:id="bibl_c4120404">
                  <genre xml:id="genre_69fa21ab">book</genre>
                  <author xml:id="author_1ac47352">Breitkopf</author>
                  <annot xml:id="annot_85173a59">
                     <p xml:id="idm72">
                        <lb xml:id="idm73"/>(Lot 299 (2)): '[<rend xml:id="idm74" fontstyle="italic">Scheibe,</rend>] Am Reformationsfeste. - Am Feste Epiphanias. P. u. St. (3 mal) 68 [Bog.]'; only one of the three 'Epiphanias' (SchW B2:013) has been identified, hence two are missing (SchW B2:012, B2:014).</p>
                  </annot>
                  <title level="m" xml:id="title_a6e669a2">Grosse Musikalien-Auction. Verzeichniss geschriebener und gedruckter Musikalien</title>
                  <title level="s" xml:id="title_6bf191ab"/>
