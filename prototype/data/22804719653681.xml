            <physDesc xml:id="physDesc_24a6cb40">
               <titlePage label="" xml:id="titlePage_31a4646e">
                  <p xml:id="idm34">Fr Sophie Hartmann / tilegnet / d. 28 Mai 1850 / Fem Digte / af / Stieglitz "Bilder des Orients" / componerede / for een Stemme med Pianof. accomp. / af / Niels W. Gade.</p>
               </titlePage>
               <extent xml:id="extent_19f49fd7">12 pages + cover with title page</extent>
               <dimensions unit="cm" xml:id="dimensions_87557dcd">26 x 29.5</dimensions>
               <physMedium xml:id="physMedium_58e7d123">2 bifolios with drafts for nos. 3-5  and 1 bifolio with sketches without text placed in a cover with richly decorated corners and title page. Written in ink. Paper: 17 and 14 staves.  Heading on fol.1<rend xml:id="idm38" rend="sup">r</rend>: "<rend xml:id="idm39" rend="underline">Ali und Fatme</rend> / I. / <rend xml:id="idm40" rend="underline">Fatme am Brunnen</rend>. / Bilder des Orients / vom / H. Stieglitz." Heading on p. 3: "Ali II (Im Garten.)", on p. 4: "III. / <rend xml:id="idm41" rend="underline">Fatme.</rend> (Vom Balcone)". Last 3 pages blank.</physMedium>
            </physDesc>
            <notesStmt xml:id="notesStmt_ed4cff4e">
               <annot type="source_description" xml:id="annot_602415b8">
                  <p xml:id="idm44">On pp. 3-4 in this manuscript. In F sharp minor / major with the tempo marking Andantino.</p>
               </annot>
