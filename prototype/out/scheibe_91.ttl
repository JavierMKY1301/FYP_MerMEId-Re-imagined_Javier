    cnw:incipitText "Herrens Salvede, som var vor Næses Aand"@da ;
    cnw:incipitText "Skræk har omspændt mig"@da ;
    cnw:incipitText "Graad skiule steds mit Øye"@da ;
    cnw:incipitText "Derfor var vort Hierte svagt"@da ;
    cnw:incipitText "Han kaldte sig sit Folks forløser"@da ;
    cnw:incipitText "Salige, hold op at græde"@da ;
    cnw:incipitText "Langt borte hvißler Slangen"@da ;
    cnw:incipitText "Kommer, Fordømte og skuer det jeg forgiæves tilbød!"@da ;
    cnw:incipitText "En liflig Straale"@da ;
    cnw:incipitText "Et reen formørket Øye"@da ;
    cnw:incipitText "Jeg vred mig paa det kummerfulde Leie"@da ;
    cnw:incipitText "Himlens Stærke vaager over Herrens Salvede"@da ;
    cnw:incipitText "Her laae Han"@da ;
    cnw:incipitText "Jord, hør den Fryd"@da ;
    cnw:incipitText "Han lever"@da ;
    cnw:incipitText "Han har vundet!"@da ;
    cnw:incipitImage "SchM_091_01-001.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

