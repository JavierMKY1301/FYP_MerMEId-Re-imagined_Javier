<https://cnw-ld.org/work/SchWB2-311>
    a frbr:Work, mo:MusicalWork ;
    dcterms:title "Sørge-Cantate ved Christi Grav som i Fasten opføres af Det musicaliske Selskab"@da ;
    dcterms:identifier "SchW B2:311" ;
    cnw:cnwNumber "B2:311" ;
    cnw:catalogueCode "SchW" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    cnw:textAuthor <https://cnw-ld.org/agent/johannes_ewald> ;
    dcterms:created "1769" ;
    dcterms:language "Danish" ;
    dcterms:language "English" ;
    dcterms:language "Italian" ;
    dcterms:subject "Vocal music" ;
    dcterms:subject "Cantata" ;
    dcterms:subject "Oratorio" ;
    dcterms:subject "Music for vocal soloists and instruments with or without choir" ;
    dcterms:subject "Passion" ;
    cnw:editorialNote "'I Anledning af den af det nye Musicaliske Selskab paa Bryggernes Laugshuus udi Fasten vel opførte Passions-Musiqve. | Hvad Evalds søde Pen og Scheibes stærke Toner | Ved Christi Grav har sat i Riim og Sørge-Noder, | Dit Selskab med sin Ræhs udførte mesterlig | Hver Skiønsom maae med Ret den Ære give dig. | Tilhørers Hundred Tall dig Roes og Biefald giver; | Tiltagen Kunst ved Fliid din Roes og Ære bliver. |  Kuns et kan siges paa din gandske Faste-Sang, | Det nemlig, at du ey sang den endnu en Gang. | Bliv ædle Selskab ved! tag til i Flor og Ære, | Ved Orden, Lyst og Fliid dit Navn skal varig være, | Hav Tak, tag Ære for hver Tirsdag Faste-Dag, Syng ofte som i Aar ved Christi Seyers-Grav. | v. W.-*'" ;
    cnw:editorialNote "soloist: C.1" ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-311/expression/1> ;
    cnw:performanceCount 0 .

