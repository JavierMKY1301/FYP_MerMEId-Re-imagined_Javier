    cnw:incipitText "Glücklich, wer geruhig wohnet!"@de ;
    cnw:incipitText "Mit immerneuer Lust beschaut mein muntrer Blick"@de ;
    cnw:incipitText "Ein ewiges Glücke begleite den König!"@de ;
    cnw:incipitText "Du bist es nicht allein"@de ;
    cnw:incipitText "Stimmt, Schäfer! die scherzenden Flöten"@de ;
    cnw:incipitText "Ihr seyd es beyde nicht, die Land und Volk beglücken"@de ;
    cnw:incipitText "Meine Vorsicht und mein Wachen"@de ;
    cnw:incipitText "Du bist es, der mich oft verbannt"@de ;
    cnw:incipitText "Landesliebe! Deine zarten Vatertriebe"@de ;
    cnw:incipitText "Auch du verstehst es nicht"@de ;
    cnw:incipitText "Jauchzet frohe Unterthanen!"@de ;
    cnw:incipitText "Ins Feld, ihr Helden fort!"@en ;
    cnw:incipitText "Auf! knallet ihr Donner der schmauchenden Stücke"@de ;
    cnw:incipitText "Wir sind schon da"@de ;
    cnw:incipitText "Wir folgen mit tobenden Schritten"@de ;
    cnw:incipitText "Ist das des Königstag? verwegner Wüterich!"@de ;
    cnw:incipitText "Dieses Reiches Glanz und Ehre wird in Ewigkeit bestehn"@de ;
    cnw:incipitText "O König! diese Lust, der Wohlstand kommt von Dir"@de ;
    cnw:incipitText "Unschuld und Ruhe und Friede und Lust"@de ;
    cnw:incipitText "Der Friede soll hier ewig wohnen"@de ;
    cnw:incipitText "Da man in diesem Schloß, das Herr! durch Dich besteht"@de ;
    cnw:incipitText "Ewiger König, Du Schöpfer der Welt!"@en ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

