    cnw:incipitText "Saa dunkel var den danske Sommerhimmel"@da ;
    cnw:incipitText "Som Mørke ruged' over Skov og Dal"@da ;
    cnw:incipitText "Den Fryd som nys paa hver en Læbe smilte"@da ;
    cnw:incipitText "Men Mørket [Solen] kæmpede mod Mulmet"@da ;
    cnw:incipitText "Og Naturen smilte til sin Ven"@da ;
    cnw:incipitText "Ak! Sommeren tidt er saa sludfuld og raa"@da ;
    cnw:incipitText "Venlige Lund! Din kjölende Skygge Glæden et Paulun opbygge"@da ;
