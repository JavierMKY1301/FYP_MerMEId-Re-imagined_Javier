    cnw:incipitText "Nè degl Ebrei germani in Mensi ancora nessuno ritorno?"@it ;
    cnw:incipitText "Er ingen af de Jødiske Brødre endnu komne tilbage til Memphis?"@da ;
    cnw:incipitText "E legge di natura"@it ;
    cnw:incipitText "Det er Naturens Lov"@da ;
    cnw:incipitText "E qvesto basta a tormentarti?"@it ;
    cnw:incipitText "Og dette er nok til at foruroelige dig?"@da ;
    cnw:incipitText "Se a ciascun l'interno affanno"@it ;
    cnw:incipitText "Dersom enhvers indvortes Bedrøvelse"@da ;
    cnw:incipitText "Vanne, s'appressa Aseneta"@it ;
    cnw:incipitText "Gaae bort, Asnat kommer"@da ;
    cnw:incipitText "Consorte, è a me permesso sperar grazia da te?"@it ;
    cnw:incipitText "Min Mand! er mig tilladt at vente en Naade af dig?"@da ;
    cnw:incipitText "Vederti io bramerei"@it ;
    cnw:incipitText "Jeg vilde nok see dig"@da ;
    cnw:incipitText "Se libero nol vuoi"@it ;
    cnw:incipitText "Dersom du ei vil at han maa blive frie"@da ;
    cnw:incipitText "D'ogni pianta palesa l'aspetto"@it ;
    cnw:incipitText "Naar man kuns kaster sine Øjne"@da ;
    cnw:incipitText "Vien Simeone. Oh se pensar potesse"@it ;
    cnw:incipitText "Der kommer Simeon. O dersom han kunde tænke"@da ;
    cnw:incipitText "O Diò! Che sembrami"@it ;
    cnw:incipitText "O Gud! Det forekommer mig"@da ;
    cnw:incipitText "Vorrei per consolarlo"@it ;
    cnw:incipitText "Jeg vilde, for at trøste ham"@da ;
    cnw:incipitText "Signore, i cenni tuoi"@it ;
    cnw:incipitText "Herre, her ere dine Befalinger"@da ;
    cnw:incipitText "Portiamo in tributo"@it ;
    cnw:incipitText "Vi bringer dig, som Skatskyldige"@da ;
    cnw:incipitText "Gradisco i doni vostri"@it ;
    cnw:incipitText "Eders Gaver behager mig"@da ;
    cnw:incipitText "Così ci lascia?"@it ;
    cnw:incipitText "Forlader han os saaledes?"@da ;
    cnw:incipitText "Defendi il popol tuo, gran Dio d'Abramo!"@it ;
    cnw:incipitText "Du store Abrahams Gud! Beskierm dit Folk!"@da ;
    cnw:incipitText "Gran Dio d'Abram, siam rei"@it ;
    cnw:incipitText "Du store Abrahams Gud"@da ;
    cnw:incipitText "Eseguisti il mio cenno"@it ;
    cnw:incipitText "Har du fuldbyrdet min Befaling?"@da ;
    cnw:incipitText "So, che la gloria perde"@it ;
    cnw:incipitText "Jeg veed, at den taber Æren"@da ;
    cnw:incipitText "Tu che dell' alme nostre eterna Verità, vedi gli arcani"@it ;
    cnw:incipitText "Du, evige Sandhed, som seer vores Sieles Hemmeligheder"@en ;
    cnw:incipitText "Sarò qval madre amante"@it ;
    cnw:incipitText "Jeg vil være som en kierlig Moder"@da ;
    cnw:incipitText "Ah sposo, il ver dicesti"@it ;
    cnw:incipitText "Ak min Mand, du har sagt sandt"@da ;
    cnw:incipitText "Nell' orror d'atra foresta"@it ;
    cnw:incipitText "Jeg seer mig i en forfærdelig mørk og fæl Skov"@da ;
    cnw:incipitText "Ecco, o Signore, i rei"@it ;
    cnw:incipitText "Herre, her ere Misdæderne"@da ;
    cnw:incipitText "Del reo nel core"@it ;
    cnw:incipitText "Du har optændt en Ild"@da ;
    cnw:incipitText "No, no tanto rigore tolga il ciel ch'io dimostri"@it ;
    cnw:incipitText "Nei, Himlen forbyde at jeg skulde vise saa stor Strænghed"@da ;
    cnw:incipitText "Voi, se pietà provate"@it ;
    cnw:incipitText "Dersom I føler Medynk"@da ;
    cnw:incipitText "Soffrite, affetti miei"@it ;
    cnw:incipitText "Holder Stand, I mine Sinds Lidelser"@da ;
    cnw:incipitText "Ma parla qvel pianto"@it ;
    cnw:incipitText "Men den Graad taler"@da ;
    cnw:incipitText "Oh giusto!"@it ;
    cnw:incipitText "O Retfærdige!"@da ;
    cnw:incipitText "Folle chi oppone i suoi a' consigli di Dio"@it ;
    cnw:incipitText "Det er en Daare som opsetter sine Raad imod Guds Raad"@da ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

