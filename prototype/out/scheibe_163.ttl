    dcterms:title "Giuseppe riconosciuto, dramma sacro per musica"@it ;
    dcterms:title "Joseph, som giver sig tilkiende for sine Brødre. Et musikalsk Stykke"@da ;
    dcterms:identifier "SchW B2:418" ;
