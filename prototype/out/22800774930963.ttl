    cnw:incipitText "Før os ind til den hellige Mand!"@da ;
    cnw:incipitText "I denne stille Dal, hvor Eremitten boer / I Hytten hist under Rankens Læ"@da ;
    cnw:incipitText "Farvel! Farvel, min elskte Pige"@da ;
    cnw:incipitText "Alt ruger Mørket over dunkle Lund / Min Clothilde! Dette Møde os forsone skal med Gud"@da ;
    cnw:incipitText "Ja Himlen signe vil vor Pagt"@da ;
    cnw:incipitText "Der staaer hun! Det er Fruentimmeret!"@da ;
    cnw:incipitText "Kom! uden Dig, min Sjæls Veninde"@da ;
    cnw:incipitText "Ak! I svandt hen, min Lykkes Drømmerier / Med ham jeg vanked under Piniers Kroner"@da ;
    cnw:incipitText "Tamburinens Bjælder klinge til Castagnettens Slag"@da ;
    cnw:incipitText "O Lykke! Det er ikke hende!"@da ;
    cnw:incipitText "Nu saa fortæl mig da hvad du veed"@da ;
    cnw:incipitText "For anden Gang jeg træde maa tilbage"@da ;
    cnw:incipitText "Hvilken Glæde! hvilken Glæde, hvilken Lykke!"@da ;
    cnw:incipitText "Saa slip mig dog, saa slip mig dog"@da ;
    cnw:incipitText "Kom mig til Hjælp! beskyt mig Eders Naade"@da ;
    cnw:incipitText "Velan! saa hør da, men vær taus og snild"@da ;
    cnw:incipitText "Øieblikket er nær, da min Skjæbne skal afgjøres / Stille jeg Gardinet rører!"@da ;
    cnw:incipitText "En Morgen i Orangens Skygge jeg vandred med ham Arm i Arm"@da ;
    cnw:incipitText "Kom hid! Kom hid vær snar!"@da ;
    cnw:incipitText "O Himmel! hvilke Qvaler!"@da ;
    cnw:incipitText "Stille, stille! nu jeg veed, nu jeg veed en gevaltig Hemmelighed"@da ;
    cnw:incipitText "Hil Dig! Fyrste! Kronens Smykke skal du bære til vor Lykke!"@da ;
    cnw:incipitImage "NWGW_148_00.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

