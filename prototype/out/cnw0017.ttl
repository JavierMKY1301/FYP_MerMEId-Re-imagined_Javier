    cnw:incipitText "Selsomt er Lykkens Gaver"@da ;
    cnw:incipitText "En buldrende Torden sit Lyn har nedsendt"@da ;
    cnw:incipitText "O Muhammed! vær nu din Tjener huld"@da ;
    cnw:incipitText "Nu, hvi gnider du saa voldsomt?"@da ;
    cnw:incipitText "Stærke Herre sig hvad vil du?"@da ;
    cnw:incipitText "Holla ho! min ædle Hersker!"@da ;
    cnw:incipitText "Snart er det Tid"@da ;
    cnw:incipitText "Rosens Tid, Rosens Tid er kommen"@da ;
    cnw:incipitText "Cithar! Lad min Bøn dig røre"@da ;
    cnw:incipitText "Den skønne Sol er dalet dybt"@da ;
    cnw:incipitText "Nu, hvi gnider du saa voldsomt?"@da ;
    cnw:incipitText "Viselulle nu, Barnlil!"@da ;
    cnw:incipitText "Herre hvad vil du mig?"@da ;
    cnw:incipitText "Hvad vil du Herre?"@da ;
    cnw:incipitText "Ha, hvad er det?"@da ;
    cnw:incipitText "Alt Maanen oprejst staaer bag sorte Skove"@da ;
    cnw:incipitText "Syvfold ønske dine Slaver dig til Lykke"@da ;
    cnw:incipitImage "cnw_017_1_1.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

