    cnw:performingForce "vl.2" ;
    cnw:performingForce "va." ;
    cnw:performingForce "bc." ;
    cnw:incipitText "Wir giengen alle in der Irre wie Schaafe"@de ;
    cnw:incipitText "Wenn meine Sünd mich kränken"@de ;
    cnw:incipitText "Versamlet euch und werft die Blicke"@de ;
    cnw:incipitText "Seht, welch ein Mensch"@de ;
    cnw:incipitText "Verhüllt euch, seyd erweichet"@de ;
    cnw:incipitText "Ist dieser nicht des Höchsten Sohn"@de ;
    cnw:incipitText "Ja, dies ist GOttes Sohn"@de ;
    cnw:incipitText "O Schöpfer, für deinem gewaltigen Schelten"@de ;
    cnw:incipitText "O Welt! sieh hier dein Leben am Stamm des Kreuzes"@de ;
    cnw:incipitText "Du stirbst, o GOTT! du stirbst"@de ;
    cnw:incipitText "Man eilt dich zu tödten: verschone dein Leben!"@de ;
    cnw:incipitText "Was soll ich dir immmehr, o Liebster"@de ;
    cnw:incipitText "Was ist doch wol die Ursach solcher Plagen?"@de ;
    cnw:incipitText "Ja, wir, nur wir begiengen gegen"@de ;
    cnw:incipitText "Wie wunderbarlich ist doch diese Strafe"@de ;
    cnw:incipitText "Du gabst uns erst den Geist"@de ;
    cnw:incipitText "O unbegreiflich starke Triebe!"@de ;
    cnw:incipitText "O du wunderbarer Rath"@de ;
    cnw:incipitText "Doch das, was du erworben"@de ;
    cnw:incipitText "O Heyland! dein betrübtes Leiden"@de ;
    cnw:incipitText "O grosse Noth!"@de ;
    cnw:incipitText "O GOTT! du kanst allein so lieben"@de ;
    cnw:incipitText "Erhebet den Helden mit eben dem Mute"@de ;
    cnw:incipitText "Und stolze Feind wißt"@de ;
    cnw:incipitText "Mein JESUS stirbt: siegt rasende Feinde!"@de ;
    cnw:incipitText "Bleibt in Andacht meine Sinnen"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

