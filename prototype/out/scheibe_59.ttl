    cnw:incipitText "Der Engel des Herrn lagert sich"@de ;
    cnw:incipitText "Der Engel des Herrn"@de ;
    cnw:incipitText "So glücklich sind die Frommen"@de ;
    cnw:incipitText "Sehr geschwinde gleich dem Winde"@de ;
