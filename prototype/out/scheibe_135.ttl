    cnw:incipitText "Dir, holde Königin! weyht sich mein froher Mund"@de ;
    cnw:incipitText "Das thönende Schallen der muntren Trompette"@de ;
    cnw:incipitText "So recht, ihr Freunde, die ich liebe"@de ;
    cnw:incipitText "Die zärtlichen Flammen der Liebe"@de ;
    cnw:incipitText "Auch ich erblicke mich an diesem grossen Paare"@en ;
    cnw:incipitText "Sanft und leicht sind meine Ketten"@de ;
    cnw:incipitText "Wie schön ist solch ein Fest"@de ;
    cnw:incipitText "Ruhm und Lust und Scherz und Glücke"@de ;
    cnw:incipitText "Dies ist der Freudentag, dies ist das grosse Fest"@de ;
    cnw:incipitText "Es tobet vergebens das Rasen der Feinde"@de ;
    cnw:incipitText "Dies Haus besteht in Ewigkeit"@de ;
    cnw:incipitText "Was meine bewafnete Schaaren bekämpfen"@de ;
    cnw:incipitText "Tollkühner Schwarm, verworfne Schaar!"@de ;
    cnw:incipitText "Wie glücklich ist der Tag, wie treflich dieses Fest!"@de ;
    cnw:incipitText "Kein Feind kann Deine Tugend kränken"@de ;
    cnw:incipitText "Mit Recht nenn ich den Tag den schönsten auf der Welt"@de ;
    cnw:incipitText "Schöner kann kein Bündniß grünen"@de ;
    cnw:incipitText "Wir wollen stets allhier bey diesem Paare wohnen"@de ;
    cnw:incipitText "Königin! Dein Fest zu ehren"@de ;
    cnw:incipitText "Mein rascher Flug soll auch nicht säumig seyn"@de ;
    cnw:incipitText "Giesse, gütiges Geschicke!"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

