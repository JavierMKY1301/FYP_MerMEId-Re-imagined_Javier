    cnw:incipitText "Som en Rovfugl farer dristig over Havets Spejl!"@da ;
    cnw:incipitText "Wie der Seefalk kreiset, jagend über blauer Fluth"@de ;
    cnw:incipitText "Idag! hvad maa jeg høre!"@da ;
    cnw:incipitText "Schon heut! darf ich dir trauen?"@de ;
    cnw:incipitText "Lad os Dandsen prøve"@da ;
    cnw:incipitText "Kommt den Tanz zu üben"@de ;
    cnw:incipitText "Stille! hvad betyder denne Skrigen"@da ;
    cnw:incipitText "Stille! was bedeutet dieses Schreien"@de ;
    cnw:incipitText "Dandse, dandse, ja, det kan I nok"@da ;
    cnw:incipitText "Tanzen, tanzen, ja, das könnt ihr wohl"@de ;
    cnw:incipitText "Naadige Greve! høie Beskytter!"@da ;
    cnw:incipitText "Gnädiger Graf und Beschützer!"@de ;
    cnw:incipitText "Den er stærk, den er stærk den gyldne, gyldne Viin!"@da ;
    cnw:incipitText "Er ist stark, er ist stark der goldne, goldne Wein"@de ;
    cnw:incipitText "O! I maa skamme Jer, som I kan tale"@da ;
    cnw:incipitText "O, schämen musst Ihr euch"@de ;
    cnw:incipitText "Hvad har jeg gjort!"@da ;
    cnw:incipitText "Ich will's nicht thun, will nicht verrathen die Guten"@de ;
    cnw:incipitText "O hjælp mig Himmel, i din Naade!"@da ;
    cnw:incipitText "O hilf mit Gott in deiner Gnade"@de ;
    cnw:incipitText "Nær ved Arnoflodens Vande"@da ;
    cnw:incipitText "An der Arnoflusses Mündung"@de ;
    cnw:incipitText "Saa langt fra hende, og saa nær"@da ;
    cnw:incipitText "So nah der Schöne und so fern"@de ;
    cnw:incipitText "For din englerene, fromme Sjæl, Helene!"@da ;
    cnw:incipitText "Hvor jeg gaaer og hvor jeg dvæler er hans Billede mig nær"@da ;
    cnw:incipitText "Jeg skal forklare dig den dybe Sands i hver en Blomst"@da ;
    cnw:incipitText "Amor, du som lærte Qvinden at elske Manden"@da ;
    cnw:incipitText "Kjerligheds Gud er mægtig, du Søde!"@da ;
    cnw:incipitText "Tys! tys! ingen Støi, sagte, sagte!"@da ;
    cnw:incipitText "Med glade Sange og muntre Dandse den pragtfulde Sal vi betræde"@da ;
    cnw:incipitText "Naadige Greve! vor høje Beskytter"@da ;
    cnw:incipitText "Jeg læser klart i Eders skjønne Blikke"@da ;
    cnw:incipitText "Hr. Greve! nogle Landsmænd vente paa Eders Vink"@da ;
    cnw:incipitText "I Achelos sidder sorgfri Michalistos i sin Gaard"@da ;
    cnw:incipitText "Milde Gud! Hvad betyder dette Skud?"@da ;
    cnw:incipitText "Medens Maanen sagte daler ved der første Skjær af Solen"@da ;
    cnw:incipitText "Uberto! Uberto!"@da ;
    cnw:incipitText "Hør! hør! Signaler lød!"@da ;
    cnw:incipitText "Dum memori est nesesse"@la ;
    cnw:incipitText "Af dine milde Blikke jeg drikker et saligt Haab"@da ;
    cnw:incipitText "O, troe ham ei!"@da ;
    cnw:incipitText "Til Hjemmet igjen med Seier vi drage"@da ;
    cnw:incipitText "Som en Rovfugl farer dristig over Havets Spejl!"@da ;
    cnw:incipitText "Idag! hvad maa jeg høre!"@da ;
    cnw:incipitText "Lad os Dandsen prøve"@da ;
    cnw:incipitText "Den er stærk, den er stærk den gyldne Vin!"@da ;
    cnw:incipitText "O, I maa skamme Jer, som I kan tale!"@da ;
    cnw:incipitText "Hvad har jeg gjort!"@da ;
    cnw:incipitText "O hjælp mig, Himmel, i din Naade"@da ;
    cnw:incipitText "Nær Arnoflodens Vande"@da ;
    cnw:incipitText "Saa langt fra hende, og saa nær!"@da ;
    cnw:incipitText "For din englerene, fromme Sjæl, Helene!"@da ;
    cnw:incipitText "Jeg skal forklare dig den dybe Sands i hver en Blomst"@da ;
    cnw:incipitText "Kjærlighedens Gud er mægtig"@da ;
    cnw:incipitText "Tys! tys! ingen Støj, sagte, sagte!"@da ;
    cnw:incipitText "Med glade Sange, med muntre Dandse den pragtfulde Sal vi betræde"@da ;
    cnw:incipitText "Naadige Greve! vor høje Beskytter!"@da ;
    cnw:incipitText "Jeg læser klart i Eders skjønne Blikke"@da ;
    cnw:incipitText "Hr. Greve! nogle Landmænd vente paa Eders Vink"@da ;
    cnw:incipitText "I Achelos sidder sorgfri Michalistos i sin Gaard"@da ;
    cnw:incipitText "Milde Gud! hvad betyder dette Skud?"@da ;
    cnw:incipitText "Medens Maanen sagte daler ved det første Skjær af Solen"@da ;
    cnw:incipitText "Uberto! Uberto!"@da ;
    cnw:incipitText "Dum me mori est decesse"@da ;
    cnw:incipitText "Min Beatrice! Min Gemal!"@da ;
    cnw:incipitText "Til Hjemmet! Til Hjemmet!"@da ;
