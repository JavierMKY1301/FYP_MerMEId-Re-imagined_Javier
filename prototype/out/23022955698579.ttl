<https://cnw-ld.org/work/SchWB7-001/expression/1>
    a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB7-001> ;
    cnw:incipitText "So auch jemand kämpfet"@de ;
    cnw:incipitText "Wiewohl ist mir der Kampf gelungen!"@de ;
    cnw:incipitText "Ewig ist mein Geist genesen"@de ;
    cnw:incipitText "O wahre Lust!"@de ;
    cnw:incipitText "Ich habe einen guten Kampfs gekämpfet"@de ;
    cnw:incipitText "So singt Lovise jetzt"@de ;
    cnw:incipitText "Ich habe den Lauf vollendet"@de ;
    cnw:incipitText "Nun bleibt, was sterblich war, zurücke"@de ;
    cnw:incipitText "Ich habe Glauben gehalten"@de ;
    cnw:incipitText "Mein Glaube hat mir manchen Sieg"@de ;
    cnw:incipitText "Kein Leiden, keine Pein"@de ;
    cnw:incipitText "O! welche nie empfundne Lust"@de ;
    cnw:incipitText "Wenn sich ein Geist besinnet"@de ;
    cnw:incipitText "Doch es ist nicht so leicht"@de ;
    cnw:incipitText "Oeffne deines Glaubens Ohren"@de ;
    cnw:incipitText "So auch jemand kämpfet"@de ;
    cnw:incipitText "Hinfort ist mir beygelegt die Krone der Gerechtigkeit"@de ;
    cnw:incipitText "Ja wohl verklärte Königinn"@de ;
    cnw:incipitText "Du trägst der Unschuld Perlenkleid"@de ;
    cnw:incipitText "Du glänzest heller als die Sonne"@de ;
    cnw:incipitText "Das Denkmahl Deiner Huld und Güte"@de ;
    cnw:incipitText "Dich hatte Glück, Geburt und Stand"@de ;
    cnw:incipitText "Wie betrübt ist Friedrichs Geist!"@de ;
    cnw:incipitText "Ganz Dännemark und Engeland"@de ;
    cnw:incipitText "Selbst die Tugend krönte Dich"@de ;
    cnw:incipitText "Nun aber rühret unsre Brust"@de ;
    cnw:incipitText "Gott weiß allein, wodurch auf Erden"@de ;
    cnw:incipitText "Dir folgt, enselte Königinn"@de ;
    cnw:incipitText "Lebe Hoffnungs-volle Jugend"@de ;
    cnw:incipitText "Nun ruhe sanft in Deiner Gruft"@de ;
    cnw:incipitText "Louise! schlafe wohl und sanft in deinem Grabe"@de ;
    cnw:incipitText "Folgt nun auf wohl beschloßnen Kampf"@de ;
    cnw:incipitText "Ach ich habe schon erblicket"@de ;
    cnw:incipitText "Wer an mich gläubet, der wird leben"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

