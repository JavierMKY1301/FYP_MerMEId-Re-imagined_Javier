    cnw:incipitText "Og ses maa under Sengen"@da ;
    cnw:incipitText "Hvad var det nu, jeg skrev?"@da ;
    cnw:incipitText "Du Pebersvend! vor Sang du ved"@da ;
    cnw:incipitText "Hvad ved den om Tankerne mangen Nat"@da ;
    cnw:incipitText "Draabe haster efter Draabe"@da ;
    cnw:incipitText "Nej, jeg vil ikke hvile mer"@da ;
    cnw:incipitText "Der fik du den til Punkt og Prikke"@da ;
    cnw:incipitText "In un boschetto trovai pastorella"@it ;
    cnw:incipitText "Vi elsker dig, vort høje Nord"@da ;
    cnw:incipitText "Med Vemod mindes jeg min stakkels Moder"@da ;
    cnw:incipitText "Fra Fyrreskovens Kuppelsal"@da ;
