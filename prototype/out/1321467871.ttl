<https://cnw-ld.org/work/HartW355/expression/1>
    a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/HartW355> ;
    cnw:key "E-flat major" ;
    cnw:tempo "Allegro non tanto" ;
    cnw:meter "2/2" ;
    cnw:performingForce "voice" ;
    cnw:performingForce "pf." ;
    cnw:incipitText "Abildtræet i Skoven staar"@da ;
    cnw:incipitText "Th' Citron, grandest of all trees, grows"@en ;
    cnw:incipitText "Fornam jeg en Klang?"@da ;
    cnw:incipitText "Was't music's clang?"@en ;
    cnw:incipitText "Stiig ned fra dit Bjerg!"@da ;
    cnw:incipitText "Come down from thy mount!"@en ;
    cnw:incipitText "Det er ingen Drøm. Jeg hører hans Røst"@da ;
    cnw:incipitText "It is not a dream, his voice I can hear"@en ;
    cnw:incipitText "Hun sover derinde"@da ;
    cnw:incipitText "A tent is her bower"@en ;
    cnw:incipitText "Er du vaagen? Elskede!"@da ;
    cnw:incipitText "Art awake thou, loved one?"@en ;
    cnw:incipitText "Dvæl, Elskede, dvæl!"@da ;
    cnw:incipitText "Stay, loved one! stay!"@en ;
    cnw:incipitText "Bort, bort! jeg vil flye"@da ;
    cnw:incipitText "Hence, hence! I will fly"@en ;
    cnw:incipitText "Jeg besværger Jer, Piger!"@da ;
    cnw:incipitText "I beseech ye, sweet maidens!"@en ;
    cnw:incipitText "Din Deilighed glemmer jeg aldrig meer"@da ;
    cnw:incipitText "Thy beauty will e'er in my mem'ry be"@en ;
    cnw:incipitImage "hartw_355_01.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

