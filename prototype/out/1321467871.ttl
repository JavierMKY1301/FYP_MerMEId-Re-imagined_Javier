    a frbr:Work, mo:MusicalWork ;
    dcterms:title "Sulamiths og Salomons Sange"@da ;
    dcterms:title "Sulamith and Solomon"@en ;
    dcterms:identifier "Opus 52" ;
    dcterms:identifier "HartW 355" ;
    dcterms:identifier "DF 125" ;
