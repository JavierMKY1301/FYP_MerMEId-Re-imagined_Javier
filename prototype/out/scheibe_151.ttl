<https://cnw-ld.org/work/SchWB2-300>
    a frbr:Work, mo:MusicalWork ;
    dcterms:title "Abbildung der Martern und des Todes unsers Erlösers Jesus Christus. Ein Oratorium"@de ;
    dcterms:identifier "SchW B2:300" ;
    cnw:cnwNumber "B2:300" ;
    cnw:catalogueCode "SchW" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
