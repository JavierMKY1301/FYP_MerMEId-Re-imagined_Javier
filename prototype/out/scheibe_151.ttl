    cnw:incipitText "JEsu! meine Missethat"@de ;
    cnw:incipitText "O Garten! ohne Lust!"@de ;
    cnw:incipitText "Alles, unterdrückter Held!"@de ;
    cnw:incipitText "Gott, der die Quaal nicht unterbricht"@de ;
    cnw:incipitText "Wem willst du doch die Lippen reichen"@de ;
    cnw:incipitText "Da streckte Petrus Hand sich aus"@de ;
    cnw:incipitText "Die strenge Rache schläfet nicht"@de ;
    cnw:incipitText "Und Hannas sprach"@de ;
    cnw:incipitText "Ach Jerusalem! Ach weine!"@de ;
    cnw:incipitText "Er weint, und wie er izt läßt Thränen fliessen"@de ;
    cnw:incipitText "Ich höre schon die Heerposaunen blasen"@de ;
    cnw:incipitText "Und Hannas sandte ihn gebunden"@de ;
    cnw:incipitText "Fleischgewordnes Wort, du schweigest?"@de ;
    cnw:incipitText "Nun ich beschwöre dich"@de ;
    cnw:incipitText "Wie tobet doch der Haß der Welt"@de ;
    cnw:incipitText "Hiedurch ward ihre Wut noch mehr erweckt"@de ;
    cnw:incipitText "Verhüllet euch, beschämte Cherubinen!"@de ;
    cnw:incipitText "Als kaum die Nacht verschwand"@de ;
    cnw:incipitText "Wie übel hab ich doch gethan"@de ;
    cnw:incipitText "Doch, weil die Priesterschaft sein Schmerz nicht rühren kann"@de ;
    cnw:incipitText "In Ewigkeit verlohrne Seele!"@de ;
    cnw:incipitText "Als Jesus vor Pilato stund"@de ;
    cnw:incipitText "Jauchzet! jauchzet! ihr geistlich Armen"@de ;
    cnw:incipitText "Und Jesus ward Pilato vorgestellt"@de ;
    cnw:incipitText "Ach schweigt doch nicht!"@de ;
    cnw:incipitText "Wie? bist du denn ein König?"@de ;
    cnw:incipitText "Dein Reich wird ewig, ewig dauren"@de ;
    cnw:incipitText "Glaubst du noch wohl"@de ;
    cnw:incipitText "Mein Herze! wem ergiebst du dich?"@de ;
    cnw:incipitText "Was ist die Wahrheit?"@de ;
    cnw:incipitText "Verhaßter Lärm! betäubendes Geschrey!"@de ;
    cnw:incipitText "Als nun die Priester aus erboßtem Neid"@de ;
    cnw:incipitText "Gott! regt sich nicht der Eifer deiner Rechte?"@de ;
    cnw:incipitText "Wie treiben sie mit angestrengten Armen"@de ;
    cnw:incipitText "Deine Pein und blutigs Schwitzen"@de ;
    cnw:incipitText "Wer seinen rauhen Arm am höchsten schwingt"@de ;
    cnw:incipitText "Wie zeichnet euch, entstellte Glieder!"@de ;
    cnw:incipitText "Wie kann der rauhe Schmerzenszwang"@de ;
    cnw:incipitText "Mein höchster Ruhm ist auf der Welt"@de ;
    cnw:incipitText "Mein Bräutigam! wie schmückt dein Vater dich?"@de ;
    cnw:incipitText "Mein Freund ist schön bey seinen Qvalen"@de ;
    cnw:incipitText "Da gieng Pilatus wiederum hinaus"@de ;
    cnw:incipitText "Seht, welch ein Mensch ist das!"@de ;
    cnw:incipitText "Der Vorspruch konnte sie doch nicht bewegen"@de ;
    cnw:incipitText "Luft, Abgrund, Meer und alles Land"@de ;
    cnw:incipitText "Pilatus! nimmt dein Herz nicht Furcht und Schrecken ein?"@de ;
    cnw:incipitText "Entsetze dich auf deinem Richterthron!"@de ;
    cnw:incipitText "Da furchte sich Pilatus noch viel mehr"@de ;
    cnw:incipitText "Brecht nicht den Stab, ihr frechen Hände!"@de ;
    cnw:incipitText "Da führten sie ihn hin"@de ;
    cnw:incipitText "Nicht das getragne Holz"@de ;
    cnw:incipitText "Verfluchtes Holz! doch, wer hat dich verflucht?"@de ;
    cnw:incipitText "O Tochter dieser Stadt! was weinst du über mich?"@de ;
    cnw:incipitText "Der Seegen und die Himmelsgaben"@de ;
    cnw:incipitText "Und kannst du das an grünen Holze sehen"@de ;
    cnw:incipitText "Was wird man nicht für Zeterttöne"@de ;
    cnw:incipitText "Ich bin des Jammeranblicks müde"@de ;
    cnw:incipitText "Ach bleibe doch!"@en ;
    cnw:incipitText "Ich scheide nicht"@de ;
    cnw:incipitText "Als Jesus nun durch einem matten Gang"@de ;
    cnw:incipitText "O Traurigkeit! O Herzleid!"@de ;
    cnw:incipitText "Erbärmliche Gestalt"@de ;
    cnw:incipitText "Dein Fuß verläßt die blutbefleckte Stadt"@de ;
    cnw:incipitText "Und oben konnte man, was seine Schuld gewesen"@de ;
    cnw:incipitText "Bist du denn der Ehrenkönig?"@de ;
    cnw:incipitText "Und um der sechsten Stunde Zeit"@de ;
    cnw:incipitText "Wenn ich einmahl soll scheiden"@de ;
    cnw:incipitText "Es ist vollbracht!"@en ;
    cnw:incipitText "All JEsus nun das Herze brach"@de ;
    cnw:incipitText "O müder Geist! so ruhe doch einmal"@de ;
    cnw:incipitText "Und JEsus neigete das Haupt"@de ;
    cnw:incipitText "Das menschliche Geschlecht fällt hier"@de ;
    cnw:incipitText "Kann dem, den so viel Leiden trift"@de ;
    cnw:incipitText "Heiliger HErre Gott!"@de ;
    cnw:incipitText "Ihr schrecklichen Höhen der donnernden Lüfte!"@de ;
    cnw:incipitText "Und weil man ihn verstorben fand"@de ;
    cnw:incipitText "O nielmals satte Wut! durchbohret man"@de ;
    cnw:incipitText "Als alles nun vollbracht"@de ;
    cnw:incipitText "Herr! dir ist alles Fleisch verbunden"@de ;
    cnw:incipitText "Und endlich muß auch, bey der Erde Beben"@de ;
    cnw:incipitText "So ist der Schrecken allgemein!"@de ;
    cnw:incipitText "Was Wunder! daß die Erde zittert"@de ;
    cnw:incipitText "Die Erde taumelt, bebt und bricht"@de ;
    cnw:incipitText "Ach! dieser Todte giebt den Todten Licht und Leben"@de ;
    cnw:incipitText "Da der Unsterbliche sein Leben"@de ;
    cnw:incipitText "Herr! deines Leidens erste Frucht"@de ;
    cnw:incipitText "Ach welche würkende warhafte Wunderzeichen"@de ;
    cnw:incipitText "Zurück! zurück!"@de ;
    cnw:incipitText "O Himmel! was geschieht der Welt?"@de ;
    cnw:incipitText "Der Herr hat schon ein furchtbar Kleid"@de ;
    cnw:incipitText "Ach wie entsetzlich wird dies Trauerspiel gestört?"@de ;
    cnw:incipitText "Auf! der Rächer wird erwachen"@de ;
    cnw:incipitText "Der Männer starke Stimme ruft"@de ;
    cnw:incipitText "Bestürzte Seelen! flieht doch nicht"@de ;
    cnw:incipitText "Ein jeder flehet nach Erbarmen"@de ;
    cnw:incipitText "Herr! deine Macht entkräftet nicht der Tod"@de ;
    cnw:incipitText "Ja diese Zeichen sind durch dessen Kraft geschehen"@de ;
    cnw:incipitText "So schließe denn dein martervolles Leiden"@de ;
    cnw:incipitText "Dein Blutdurchströmtes Fleisch"@de ;
    cnw:incipitText "Nun ich danke dir von Herzen"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

