    cnw:incipitText "Syng om mit Søtog"@da ;
    cnw:incipitText "Drot er Harald paa sin Drage"@da ;
    cnw:incipitText "Kender du Sne"@da ;
    cnw:incipitText "Ja - galdre, galdre!"@da ;
    cnw:incipitText "Træd ind, Kong Harald"@da ;
    cnw:incipitText "Ved alle Guder!"@da ;
    cnw:incipitText "Hulde Vætter, høje Diser"@da ;
    cnw:incipitText "Der hvor Harald hæver Skatten"@da ;
    cnw:incipitText "Snefrid - Snefrid... sover du end?"@da ;
