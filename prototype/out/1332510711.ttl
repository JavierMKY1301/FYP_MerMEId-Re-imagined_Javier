    cnw:incipitText "Bort svinder den mørke Tordensky"@da ;
    cnw:incipitText "Undine kommer ikke! snart falder Mørket paa"@da ;
    cnw:incipitText "Og vær mig, du Fiskerpige huld"@da ;
    cnw:incipitText "Undine! Undine! Daarende Mø!"@da ;
    cnw:incipitText "I dette Øje læser jeg kun Godt"@da ;
    cnw:incipitText "Du stakkels Barn! hvor jeg beklager Dig"@da ;
    cnw:incipitText "Hil Dig vor Hersker!"@da ;
    cnw:incipitText "Modtag, favre Herskerinde, Somrens friske Blomsterpryd!"@da ;
    cnw:incipitText "Nu velan! men end engang hør din Skjæbnes Villie"@da ;
    cnw:incipitText "Ensom i min Hytte sad jeg"@da ;
    cnw:incipitText "Arme Fisker! hvorfor græder du?"@da ;
    cnw:incipitText "Undine! Kom!"@da ;
    cnw:incipitText "Solen synker! gylden Glands spreder den paa Voven!"@da ;
    cnw:incipitText "Ja, ses I atter, rammer Døden dig!"@da ;
    cnw:incipitText "Hvert Fjed, vi gjennem Livet gaae"@da ;
    cnw:incipitImage "hartw_016_00.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

