    cnw:incipitText "O skjønne Borg! Hist kneiser den med sine Spir"@da ;
    cnw:incipitText "Gaa! behold dit Hovedhaar"@da ;
    cnw:incipitText "En sælsom Følelse, Reigin besjæler mig"@da ;
    cnw:incipitText "En Hyrdepige nærmer sig med hviden Spand"@da ;
    cnw:incipitText "Gid denne Drik maa styrke Dig"@da ;
    cnw:incipitText "Med langsom List Flodernes Dronning hævner Ymerkæmpe"@da ;
    cnw:incipitText "Nu græm dig ei meer!"@da ;
    cnw:incipitText "Saa seile vi Hjem ved Medbørsvind"@da ;
    cnw:incipitImage "hartw_022_0.png" ;
