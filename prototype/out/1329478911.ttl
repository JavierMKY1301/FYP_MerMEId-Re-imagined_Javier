    cnw:incipitText "The convent where the pious nuns reside"@en ;
    cnw:incipitText "Ak, det er sidste Gang i denne Verden"@da ;
    cnw:incipitText "Ach, heut zum Letztenmal in diesem Leben"@de ;
    cnw:incipitText "This is the final moment in this world"@en ;
    cnw:incipitText "Den Spillemand sin Harpe tog"@da ;
    cnw:incipitText "Der Sänger nahm die Harfe sein"@de ;
    cnw:incipitText "The minstrel stood and took his harp"@en ;
    cnw:incipitText "Nu drik, værer glade!"@da ;
    cnw:incipitText "Nun trinkt, und erfreut euch!"@de ;
    cnw:incipitText "Now drink, and be merry!"@en ;
    cnw:incipitText "For Herrens Altar tør jeg sværge"@da ;
    cnw:incipitText "Mit heil'gem Eide kann ich bezeugen"@de ;
    cnw:incipitText "Before our Father's altar I'd swear"@en ;
    cnw:incipitText "God Aften Moder! kan du kjende mig?"@da ;
    cnw:incipitText "Gott grüss' dich Mutter! erkennst du mich?"@de ;
    cnw:incipitText "Good evening, mother! Do you know it's me?"@en ;
    cnw:incipitText "Min Søn, fortæl, hvad Du har seet!"@da ;
    cnw:incipitText "Mein Sohn, erzähl', was Du gesehn'!"@de ;
    cnw:incipitText "My son, now tell what you have seen!"@en ;
    cnw:incipitText "I Kloster Liden Kirsten gaaer"@da ;
    cnw:incipitText "Ins Kloster man klein Karin lässt"@de ;
    cnw:incipitText "The convent soon shall Kirsten join"@en ;
    cnw:incipitText "Sverkel! O du Kjære!"@da ;
    cnw:incipitText "Hialmar! O Du Theurer!"@de ;
    cnw:incipitText "Sverkel! Oh, my dearest"@en ;
    cnw:incipitText "Liden Kirsten, det er hende"@da ;
    cnw:incipitText "Ha! klein Karin kommt gegangen"@de ;
    cnw:incipitText "Little Kirsten stands before me"@en ;
    cnw:incipitText "I morgen Du vil i Kloster gaae"@da ;
    cnw:incipitText "Morgen willst Du in's Kloster gehn"@de ;
    cnw:incipitText "The convent you will tomorrow join"@en ;
    cnw:incipitText "Natten lang, Dands og Sang"@da ;
    cnw:incipitText "Nächte lang, Tanz und Sang"@de ;
    cnw:incipitText "All night long shall we sing"@en ;
    cnw:incipitText "Ja, jeg er hjemme! Ja, jeg er i Danmark!"@da ;
    cnw:incipitText "Ja, jeg er hjemme, i mit kjære Danmark"@da ;
    cnw:incipitText "Ja ich bin wieder in der lieben Heimath"@de ;
    cnw:incipitText "Yes, I am home now in my dearest Denmark"@en ;
    cnw:incipitText "Langt, langt fra Hjemmets Kyst"@da ;
    cnw:incipitText "Weit, weit von der Heimath"@de ;
    cnw:incipitText "Far from my home's coast"@en ;
    cnw:incipitText "Seer Du, jeg er her alt og festlig smykket"@da ;
    cnw:incipitText "Siehst Du, schon bin ich hier im Festgewande"@de ;
    cnw:incipitText "Look now, I am here and finely dressed"@en ;
    cnw:incipitText "Hør Ungersvend, siig ikke nei"@da ;
    cnw:incipitText "Hör', Junggesell, stell dich hierher"@de ;
    cnw:incipitText "Now hear young friend, do not say no"@en ;
    cnw:incipitText "Hil være vor Indgang i Riddersal"@da ;
    cnw:incipitText "Heil unserem Eintritt zum Fest im hohen Rittersaal"@de ;
    cnw:incipitText "Hail, as we bring to the Castle Hall"@en ;
    cnw:incipitText "Fra Klostret til Kirken er Nonnens Gang"@da ;
    cnw:incipitText "Zur Kirch' geht vom Kloster der Nonne Gang"@de ;
    cnw:incipitText "From convent to church is the path of the nun"@en ;
    cnw:incipitText "Natten kan rumme en Verden af Glæde!"@da ;
    cnw:incipitText "Jubel und Freude erhellen die Nacht"@de ;
    cnw:incipitText "Evening can fill a whole world with rejoicing"@en ;
    cnw:incipitText "Hr. Lave han reed sig under Ø"@da ;
    cnw:incipitText "Herr Lave reitet wohl auf die Freit'"@de ;
    cnw:incipitText "Lave he rode out one fine day"@en ;
    cnw:incipitText "Søster og Broder! Velsign os Moder!"@da ;
    cnw:incipitText "Schwester und Bruder! o seg'n uns Mutter!"@de ;
    cnw:incipitText "Sister and brother! bless us, Mother!"@en ;
    cnw:incipitText "Det er min Synd, min Smerte"@da ;
    cnw:incipitText "Fasst meine Sünde, meine Schmerzen"@de ;
    cnw:incipitText "This is my sin that I suffer"@en ;
    cnw:incipitText "Kjær Moder sig mig da, hvordan jeg Liden Kirsten glemme kan"@da ;
    cnw:incipitText "Lieb' Mutter, sag mig an, wie ich klein Karin vergessen kann?"@de ;
    cnw:incipitText "Dear mother mine, tell me how I can Little Kirsten forget?"@en ;
    cnw:incipitText "De stakkels Børn! Min ejegode Frue!"@da ;
    cnw:incipitText "Die armen Kinder! edle liebe Frau!"@de ;
    cnw:incipitText "Unhapiness! My kind-hearted Lady!"@en ;
    cnw:incipitText "Det Barn, som Eders Husbond bragte mig, er dødt!"@da ;
    cnw:incipitText "Das Kind, das Euer Hausherr mir gebracht, es starb"@de ;
    cnw:incipitText "That child, which your husband brought me, is dead"@en ;
    cnw:incipitText "Munken han reed sig under Ø"@da ;
    cnw:incipitText "Der Mönch ist geritten über Land"@de ;
    cnw:incipitText "Early one day the monk rode out"@en ;
    cnw:incipitImage "hartw_003_1_0.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

<https://cnw-ld.org/agent/j_p_e_hartmann>
    a foaf:Agent ;
    foaf:name "J.P.E. Hartmann" .

<https://cnw-ld.org/agent/hans_christian_andersen>
    a foaf:Agent ;
    foaf:name "Hans Christian Andersen" .

