    cnw:incipitText "In Hellas, in Hellas"@de ;
    cnw:incipitText "In Hellas, in Hellas"@en ;
    cnw:incipitText "Weh mir, fern von der theuren Heimath"@de ;
    cnw:incipitText "Ah me! far from the home I long for"@en ;
    cnw:incipitText "Psyche, höre, was wir dir verkünden"@de ;
    cnw:incipitText "Psyche, hear thou what we have to teach thee"@en ;
    cnw:incipitText "Wo bin ich? Dunkel mich umhüllt"@de ;
    cnw:incipitText "Where am I? Darkness wraps me round"@en ;
    cnw:incipitText "Psyche! Psyche! Wer ruft?"@de ;
    cnw:incipitText "Psyche! Psyche! Who calls?"@en ;
    cnw:incipitText "Im wallend, dunkelblauen Mantel"@de ;
    cnw:incipitText "There comes with waving dusky robes bedight"@en ;
    cnw:incipitText "Hört munt'rer Vögel Chor"@de ;
    cnw:incipitText "The birds, in playful throng"@en ;
    cnw:incipitText "Dank Euch, holde Schwestern"@de ;
    cnw:incipitText "Thanks, ye kindly sisters"@en ;
    cnw:incipitText "Psyche, Unsel'ge von Zweifel bethört"@de ;
    cnw:incipitText "Psyche, unhappy, by doubt led astray"@en ;
    cnw:incipitText "Voll Demuth, göttlich hehrer Eros"@de ;
    cnw:incipitText "With meekness, god like Eros"@en ;
    cnw:incipitText "Du siegtest, o Venus, das Herze ihr brach"@de ;
    cnw:incipitText "Thou gainest, o Venus"@en ;
    cnw:incipitText "Allbesieger, o Eros!"@de ;
    cnw:incipitText "Thou art mighty, o Eros"@en ;
    cnw:incipitText "Schatten schweben durch das Dunkel"@de ;
    cnw:incipitText "Shadows hover, sad and mournful"@en ;
    cnw:incipitText "Noch ruhet Morgendämmerung auf der Flur"@de ;
    cnw:incipitText "Still rests the morning twilight"@en ;
    cnw:incipitText "Eros! Ich fühl's, ich fühl's, dein Herz mir jetzt Verzeihung gab"@de ;
    cnw:incipitText "Eros, I feel thy heart at last can pardon shew"@en ;
    cnw:incipitText "Breit' aus die Flügel ohne Furcht und Beben"@de ;
    cnw:incipitText "Spread out thy pinions, on their strength relying"@en ;
    cnw:incipitText "Sei uns gegrüsst!"@de ;
    cnw:incipitText "We great thee well"@en ;
    cnw:incipitImage "NWGW_179_01.png" ;
