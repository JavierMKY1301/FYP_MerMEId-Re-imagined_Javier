    cnw:performingForce "voice" ;
    cnw:incipitText "Rinder I Taarer, og ikke aflader!"@da ;
    cnw:incipitText "I Nordens Tvilling-Riger!"@da ;
    cnw:incipitText "Ja! tvende Dronninger"@da ;
    cnw:incipitText "Ey noget Tordenslag kan os saa bange giøre"@da ;
    cnw:incipitText "Sørg da, du hele Land"@da ;
    cnw:incipitText "Vor Sceptermand, vor Konge Christian"@da ;
    cnw:incipitText "Der er fornummet en Røst i det Høye"@da ;
    cnw:incipitText "Bort Leeg og Lyst!"@da ;
    cnw:incipitText "Hvad nu! hvad Graad! hvad Jammer-Skrig!"@da ;
    cnw:incipitText "Hvad har dig Dyd bekymret giort?"@da ;
    cnw:incipitText "See Femte Fridrich med Dyder var prydet"@da ;
    cnw:incipitText "See! Fred paakom en Bitterhed, ja en Bitterhed"@da ;
    cnw:incipitText "Parnasse! sid i Støv!"@da ;
    cnw:incipitText "Nu sidde vi da og begræde"@da ;
    cnw:incipitText "Vel er den følesløs, ja, har et Tiger-Hierte"@da ;
    cnw:incipitText "Om Dig skal hver en Tunge"@da ;
    cnw:incipitText "Velan! vort sørge-Spil"@da ;
    cnw:incipitText "Hvad Trøst kan vel Opmuntre vores Siel?"@da ;
    cnw:incipitText "Du Kongers Konge giv vor Konge Fryd og Glæde!"@da ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

