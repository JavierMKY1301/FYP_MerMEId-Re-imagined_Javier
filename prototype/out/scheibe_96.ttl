    a frbr:Work, mo:MusicalWork ;
    dcterms:title "Vollständiges Liederbuch der Freymäurer mit Melodieen"@de ;
    dcterms:identifier "SchW B5:Coll.006" ;
    cnw:cnwNumber "B5:Coll.006" ;
    cnw:catalogueCode "SchW" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
