    cnw:incipitText "Auf, auf, auf, laut schall das Horn"@de ;
    cnw:incipitText "Frem, frem, frem, fremad til Kamp"@da ;
    cnw:incipitText "Heute noch brech' ich des stolzen Königs Macht"@de ;
    cnw:incipitText "Alt i Kvæld slaar jeg den stolte Konges Hær"@da ;
    cnw:incipitText "Auf, auf in die Schlacht, Fingal führt zum Sieg!"@de ;
    cnw:incipitText "Frem, fremad til Kamp. Fingal fører til Seir."@da ;
    cnw:incipitText "O grauenvolle Stille! dahin, dahin sind die lieblichen Träume"@de ;
    cnw:incipitText "Hvor alt er tyst og stille! De svandt, de svandt de livsalige Drømme!"@da ;
    cnw:incipitText "Vom Lochlin kam gezogen Suaran, der stolze Held"@de ;
    cnw:incipitText "Suaran, den Lochlins Konge, drog over Bølgen blaa"@da ;
    cnw:incipitText "Still, still ist die Jagd, kein Laut ertönt, als das Brausen des Strom's"@de ;
    cnw:incipitText "Ak! Snart det er Nat! Alt Vinden suser i Granernes Top"@da ;
    cnw:incipitText "Wir wandeln auf dem Sturm"@de ;
    cnw:incipitText "Vi drage som Storm over Hede"@da ;
    cnw:incipitText "O, o, dass ich nicht sitze an Caruns Wellen"@de ;
    cnw:incipitText "O! o sad jeg dog hist ved Caruns Vover!"@da ;
    cnw:incipitText "Entfloh'n ist der Feind' Getöse, nicht sieht man sein Ross auf den Höhen"@de ;
    cnw:incipitText "Nu flygter den stolte Caracul, hans Ganger foer bort over Heden"@da ;
    cnw:incipitText "Lasst ab vom lauten Siegsgesang, ihr Krieger Fingals, schweigt, o schweigt!"@de ;
    cnw:incipitText "O stands den glade Sejerssang, du Fingals Kriger ti, o ti!"@da ;
    cnw:incipitText "Lasst mich schauen die Geliebte, zeiget, wo die Holde schläft"@de ;
    cnw:incipitText "Sorgens Taager stille svæve om min Elsktes Hvilested"@da ;
    cnw:incipitText "Aus den Wolken herab schauen die Geister der Ahnen"@de ;
    cnw:incipitText "Højt fra Skyernes Krands skue de Henfarnes Aander"@da ;
    cnw:incipitImage "NWGW_162_00.png" ;
