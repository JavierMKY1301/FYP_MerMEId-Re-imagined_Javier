    cnw:incipitText "Vee os! Vee os! der i Fred overfaldt en Bitterhed"@da ;
    cnw:incipitText "Bedrøvelige Død"@da ;
    cnw:incipitText "Du forkorted Dine Dage"@da ;
    cnw:incipitText "Vort Liv er her paa Jorden som en Skygge"@da ;
