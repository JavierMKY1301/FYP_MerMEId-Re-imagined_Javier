<https://cnw-ld.org/work/SchWB2-412>
    a frbr:Work, mo:MusicalWork ;
    dcterms:title "Cantate zur Erinnerung des hohen Vermählungsfestes beyder regierenden königl. Majest. zu Dännemark"@de ;
    dcterms:identifier "SchW B2:412" ;
    cnw:cnwNumber "B2:412" ;
    cnw:catalogueCode "SchW" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    cnw:textAuthor <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    dcterms:created "1742" ;
    dcterms:language "Danish" ;
    dcterms:language "German" ;
    dcterms:language "English" ;
    dcterms:language "Italian" ;
    dcterms:subject "Cantata" ;
    dcterms:subject "Music for vocal soloists and instruments with or without choir" ;
    dcterms:subject "Vocal music" ;
    dcterms:subject "Secular" ;
    dcterms:subject "Occasional" ;
    cnw:editorialNote "'E. M. werden bald Ursache haben, mich für einen Lügner zu halten, weil ich auch diese Messe nichts von meinem Critischen Musicus übersende, allein ich kann versichern, daß ich seither, sonderlich aber vorigen Sommer, soviel Instrumentsachen zu componieren gehabt habe, daß ich mir auch nicht das geringste Vergnügen habe machen können.'" ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-412/expression/1> ;
    cnw:performanceCount 0 .

<https://cnw-ld.org/work/SchWB2-412/expression/1>
    a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-412> ;
    cnw:incipitText "So Freunde ist es recht!"@de ;
    cnw:incipitText "O! welch ein froh Geschicke!"@de ;
    cnw:incipitText "Doch nicht allein das Land kann dieses Fest erfreun"@de ;
    cnw:incipitText "Die zärtlichen Triebe"@de ;
    cnw:incipitText "O grosser Christian!"@de ;
    cnw:incipitText "Ja, Himmel!"@de ;
    cnw:incipitText "Wiederholtes Fest der Liebe"@en ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

