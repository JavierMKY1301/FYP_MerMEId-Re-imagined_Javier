    cnw:incipitText "Herrens Engel aabenbaredes for Joseph"@da ;
    cnw:incipitText "Des Herren Engel offenbarte sich vor Joseph"@de ;
    cnw:incipitText "Men da Jesus var født i Bethlehem"@da ;
    cnw:incipitText "Da nun Jesus geboren in Bethlehem"@de ;
    cnw:incipitText "Hvor er den Jødernes Konge"@da ;
    cnw:incipitText "Wo ist der König der Juden"@de ;
    cnw:incipitText "Men der Kong Herodes det hørte"@da ;
    cnw:incipitText "Doch da nun Herodes das hörte"@de ;
    cnw:incipitText "I Bethlehem, i Judæa"@da ;
    cnw:incipitText "In Bethlehem, in Judäa"@de ;
    cnw:incipitText "Da kaldte Herodes de Vise hemmelig"@da ;
    cnw:incipitText "Herodes berief nun die Weisen heimlich"@de ;
    cnw:incipitText "Gaar hen, gaar hen og udspørger flittelig om Barnet"@da ;
    cnw:incipitText "Zieh't hin, zieh't hin und forschet dort fleissig nach dem Kindlein"@de ;
    cnw:incipitText "Og se! se! Stjernen, som de havde set i Øster"@da ;
    cnw:incipitText "Und siehe! siehe, der Stern, denn sie sahen im Osten"@de ;
    cnw:incipitImage "hartw_184_01.png" ;
