    cnw:incipitText "Og jeg og dig, du mi' Solskinslue!"@nb ;
    cnw:incipitText "Kom Sjæl, og tag dit Regnebræt"@nb ;
    cnw:incipitText "Kjender du Solen i Siljedal"@nb ;
    cnw:incipitText "Der lusker en Ulv bagom Gaard"@nb ;
    cnw:incipitText "\"Jeg er lystig og glad!\" sang Gutten"@nb ;
    cnw:incipitText "Du leker saa lystig, du gule Blad"@nb ;
    cnw:incipitText "Kraaken fløj op"@nb ;
    cnw:incipitText "Og vesle Jon gik bagom, og store Jon gik frem"@nb ;
    cnw:incipitText "Der er saa godt at bygge i højen Himmelbo!"@nb ;
