    cnw:incipitText "O Skræk hvad seer jeg her?"@da ;
    cnw:incipitText "Ach! bange Hierte"@da ;
    cnw:incipitText "Ægyptisk Mørke skiulte Norden"@da ;
    cnw:incipitText "Vor Hoveds Krone er affalden"@da ;
    cnw:incipitText "Som Egens tætte Skygge"@da ;
    cnw:incipitText "Som Klippen staaer"@da ;
    cnw:incipitText "Da Vesterhavet brusede med Torden"@da ;
    cnw:incipitText "See du, som Slaget ikke rører"@da ;
    cnw:incipitText "Kan Viisdom selv ey holde Taarerne tilbage"@da ;
    cnw:incipitText "Græder Nordens Nationer"@da ;
    cnw:incipitText "O matte Skræk! – vi gyse – Tungen stræber"@da ;
    cnw:incipitText "Vor Harpe er bleven til Sorrig"@da ;
    cnw:incipitText "Hold Taare op at trille"@da ;
    cnw:incipitText "Derfor var vort Hierte svagt"@da ;
    cnw:incipitText "Lad det forgrædte Øye"@da ;
    cnw:incipitText "Vi seer vor Frederik ey mere"@da ;
    cnw:incipitText "De skal udbrede din store Godheds Ihukommelse"@da ;
    cnw:incipitText "Viis, Naadig og Retfærdig"@da ;
    cnw:incipitText "Hyyl hyyl Fyr, thi Eeder er falden"@da ;
    cnw:incipitText "Farvel vor døde Glæde"@da ;
    cnw:incipitText "En Retfærdig skal være til en evig Ihukommelse"@da ;
    cnw:incipitText "Hold Taare op at trille"@da ;
    cnw:incipitImage "SchM_008_1_1.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

