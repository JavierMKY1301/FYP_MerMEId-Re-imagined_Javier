    cnw:incipitText "Der Herr wird zu uns kommen"@de ;
    cnw:incipitText "Wie wann des heissen Mittagsstrahl"@de ;
    cnw:incipitText "Betrübtes Israel, du bist verlassen"@de ;
    cnw:incipitText "Nein, nein, betrübte Herzen, nein"@de ;
    cnw:incipitText "Dunkler Abend, düstre Schatten"@de ;
    cnw:incipitText "Kein Regen kann so lieblich seyn"@de ;
    cnw:incipitText "Ligt schon der Leib im finstern Grabe"@de ;
