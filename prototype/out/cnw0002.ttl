    cnw:incipitText "Aa ja, aa ja, ja, ja"@da ;
    cnw:incipitText "Oh - ha, ay- ay, ay, - ay!"@en ;
    cnw:incipitText "[Først kommer fæl og fus Monsør Jeronimus]"@da ;
    cnw:incipitText "[First enter furious Monsieur Jeronimus]"@en ;
    cnw:incipitText "Er der nogen hjemme?"@da ;
    cnw:incipitText "Is that you, Leander?"@en ;
    cnw:incipitText "En Cinquepas, en Galliard"@da ;
    cnw:incipitText "A cinquepas, a galliard"@en ;
    cnw:incipitText "Kan I være rolige!"@da ;
    cnw:incipitText "Will you please be quite there?"@en ;
    cnw:incipitText "Det Satans Spind!"@da ;
    cnw:incipitText "That place of sin!"@en ;
    cnw:incipitText "[Fordum var her Fred paa Gaden]"@da ;
    cnw:incipitText "[Time was when our street was silent]"@en ;
    cnw:incipitText "Hr. Leonard, Herrens tilkommende Svoger"@da ;
    cnw:incipitText "Herr Leonard, your cousin-in-law-to-be, sir!"@en ;
    cnw:incipitText "Monsieur Jeronimus!"@da ;
    cnw:incipitText "Monsieur Jeronimus!"@en ;
    cnw:incipitText "Her er jeg, Husbond!"@da ;
    cnw:incipitText "I'm coming, master!"@en ;
    cnw:incipitText "Kom ind! Kom ud!"@da ;
    cnw:incipitText "Come in! Come out!"@da ;
    cnw:incipitText "Hihi, hihi, hihi, hihi, det blir et farligt Skænderi"@en ;
    cnw:incipitText "Hehe, hehe, hehe, hehe! Here comes assault and Battery!"@da ;
    cnw:incipitText "Hov! Vægter. Klokken er slagen otte"@da ;
    cnw:incipitText "Ho! Watchman! Eight o'the clock, good people!"@en ;
    cnw:incipitText "Hum! Nu jeg skal te'et er jeg dog ikke rigtig dristig ve'et"@da ;
    cnw:incipitText "I don't like to say it, but I'm a coward and my knees betray it"@en ;
    cnw:incipitText "Mellem Kande, Krus og Potte"@da ;
    cnw:incipitText "In among the pots and dishes"@en ;
    cnw:incipitText "Af Sted! Af Sted Nu er det Sværmetid"@da ;
    cnw:incipitText "Com on! Come on! Let's go and join the fun!"@en ;
    cnw:incipitText "Gibt Platz! Gibt Platz! Nu tag, du Borgermand dit Kvindfolk i Agt"@da ;
    cnw:incipitText "Make way! make way! Now, worthy citizens, lock up your women folk"@en ;
    cnw:incipitText "Let paa Taa og Hus forbi"@da ;
    cnw:incipitText "Fleet of foot and fancy free!"@en ;
    cnw:incipitText "Der gad jeg nok være med"@da ;
    cnw:incipitText "I wouldn't mind being there"@en ;
    cnw:incipitText "Herre! Herre! Kom kun frem"@da ;
    cnw:incipitText "Master! Master! Come on out!"@en ;
    cnw:incipitText "Se, Henrik! se, hvor Nat og Mørke knuger den gamle Gaard"@da ;
    cnw:incipitText "See, Henrik, how the darkness creeps and fluters round this old house"@en ;
    cnw:incipitText "Min Herre se som Venus steg af Havet"@da ;
    cnw:incipitText "Why, master, look! Like Venus from the water, ascending"@en ;
    cnw:incipitText "Naar Hjertet brænder, hvad Lykken sender"@da ;
    cnw:incipitText "An ardent lover, when fortune beckons"@en ;
    cnw:incipitText "Min Herre. Min Pigeære"@da ;
    cnw:incipitText "Good master! My maiden honour"@en ;
    cnw:incipitText "Hør et Ord Kavaler, nu rask! Kom her!"@da ;
    cnw:incipitText "Listen here, cavalier! Look sharp! Come here!"@en ;
    cnw:incipitText "Luk op! Luk op!"@da ;
    cnw:incipitText "Open up! open up!"@en ;
    cnw:incipitText "Min Herre De maa maske Dem"@da ;
    cnw:incipitText "You have to wear a mask, you know"@en ;
    cnw:incipitText "Porten er aaben! Borte er Hoben"@da ;
    cnw:incipitText "Good it was open, no sign of people"@en ;
    cnw:incipitText "Se saa! Se saa! Nu er jeg bered"@da ;
    cnw:incipitText "This way! This way! I'm ready for the fray!"@en ;
    cnw:incipitText "Columbiner, Harlekiner"@da ;
    cnw:incipitText "Columbines, Harlequins, sir"@en ;
    cnw:incipitText "Hov! Vægter, Klokken er slagen ni!"@da ;
    cnw:incipitText "Ho, watchman! Nine o'clock sounds, good folk!"@en ;
    cnw:incipitText "Gaa af Vejen! Gaa af Vejen!"@da ;
    cnw:incipitText "Clear the way there! Clear the way there!"@en ;
    cnw:incipitText "Studenter! Studenter! /Pomeranser! Pomeranser!"@da ;
    cnw:incipitText "You students, you students / Buy my oranges!"@en ;
    cnw:incipitText "Lad vær' at knibe mig, Jeg skriger"@da ;
    cnw:incipitText "Let go of me, or I'll start yelling!"@en ;
    cnw:incipitText "At slig er Ungersvend i sin Tale"@da ;
    cnw:incipitText "To catch an eel with bare hands"@en ;
    cnw:incipitText "Ulignelige Pige"@da ;
    cnw:incipitText "Incomparable lady"@en ;
    cnw:incipitText "Min søde balsambøsse"@da ;
    cnw:incipitText "You pretty little mistress"@en ;
    cnw:incipitText "Ydmygste Tjener, Madam! og Tak for Dansen!"@da ;
    cnw:incipitText "Your humble servant, madame! I praise your dancing!"@en ;
    cnw:incipitText "Aa, med Forlov, De!"@da ;
    cnw:incipitText "Out of my way, you!"@en ;
    cnw:incipitText "Oh, kom min Ven!"@da ;
    cnw:incipitText "Oh, come my pride!"@en ;
    cnw:incipitText "Hvis ej Jer Mine lyver slemt"@da ;
    cnw:incipitText "If looks are any guarantee"@en ;
    cnw:incipitText "Dit Snakketøj gaar ej i Staa"@da ;
    cnw:incipitText "I thought you'd never stop, my lad"@en ;
    cnw:incipitText "Gør Plads! Gør Plads!"@da ;
    cnw:incipitText "Make room! Make room!"@en ;
    cnw:incipitText "Naar Mars og Venus har endt deres Spil"@da ;
    cnw:incipitText "When Mars and Venus had finished their game"@en ;
    cnw:incipitText "Og dette skal være vor Border til Ære"@da ;
    cnw:incipitText "A toast for our brother, our colleague and brother"@en ;
    cnw:incipitText "Tramtrara! Tramtrara!"@da ;
    cnw:incipitText "Tramtrara! Tramtrara!"@en ;
    cnw:incipitText "Kehraus! Kehraus! Dans ud! Dans ud! Dans ud!"@da ;
    cnw:incipitText "Dance on, dance on! Dance on, dance on, dance on!"@en ;
    cnw:incipitImage "cnw_002_1_1.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

