    cnw:incipitText "Landesvater! lebe lange"@en ;
    cnw:incipitText "An diesen erhabenen göttlichen Feste"@de ;
    cnw:incipitText "Stark, wie der Strahl der heitern Sonne"@de ;
    cnw:incipitText "Wie? streitet man an diesem Tage"@de ;
    cnw:incipitText "Brauset, ihr Wellen! schäumt stürmend ihr Wogen!"@de ;
    cnw:incipitText "Laßt uns, indem sie streiten, singen"@de ;
    cnw:incipitText "Wir preisen den König"@de ;
    cnw:incipitText "So recht! ich mische mich in eure Töne"@de ;
    cnw:incipitText "Ja! preiset den König: singet tönende Lieder!"@de ;
    cnw:incipitText "O König! der Festtag komme seegnend zurücke!"@de ;
    cnw:incipitText "Ja, ja! man singe nur"@de ;
    cnw:incipitText "Wir preisen den König. Friderich! Vater der Meere"@de ;
    cnw:incipitText "O! die Vereinigung zum Lobe meines Königs"@de ;
    cnw:incipitText "Königinn! Dieses holden Festes Prangen"@de ;
    cnw:incipitText "Ein König, der wie du, erhabner Fridrich!"@de ;
    cnw:incipitText "Wachse, Prinz! zum Heil des Länder!"@de ;
    cnw:incipitText "Auf! Ihr Glückseeligkeiten!"@de ;
    cnw:incipitText "Unschätzbare Stunden! kehrt öfters zurücke"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

