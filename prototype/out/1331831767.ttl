    cnw:incipitText "O hvor godt at sidde her i den muntre Klynge!"@da ;
    cnw:incipitText "Nu er det svalt, nu synker Dæmring over Lunden"@da ;
    cnw:incipitText "Konning Volmer drager afsted paa Jagt"@da ;
    cnw:incipitText "Ved Kveld, ved Nat, i Skov, i Krat Jægerne fare"@da ;
    cnw:incipitText "Anna! Balthasar! Kan I høre vor Stemme?"@da ;
    cnw:incipitText "Anna! Balthasar! Kan I høre vor Stemme?"@da ;
    cnw:incipitText "Ha! hvor skal vi nu dem søge?"@da ;
    cnw:incipitText "Hvad nu! det klinger jo, som om Naturen sukked?"@da ;
    cnw:incipitText "Ha! hvilken Stræng zitred i Luften?"@da ;
    cnw:incipitText "Trolddommen dybt begravet hviler paa Søens Bund"@da ;
    cnw:incipitText "tys! tys! Vi kan høre Menneskers Fjed!"@da ;
    cnw:incipitText "Snart er Natten svunden, Dagen bryder frem"@da ;
    cnw:incipitText "Herfrem i Taager som af Jord og Sø! - Ha! hvordan finder jeg Vei gjennem Taagen?"@da ;
    cnw:incipitText "Lad os nøie følge Manden"@da ;
    cnw:incipitText "Til Frederiksborg! Til Frederiksborg!"@da ;
    cnw:incipitText "Hør nu begynder alt mit muntre Spil - O hvor godt at sidde her i den muntre Klynge"@da ;
    cnw:incipitText "Ja render kun I Narre!"@da ;
    cnw:incipitText "Syvsoverdagen i Sol gaaer netop ned i dette Nu!"@da ;
    cnw:incipitText "Nu er det svalt, nu synker Dæmring over Lunden"@da ;
    cnw:incipitText "Kong Volmer drager af sted paa Jagt"@da ;
    cnw:incipitText "Ved Kveld, ved Nat, i Skov i Krat Jægerne fare"@da ;
    cnw:incipitText "Anna! Balthasar! kan I høre vore Stemmer?"@da ;
    cnw:incipitText "For Jer er ingen Virkelighed her"@da ;
    cnw:incipitText "Anna! Balthasar! Kan I vort Raab fornemme?"@da ;
    cnw:incipitText "Tys! tys! Det er Kong Valdemars vilde Jagt!"@da ;
    cnw:incipitText "Hvad nu! Det klinger jo, som om Naturen sukked?"@da ;
    cnw:incipitText "Ha! hvilken Stræng sitred i Luften!"@da ;
    cnw:incipitText "Trolddommen dybt begravet hviler paa Søens Bund"@da ;
    cnw:incipitText "Snart er Natten svunden, Dagen bryder frem"@da ;
    cnw:incipitText "Her frem, I Taager, frem af Jord og Sø og lette Sommerskyer"@da ;
    cnw:incipitText "Nu lufter Skoven sin lysegrønne Pragt"@da ;
    cnw:incipitImage "hartw_014_1840_0_00.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

