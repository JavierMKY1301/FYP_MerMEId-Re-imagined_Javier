    cnw:incipitText "Hear, O my flock Israel!"@en ;
    cnw:incipitText "Höre, mein Volk, Israel"@de ;
    cnw:incipitText "Hør, du mit Folk Israel!"@da ;
    cnw:incipitText "The Lord hath in Egypt, in the field of Zoan"@en ;
    cnw:incipitText "Im Lande Egypten, auf der Ebene Zoan"@de ;
    cnw:incipitText "I Pharaos Lande og paa Sletten ved Zoan"@da ;
    cnw:incipitText "But then His flock forsook the commandments of God"@en ;
    cnw:incipitText "Allein das Volk wich ab vom Gesetze des Herrn"@de ;
    cnw:incipitText "Men Herrens Folk veg bort fra hans Veje"@da ;
    cnw:incipitText "Yet merciful and tender is the Lord"@en ;
    cnw:incipitText "Doch gnädig und barmherzig ist der Herr"@de ;
    cnw:incipitText "Dog Herren er barmhjertig og naadig"@da ;
    cnw:incipitText "Bethlehem Ephrata!"@en ;
    cnw:incipitText "Bethlehem Ephrata!"@de ;
    cnw:incipitText "Bethlehem evindelig hans Herredom"@da ;
