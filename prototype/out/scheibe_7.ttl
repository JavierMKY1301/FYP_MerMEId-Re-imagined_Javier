    cnw:incipitText "Vor Harpe er bleven til Sorrig"@da ;
    cnw:incipitText "I Kedrons stille Dale"@da ;
    cnw:incipitText "Guds Vredes Straaler brænder over Horeb"@da ;
    cnw:incipitText "Græde I, som boe paa Jorden!"@da ;
    cnw:incipitText "Jeg seer Ham. – Gud! – og denne er min Skaber!"@da ;
    cnw:incipitText "Hvo kan bestaae for en almægtig Vrede"@da ;
    cnw:incipitText "Forhænget revner, og en hellig Flamme igiennemtrænger det rædsomme Mørke"@da ;
    cnw:incipitText "O stille Skræk! – Guds Rædsel! – Hiertet standser"@da ;
    cnw:incipitText "De skal udbrede din store Godheds Ihukommelse"@da ;
    cnw:incipitText "Han fandtes ene værdig, at agtes for retfærdig"@da ;
    cnw:incipitText "Jeg saae: og Mørkets grumme Kiæmpe igiennemløb et forvirret Øye"@da ;
    cnw:incipitText "Slaae Cithar, slaae i sagte Toner"@da ;
    cnw:incipitText "Langt under Chaos er de mørke Huuler"@da ;
    cnw:incipitText "O Graad, du Glædens tause Tolk"@da ;
    cnw:incipitText "Men Himlen taug, – Seraphen selv holdt inde"@da ;
    cnw:incipitText "Lad Himlene fornemme"@da ;
    cnw:incipitText "Stor var Han – fød af Evigheders Fader"@da ;
    cnw:incipitText "Naar Himle flye din Røst, naar Verdner skiule sig"@da ;
    cnw:incipitText "Bliv Taare ved at trille"@da ;
    cnw:incipitText "Triumpf? Men, ak! den dyrekiøbes"@da ;
    cnw:incipitImage "SchM_007_1_1.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

