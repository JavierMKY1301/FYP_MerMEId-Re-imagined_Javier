    cnw:incipitText "Forundring! Skræk! Forundring!"@da ;
    cnw:incipitText "Hævn Fader! Fader, Gud, Gud, din Søn!"@da ;
    cnw:incipitText "O Salighed! at have Jesum fundet"@da ;
    cnw:incipitText "O Afmagts Røst, jeg af min Jesu Mund maae høre!"@da ;
    cnw:incipitText "O Jesu! Jesu da du saa har elsket mig"@da ;
    cnw:incipitText "O Syn! det Jesu Kors at see!"@da ;
    cnw:incipitText "Ak vee mig! Gud! den haarde Lykke!"@da ;
    cnw:incipitText "Ja Jesu! engang Verdens Dommere!"@da ;
    cnw:incipitText "Gud styrk mig!"@da ;
    cnw:incipitText "O! hvilke Almagts Under! rundt om her udtordne"@da ;
    cnw:incipitText "Forfærdelse! hvad skeer mig?"@da ;
    cnw:incipitText "I Himlens Børn! og nu er jeg forløst, i Brødre!"@da ;
    cnw:incipitText "Halleluja høylovet være Gud!"@da ;
    cnw:incipitText "Ja, dobbelt Raserie sin Salighed forspilde"@da ;
    cnw:incipitText "Flye Verden, flye! jeg min Jesum følge vil"@da ;
    cnw:incipitText "O min Jesu! gid jeg kunde"@da ;
    cnw:incipitText "Triumph! Triumph! Triumph! den Juda Løve vandt"@da ;
    cnw:incipitImage "SchM_065_1_1.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

