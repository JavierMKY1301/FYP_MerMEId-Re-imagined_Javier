    cnw:incipitText "Und ist Tigranes tod, so lieb ich seinen Schatten"@de ;
    cnw:incipitText "Verwirfst du noch mein zärtlich Flehen?"@de ;
    cnw:incipitText "Ja, ist dein Wunsch getreu, so kan er noch geschehn"@de ;
    cnw:incipitText "Sieg und Ruhm und Lust und Glücke"@de ;
    cnw:incipitText "So ist der stoltze Feind gedämpft"@de ;
    cnw:incipitText "Die Unschuld erhebet ein redliches Herze"@de ;
    cnw:incipitText "Der arme Stolz soll bald vergehn"@de ;
    cnw:incipitText "Mit donnerndem Eifer, mit rasenden Waffen"@de ;
    cnw:incipitText "Ja, König, ja, dein unerschrockner Muth"@de ;
    cnw:incipitText "Wir sehen mit Wollust und Freuden dem Seegen"@de ;
    cnw:incipitText "Was hilfts, von einem Helden"@de ;
    cnw:incipitText "Prinz, sage selbst, geht nicht die wilde Grausamkeit"@de ;
    cnw:incipitText "Der König ist ein armer Sclave"@de ;
    cnw:incipitText "Kein Wunder, daß der Prinz nichts zu dem allen spricht"@de ;
    cnw:incipitText "Da wir der Tugend Schutz geniessen"@de ;
    cnw:incipitText "Wie viele Regungen verwirren meinen Sinn"@de ;
    cnw:incipitText "Laß nur die Hoffnung nicht verschwinden"@de ;
    cnw:incipitText "Tortora che il suo bene"@it ;
    cnw:incipitText "Wenn die Turteltabe ihren Gatten"@de ;
    cnw:incipitText "Ich mache mich bereit"@de ;
    cnw:incipitText "Arbaces, ja, ich kenne deine Treu"@de ;
    cnw:incipitText "Trotz und Verwegenheit"@de ;
    cnw:incipitText "Was fass ich doch für einen Schluß?"@de ;
    cnw:incipitText "O Printz! wie muß mein Herze sich"@de ;
    cnw:incipitText "La sua virtù m' accesse"@it ;
    cnw:incipitText "Seine Tugend hat meine Seele"@de ;
    cnw:incipitText "Hoffnung, Seufzer, Wünsche, Thränen"@de ;
    cnw:incipitText "Ja seyd getrost, und hoffet nur"@de ;
    cnw:incipitText "Des Pöbels Ruhm, die Kunst zu lügen"@de ;
    cnw:incipitText "Wohlan, so wollen wir mit zärtlichem Vertrauen"@de ;
    cnw:incipitText "Wir küssen deine milden Hände"@de ;
    cnw:incipitText "So siehst du doch, wie das Geschicke"@de ;
    cnw:incipitText "Noch, Freunde, weiß ich keinen Raht"@de ;
    cnw:incipitText "O! mögt ich doch mein ander Leben sehen"@de ;
    cnw:incipitText "O! König, laß dich doch durch keine freche List"@de ;
    cnw:incipitText "Furibonda a te d' inante"@it ;
    cnw:incipitText "Der Schatten deines Sohnes irret"@de ;
    cnw:incipitText "Dein billigs Wünschen soll geschehn"@de ;
    cnw:incipitText "Die Triebe der gerechten Treu"@de ;
    cnw:incipitText "Verdammter Bösewicht!"@de ;
    cnw:incipitText "Geh hin zu Artaban"@de ;
    cnw:incipitText "Arbaces sey vergnügt, dein zärtliches Verlangen"@de ;
    cnw:incipitText "Wir danken mit gerührtem Herzen"@de ;
    cnw:incipitText "So bald ich dich gesehn, hat mich dein edler Blick"@de ;
    cnw:incipitText "Ich kenne kein gemeines Lieben"@de ;
    cnw:incipitText "Prinz, Held und Freund, wie könnt ich die und deiner Liebe wiederstehn?"@de ;
    cnw:incipitText "Er will von unsrer Lust ein froher Zeuge seyn"@de ;
    cnw:incipitText "Mich macht mein redliches Gewissen"@de ;
    cnw:incipitText "Ich habe dich bisher"@de ;
    cnw:incipitText "È del reo grande il fallo"@it ;
    cnw:incipitText "Das Verbrechen des Beklagten ist groß"@de ;
    cnw:incipitText "Verschone mich"@de ;
    cnw:incipitText "Verräther, kanst du noch vor meinem Angesichte stehn?"@de ;
    cnw:incipitText "Kein Donner kan mein Herze rühren"@de ;
    cnw:incipitText "Dein freches Reden macht dich doppelt sirafens werth"@de ;
    cnw:incipitText "So muß man den Frevel belohnen"@de ;
    cnw:incipitText "Wie martert sich mein unentschloßner Sinn?"@de ;
    cnw:incipitText "Meinen Willen zu erfüllen"@de ;
    cnw:incipitText "Ich will nicht in den Tempel gehn"@de ;
    cnw:incipitText "Wenn man die Bösen straft"@de ;
    cnw:incipitText "Mandane lebe wohl"@de ;
    cnw:incipitText "Wofern ich dich beleidigt habe"@de ;
    cnw:incipitText "Ist dieß Barsine dann"@de ;
    cnw:incipitText "La tua innocenza ò Caro"@it ;
    cnw:incipitText "Deine Unschuld, o Geliebter"@de ;
    cnw:incipitText "Geliebter Prinz, nun müßen wir einander Abschied geben"@de ;
    cnw:incipitText "So stirbest du?"@de ;
    cnw:incipitText "Es sterbe der Tyrann!"@de ;
    cnw:incipitText "Hier, König, ist der Arm, hier ist das blutge Schwerdt"@de ;
    cnw:incipitText "Hier ist der Arm, der dich allein befreyt"@de ;
    cnw:incipitText "Es lebe König Artaban"@de ;
    cnw:incipitText "Last uns die holde Ruhe preisen"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

