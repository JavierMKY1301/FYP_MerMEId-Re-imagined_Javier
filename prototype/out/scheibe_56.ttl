    cnw:incipitText "Magnificat, anima mea Dominum"@la ;
    cnw:incipitText "Exultavit spiritui mei"@la ;
    cnw:incipitText "Quia respexit"@la ;
    cnw:incipitText "Quia fecit"@la ;
    cnw:incipitText "Et misericordia"@la ;
    cnw:incipitText "Fecit potentiam"@la ;
    cnw:incipitText "De posuit potentes de sede"@la ;
    cnw:incipitText "Esurientes implevit bonis"@la ;
    cnw:incipitText "Suscepit Israel"@la ;
    cnw:incipitText "Sicut locutus est ad patres"@la ;
    cnw:incipitText "Gloria"@la ;
    cnw:incipitText "Sicut erat in principis"@la ;
