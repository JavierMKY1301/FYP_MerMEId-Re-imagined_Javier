    cnw:incipitText "Odins Øje, véd jeg, dølges dybt"@da ;
    cnw:incipitText "Først af Drab i Verden"@da ;
    cnw:incipitText "Da gik alle Magter til de høje Stole"@da ;
    cnw:incipitText "Valens Møer saae jeg, viden fra de steved"@da ;
    cnw:incipitText "Saa den Stærke kommer, han, som alting styrer"@da ;
