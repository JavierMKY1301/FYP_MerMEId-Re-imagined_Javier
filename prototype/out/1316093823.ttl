    cnw:incipitText "En Konges Haand har det plantet, Kundskabs Træ i vor Jord"@da ;
    cnw:incipitText "Sekler svandt"@da ;
    cnw:incipitText "Og priset være hans Herskerslægt"@da ;
    cnw:incipitText "Er paa Jord vi som de Svage vegne Fod for Fod"@da ;
    cnw:incipitText "Og som i Natten ved Sanct Hans"@da ;
    cnw:incipitText "Tog Kronen, Konge, Du i tunge Tider"@da ;
    cnw:incipitText "Tynger end Kronen, den vorde Dig let"@da ;
    cnw:incipitText "Tider der var, da et Kæmpekuld drog fra vort Hjem"@da ;
    cnw:incipitText "De Dage svandt, for aldrig op at staa"@da ;
    cnw:incipitText "Dog, har til Maal Du sat Dig, Drot"@da ;
    cnw:incipitText "Bær da Spiret, Konge, som Du plejer"@da ;
