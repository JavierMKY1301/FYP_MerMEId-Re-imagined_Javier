    cnw:incipitText "Hedt bølger Sandet, guult som Flammer"@da ;
    cnw:incipitText "Heiss wogt das Sandmeer, gelb wie Flammen"@de ;
    cnw:incipitText "Snart vort Øie skuer Maalet"@da ;
    cnw:incipitText "Bald zum Ziel wird Gott uns tragen"@de ;
    cnw:incipitText "Straal, høie Sol, straal paa mit Sværd med Lyst!"@da ;
    cnw:incipitText "Strahl' hehre Sonn' strahl auf mein Schwert mit Lust!"@de ;
    cnw:incipitText "Herre, fra det Fjerne drog din Skare hid"@da ;
    cnw:incipitText "Vater, aus der Ferne zog dein Heer herbei"@de ;
    cnw:incipitText "Nu snoer Natten sig mørk om den dødstille Ørk"@da ;
    cnw:incipitText "Schleichend listig und sacht kommt das Dunkel der Nacht"@de ;
    cnw:incipitText "De slumre trygt i Nattens svale Fred!"@da ;
    cnw:incipitText "Sie schlafen sanft in friedlich kühler Nacht!"@de ;
    cnw:incipitText "Jeg dukker mit Bryst, jeg dukker min Kind"@da ;
    cnw:incipitText "Ich tauch' meine Brust, die Wange so lind"@de ;
    cnw:incipitText "Vaagn, Rinaldo, vaagn af din Slummer!"@en ;
    cnw:incipitText "O, Rinaldo, auf, Rinaldo, auf, erwache!"@de ;
    cnw:incipitText "Alt breder sig den lyse Sky"@da ;
    cnw:incipitText "Im Ost die Sonne nahet schon"@de ;
    cnw:incipitText "Med hellig Hu, til Maalet nu!"@da ;
    cnw:incipitText "Mit heilgem Sinn zum Heilgen Ziel!"@de ;
    cnw:incipitText "Fremad, fremad frem nu min mødige Fod"@da ;
    cnw:incipitText "Weiter, weiter! weiter mein müder Fuss"@de ;
    cnw:incipitText "Løft høit dit Hoved, Korsmand, stands!"@da ;
    cnw:incipitText "Dein Haupt erhebe, Kreuzmann, steh!"@de ;
    cnw:incipitImage "NWGW_172_01.png" ;
