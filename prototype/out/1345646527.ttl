    cnw:incipitText "Et skjønne Syn at skue! den grønne Strand"@da ;
    cnw:incipitText "Jeg er saa træt af Reisen"@da ;
    cnw:incipitText "Hvad har vor Dronning at befale?"@da ;
    cnw:incipitText "Hvad skjønne Toner i Skovens Kroner har Hornet vakt!"@da ;
    cnw:incipitText "Ædle Sultan! dine Dage straale solklart for vort Liv"@da ;
    cnw:incipitText "Jeg maner ham til Stranden ud!"@da ;
    cnw:incipitText "Jeg aabner Laaget med min Foldekniv"@da ;
    cnw:incipitText "Store Muhamed! Store Muhamed!"@da ;
    cnw:incipitText "Her har jeg den!"@da ;
    cnw:incipitText "Barmen os baner Veien gjennem Vover"@da ;
    cnw:incipitText "Vor Sultan Held! og Held hans Folk!"@da ;
    cnw:incipitImage "hartw_013_01.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

