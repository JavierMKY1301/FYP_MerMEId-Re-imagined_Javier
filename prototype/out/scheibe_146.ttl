<https://cnw-ld.org/work/SchWB2-305>
    a frbr:Work, mo:MusicalWork ;
    dcterms:title "Gudelige Tanker over vor Frelseres Lidelse og Død. Et Passions-Oratorium"@da ;
    dcterms:identifier "SchW B2:305" ;
    cnw:cnwNumber "B2:305" ;
    cnw:catalogueCode "SchW" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    cnw:textAuthor <https://cnw-ld.org/agent/gerhard_treschow> ;
