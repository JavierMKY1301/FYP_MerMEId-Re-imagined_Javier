    cnw:incipitText "Dette er skeet af HErren"@da ;
    cnw:incipitText "Saa gaaer min JEsus da, da med Lovsang og med Glæde"@da ;
    cnw:incipitText "Jeg derfor vil forsøge paa"@da ;
    cnw:incipitText "Da kom JEsus med dem til den Have"@da ;
    cnw:incipitText "Søde JEsu! Du begynder"@da ;
    cnw:incipitText "Min JEsus føres fængslet hen til Annam"@da ;
    cnw:incipitText "Jeg, o JEsu! mægtig styrkes"@da ;
    cnw:incipitText "At ingen Ret skal gaaes forbi"@da ;
    cnw:incipitText "JEsu! Du min Konge bliver"@da ;
    cnw:incipitText "Saasnart er Dommen ey sagt af"@da ;
    cnw:incipitText "Der er i JEsu Kors langt større Trøst og Glæde"@da ;
    cnw:incipitText "Ach! JEsus døer!"@da ;
    cnw:incipitText "Saa skal da JEsu Død"@da ;
    cnw:incipitText "Ingen haver større Kierlighed"@da ;
    cnw:incipitText "Ach! Ach! hvad hører jeg?"@da ;
    cnw:incipitText "Jeg vil gierne underskrive"@da ;
    cnw:incipitText "I ere dyrekiøbte"@da ;
    cnw:incipitText "O! dyrekiøbte Siel"@da ;
    cnw:incipitText "Søde JEsu! du vel ikke vredes over"@da ;
    cnw:incipitText "Det neppe hedde kan at vi Dig lover"@da ;
    cnw:incipitText "Syng, min Siel! og lad dig høre"@da ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

