    cnw:incipitText "Ertönet dankerfüllte Lieder!"@de ;
    cnw:incipitText "Ja! danket, dankt!"@de ;
    cnw:incipitText "Des Höflings Schmeicheleyen"@de ;
    cnw:incipitText "Auf frommer Väter Wegen"@de ;
    cnw:incipitText "Er sehe des Krieges zernichtende Flammen"@de ;
    cnw:incipitText "Tochter des Himmels, unsterbliche Tugend, erscheine!"@de ;
