    cnw:incipitImage "hartw_150_1.png" ;
    cnw:incipitText "Ak! Sommeren tidt er saa sludfuld og raa"@da,
        "Den Fryd som nys paa hver en Læbe smilte"@da,
        "Men Mørket [Solen] kæmpede mod Mulmet"@da,
        "Og Naturen smilte til sin Ven"@da,
        "Saa dunkel var den danske Sommerhimmel"@da,
        "Som Mørke ruged' over Skov og Dal"@da,
        "Venlige Lund! Din kjölende Skygge Glæden et Paulun opbygge"@da ;
    cnw:meter "3/4" ;
    cnw:performingForce "A.",
