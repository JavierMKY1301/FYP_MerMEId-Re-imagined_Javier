<https://cnw-ld.org/work/SchWB5-Coll-006> a mo:MusicalWork,
        frbr:Work ;
    dcterms:created "1776" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    dcterms:identifier "SchW B5:Coll.006" ;
    dcterms:language "English",
        "German" ;
    dcterms:subject "Commiunity singing",
        "Song",
        "Vocal music" ;
    dcterms:title "Vollständiges Liederbuch der Freymäurer mit Melodieen"@de ;
    frbr:realization <https://cnw-ld.org/work/SchWB5-Coll-006/expression/1> ;
    cnw:catalogueCode "SchW" ;
    cnw:cnwNumber "B5:Coll.006" ;
    cnw:editorialNote " 'Er giebt in der Vorerinnerung Rechenschaft von seiner Arbeit, die ihm gelingen muste, da er bey seiner groβen Stärke in der Tonkunst, zugleich viel in den lichtern Dichtungsarten gearbeitet, wie denn in jene Sammlung sehr viele Lieder, beydes Text und Melodien ihm gehören. In eben der Vorerinnerung verspricht er die Fortsetzung der Sammlung, und nur seine sehr bald darauf erfolgter Tod, hat ihn an der Erfüllung dieses Versprechens gehindert'.",
        " 2. Weltliche, mit dem Clavier oder andern Instrumenten. a. Lieder: 'Vollständiges Liederbuch der Freymäurer, mit Melodien, in zwey Büchern, herausgegeben von einem alten Mitgliede der Loge Zorobabel. Kopenhagen und Leipzig 1776. 4to. 2 thl. 16 gl.'" ;
    cnw:performanceCount 0 ;
    cnw:textAuthor <https://cnw-ld.org/agent/anonymous>,
        <https://cnw-ld.org/agent/johann_elias_schlegel> .

