<https://cnw-ld.org/work/SchWB2-301/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-301> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "SchM_067_01.png" ;
    cnw:incipitText "Auf einem Hügel"@de,
        "Die frommen Töchter Zions gehn verwundernd"@de,
        "Dort seh ich aus den Thoren Jerusalems"@de,
        "Eilf auserwählte Jünger"@de,
        "Freundinnen Jesu! sagt, woher so oft in diesen Garten?"@de,
        "Gott fähret auf mit Jauchzen!"@de,
        "Gott! Du wirst seine Seele nicht in der Hölle lassen!"@de,
        "Ich folge dir verklärter Held!"@de,
        "Ihr Thore Gottes öffnet euch!"@de,
        "Judäa zittert! – seine Berge beben!"@de,
        "Mein Geist, voll Furcht und Freude, bebet"@de,
        "Mein Herr! mein Gott! mein Herr! mein Gott!"@de,
        "Sey gegrüßet, Fürst des Lebens!"@de,
        "Tod! wo ist dein Stachel?"@de,
        "Triumph! Triumph!"@de,
        "Triumph! Triumph! Der Fürst des Lebens sieget!"@de,
        "Triumph! Triumph! der Sohn des Höchsten sieget!"@de,
        "Vater deiner schwachen Kinder"@de,
        "Wer ist die Sionitinn, die vom Grabe so schüchtern"@de,
        "Willkommen, Heyland! freut euch, Väter!"@de ;
    cnw:key "B minor" ;
    cnw:meter "3/2" ;
    cnw:performingForce "B.",
        "C.1",
        "C.2",
        "C.2/A.",
        "T.",
        "T.1",
        "T.1, T.2",
        "T.2",
        "bc.",
        "clrno.",
        "cor.",
        "fl.",
        "ob.",
        "timp.",
        "va.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Grave ed affettuoso" .

