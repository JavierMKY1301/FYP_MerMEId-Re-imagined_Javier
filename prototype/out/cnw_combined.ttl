        "bc.",
        "clrno.",
        "cor.",
        "fl.",
        "ob.",
        "ob.a.",
        "princ.",
        "timp.",
        "va.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Adagio lamento" .

