<https://cnw-ld.org/work/SchWB2-426/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-426> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Ach den Herlighed og Glæde"@da,
        "Bedrøvelige Død"@da,
        "Dog at vort Haab herved ey gandske skulde falde hen"@da,
        "Du forkorted Dine Dage"@da,
        "Far vel, og hviil Dig da i Fred"@da,
        "Kongen skee Lykke!"@da,
        "Kongens Viisdom Gud formeere"@da,
        "Men ach! hvad kand det hielpe meer!"@da,
        "Vee os! Vee os! der i Fred overfaldt en Bitterhed"@da,
        "Vort Liv er her paa Jorden som en Skygge"@da,
        "Salige ere de Døde"@en ;
    cnw:performingForce "soloist" .

