    cnw:editorialNote "Coro DC: dal Segno §",
        "In the printed vocal score \"Allegro non troppo\".",
        "In the printed vocal score Andantino con moto.",
        "The autograph score has \"Allegro assai, passionato, con molto fuoco\"." ;
    cnw:manuscriptLocation "DK-Kk",
        "DK-Odense, H.C. Andersens Hus" ;
    cnw:opus "12" ;
