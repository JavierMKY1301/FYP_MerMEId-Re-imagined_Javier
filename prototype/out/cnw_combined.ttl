<https://cnw-ld.org/work/SchWB2-440/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-440> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "At giøre got imod enhver"@da,
        "Bliv ved at tale, viise Mund!"@da,
        "Den mildeste Konge, som findes paa Jorden"@da,
        "Der, hvor man baade seer og hører"@da,
        "Det skal til Nordens Ære blive"@da,
        "Du Landets Magt, min Støtte, kom"@da,
        "Du Landetsfader! Folkets Lyst!"@da,
        "Du Nordens Soel skal sildig dale"@da,
        "En sød, en tryg, en stille Roe"@da,
        "Er Du allene Rigets Støtte?"@da,
        "Et Riges Herlighed vedvarer"@da,
        "Her ere vi Helte, vi os strax tillave"@da,
        "Her skal mit Øye altid vaage"@da,
        "Ja billigen enhver sig fryder"@da,
        "Ja, ja, alt dette er vel værd at prise"@da,
        "Jeg er min Konges Vogtere"@da,
        "Jeg staaer som henrykt ved at see"@da,
        "Men hisset Mildhed staaer og bier"@da,
        "O Store Kongepar!"@da,
        "O! mægtige Beskyttere!"@da,
        "Tag nu, Velsignede Konge! Din Krone"@da,
        "Tag nu, velsignede Konge! Din Krone"@da,
        "Med uudsigelig Fornøyelse og Glæde"@en ;
    cnw:performingForce "voice" .

