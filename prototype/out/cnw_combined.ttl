    cnw:incipitImage "cnw_010_1.png" ;
    cnw:incipitText "Aa Herre, hvorfor ser I saadan paa mig?"@da,
        "Der sad to Fluer paa Aakandens Blad"@da,
        "Der stod en Engel hos mig med en Rose i sin Haand"@da,
        "Det er Lærkernes Tid"@da,
        "Dryp, dryp, dryp, dryp"@da,
        "Du her, Ulykkesfugl"@da,
        "Fru Kedsomhed satte sin Krone paa"@da,
        "Glenten styrter fra Fjeldets Kam"@da,
        "I Skoven vipper de Fugle smaa"@da,
        "Vi Sletternes Sønner har Drømme i Sind"@da ;
    cnw:meter "4/4" ;
    cnw:performingForce "A.",
        "S.",
        "cb.",
        "cl.",
        "cor.",
        "fg.",
        "fl.",
        "fl./fl.picc.",
        "ob.",
        "timp.",
        "tr.",
        "trb.",
        "va.",
        "vc.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Allegro non troppo" .

