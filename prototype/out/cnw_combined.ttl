<https://cnw-ld.org/work/SchWB7-001/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB7-001> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Ach ich habe schon erblicket"@de,
        "Das Denkmahl Deiner Huld und Güte"@de,
        "Dich hatte Glück, Geburt und Stand"@de,
        "Dir folgt, enselte Königinn"@de,
        "Doch es ist nicht so leicht"@de,
        "Du glänzest heller als die Sonne"@de,
        "Du trägst der Unschuld Perlenkleid"@de,
        "Ewig ist mein Geist genesen"@de,
        "Folgt nun auf wohl beschloßnen Kampf"@de,
        "Ganz Dännemark und Engeland"@de,
        "Gott weiß allein, wodurch auf Erden"@de,
        "Hinfort ist mir beygelegt die Krone der Gerechtigkeit"@de,
        "Ich habe Glauben gehalten"@de,
        "Ich habe den Lauf vollendet"@de,
        "Ich habe einen guten Kampfs gekämpfet"@de,
        "Ja wohl verklärte Königinn"@de,
        "Kein Leiden, keine Pein"@de,
        "Lebe Hoffnungs-volle Jugend"@de,
        "Louise! schlafe wohl und sanft in deinem Grabe"@de,
        "Mein Glaube hat mir manchen Sieg"@de,
        "Nun aber rühret unsre Brust"@de,
        "Nun bleibt, was sterblich war, zurücke"@de,
        "Nun ruhe sanft in Deiner Gruft"@de,
        "O wahre Lust!"@de,
        "O! welche nie empfundne Lust"@de,
        "Oeffne deines Glaubens Ohren"@de,
        "Selbst die Tugend krönte Dich"@de,
        "So auch jemand kämpfet"@de,
        "So singt Lovise jetzt"@de,
        "Wenn sich ein Geist besinnet"@de,
        "Wer an mich gläubet, der wird leben"@de,
        "Wie betrübt ist Friedrichs Geist!"@de,
        "Wiewohl ist mir der Kampf gelungen!"@de .

<https://cnw-ld.org/work/SchWC1-001> a mo:MusicalWork,
        frbr:Work ;
    dcterms:created "1754" ;
    dcterms:identifier "SchW C1:001" ;
    dcterms:language "English",
        "German" ;
    dcterms:subject "Music history",
        "Music theory, analysis and criticism",
        "Text" ;
    dcterms:title "Abhandlung vom Ursprunge und Alter der Musik"@de ;
