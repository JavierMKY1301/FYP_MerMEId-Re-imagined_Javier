<https://cnw-ld.org/work/SchWB2-045/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-045> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "SchM_179_001.png" ;
    cnw:incipitText "Ach Gott ich hab nach solcher Arth, gar lang mit großen Schaden"@de,
        "Ach ja, der Sünden lust, die stets das gute von sich stößet, die treibt noch immerfort zu alten lügen"@de,
        "Du thörichte Vernunft, die sich durch falsches Wissen blehet"@de,
        "Gehe hin, und sprich zu diesem Volcke"@de,
        "Ihr Hertze rennt im Heuchel-Schein zur Höllen-Pful hienein"@de,
        "Ist nun unser Evangelium verdeckt"@de,
        "Mit Blindheit ist die Welt geschlagen"@de,
        "So ofte Jesus großer Nahme bald Sünden tilgt, bald Zeichen thut"@de,
        "Stehe auf, und wandle"@de,
        "Wach auf! ô Mensch vom Sünden-Schlaf, ermuntre dich verlohrnes Schaaf"@de,
        "Zweifeln und Tadeln, verdrehen und schmähen"@de ;
    cnw:key "E minor" ;
    cnw:meter "4/4" ;
    cnw:performingForce "A.",
        "B.",
        "C.",
        "T.",
        "colascione",
        "ob.",
        "org.",
        "va.",
        "vc.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Vivace" .

