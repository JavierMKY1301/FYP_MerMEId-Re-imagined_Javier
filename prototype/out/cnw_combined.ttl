<https://cnw-ld.org/work/HartW16/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/HartW16> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "hartw_016_00.png" ;
    cnw:incipitText "Arme Fisker! hvorfor græder du?"@da,
        "Bort svinder den mørke Tordensky"@da,
        "Du stakkels Barn! hvor jeg beklager Dig"@da,
        "Ensom i min Hytte sad jeg"@da,
        "Hil Dig vor Hersker!"@da,
        "Hvert Fjed, vi gjennem Livet gaae"@da,
        "I dette Øje læser jeg kun Godt"@da,
        "Ja, ses I atter, rammer Døden dig!"@da,
        "Modtag, favre Herskerinde, Somrens friske Blomsterpryd!"@da,
        "Nu velan! men end engang hør din Skjæbnes Villie"@da,
        "Og vær mig, du Fiskerpige huld"@da,
        "Solen synker! gylden Glands spreder den paa Voven!"@da,
        "Undine kommer ikke! snart falder Mørket paa"@da,
        "Undine! Kom!"@da,
        "Undine! Undine! Daarende Mø!"@da ;
    cnw:meter "4/4" ;
    cnw:performingForce "A.",
        "Actor",
        "B.",
        "Kjølbrand",
        "MezzS.",
