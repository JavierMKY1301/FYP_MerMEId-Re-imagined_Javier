<https://cnw-ld.org/work/SchWB2-443/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-443> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Ach! derfor sees paa alle Steder sort"@da,
        "Ach! hvad Sorrig maa vi friste"@da,
        "Dog før vi her fra træde"@da,
        "Far vel da! vor Græde-Stemme!"@da,
        "HErren sætte Kongen til Velsignelse ævindelig"@da,
        "HErrens Igienløste skulde komme til Zion"@da,
        "I Høystbedrøvede igien!"@da,
        "Saa vel er DU"@da,
        "Salig Konge! Landets Fader!"@da,
        "Stor Væ! stor Klage! nu i Dag"@da,
        "Velsignede Kong Christian!"@da,
        "Vor Salig Konge! Far vel da!"@da ;
    cnw:performingForce "soloist",
        "soloists" .

