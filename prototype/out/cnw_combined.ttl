<https://cnw-ld.org/work/SchWB5-Coll-002> a mo:MusicalWork,
        frbr:Work ;
    dcterms:created "1765" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    dcterms:identifier "SchW B5:Coll.002" ;
    dcterms:language "English",
        "German" ;
    dcterms:subject "Children's songs",
        "Song",
        "Vocal music" ;
    dcterms:title "Kleine Lieder für Kinder zur Beförderung der Tugend"@de ;
    frbr:realization <https://cnw-ld.org/work/SchWB5-Coll-002/expression/1> ;
    cnw:catalogueCode "SchW" ;
    cnw:cnwNumber "B5:Coll.002" ;
    cnw:editorialNote "A review which contains substantial quotations from Scheibe's introduction to the collection of children's songs.",
        "Letter from Weiße to Ramler dated 29 Aug. 1765.",
        " 'Ein Theil dieser Lieder war schon ehmals in größrer Gestalt componirt, und zwar von einem Manne, der um die deutsche Musik unbezweifelte Verdienste hat. Worunter aber die Composition seiner Kinderlieder nicht mit gerechnet werden kann.'",
        " 'Genug, die schönen Poesien hätten ein besseres Schicksal verdient. Wir ersuchen daher den Herrn Kapellmeister, im Namen des guten Geschmacks, künftig Kinder und Erwachsene mit dergleichen Melodien zu verschonen.'",
        " 'Man hat gegenwärtige Lieder schon in einer größern Gestalt, vom Herrn Kapellmeister Scheibe in Koppenhagen, componirt gesehen, und von mir wurde verlangt, sie in eine kleinere zu bringen: bloβ dieser Anforderung Genüge zu leisten, und nicht, mich mit einem andern zu messen, habe ich eine neue Composition derselben unternommen.'",
        " ('VII. Das Singen. 2. Weltliche. a. Lieder.'): 'Scheibens, kleine Lieder für kinder, zur Beförderung der Tugend, mit Melodien zum Singen beym Clavier. Erste Theil. Flensburg, 1766. fol. 20 gl.'" ;
    cnw:performanceCount 0 ;
    cnw:textAuthor <https://cnw-ld.org/agent/christian_felix_wei_e> .

<https://cnw-ld.org/work/SchWB5-Coll-002/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB5-Coll-002> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:performingForce "cemb.",
        "voci" .

