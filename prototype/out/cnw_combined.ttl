    cnw:textAuthor <https://cnw-ld.org/agent/peder_sparki_r> .

<https://cnw-ld.org/work/SchWB2-407/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-407> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Din Lov vi vil da ey forglemme"@da,
        "Frisk op med Instrumenters Lyd"@da,
        "Hellige og store GUD?"@da,
        "Hellighed og Herlighed"@da,
        "Hosianna! Lovet være Den, som kommer i HErrens Navn!"@da,
        "Lovet være Herren Israels Gud"@da,
        "Med denne Bøn og Tak Hvers Hierte bryder ud"@da,
        "Saa er Indvielsen i JEsu Navn fuldendt"@da,
        "Saa gaae vi da ad Dine Porte ind med Glæde"@da,
        "Vi vil hernæst i Bøn vedblive"@da .

