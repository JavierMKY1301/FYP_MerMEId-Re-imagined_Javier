<https://cnw-ld.org/work/HartW3/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/HartW3> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "hartw_003_1_0.png" ;
    cnw:incipitText "Ak, det er sidste Gang i denne Verden"@da,
        "De stakkels Børn! Min ejegode Frue!"@da,
        "Den Spillemand sin Harpe tog"@da,
        "Det Barn, som Eders Husbond bragte mig, er dødt!"@da,
        "Det er min Synd, min Smerte"@da,
        "For Herrens Altar tør jeg sværge"@da,
        "Fra Klostret til Kirken er Nonnens Gang"@da,
        "God Aften Moder! kan du kjende mig?"@da,
        "Hil være vor Indgang i Riddersal"@da,
        "Hr. Lave han reed sig under Ø"@da,
        "Hør Ungersvend, siig ikke nei"@da,
        "I Kloster Liden Kirsten gaaer"@da,
        "I Klostret, hvor de fromme Nonner boe"@da,
        "I morgen Du vil i Kloster gaae"@da,
        "Ja, jeg er hjemme! Ja, jeg er i Danmark!"@da,
        "Ja, jeg er hjemme, i mit kjære Danmark"@da,
        "Kjær Moder sig mig da, hvordan jeg Liden Kirsten glemme kan"@da,
        "Langt, langt fra Hjemmets Kyst"@da,
        "Liden Kirsten, det er hende"@da,
        "Min Søn, fortæl, hvad Du har seet!"@da,
        "Munken han reed sig under Ø"@da,
        "Natten kan rumme en Verden af Glæde!"@da,
        "Natten lang, Dands og Sang"@da,
        "Nu drik, værer glade!"@da,
        "Seer Du, jeg er her alt og festlig smykket"@da,
        "Sverkel! O du Kjære!"@da,
        "Søster og Broder! Velsign os Moder!"@da,
        "Ach, heut zum Letztenmal in diesem Leben"@de,
        "Das Kind, das Euer Hausherr mir gebracht, es starb"@de,
        "Der Mönch ist geritten über Land"@de,
        "Der Sänger nahm die Harfe sein"@de,
        "Die armen Kinder! edle liebe Frau!"@de,
        "Fasst meine Sünde, meine Schmerzen"@de,
        "Gott grüss' dich Mutter! erkennst du mich?"@de,
        "Ha! klein Karin kommt gegangen"@de,
        "Heil unserem Eintritt zum Fest im hohen Rittersaal"@de,
        "Herr Lave reitet wohl auf die Freit'"@de,
        "Hialmar! O Du Theurer!"@de,
        "Hör', Junggesell, stell dich hierher"@de,
        "Im Kloster, wo die frommen Nonnen sind"@de,
        "Ins Kloster man klein Karin lässt"@de,
        "Ja ich bin wieder in der lieben Heimath"@de,
        "Jubel und Freude erhellen die Nacht"@de,
        "Lieb' Mutter, sag mig an, wie ich klein Karin vergessen kann?"@de,
        "Mein Sohn, erzähl', was Du gesehn'!"@de,
        "Mit heil'gem Eide kann ich bezeugen"@de,
        "Morgen willst Du in's Kloster gehn"@de,
        "Nun trinkt, und erfreut euch!"@de,
        "Nächte lang, Tanz und Sang"@de,
        "Schwester und Bruder! o seg'n uns Mutter!"@de,
        "Siehst Du, schon bin ich hier im Festgewande"@de,
        "Weit, weit von der Heimath"@de,
        "Zur Kirch' geht vom Kloster der Nonne Gang"@de,
        "All night long shall we sing"@en,
        "Before our Father's altar I'd swear"@en,
        "Dear mother mine, tell me how I can Little Kirsten forget?"@en,
        "Early one day the monk rode out"@en,
        "Evening can fill a whole world with rejoicing"@en,
        "Far from my home's coast"@en,
        "From convent to church is the path of the nun"@en,
        "Good evening, mother! Do you know it's me?"@en,
        "Hail, as we bring to the Castle Hall"@en,
        "Lave he rode out one fine day"@en,
        "Little Kirsten stands before me"@en,
        "Look now, I am here and finely dressed"@en,
        "My son, now tell what you have seen!"@en,
        "Now drink, and be merry!"@en,
        "Now hear young friend, do not say no"@en,
        "Sister and brother! bless us, Mother!"@en,
        "Sverkel! Oh, my dearest"@en,
        "That child, which your husband brought me, is dead"@en,
        "The convent soon shall Kirsten join"@en,
        "The convent where the pious nuns reside"@en,
        "The convent you will tomorrow join"@en,
        "The minstrel stood and took his harp"@en,
        "This is my sin that I suffer"@en,
        "This is the final moment in this world"@en,
        "Unhapiness! My kind-hearted Lady!"@en,
        "Yes, I am home now in my dearest Denmark"@en ;
    cnw:meter "3/4" ;
    cnw:performingForce "A.",
        "Alto",
        "B.",
        "Mezzo Soprano",
        "S.",
        "Soprano",
        "T.",
        "Tenor",
        "alto",
        "arp.",
        "cb.",
        "cl.",
        "cor.",
        "fg.",
        "fl.",
        "fl. pic.",
        "ob.",
        "timp.",
        "tr.",
        "trb.b.",
        "trb.t.",
        "va.",
        "vc.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Moderato - Allegro molto assai - Tempo I - Allegro molto assai" .

