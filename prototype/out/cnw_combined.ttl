<https://cnw-ld.org/work/HartW2/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/HartW2> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "hartw_002_1835_0.png" ;
    cnw:incipitText "Af dine milde Blikke jeg drikker et saligt Haab"@da,
        "Amor, du som lærte Qvinden at elske Manden"@da,
        "Dandse, dandse, ja, det kan I nok"@da,
        "Den er stærk, den er stærk den gyldne Vin!"@da,
        "Den er stærk, den er stærk den gyldne, gyldne Viin!"@da,
        "Dum me mori est decesse"@da,
        "For din englerene, fromme Sjæl, Helene!"@da,
        "Hr. Greve! nogle Landmænd vente paa Eders Vink"@da,
        "Hr. Greve! nogle Landsmænd vente paa Eders Vink"@da,
        "Hvad har jeg gjort!"@da,
        "Hvor jeg gaaer og hvor jeg dvæler er hans Billede mig nær"@da,
        "Hør! hør! Signaler lød!"@da,
        "I Achelos sidder sorgfri Michalistos i sin Gaard"@da,
        "Idag! hvad maa jeg høre!"@da,
        "Jeg læser klart i Eders skjønne Blikke"@da,
        "Jeg skal forklare dig den dybe Sands i hver en Blomst"@da,
        "Kjerligheds Gud er mægtig, du Søde!"@da,
        "Kjærlighedens Gud er mægtig"@da,
        "Lad os Dandsen prøve"@da,
        "Med glade Sange og muntre Dandse den pragtfulde Sal vi betræde"@da,
        "Med glade Sange, med muntre Dandse den pragtfulde Sal vi betræde"@da,
        "Medens Maanen sagte daler ved der første Skjær af Solen"@da,
        "Medens Maanen sagte daler ved det første Skjær af Solen"@da,
        "Milde Gud! Hvad betyder dette Skud?"@da,
        "Milde Gud! hvad betyder dette Skud?"@da,
        "Min Beatrice! Min Gemal!"@da,
        "Naadige Greve! høie Beskytter!"@da,
        "Naadige Greve! vor høje Beskytter"@da,
        "Naadige Greve! vor høje Beskytter!"@da,
        "Nær Arnoflodens Vande"@da,
        "Nær ved Arnoflodens Vande"@da,
        "O hjælp mig Himmel, i din Naade!"@da,
        "O hjælp mig, Himmel, i din Naade"@da,
        "O! I maa skamme Jer, som I kan tale"@da,
        "O, I maa skamme Jer, som I kan tale!"@da,
        "O, troe ham ei!"@da,
        "Saa langt fra hende, og saa nær"@da,
        "Saa langt fra hende, og saa nær!"@da,
        "Som en Rovfugl farer dristig over Havets Spejl!"@da,
        "Stille! hvad betyder denne Skrigen"@da,
        "Til Hjemmet igjen med Seier vi drage"@da,
        "Til Hjemmet! Til Hjemmet!"@da,
        "Tys! tys! ingen Støi, sagte, sagte!"@da,
        "Tys! tys! ingen Støj, sagte, sagte!"@da,
        "Uberto! Uberto!"@da,
        "An der Arnoflusses Mündung"@de,
        "Er ist stark, er ist stark der goldne, goldne Wein"@de,
        "Gnädiger Graf und Beschützer!"@de,
        "Ich will's nicht thun, will nicht verrathen die Guten"@de,
        "Kommt den Tanz zu üben"@de,
        "O hilf mit Gott in deiner Gnade"@de,
        "O, schämen musst Ihr euch"@de,
        "Schon heut! darf ich dir trauen?"@de,
        "So nah der Schöne und so fern"@de,
        "Stille! was bedeutet dieses Schreien"@de,
        "Tanzen, tanzen, ja, das könnt ihr wohl"@de,
        "Wie der Seefalk kreiset, jagend über blauer Fluth"@de,
        "Dum memori est nesesse"@la ;
    cnw:meter "2/4" ;
    cnw:performingForce "A.",
        "B.",
        "Bar.",
        "S.",
        "T.",
        "arp.",
        "cb.",
        "cl.",
        "cor.",
        "fg.",
        "fl.",
        "gr.c. & ptti.",
        "ob.",
        "picc.",
        "timp.",
        "tr.",
        "trb.a",
        "trb.b.",
        "trb.t",
        "trgl.",
        "va.",
        "vc.",
        "vc. obl.",
        "vc. solo",
        "vl. solo",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Moderato marziale - Allegro assai con fuoco" .

