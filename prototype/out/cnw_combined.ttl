        "cl.",
        "cor.",
        "fg.",
        "fl.",
        "ob.",
        "picc.",
        "tb.",
        "timp.",
        "tr.",
        "trb.",
        "trgl.",
        "va.",
        "vc.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Allegro non troppo" .

