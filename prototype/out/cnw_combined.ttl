<https://cnw-ld.org/work/SchWB2-310/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-310> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Bort med jordisk Roe og Glæde!"@da,
        "Dertil hielp os Christus vor Trøst"@da,
        "Det er fuldendt – det glade Budskab"@da,
        "Det uvelkomne Skraal af Jøders Skare"@da,
        "Din Kamp er ude – og jeg staaer tilbage"@da,
        "Dybt er mit ømme Hierte saaret"@da,
        "Ei Helved-Slangens List og Rænke"@da,
        "Herefter skal da Død og Grav"@da,
        "I Korsets Skole, o korsfæstet Frelser!"@da,
        "Jeg knurrer ei mod din dybe Viisdom"@da,
        "Jeg veed, o Herre Jesu Christ!"@da,
        "Jeg ønsker kun med Længsel"@da,
        "Kierlighed vandt Seier"@da,
        "Min Siæl er tændt af ædel Iver"@da,
        "Nei, denne døende er meget mere, end en anden dødelig"@da,
        "Nu aabnedes mit Øye giennem Taarer"@da,
        "O Himmel! – hvilken Skare af Mirakler!"@da,
        "Saa faldt den hele Last af Syndens Straf paa dig"@da,
        "Salighed og Smerte"@da,
        "Tidens umættede Tænder"@da,
        "Uden Ophold bør vi græde"@da,
        "Udvalgte Flok! – Ak! ved hans Blod udkaaret"@da,
        "Ved høie Middagstid er saadant Mørke!"@da ;
    cnw:performingForce "voice" .

<https://cnw-ld.org/work/SchWB2-311> a mo:MusicalWork,
        frbr:Work ;
    dcterms:created "1769" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    dcterms:identifier "SchW B2:311" ;
    dcterms:language "Danish",
        "English",
        "Italian" ;
    dcterms:subject "Cantata",
        "Music for vocal soloists and instruments with or without choir",
        "Oratorio",
        "Passion",
        "Vocal music" ;
    dcterms:title "Sørge-Cantate ved Christi Grav som i Fasten opføres af Det musicaliske Selskab"@da ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-311/expression/1> ;
    cnw:catalogueCode "SchW" ;
    cnw:cnwNumber "B2:311" ;
    cnw:editorialNote "'I Anledning af den af det nye Musicaliske Selskab paa Bryggernes Laugshuus udi Fasten vel opførte Passions-Musiqve. | Hvad Evalds søde Pen og Scheibes stærke Toner | Ved Christi Grav har sat i Riim og Sørge-Noder, | Dit Selskab med sin Ræhs udførte mesterlig | Hver Skiønsom maae med Ret den Ære give dig. | Tilhørers Hundred Tall dig Roes og Biefald giver; | Tiltagen Kunst ved Fliid din Roes og Ære bliver. |  Kuns et kan siges paa din gandske Faste-Sang, | Det nemlig, at du ey sang den endnu en Gang. | Bliv ædle Selskab ved! tag til i Flor og Ære, | Ved Orden, Lyst og Fliid dit Navn skal varig være, | Hav Tak, tag Ære for hver Tirsdag Faste-Dag, Syng ofte som i Aar ved Christi Seyers-Grav. | v. W.-*'",
        "soloist: C.1" ;
    cnw:performanceCount 0 ;
    cnw:textAuthor <https://cnw-ld.org/agent/johannes_ewald> .

<https://cnw-ld.org/work/SchWB2-311/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-311> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "SchM_091_01-001.png" ;
    cnw:incipitText "Derfor var vort Hierte svagt"@da,
        "En liflig Straale"@da,
        "Et reen formørket Øye"@da,
        "Graad skiule steds mit Øye"@da,
        "Han har vundet!"@da,
        "Han kaldte sig sit Folks forløser"@da,
        "Han lever"@da,
        "Her laae Han"@da,
        "Herrens Salvede, som var vor Næses Aand"@da,
        "Himlens Stærke vaager over Herrens Salvede"@da,
        "Jeg vred mig paa det kummerfulde Leie"@da,
        "Jord, hør den Fryd"@da,
        "Kommer, Fordømte og skuer det jeg forgiæves tilbød!"@da,
        "Langt borte hvißler Slangen"@da,
        "Salige, hold op at græde"@da,
        "Skræk har omspændt mig"@da ;
    cnw:key "E-flat major" ;
    cnw:meter "2/2" ;
    cnw:performingForce "B.",
        "C.1",
        "C.2",
        "C1.",
        "C2.",
        "T.",
        "bc.",
        "clrno.",
        "cor.",
        "fl.",
        "ob.",
        "ob.gr.",
        "princ.",
        "timp.",
        "va.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Poco adagio e maestoso" .

<https://cnw-ld.org/work/SchWB2-312> a mo:MusicalWork,
        frbr:Work ;
    dcterms:created "1746" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    dcterms:identifier "SchW B2:312" ;
    dcterms:language "Danish",
        "English",
        "German" ;
    dcterms:subject "Music for vocal soloists and instruments with or without choir",
        "Oratorio",
        "Passion",
        "Vocal music" ;
    dcterms:title "Thränen der Sünder bey dem Kreuze Ihres Erlösers. Ein Oratorium"@de ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-312/expression/1> ;
    cnw:catalogueCode "SchW" ;
    cnw:cnwNumber "B2:312" ;
    cnw:editorialNote "'Hermed bekiendt giøres for alle Liebhabere af Musiqven, at Torsdagen den 2 Martii bliver paa det Musicaliske Sælskabs Sahl opført et Passions-Oratorium kaldet Thränen der Sünder beym Creuze unsers Erlösers. Et Mesterstykke af den berømmelige Capellmester Scheibe.'",
        " 'Der Hr. Verfasser hat dieses musikalische Oratorium als bloße Betrachtungen über den Tod Jesu abgefasset, welche Art von Paßionscantaten in gewisser Maße und in Ansehen der Erbauung einen Vorzug vor andern hat. Es kommen manche Redensarten darinn vor, die den Leser an die bekannte Stelle in dem Liede O Traurigkeit, o Herzeleid &c erinnern müssen [...] Wir wissen zwar, wie sich dergleichen Ausdrücke vertheidigen lassen, es ist aber doch ohne allen Zweifel viel besser, wenn man sich derselben enthält.'" ;
    cnw:performanceCount 0 ;
    cnw:textAuthor <https://cnw-ld.org/agent/johann_adolph_scheibe> .

<https://cnw-ld.org/work/SchWB2-312/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-312> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Ach grosser König, groß zu allen Zeiten!"@de,
        "Bey diesem erstaunenden göttlichen Lieben"@de,
        "Das ist der grosse Tag"@de,
        "Doch ach! wie klein ist nicht die Zahl"@de,
        "Ein Lämmlein geht und trägt die Schuld der Welt"@de,
        "Erlöser! Da deine gemarterten Glieder ersterben"@de,
        "Es dient zu meinen Freuden"@de,
        "Für alle Sünde, die du je begangen"@de,
        "Heyland! ach, bey deinem Schmerze"@de,
        "Höllische Feinde, was wütet ihr noch?"@de,
        "Ihr aber, die ihr hier vor JEsu Augen stehet"@de,
        "In JEsu Blut erfüllten Wunden"@de,
        "Ja wohl, mein GOtt! dein Lieben"@de,
        "Lasset uns mit Jesu sterben"@de,
        "Liebreicher Heyland, ja mir gehn die Schmerzen"@de,
        "Mit JEsus Blut erkauffte Seelen!"@de,
        "O JEsu! wahrer Fürst des Lebens!"@de,
        "O! daß ich könnte Trähnen gnug vergiessen!"@de,
        "So weinet, Sünder, weinet Blut!"@de,
        "Wie werd ich denn so frölich seyn"@de,
        "Wisset, daß ihr nicht mit vergänglichen Silber oder Gold erlöst seyd"@de .

