    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "hartw_485_1.png" ;
    cnw:incipitText "\"Jeg er lystig og glad!\" sang Gutten"@nb,
        "Der er saa godt at bygge i højen Himmelbo!"@nb,
        "Der lusker en Ulv bagom Gaard"@nb,
        "Du leker saa lystig, du gule Blad"@nb,
        "Kjender du Solen i Siljedal"@nb,
        "Kom Sjæl, og tag dit Regnebræt"@nb,
        "Kraaken fløj op"@nb,
        "Og jeg og dig, du mi' Solskinslue!"@nb,
        "Og vesle Jon gik bagom, og store Jon gik frem"@nb ;
    cnw:meter "3/4" ;
    cnw:performingForce "pf.",
        "voice" ;
    cnw:tempo "Allegro moderato" .

