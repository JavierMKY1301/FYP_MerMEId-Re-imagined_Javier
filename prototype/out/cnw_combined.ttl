<https://cnw-ld.org/work/SchWB2-437/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-437> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Bort Leeg og Lyst!"@da,
        "Der er fornummet en Røst i det Høye"@da,
        "Du Kongers Konge giv vor Konge Fryd og Glæde!"@da,
        "Ey noget Tordenslag kan os saa bange giøre"@da,
        "Hvad Trøst kan vel Opmuntre vores Siel?"@da,
        "Hvad har dig Dyd bekymret giort?"@da,
        "Hvad nu! hvad Graad! hvad Jammer-Skrig!"@da,
        "I Nordens Tvilling-Riger!"@da,
        "Ja! tvende Dronninger"@da,
        "Nu sidde vi da og begræde"@da,
        "Om Dig skal hver en Tunge"@da,
        "Parnasse! sid i Støv!"@da,
        "Rinder I Taarer, og ikke aflader!"@da,
        "See Femte Fridrich med Dyder var prydet"@da,
        "See! Fred paakom en Bitterhed, ja en Bitterhed"@da,
        "Sørg da, du hele Land"@da,
        "Vel er den følesløs, ja, har et Tiger-Hierte"@da,
        "Velan! vort sørge-Spil"@da,
        "Vor Sceptermand, vor Konge Christian"@da ;
    cnw:performingForce "voice" .

