<https://cnw-ld.org/work/SchWB2-402/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-402> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Das thönende Schallen der muntren Trompette"@de,
        "Die zärtlichen Flammen der Liebe"@de,
        "Dies Haus besteht in Ewigkeit"@de,
        "Dies ist der Freudentag, dies ist das grosse Fest"@de,
        "Dir, holde Königin! weyht sich mein froher Mund"@de,
        "Es tobet vergebens das Rasen der Feinde"@de,
        "Giesse, gütiges Geschicke!"@de,
        "Kein Feind kann Deine Tugend kränken"@de,
        "Königin! Dein Fest zu ehren"@de,
        "Mein rascher Flug soll auch nicht säumig seyn"@de,
        "Mit Recht nenn ich den Tag den schönsten auf der Welt"@de,
        "Ruhm und Lust und Scherz und Glücke"@de,
        "Sanft und leicht sind meine Ketten"@de,
        "Schöner kann kein Bündniß grünen"@de,
        "So recht, ihr Freunde, die ich liebe"@de,
        "Tollkühner Schwarm, verworfne Schaar!"@de,
        "Was meine bewafnete Schaaren bekämpfen"@de,
        "Wie glücklich ist der Tag, wie treflich dieses Fest!"@de,
        "Wie schön ist solch ein Fest"@de,
        "Wir wollen stets allhier bey diesem Paare wohnen"@de,
        "Auch ich erblicke mich an diesem grossen Paare"@en ;
    cnw:performingForce "voice" .

<https://cnw-ld.org/work/SchWB2-403> a mo:MusicalWork,
        frbr:Work ;
    dcterms:created "1743" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    dcterms:identifier "SchW B2:403" ;
    dcterms:language "Danish",
        "English",
        "German" ;
    dcterms:subject "Cantata",
        "Music for vocal soloists and instruments with or without choir",
        "Occasional",
        "Secular",
        "Vocal music" ;
    dcterms:title "An dem hohen Geburtsfeste der durchlauchtigsten Fürstin und Frau Louise vermählten Kronprinzeßin ward folgende Cantate aufgeführet"@de ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-403/expression/1> ;
    cnw:catalogueCode "SchW" ;
    cnw:cnwNumber "B2:403" ;
    cnw:editorialNote "'Die auf die Kronprinzeßin von Dänemark ist auf einem einzelnen Blatte ohne seinen Namen gedruckt, als sie von dem Herrn Kapellmeister Scheibe in Kopenhagen aufgeführt wurde. Sie ist nur das Werk weniger Stunden gewesen, schien aber in Betrachtung einiger glücklichen Wendungen, und vornehmlich ihres Gegenstandes wegen, der Erhaltung würdig zu seyn. Sie ist ein Ausdruck der unbeschreiblichen Liebe, welche ganz Dänemark, von ihrer ersten Ankunft an bis an ihren Tod, gegen seine unvergeßliche Königin Louise, gebohrne Prinzeßin von Großbritannien, gehabt und bezeiget hat. Dieselbe hatte kurz vorher, ehe diese Cantate augeführet ward, nehmlich den 11 Dec. 1743 als vermählte Kronprinzeßin, ihren Einzug in Kopenhagen gehalten.'" ;
    cnw:performanceCount 0 ;
    cnw:textAuthor <https://cnw-ld.org/agent/johann_elias_schlegel> .

<https://cnw-ld.org/work/SchWB2-403/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-403> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Das Land hat nun ein Kleinod mehr"@de,
        "Das Volk, das seinen Blick Dir längst entgegen wandte"@de,
        "Dieß ist der Ruf, der noch anitzt erklingt"@de,
        "Ihr Bürger! euren Freudenzeichen"@de,
        "O! seht! wie schön ist es zu preisen"@de,
        "Sey voll Glücke, sey voll Seegen"@de .

<https://cnw-ld.org/work/SchWB2-404> a mo:MusicalWork,
        frbr:Work ;
    dcterms:created "1765" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    dcterms:identifier "SchW B2:404" ;
    dcterms:isPartOf <https://cnw-ld.org/collection/22970470698739> ;
    dcterms:language "English",
        "German" ;
    dcterms:subject "Cantata",
        "Music for vocal soloists and instruments with or without choir",
        "Secular",
        "Vocal music" ;
    dcterms:title "Ariadne auf Naxos, eine Kantate"@de ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-404/expression/1> ;
    cnw:catalogueCode "SchW" ;
    cnw:cnwNumber "B2:404" ;
    cnw:editorialNote " 'Diese Cantate steht in einer Sammlung von Cantaten, welche mit Hn. Kapellmeisters Scheibens Composition vor einigen Jahren herausgekommen ist. Diese Sammlung ist in wenigen Händen, und viele Freunde der Dichtkunst, die nicht zugleich musikalisch sind, haben längst gewünscht, dies vortrefliche Gedicht ohne jene Composition besitzen zu können.' (p. 383)",
        " 'Gerstenbergs Ariadne auf Naxos und ein Te deum hält man für das Beste, was er jemals in Musik gesetzt hat'." ;
    cnw:performanceCount 0 ;
    cnw:textAuthor <https://cnw-ld.org/agent/heinrich_wilhelm_von_gerstenberg> .

<https://cnw-ld.org/work/SchWB2-404/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-404> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "SchM_072_01.png" ;
    cnw:incipitText "Daß er der Fluch der Menschheit werde!"@de,
        "Einst war ich schuldlos"@de,
        "Kannst du, mein Herz, unter diesem stechenden Schmerz"@de,
        "O du, wie kann ich dich zu zärtlich lieben?"@de,
        "Sey mir gegrüßt, auf Naxos Höhn"@de,
        "Sie brüllen, die Löwen"@de,
        "Weh mir! warum mußt ich ihn sehn?"@de,
        "Wohin? wo flieh ich hin?"@de,
        "Zu weit entfernt das Meer den Frevler schon!"@de,
        "Zwar hier, mein Theseus"@de ;
    cnw:key "A major" ;
    cnw:meter "2/4" ;
    cnw:performingForce "S.",
        "cemb." ;
    cnw:tempo "Ein wenig geschwind, aber angenehm und zärtlich" .

<https://cnw-ld.org/work/SchWB2-405> a mo:MusicalWork,
        frbr:Work ;
    dcterms:created "1734" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    dcterms:identifier "SchW B2:405" ;
    dcterms:language "Danish",
        "English",
        "German",
        "Italian" ;
    dcterms:subject "Cantata",
        "Music for vocal soloists and instruments with or without choir",
        "Occasional",
        "Secular",
        "Vocal music" ;
    dcterms:title "Auf das hohe Krönungs-Fest Sr. Majestät Augustus des III. Königs in Pohlen, und Churfürstens zu Sachsen wurde folgendes Drama aufgeführet"@de ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-405/expression/1> ;
    cnw:catalogueCode "SchW" ;
    cnw:cnwNumber "B2:405" ;
    cnw:performanceCount 1 ;
    cnw:textAuthor <https://cnw-ld.org/agent/johann_adolph_scheibe> .

<https://cnw-ld.org/work/SchWB2-405/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-405> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Doch welche Furcht nimmt meine Glieder ein?"@de,
        "Du steigest, Herr! durch Dein erhabnes Wesen"@de,
        "Ein Gegenstand von so viel Schätzen"@de,
        "Er lebe ja! Ich bin zu gleicher Freude da"@de,
        "Es lebe Augustus!"@de,
        "Helden, die der Himmel liebet"@de,
        "Herrsche, lebe, blühe, grüne"@de,
        "Mein Haupt, vom Schnee der Zeit bedeckt"@de,
        "So fest ist unser Wohl gegründet"@de,
        "So recht, mein Freund! wir können deutlich spüren"@de,
        "Statt Tropffen quillt mein Fluß vom Glücke"@de,
        "Wie gleichgesinnt, o Freundin! sind wir nicht"@de ;
    cnw:performingForce "Voice" .

