<https://cnw-ld.org/work/SchWB2-306/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-306> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "SchM_007_1_1.png" ;
    cnw:incipitText "Bliv Taare ved at trille"@da,
        "De skal udbrede din store Godheds Ihukommelse"@da,
        "Forhænget revner, og en hellig Flamme igiennemtrænger det rædsomme Mørke"@da,
        "Græde I, som boe paa Jorden!"@da,
        "Guds Vredes Straaler brænder over Horeb"@da,
        "Han fandtes ene værdig, at agtes for retfærdig"@da,
        "Hvo kan bestaae for en almægtig Vrede"@da,
        "I Kedrons stille Dale"@da,
        "Jeg saae: og Mørkets grumme Kiæmpe igiennemløb et forvirret Øye"@da,
        "Jeg seer Ham. – Gud! – og denne er min Skaber!"@da,
        "Lad Himlene fornemme"@da,
        "Langt under Chaos er de mørke Huuler"@da,
        "Men Himlen taug, – Seraphen selv holdt inde"@da,
        "Naar Himle flye din Røst, naar Verdner skiule sig"@da,
        "O Graad, du Glædens tause Tolk"@da,
        "O stille Skræk! – Guds Rædsel! – Hiertet standser"@da,
        "Slaae Cithar, slaae i sagte Toner"@da,
        "Stor var Han – fød af Evigheders Fader"@da,
        "Triumpf? Men, ak! den dyrekiøbes"@da,
        "Vor Harpe er bleven til Sorrig"@da ;
    cnw:key "E-flat major" ;
    cnw:meter "4/4" ;
    cnw:performingForce "B.",
        "C.",
        "C.1",
