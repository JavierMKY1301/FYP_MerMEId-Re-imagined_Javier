<https://cnw-ld.org/work/NWGW172/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/NWGW172> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "NWGW_172_01.png" ;
    cnw:incipitText "Alt breder sig den lyse Sky"@da,
        "De slumre trygt i Nattens svale Fred!"@da,
        "Fremad, fremad frem nu min mødige Fod"@da,
        "Hedt bølger Sandet, guult som Flammer"@da,
        "Herre, fra det Fjerne drog din Skare hid"@da,
        "Jeg dukker mit Bryst, jeg dukker min Kind"@da,
        "Løft høit dit Hoved, Korsmand, stands!"@da,
        "Med hellig Hu, til Maalet nu!"@da,
        "Nu snoer Natten sig mørk om den dødstille Ørk"@da,
        "Snart vort Øie skuer Maalet"@da,
        "Straal, høie Sol, straal paa mit Sværd med Lyst!"@da,
        "Bald zum Ziel wird Gott uns tragen"@de,
        "Dein Haupt erhebe, Kreuzmann, steh!"@de,
        "Heiss wogt das Sandmeer, gelb wie Flammen"@de,
        "Ich tauch' meine Brust, die Wange so lind"@de,
        "Im Ost die Sonne nahet schon"@de,
        "Mit heilgem Sinn zum Heilgen Ziel!"@de,
        "O, Rinaldo, auf, Rinaldo, auf, erwache!"@de,
        "Schleichend listig und sacht kommt das Dunkel der Nacht"@de,
        "Sie schlafen sanft in friedlich kühler Nacht!"@de,
        "Strahl' hehre Sonn' strahl auf mein Schwert mit Lust!"@de,
        "Vater, aus der Ferne zog dein Heer herbei"@de,
        "Weiter, weiter! weiter mein müder Fuss"@de,
        "Vaagn, Rinaldo, vaagn af din Slummer!"@en ;
    cnw:meter "4/4" ;
    cnw:performingForce "A.",
        "B.",
        "MezzS.",
        "S.",
        "T.",
