<https://cnw-ld.org/work/HartW14/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/HartW14> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "hartw_014_1840_0_00.png" ;
    cnw:incipitText "Anna! Balthasar! Kan I høre vor Stemme?"@da,
        "Anna! Balthasar! Kan I vort Raab fornemme?"@da,
        "Anna! Balthasar! kan I høre vore Stemmer?"@da,
        "For Jer er ingen Virkelighed her"@da,
        "Ha! hvilken Stræng sitred i Luften!"@da,
        "Ha! hvilken Stræng zitred i Luften?"@da,
        "Ha! hvor skal vi nu dem søge?"@da,
        "Her frem, I Taager, frem af Jord og Sø og lette Sommerskyer"@da,
        "Herfrem i Taager som af Jord og Sø! - Ha! hvordan finder jeg Vei gjennem Taagen?"@da,
        "Hvad nu! Det klinger jo, som om Naturen sukked?"@da,
        "Hvad nu! det klinger jo, som om Naturen sukked?"@da,
        "Hør nu begynder alt mit muntre Spil - O hvor godt at sidde her i den muntre Klynge"@da,
        "Ja render kun I Narre!"@da,
        "Kong Volmer drager af sted paa Jagt"@da,
        "Konning Volmer drager afsted paa Jagt"@da,
        "Lad os nøie følge Manden"@da,
        "Nu er det svalt, nu synker Dæmring over Lunden"@da,
        "Nu lufter Skoven sin lysegrønne Pragt"@da,
        "O hvor godt at sidde her i den muntre Klynge!"@da,
        "Snart er Natten svunden, Dagen bryder frem"@da,
        "Syvsoverdagen i Sol gaaer netop ned i dette Nu!"@da,
        "Til Frederiksborg! Til Frederiksborg!"@da,
        "Trolddommen dybt begravet hviler paa Søens Bund"@da,
        "Tys! tys! Det er Kong Valdemars vilde Jagt!"@da,
        "Ved Kveld, ved Nat, i Skov i Krat Jægerne fare"@da,
        "Ved Kveld, ved Nat, i Skov, i Krat Jægerne fare"@da,
        "tys! tys! Vi kan høre Menneskers Fjed!"@da ;
    cnw:meter "4/4" ;
    cnw:performingForce "A.",
        "B.",
        "MezzS.",
        "S.",
        "T.",
        "arp.",
        "cb.",
        "cl.",
        "cor.",
