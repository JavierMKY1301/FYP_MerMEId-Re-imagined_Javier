<https://cnw-ld.org/work/SchWB2-302/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-302> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "SchM_065_1_1.png" ;
    cnw:incipitText "Ak vee mig! Gud! den haarde Lykke!"@da,
        "Flye Verden, flye! jeg min Jesum følge vil"@da,
        "Forfærdelse! hvad skeer mig?"@da,
        "Forundring! Skræk! Forundring!"@da,
        "Gud styrk mig!"@da,
        "Halleluja høylovet være Gud!"@da,
        "Hævn Fader! Fader, Gud, Gud, din Søn!"@da,
        "I Himlens Børn! og nu er jeg forløst, i Brødre!"@da,
        "Ja Jesu! engang Verdens Dommere!"@da,
        "Ja, dobbelt Raserie sin Salighed forspilde"@da,
        "O Afmagts Røst, jeg af min Jesu Mund maae høre!"@da,
        "O Jesu! Jesu da du saa har elsket mig"@da,
        "O Salighed! at have Jesum fundet"@da,
        "O Syn! det Jesu Kors at see!"@da,
        "O min Jesu! gid jeg kunde"@da,
        "O! hvilke Almagts Under! rundt om her udtordne"@da,
        "Triumph! Triumph! Triumph! den Juda Løve vandt"@da ;
    cnw:key "D minor" ;
    cnw:meter "2/2" ;
    cnw:performingForce "B.",
        "C.1",
        "C.2",
        "T.",
        "bc.",
        "clrno.",
        "cor.",
        "fl.",
        "timp.",
        "va.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Adagio ed affettuoso" .

<https://cnw-ld.org/work/SchWB2-303> a mo:MusicalWork,
        frbr:Work ;
