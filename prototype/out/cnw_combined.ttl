<https://cnw-ld.org/work/HartW163/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/HartW163> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "hartw_163_00.png" ;
    cnw:incipitText "Der er Phantasus, min lille Tjener"@da,
        "Du bringer Bud mig fra Olympens Konge?"@da,
        "Du vor straalende Drot"@da,
        "Fornemmer Du Nymphernes Ord?"@da,
        "Fra hendes Læbe Sjælen bort er flygtet"@da,
        "Fremad! Hør, med sagte Susen"@da,
        "Gjennem Skovens dybe Stilhed"@da,
        "Her er Nectarens skummende Bæger"@da,
        "Hil Apollo! herlig steg fra Oven ned"@da,
        "Jeg skal bort fra Livet"@da,
        "Nu flygter Dagens Glands"@da,
        "O faure Lyra! sidste Trøst i Nøden"@da,
        "Snart, I Smaa, vi her kan hvile"@da,
        "Bald, Ihr Kleinen, könnt Ihr ruhen"@de,
        "Da ist Phantasus, mein kleiner Bote"@de,
        "Dieser Becher voll schäumenden Nectars"@de,
        "Du bringst mir Botschaft von Olymps Beherrscher?"@de,
        "Durch die Stille des Walds"@de,
        "Erfreuet der Klang nicht dein Ohr?"@de,
        "Heil Apollo! von den hohen Hallen"@de,
        "Ich soll fort vom Leben"@de,
        "Nun schwindet hinter Wald"@de,
        "O traute Lyra! letzter Trost im Tode!"@de,
        "Unser strahlender Fürst"@de,
        "Von ihrer Lippe schon entweicht die Seele"@de,
        "Vorwärts! Hör, der Baüme Säuseln"@de ;
    cnw:meter "4/4" ;
    cnw:performingForce "A",
        "A.",
        "B",
        "B.",
        "MezzS",
        "MezzT",
        "S",
        "S.",
        "T",
        "T.",
        "arp.",
