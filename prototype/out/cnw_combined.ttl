<https://cnw-ld.org/work/SchWB2-433/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-433> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Der Schäfer, wenn mein Arm ihn bindet"@de,
        "Die allgemeine Lust"@de,
        "Die lockende Freude, das brünstige Scherzen"@de,
        "Es jauchzen die Völker, es scherzen die Felder"@de,
        "Göttin der Liebe"@de,
        "König! Wir danken vor dieses Ergetzen"@de,
        "Mir folgen Wonne, Scherz und Liebe"@de,
        "O König! dieses Fest dankt Dir Dein ganzes Reich"@de,
        "Prinzeßiin! Preis erhabner Schönen"@de,
        "Qvell der Freude"@de,
        "Singet, scherzende Najaden"@de,
        "Welch ein Triumph vor mich!"@de,
        "Wie schön vereinigt sich die Schickung und die Liebe!"@de,
        "Wo der Verstand regiert"@de,
        "Zärtliche Bande! Ergetzende Flammen!"@de,
        "So recht! erkennt ihr nun die Führung meiner Hand"@en ;
    cnw:performingForce "Voice",
        "voice" .

