<https://cnw-ld.org/work/SchWB2-435/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-435> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Beglückte, ja, wir kommen"@de,
        "Des Himmels schönste Kronen"@de,
        "Eines Fürsten schönster Lohn"@de,
        "Er soll, was nun sein Vater thut"@de,
        "Er wandle nur der Tugend Bahn"@de,
        "Er wähle sich nur dich, Religion"@de,
        "Frolocke, glückliches Volk!"@de,
        "Fürsten sind Götter! – Doch werden sie sterben!"@de,
        "Ich winde meine Kränze"@de,
        "Ich, wenn er sich von dir beherrschen läßt"@de,
        "Noch blühn wir durch Friedrichs Milde! –"@de,
        "Tödtend flammt das Weltgericht"@de,
        "Wie der Thau von Libanon"@de,
        "Wie seelig kann nicht schon auf Erden"@de,
        "Wir wollen alle Dich beglücken"@de ;
    cnw:performingForce "voice" .

<https://cnw-ld.org/work/SchWB2-436> a mo:MusicalWork,
        frbr:Work ;
    dcterms:created "1750" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    dcterms:identifier "SchW B2:436" ;
    dcterms:language "Danish",
        "German" ;
    dcterms:subject "Cantata",
        "Music for vocal soloists and instruments with or without choir",
        "Occasional",
        "Secular",
        "Vocal music" ;
    dcterms:title "Singgedichte vor der neuaufgerichteten musikalischen Gesellschaft in Kopenhagen bey der Einweyhung des ihren wöchentlichen Zusammenkünften gewiedmeten Saales aufgeführet"@de ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-436/expression/1> ;
    cnw:catalogueCode "SchW" ;
    cnw:cnwNumber "B2:436" ;
    cnw:editorialNote "'I Onsdags, den 24 hujus, blev den til det ny oprettede Musicaliske Selskabs ugentlige Forsamlinger destinerede Sal udi den nybygte store Gaard i Raadhuus-Stræde udi adskillige høye Stands- og Rangs-Personer gracieuse Overværelse solenniter indviet, og i den Anledning en yndig Vocal- og Instrumental-Musiqve opført, hvis Poesie og Composition var af den Kongel. Capellmester Hr. Scheibe.'",
        "'Ungefehr im Februar 1751. ward ein zu den öffentlichen Zusammenkünften und Concerten wohl eingerichteter Saal in Gegenwart einer großen Anzahl ansehnlicher Personen, worunter sich viele aus dem ersten und andern Range befanden, durch eine wohlbesetzte Instrumental- und Vokalmusik unter Trompeten- und Pauckenschall aufs feyerlichste eingeweihet, wobey unter anders Se. Hochfürstl. Durchl. der Prinz von Anhalt-Cöthen nebst einigen Rittern und andern Großen selbst mitspielten. Auf Ersuchen der Gesellschaft hatte ich dazu Poesie und Musik verfertiget.'",
        "The journal gives the title of the printed text mentioning that 'Wir haben von dieser recht ruhmwürdigen Gesellschaft von Kennern und Liebhabern der Tonkunst schon in unserm neunzehenden Stück Nachricht gegeben.'" ;
    cnw:performanceCount 0 ;
    cnw:textAuthor <https://cnw-ld.org/agent/johann_adolph_scheibe> .

