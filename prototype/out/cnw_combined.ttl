    cnw:incipitImage "NWGW_167_1.png" ;
    cnw:incipitText "Baldur i de Dødes Rige!"@da,
        "Baldur! Baldur, tal"@da,
        "Højst blandt de Høje paa Guders Stol"@da,
        "Ikkun Blændværk er Nattens Drøm!"@da,
        "Nu stiger Odin op til Valhalla"@da,
        "Pagten er sluttet, Faren er svunden!"@da,
        "Thor, du stærke! hjælp nu du!"@da,
        "Uprøvede i Modgangs tunge Lod!"@da,
        "Velan! I alle Guders Navn sin Røst oplader Frigge!"@da,
        "Balder in dem Reich des Todes!"@de,
        "Balder! Balder, sag"@de,
        "Euch unbekannt blieb Unglücks hartes Loos!"@de,
        "König der Kön'ge, im Göttersaal"@de,
        "Leeres Blendwerk ist Traum der Nacht!"@de,
        "Nun steiget Odin auf gen Walhalla"@de,
        "Pacht ist geschlossen, Wolke verschwunden!"@de,
        "Thor, du starker, hilf nun du!"@de,
        "Wohlan! In aller Götter Namen die Stimme erhebet Frigge!"@de ;
    cnw:meter "3/4" ;
