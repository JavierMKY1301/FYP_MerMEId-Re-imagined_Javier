<https://cnw-ld.org/work/CNW2/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/CNW2> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "cnw_002_1_1.png" ;
    cnw:incipitText "Aa ja, aa ja, ja, ja"@da,
        "Aa, med Forlov, De!"@da,
        "Af Sted! Af Sted Nu er det Sværmetid"@da,
        "At slig er Ungersvend i sin Tale"@da,
        "Columbiner, Harlekiner"@da,
        "Come in! Come out!"@da,
        "Der gad jeg nok være med"@da,
        "Det Satans Spind!"@da,
        "Dit Snakketøj gaar ej i Staa"@da,
        "En Cinquepas, en Galliard"@da,
        "Er der nogen hjemme?"@da,
        "Gaa af Vejen! Gaa af Vejen!"@da,
        "Gibt Platz! Gibt Platz! Nu tag, du Borgermand dit Kvindfolk i Agt"@da,
        "Gør Plads! Gør Plads!"@da,
        "Hehe, hehe, hehe, hehe! Here comes assault and Battery!"@da,
        "Her er jeg, Husbond!"@da,
        "Herre! Herre! Kom kun frem"@da,
        "Hov! Vægter, Klokken er slagen ni!"@da,
        "Hov! Vægter. Klokken er slagen otte"@da,
        "Hr. Leonard, Herrens tilkommende Svoger"@da,
        "Hum! Nu jeg skal te'et er jeg dog ikke rigtig dristig ve'et"@da,
        "Hvis ej Jer Mine lyver slemt"@da,
        "Hør et Ord Kavaler, nu rask! Kom her!"@da,
        "Kan I være rolige!"@da,
        "Kehraus! Kehraus! Dans ud! Dans ud! Dans ud!"@da,
        "Kom ind! Kom ud!"@da,
        "Lad vær' at knibe mig, Jeg skriger"@da,
        "Let paa Taa og Hus forbi"@da,
        "Luk op! Luk op!"@da,
        "Mellem Kande, Krus og Potte"@da,
        "Min Herre De maa maske Dem"@da,
        "Min Herre se som Venus steg af Havet"@da,
        "Min Herre. Min Pigeære"@da,
        "Min søde balsambøsse"@da,
        "Monsieur Jeronimus!"@da,
        "Naar Hjertet brænder, hvad Lykken sender"@da,
        "Naar Mars og Venus har endt deres Spil"@da,
        "Og dette skal være vor Border til Ære"@da,
        "Oh, kom min Ven!"@da,
        "Porten er aaben! Borte er Hoben"@da,
        "Se saa! Se saa! Nu er jeg bered"@da,
        "Se, Henrik! se, hvor Nat og Mørke knuger den gamle Gaard"@da,
        "Studenter! Studenter! /Pomeranser! Pomeranser!"@da,
        "Tramtrara! Tramtrara!"@da,
        "Ulignelige Pige"@da,
        "Ydmygste Tjener, Madam! og Tak for Dansen!"@da,
        "[Fordum var her Fred paa Gaden]"@da,
        "[Først kommer fæl og fus Monsør Jeronimus]"@da,
        "A cinquepas, a galliard"@en,
        "A toast for our brother, our colleague and brother"@en,
        "An ardent lover, when fortune beckons"@en,
        "Clear the way there! Clear the way there!"@en,
        "Columbines, Harlequins, sir"@en,
        "Com on! Come on! Let's go and join the fun!"@en,
        "Dance on, dance on! Dance on, dance on, dance on!"@en,
        "Fleet of foot and fancy free!"@en,
        "Good it was open, no sign of people"@en,
        "Good master! My maiden honour"@en,
        "Herr Leonard, your cousin-in-law-to-be, sir!"@en,
        "Hihi, hihi, hihi, hihi, det blir et farligt Skænderi"@en,
        "Ho! Watchman! Eight o'the clock, good people!"@en,
        "Ho, watchman! Nine o'clock sounds, good folk!"@en,
        "I don't like to say it, but I'm a coward and my knees betray it"@en,
        "I thought you'd never stop, my lad"@en,
        "I wouldn't mind being there"@en,
        "I'm coming, master!"@en,
        "If looks are any guarantee"@en,
        "In among the pots and dishes"@en,
        "Incomparable lady"@en,
        "Is that you, Leander?"@en,
        "Let go of me, or I'll start yelling!"@en,
        "Listen here, cavalier! Look sharp! Come here!"@en,
        "Make room! Make room!"@en,
        "Make way! make way! Now, worthy citizens, lock up your women folk"@en,
        "Master! Master! Come on out!"@en,
        "Monsieur Jeronimus!"@en,
        "Oh - ha, ay- ay, ay, - ay!"@en,
        "Oh, come my pride!"@en,
        "Open up! open up!"@en,
        "Out of my way, you!"@en,
        "See, Henrik, how the darkness creeps and fluters round this old house"@en,
        "That place of sin!"@en,
        "This way! This way! I'm ready for the fray!"@en,
        "To catch an eel with bare hands"@en,
        "Tramtrara! Tramtrara!"@en,
        "When Mars and Venus had finished their game"@en,
        "Why, master, look! Like Venus from the water, ascending"@en,
        "Will you please be quite there?"@en,
        "You have to wear a mask, you know"@en,
        "You pretty little mistress"@en,
        "You students, you students / Buy my oranges!"@en,
        "Your humble servant, madame! I praise your dancing!"@en,
        "[First enter furious Monsieur Jeronimus]"@en,
        "[Time was when our street was silent]"@en ;
    cnw:meter "6/8" ;
    cnw:performingForce "B.",
        "B.Bar.",
        "Bar.",
        "Mezz.S.",
        "S.",
        "T.",
        "T.Bar.",
        "camp.",
        "cast.",
        "cb.",
        "cl.",
        "cl.b.",
        "cor.",
        "cor.ingl.",
        "fg.",
        "fl.",
        "fl. / fl.picc.",
        "glsp.",
        "gr.c.",
        "ob.",
        "ptti.",
        "tam.",
        "tamb.picc.",
        "tb.",
        "timp.",
        "tr.",
        "trb.b.",
        "trb.t.",
        "trgl.",
        "va.",
        "vc.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Allegro ma non tanto" .

