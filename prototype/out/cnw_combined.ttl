<https://cnw-ld.org/work/NWGW162/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/NWGW162> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "NWGW_162_00.png" ;
    cnw:incipitText "Ak! Snart det er Nat! Alt Vinden suser i Granernes Top"@da,
        "Alt i Kvæld slaar jeg den stolte Konges Hær"@da,
        "Frem, frem, frem, fremad til Kamp"@da,
        "Frem, fremad til Kamp. Fingal fører til Seir."@da,
        "Hvor alt er tyst og stille! De svandt, de svandt de livsalige Drømme!"@da,
        "Højt fra Skyernes Krands skue de Henfarnes Aander"@da,
        "Nu flygter den stolte Caracul, hans Ganger foer bort over Heden"@da,
        "O stands den glade Sejerssang, du Fingals Kriger ti, o ti!"@da,
        "O! o sad jeg dog hist ved Caruns Vover!"@da,
        "Sorgens Taager stille svæve om min Elsktes Hvilested"@da,
        "Suaran, den Lochlins Konge, drog over Bølgen blaa"@da,
        "Vi drage som Storm over Hede"@da,
        "Auf, auf in die Schlacht, Fingal führt zum Sieg!"@de,
        "Auf, auf, auf, laut schall das Horn"@de,
        "Aus den Wolken herab schauen die Geister der Ahnen"@de,
        "Entfloh'n ist der Feind' Getöse, nicht sieht man sein Ross auf den Höhen"@de,
        "Heute noch brech' ich des stolzen Königs Macht"@de,
        "Lasst ab vom lauten Siegsgesang, ihr Krieger Fingals, schweigt, o schweigt!"@de,
        "Lasst mich schauen die Geliebte, zeiget, wo die Holde schläft"@de,
        "O grauenvolle Stille! dahin, dahin sind die lieblichen Träume"@de,
        "O, o, dass ich nicht sitze an Caruns Wellen"@de,
        "Still, still ist die Jagd, kein Laut ertönt, als das Brausen des Strom's"@de,
        "Vom Lochlin kam gezogen Suaran, der stolze Held"@de,
        "Wir wandeln auf dem Sturm"@de ;
    cnw:meter "4/4" ;
    cnw:performingForce "A.",
        "B.",
        "Bar.",
        "MezzS.",
        "S.",
        "T.",
        "arp.",
        "cb.",
        "cl.",
        "cor.",
        "fg.",
        "fl.",
        "ob.",
        "ptti.",
        "tb.",
        "timp.",
        "tr.",
        "trb.",
        "va.",
        "vc.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Molto moderato" .

