<https://cnw-ld.org/work/SchWC1-008> a mo:MusicalWork,
        frbr:Work ;
    dcterms:alternative "Critischer Musikus"@de ;
    dcterms:created "1737–40" ;
    dcterms:identifier "SchW C1:008" ;
