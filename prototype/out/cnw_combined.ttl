    cnw:catalogueCode "SchW" ;
    cnw:cnwNumber "C1:001" ;
    cnw:editorialNote " Musikalischer Bücher. I. Historie der Musik: 'Scheibens, (Joh. Adolph, Königl. Dänischen Capellmeisters) Abhandlung vom Ursprunge und Alter der Musik, insonderheit der Vocal-Musik. Altona und Flensburg 1754. 8vo. 6 gl.'" ;
    cnw:performanceCount 0 .

<https://cnw-ld.org/work/SchWC1-001/expression/1> a frbr:Expression ;
