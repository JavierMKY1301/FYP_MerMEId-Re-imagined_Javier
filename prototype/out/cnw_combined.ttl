<https://cnw-ld.org/work/NWGW165/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/NWGW165> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "NWGW_165_00.png" ;
    cnw:incipitText "Alt vented jeg ved Borgeled"@da,
        "Dandsen gaaer saa let gjennem Lunden!"@da,
        "Herr Oluf standsed sin Ganger i Kvæld"@da,
        "Hør du, Herr Oluf, kjær Sønnen min!"@da,
        "I Øster stiger Solen op"@da,
        "Læg Sadel paa min raske Hest"@da,
        "Natten er stille!"@da,
        "Nu synker Sol i Luften blaa"@da,
        "Saa tidt jeg rider mig under Ø"@da,
        "Thi raader jeg hver dannis Svend"@da,
        "Drum rath' ich jedem Jüngling an"@de,
        "Herr Oluf Abends hielt an sein Ross"@de,
        "Hör' du, Herr Oluf, sag' an mir gleich"@de,
        "Ich wartet' an des Hauses Thür"@de,
        "Im Osten geht die Sonne auf"@de,
        "In's blaue Meer die Sonne sinkt"@de,
        "Leicht nun schwebt der Tanz durch die Haine!"@de,
        "Nacht, o wie stille!"@de,
        "So oft mein Auge die Fluren schaut"@de,
        "Willkommen Herr Oluf, was eilst du von hier?"@de,
        "Zäum' auf mein Ross mit goldner Kett'"@de,
        "Velkommen, Herr Oluf, lad fare din Fig"@en ;
    cnw:key "E major" ;
    cnw:meter "6/8" ;
    cnw:performingForce "A.",
        "B.",
        "S.",
        "T.",
        "cb.",
        "cl.",
        "cor.",
        "fg.",
        "fl.",
        "ob.",
        "picc.",
        "ptti",
        "timp.",
        "tr.",
        "trgl.",
        "va.",
        "vc.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Andantino" .

