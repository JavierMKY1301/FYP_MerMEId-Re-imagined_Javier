    cnw:incipitImage "NWGW_150_01.png" ;
    cnw:incipitText "Beed til Gud og tænk paa mig"@da,
        "Den Fryd at dele Venners Glæde"@da,
        "Dør fra Dør jeg maatte gaae"@da,
        "Før vi fra Hjemmet drage"@da,
        "Leve Champagnens søde Druer"@da,
        "Min Barndoms svundne Glæder jeg gjenfinder i Dig"@da,
        "Modtag da vort Farvel! Himlen skjænke Jer Held!"@da,
        "O hvilken Fryd naar man en Ven fra den elskte Dal gjenfinder"@da,
        "Send, Madonna! fra det Høie Styrke til min Moder ned!"@da,
        "Stjernerne tindre paa Himmelens blaa"@da,
        "Sødeste Nanette jeg i en Karet, laridette"@da,
        "Tre Sous jeg og tre Sous Du?"@da,
        "Ud i Livets Trængsler"@da,
        "Ud i Livets Trængsler og Farer"@da,
        "Vær gjenhilset, elskte Dale"@da ;
    cnw:meter "6/8" ;
    cnw:performingForce "A.",
        "B.",
        "S.",
        "T.",
        "cb.",
        "cl.",
        "cor.",
        "fg.",
        "fl.",
        "ob.",
        "picc.",
        "va.",
        "vc.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Allegro" .

