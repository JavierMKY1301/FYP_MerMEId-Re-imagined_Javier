<https://cnw-ld.org/work/SchWB2-417> a mo:MusicalWork,
        frbr:Work ;
    dcterms:created "1766" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    dcterms:identifier "SchW B2:417" ;
    dcterms:language "Danish",
        "English",
        "German",
        "Italian" ;
    dcterms:subject "Cantata",
        "Music for vocal soloists and instruments with or without choir",
        "Occasional",
        "Vocal music",
        "secular" ;
    dcterms:title "Das Urtheil des Paris, ein Singgedicht. Welches an dem höchsterfreulichen Vermählungsfeste Königs Christian des Siebten und Caroline Mathildis"@de,
        "Il giudicio di Paride, drama per musica. Da cantarsi per le felicissime nozze di sua maestà Cristiano VII e Carolina Matilde"@it ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-417/expression/1> ;
    cnw:catalogueCode "SchW" ;
    cnw:cnwNumber "B2:417" ;
    cnw:editorialNote "'Saasnart de Høy-Kongelige Herskaber i Ridder-Salen vare indkomne begyn[d]tes strax med Pauker og Trompetter og continueredes dermed indtil Tegn af Ober-Hof-Marskallen blev givet at opholde. Over Taffelet opførtes en af Capelmester Scheibe componeret prægtig Musik, bestaaende af 80ve Musicis.'" ;
    cnw:performanceCount 1 ;
    cnw:textAuthor <https://cnw-ld.org/agent/leopoldo_di_villati> .

<https://cnw-ld.org/work/SchWB2-417/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-417> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Der Zorn nimmt mein Herz ganz ein"@de,
        "Dir verspreche ich ein erkenntliches Herz"@de,
        "Geliebter Paris! ich sehe, du erblassest"@de,
        "Ich besitze den Ruhm der Schönheit"@de,
        "Ich, der Bothe Jupiters, komme zu dir"@de,
        "Ihr Königlichen Vermählten!"@de,
        "Itzt hast du, schöne Königinn"@de,
        "Laß dich nicht den eitlen Glanz des Goldes verblenden"@de,
        "Mein Schäfer"@de,
        "Schöne Göttinn"@de,
        "Schöne Venus"@de,
        "Weisheit ist das grosse Gut"@de,
        "Wenn du sehen wirst, daß jene schönen und glänzenden Augen"@de,
        "Paris, ich erröthe vor Scham"@en,
        "(Tutto occupate il cor, o sdegni miei)"@it,
        "Bella Dea, che degli Dei"@it,
        "Bella Venere"@it,
        "Della bellezza ho il vanto"@it,
        "E' il sapere quel gran Bene"@it,
        "Grato core a te permetto"@it,
        "Messagiero di Giove a te me vengo"@it,
        "Mio Pastorello"@it,
        "Non ti lusinghi il vano splendor dell' oro"@it,
        "Or tu vedesti, o bella Regina"@it,
        "Paride caro, impallidir ti veggo"@it,
        "Paride, io m'arrossisco di cimentar"@it,
        "Reali Sposi Augusti!"@it,
        "Se vedrai que' begli occhi lucenti"@it ;
    cnw:performingForce "voice" .

<https://cnw-ld.org/work/SchWB2-418> a mo:MusicalWork,
        frbr:Work ;
    dcterms:created "1769" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    dcterms:identifier "SchW B2:418" ;
    dcterms:language "Danish",
        "English",
        "Italian" ;
    dcterms:subject "Cantata",
        "Instrumental music",
        "Music for vocal soloists and instruments with or without choir",
        "Secular",
        "Vocal music" ;
    dcterms:title "Joseph, som giver sig tilkiende for sine Brødre. Et musikalsk Stykke"@da,
        "Giuseppe riconosciuto, dramma sacro per musica"@it ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-418/expression/1> ;
    cnw:catalogueCode "SchW" ;
    cnw:cnwNumber "B2:418" ;
    cnw:editorialNote "'NB. NB. Musikens Velyndere og Liebhabere bekiendtgiøres, at den 1ste, 8de og 15de October næstkommende, bliver om Eftermiddagen præcise Kl. 5. paa Bryggeres Laugshuus-Sahl, opført et stort Drammatisk Synge-Stykke under Titul: G[iu]seppe riconosciuto, Dramma sacro per Musica, eller Joseph, som giver sig tilkiende for sine Brødre: Et Synge-Stykke af den hellige Skrift. Poesien er af den berømte Abbed Metasta[s]io, og den dertil nye componerede Musik af Capellmester Scheibe. Entreen koster pro Persona 1 Rdlr., hvorfor tillige gratis bekommes den trykte Italienske Text vedsatte Hr. Soelbergs Danske Oversettelse. Liebhaberne kan og bekomme Billets til Entre pro Persona for alle 3de Gange, eller og hvorpaa en Aften 3 Personer kan indgaae, Stykket 2 Rdlr. men hvorimod de den trykte Text betaler med 1 Mk. Danske. Billetterne kan fra i Dag af bekommes alle Formiddage fra Kl. 8 til 12 hos Capellmester Scheibe, boende i Reverentz-Gaden, imellem Hr. Cammer-Raad Post og Tracteuren Monsr. Marechall.'" ;
    cnw:performanceCount 0 ;
    cnw:textAuthor <https://cnw-ld.org/agent/pietro_metastasio> .

<https://cnw-ld.org/work/SchWB2-418/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-418> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Ak min Mand, du har sagt sandt"@da,
        "Der kommer Simeon. O dersom han kunde tænke"@da,
        "Dersom I føler Medynk"@da,
        "Dersom du ei vil at han maa blive frie"@da,
        "Dersom enhvers indvortes Bedrøvelse"@da,
        "Det er Naturens Lov"@da,
        "Det er en Daare som opsetter sine Raad imod Guds Raad"@da,
        "Du har optændt en Ild"@da,
        "Du store Abrahams Gud"@da,
        "Du store Abrahams Gud! Beskierm dit Folk!"@da,
        "Eders Gaver behager mig"@da,
        "Er ingen af de Jødiske Brødre endnu komne tilbage til Memphis?"@da,
        "Forlader han os saaledes?"@da,
        "Gaae bort, Asnat kommer"@da,
        "Har du fuldbyrdet min Befaling?"@da,
        "Herre, her ere Misdæderne"@da,
        "Herre, her ere dine Befalinger"@da,
        "Holder Stand, I mine Sinds Lidelser"@da,
        "Jeg seer mig i en forfærdelig mørk og fæl Skov"@da,
        "Jeg veed, at den taber Æren"@da,
        "Jeg vil være som en kierlig Moder"@da,
        "Jeg vilde nok see dig"@da,
        "Jeg vilde, for at trøste ham"@da,
        "Men den Graad taler"@da,
        "Min Mand! er mig tilladt at vente en Naade af dig?"@da,
        "Naar man kuns kaster sine Øjne"@da,
        "Nei, Himlen forbyde at jeg skulde vise saa stor Strænghed"@da,
        "O Gud! Det forekommer mig"@da,
        "O Retfærdige!"@da,
        "Og dette er nok til at foruroelige dig?"@da,
        "Vi bringer dig, som Skatskyldige"@da,
        "Du, evige Sandhed, som seer vores Sieles Hemmeligheder"@en,
        "Ah sposo, il ver dicesti"@it,
        "Consorte, è a me permesso sperar grazia da te?"@it,
        "Così ci lascia?"@it,
        "D'ogni pianta palesa l'aspetto"@it,
        "Defendi il popol tuo, gran Dio d'Abramo!"@it,
        "Del reo nel core"@it,
        "E legge di natura"@it,
        "E qvesto basta a tormentarti?"@it,
        "Ecco, o Signore, i rei"@it,
        "Eseguisti il mio cenno"@it,
        "Folle chi oppone i suoi a' consigli di Dio"@it,
        "Gradisco i doni vostri"@it,
        "Gran Dio d'Abram, siam rei"@it,
        "Ma parla qvel pianto"@it,
        "Nell' orror d'atra foresta"@it,
        "No, no tanto rigore tolga il ciel ch'io dimostri"@it,
        "Nè degl Ebrei germani in Mensi ancora nessuno ritorno?"@it,
        "O Diò! Che sembrami"@it,
        "Oh giusto!"@it,
        "Portiamo in tributo"@it,
        "Sarò qval madre amante"@it,
        "Se a ciascun l'interno affanno"@it,
        "Se libero nol vuoi"@it,
        "Signore, i cenni tuoi"@it,
        "So, che la gloria perde"@it,
        "Soffrite, affetti miei"@it,
        "Tu che dell' alme nostre eterna Verità, vedi gli arcani"@it,
        "Vanne, s'appressa Aseneta"@it,
        "Vederti io bramerei"@it,
        "Vien Simeone. Oh se pensar potesse"@it,
        "Voi, se pietà provate"@it,
        "Vorrei per consolarlo"@it ;
    cnw:performingForce "voice" .

