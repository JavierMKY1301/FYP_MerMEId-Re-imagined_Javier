<https://cnw-ld.org/work/NWGW179/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/NWGW179> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "NWGW_179_01.png" ;
    cnw:incipitText "Allbesieger, o Eros!"@de,
        "Breit' aus die Flügel ohne Furcht und Beben"@de,
        "Dank Euch, holde Schwestern"@de,
        "Du siegtest, o Venus, das Herze ihr brach"@de,
        "Eros! Ich fühl's, ich fühl's, dein Herz mir jetzt Verzeihung gab"@de,
        "Hört munt'rer Vögel Chor"@de,
        "Im wallend, dunkelblauen Mantel"@de,
        "In Hellas, in Hellas"@de,
        "Noch ruhet Morgendämmerung auf der Flur"@de,
        "Psyche! Psyche! Wer ruft?"@de,
