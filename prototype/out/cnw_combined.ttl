    cnw:incipitImage "NWGW_178_01.png" ;
    cnw:incipitText "Ad Tidens Strøm, hvis Kyster hun vil tegne"@da,
        "Aldrig din higende Attraa du stiller"@da,
        "Det Ord, hun hørte bag Judæas Ranker"@da,
        "En Vingaardsmø med arbejdsvante Hænder"@da,
        "Fiskerdrengen leger ved salten Vesterhav"@da,
        "Her saae vi gjennem Kundskabs Glar"@da,
        "Hun, vort Aarhundreds kjække Yndlingsterne"@da,
        "Men vil du have Svar, da spørg dig først: Hvad var din Længsel"@da,
        "Saa voxe tusind Spørgsmaal"@da,
        "Skjøndt ammet op i Sydens Marmorsale"@da,
        "Thi Hver fik eget Kald og Kaar"@da ;
