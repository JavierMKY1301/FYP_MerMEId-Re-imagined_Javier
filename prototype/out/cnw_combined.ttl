    cnw:incipitImage "hartw_184_01.png" ;
    cnw:incipitText "Da kaldte Herodes de Vise hemmelig"@da,
        "Gaar hen, gaar hen og udspørger flittelig om Barnet"@da,
        "Herrens Engel aabenbaredes for Joseph"@da,
        "Hvor er den Jødernes Konge"@da,
        "I Bethlehem, i Judæa"@da,
        "Men da Jesus var født i Bethlehem"@da,
        "Men der Kong Herodes det hørte"@da,
        "Og se! se! Stjernen, som de havde set i Øster"@da,
        "Da nun Jesus geboren in Bethlehem"@de,
        "Des Herren Engel offenbarte sich vor Joseph"@de,
        "Doch da nun Herodes das hörte"@de,
        "Herodes berief nun die Weisen heimlich"@de,
        "In Bethlehem, in Judäa"@de,
        "Und siehe! siehe, der Stern, denn sie sahen im Osten"@de,
        "Wo ist der König der Juden"@de,
        "Zieh't hin, zieh't hin und forschet dort fleissig nach dem Kindlein"@de ;
