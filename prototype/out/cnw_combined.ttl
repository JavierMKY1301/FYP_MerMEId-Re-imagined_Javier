<https://cnw-ld.org/work/HartW355/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/HartW355> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "hartw_355_01.png" ;
    cnw:incipitText "Abildtræet i Skoven staar"@da,
        "Bort, bort! jeg vil flye"@da,
        "Det er ingen Drøm. Jeg hører hans Røst"@da,
        "Din Deilighed glemmer jeg aldrig meer"@da,
        "Dvæl, Elskede, dvæl!"@da,
        "Er du vaagen? Elskede!"@da,
        "Fornam jeg en Klang?"@da,
        "Hun sover derinde"@da,
        "Jeg besværger Jer, Piger!"@da,
        "Stiig ned fra dit Bjerg!"@da,
        "A tent is her bower"@en,
        "Art awake thou, loved one?"@en,
        "Come down from thy mount!"@en,
        "Hence, hence! I will fly"@en,
        "I beseech ye, sweet maidens!"@en,
        "It is not a dream, his voice I can hear"@en,
        "Stay, loved one! stay!"@en,
        "Th' Citron, grandest of all trees, grows"@en,
        "Thy beauty will e'er in my mem'ry be"@en,
        "Was't music's clang?"@en ;
    cnw:key "E-flat major" ;
    cnw:meter "2/2" ;
    cnw:performingForce "pf.",
        "voice" ;
    cnw:tempo "Allegro non tanto" .

