<https://cnw-ld.org/work/NWGW148/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/NWGW148> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "NWGW_148_00.png" ;
    cnw:incipitText "Ak! I svandt hen, min Lykkes Drømmerier / Med ham jeg vanked under Piniers Kroner"@da,
        "Alt ruger Mørket over dunkle Lund / Min Clothilde! Dette Møde os forsone skal med Gud"@da,
        "Der staaer hun! Det er Fruentimmeret!"@da,
        "En Morgen i Orangens Skygge jeg vandred med ham Arm i Arm"@da,
        "Farvel! Farvel, min elskte Pige"@da,
        "For anden Gang jeg træde maa tilbage"@da,
        "Før os ind til den hellige Mand!"@da,
        "Hil Dig! Fyrste! Kronens Smykke skal du bære til vor Lykke!"@da,
        "Hvilken Glæde! hvilken Glæde, hvilken Lykke!"@da,
        "I denne stille Dal, hvor Eremitten boer / I Hytten hist under Rankens Læ"@da,
        "Ja Himlen signe vil vor Pagt"@da,
        "Kom hid! Kom hid vær snar!"@da,
        "Kom mig til Hjælp! beskyt mig Eders Naade"@da,
        "Kom! uden Dig, min Sjæls Veninde"@da,
        "Nu saa fortæl mig da hvad du veed"@da,
        "O Himmel! hvilke Qvaler!"@da,
        "O Lykke! Det er ikke hende!"@da,
        "Saa slip mig dog, saa slip mig dog"@da,
        "Stille, stille! nu jeg veed, nu jeg veed en gevaltig Hemmelighed"@da,
        "Tamburinens Bjælder klinge til Castagnettens Slag"@da,
        "Velan! saa hør da, men vær taus og snild"@da,
        "Øieblikket er nær, da min Skjæbne skal afgjøres / Stille jeg Gardinet rører!"@da ;
    cnw:meter "6/8" ;
    cnw:performingForce "A.",
        "B.",
        "S.",
        "T.",
        "cb.",
        "cl.",
        "cor.",
        "fg.",
        "fl.",
        "ob.",
        "org.",
        "picc.",
        "tb.",
        "timp.",
        "tr.",
        "trb.",
        "trb.b.",
        "va.",
        "va. solo",
        "vc.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Allegro molto vivace" .

