<https://cnw-ld.org/work/HartW181/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/HartW181> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "hartw_181_01.png" ;
    cnw:incipitText "Bær da Spiret, Konge, som Du plejer"@da,
        "De Dage svandt, for aldrig op at staa"@da,
        "Dog, har til Maal Du sat Dig, Drot"@da,
        "En Konges Haand har det plantet, Kundskabs Træ i vor Jord"@da,
        "Er paa Jord vi som de Svage vegne Fod for Fod"@da,
        "Og priset være hans Herskerslægt"@da,
        "Og som i Natten ved Sanct Hans"@da,
        "Sekler svandt"@da,
        "Tider der var, da et Kæmpekuld drog fra vort Hjem"@da,
        "Tog Kronen, Konge, Du i tunge Tider"@da,
        "Tynger end Kronen, den vorde Dig let"@da ;
    cnw:meter "4/4" ;
    cnw:performingForce "B.",
        "Baritone",
        "T.",
        "Tenor",
        "cb.",
        "cl.",
        "cor.",
        "fg.",
        "fl.",
        "ob.",
        "tb.",
        "timp.",
        "tr.",
        "trb.",
        "va.",
        "vc.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Allegro risoluto, non troppo" .

