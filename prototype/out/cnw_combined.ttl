        "Din Sjæl være ung, da er ingen Byrde Dig tung"@da,
        "For din Fod jeg nedlægger Harpen"@da,
        "Fra Philisternes Hær atter Kæmpen staaer frem"@da,
        "Hos de raske Vaabendrenge vil jeg gribe Harpens Strenge"@da,
        "Israels Gud, du os høre"@da,
        "Jehova! Jehova!"@da,
        "Nu er det skeet og ei var Tid at spørge"@da,
        "Offerrøgen sig svinge gjennem Himlens Pauluner"@da,
        "Til Kamp med Ham til Striden"@da,
        "Ud i Leiren, ud til Seiren"@da ;
    cnw:meter "4/4" ;
    cnw:performingForce "A.",
        "B",
        "B.",
        "S",
        "S.",
        "T",
        "T.",
        "arpa",
        "cb.",
        "cl.",
        "cor.",
        "fg.",
        "fl.",
        "ob.",
        "ptti.",
        "timp.",
        "tr.",
        "trb.a",
        "trb.b",
        "trb.t",
        "trgl.",
        "va.",
        "vc.",
        "vl. solo",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Maestoso" .

