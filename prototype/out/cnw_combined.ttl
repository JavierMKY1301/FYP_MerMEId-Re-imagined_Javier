<https://cnw-ld.org/work/SchWB2-438/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-438> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "Ach! – Viisdoms første Støtte faldt!"@da,
        "Herre! lad mig kiende min Ende"@da,
        "O maatte dog din Lovsang være"@da,
        "O! – kunde du strax skabe os til Guder –"@da,
        "Svøbt i Regn belys vor Jammer"@da,
        "Vor Ven, vor Lærer og vor Lyst"@da ;
    cnw:performingForce "soloist",
        "soloists" .

<https://cnw-ld.org/work/SchWB2-439> a mo:MusicalWork,
        frbr:Work ;
    dcterms:created "1752" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    dcterms:identifier "SchW B2:439" ;
    dcterms:language "Danish",
        "English",
        "German",
        "Italian" ;
    dcterms:subject "Cantata",
        "Music for vocal soloists and instruments with or without choir",
        "Occasional",
        "Sacred",
        "Vocal music" ;
    dcterms:title "Der Tempel des Ruhmes. Ein Singgedicht. Am Einzugstage der itztregierenden Königinn Juliana Maria in Copenhagen"@de ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-439/expression/1> ;
    cnw:catalogueCode "SchW" ;
    cnw:cnwNumber "B2:439" ;
    cnw:editorialNote "Scheibe mentions the work in connection with a performance of it in the Musical Society in 1752.",
        "[si replica (= 7:1)]",
        "[si replica (= 7:5)]",
        "si replica [= no. 1:4]",
        " 'Es donnert. Nur ruhig! euch schadet kein Wetter, merkt man, dass der Hr. Verfasser der Musik hat Gelegenheit machen wollen sich zu zeigen. Die Abwechselung der Namen Juliana und Maria ist zwar nur eine Kleinigkeit, hätte aber doch vermieden werden können.'",
        " 'Ved den almindelige Glæde, som i disse Dage har opfyldt denne Hovedstad, har ogsaa det høylovelige Musicaliske Selskab udi Raadhuus-Gaden distingueret sig. Efterat samtlige Lemmer af dette priiselige Selskab, deels fra Reyser, deels fra Landet, havde indfundet sig igien her i Staden, aabnede Societetet den 18 hujus igien sin i Fior med saa stor Applausu begyndte Concerts, med en prægtig Musiqve paa Hendes Majestests, vor Allernaadigste Dronnings solenne Indtog, som med Pauker og Trompeter blev opført. Den dertil forfærdigede Poesie og Musique er af den noksom bekiendte og habile Kongel. Capellmester, Hr. Scheibe, under den Titel: Der Tempel des Ruhms, en Singgedicht, paa det netteste udført. Og har Verket ey allene ved de mangfoldige derudi forekommende Forandringer, men ogsaa formedelst et derved anbragt sangverk, fortient et almindeligt Bifald.'" ;
    cnw:performanceCount 0 ;
    cnw:textAuthor <https://cnw-ld.org/agent/johann_adolph_scheibe> .

<https://cnw-ld.org/work/SchWB2-439/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-439> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "SchM_068_1_1.png" ;
    cnw:incipitText "Verwundernd sahen wir den prächtgen Einzug an"@da,
        "Alle Freude dieses Lebens"@de,
        "An diesem Ort bey meinem König"@de,
        "Der Stammbaum verneue sich jährlich entzückend!"@de,
        "Die Wahrheit strahlt aus ihren Blicken"@de,
        "Doch wie? hier kommt die Zeit"@de,
        "Entzückter Lustgesang!"@de,
        "Erhabne Tugenden!"@de,
        "Es donnert! nur ruhig!"@de,
        "Es ertöne durch Thäler"@de,
        "Glückselger Einzug!"@de,
        "Glückselger Tag! holdselge Königinn!"@de,
        "Ihr meines Tempels Stützen!"@de,
        "In Friedrichs Schatten will ich wohnen"@de,
        "Ja ja! man singe nur von Lust und Wonne"@de,
        "Mit rauschendem Schritte"@de,
        "Monarch! wenn einst die späten Zeiten"@de,
        "Nach dunkeln Wolken strahlt die Sonne"@de,
        "So wie wir abwechselnd"@de,
        "Soll nun, o Schutzgeist!"@de,
        "Unglücklicher! was seufzest du?"@de,
        "Wie? was ist doch mit mir geschehn?"@de,
        "Wir preisen die erhabnen Triebe!"@de,
        "Wir tanzen, wir scherzen"@de,
        "Zufrieden, in süssem in heitrem Vergnügen"@de ;
    cnw:key "D major" ;
    cnw:meter "3/4" ;
    cnw:performingForce "B.",
        "B.1, B.2",
        "C.",
        "C.1",
        "C.2",
        "T.",
        "bc.",
        "cemb. obl.",
        "clrno.",
        "cor.",
        "fg. obl.",
        "fl.",
        "ob.",
        "ob. obl.",
        "princ.",
        "timp.",
        "va.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Allegro assai" .

