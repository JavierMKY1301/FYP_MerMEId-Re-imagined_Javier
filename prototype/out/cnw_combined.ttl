<https://cnw-ld.org/work/SchWB2-410/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-410> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitText "At nordiske Sønner skal hædres i Norden"@da,
        "Dog ikke nok; at Freden, den vi see"@da,
        "Himmel som vaager for Høihed"@da,
        "Ja høit skal Glædskabs Sange lyde"@da,
        "Roelig ved den Hæld som vinkes"@da,
        "Vær hædret, vær hellig du første blant CHRISTIANS Dage!"@da .

