    cnw:incipitImage "SchM_088_001a.png" ;
    cnw:incipitText "Bort Leeg og Lyst, og hvad som giver Glæde"@da,
        "Der er fornummet en Røst i det Høye"@da,
        "Du Kongers Konge giv vor Konge Fryd og Glæde"@da,
        "Ey noget Torden-Slag kand os saa bange giøre"@da,
        "Hvad nu? Hvad Graad! Hvad Jammer-Skriig?"@da,
        "Høyst-Salige Luise!"@da,
        "I Nordens Tvilling-Riiger"@da,
        "Ja see! Hvor Skiæbnen har forøget Eders Smerte"@da,
        "Nu sidde vi da og begræde"@da,
        "Parnasse! Sid i Støv!"@da,
        "Rinder i Taarer fra bundløse Floder"@da,
        "See Kongens Datter og Dronning er prydet"@da,
        "See i Fred paakom mig en Bitterhed"@da,
        "Vel er den følesløs"@da ;
    cnw:key "B minor" ;
    cnw:meter "2/2" ;
    cnw:performingForce "B.",
        "C.",
        "C.1",
        "C.2",
        "C1.",
        "C2.",
        "T.",
        "bc.",
        "clrno.",
        "cor.",
        "fl.",
        "ob.gr.",
        "timp.",
        "va.",
        "vc.",
        "vc. obl.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Andante e maestoso" .

