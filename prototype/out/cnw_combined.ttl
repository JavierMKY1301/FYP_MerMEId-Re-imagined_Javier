        "Music for vocal soloists and instruments with or without choir",
        "Occasional",
        "Secular",
        "Vocal music" ;
    dcterms:title "Trauer-Cantate, bey Gelegenheit des am 19 Decemb. 1751 erfolgten Absterben der Königinn und Frauen, Louise"@de ;
    frbr:realization <https://cnw-ld.org/work/SchWB7-001/expression/1> ;
    cnw:catalogueCode "SchW" ;
    cnw:cnwNumber "B7:001" ;
