<https://cnw-ld.org/work/NWGW174/expression/1> a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/NWGW174> ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false ;
    cnw:incipitImage "NWGW_174_01.png" ;
    cnw:incipitText "Al Jordens Slægt eet Maal er sat"@da,
        "Festlige Hal!"@da,
        "Ja du er Guden!"@da,
        "Jeg er den Stærke, see jeg gaaer til Havet"@da,
        "Men tys hvad bryder Aftnens Fred"@da,
        "Nei bort, bort hver blød, kvindagtig Drøm"@da,
        "Nu Dødens Nat ham aabner bag tætte Søiler sin Port"@da,
        "O milde Lys"@da,
        "Saa fjernt, saa fjernt fra Ganges Bred"@da,
        "See hist! see, Støvskyer taarne sig i Vest."@da,
        "Stands her i Dalen, Stridsmænd!"@da,
        "Tys! Lytter til min Lyres Toner!"@da,
        "Dem Menschen ward ein Ziel gesetzt"@de,
        "Die Todesnacht, sie öffnet den Weg zum Himmel ihm"@de,
        "Doch still! wer stört des Abends Ruh?"@de,
        "Heil sei dem Fest!"@de,
        "Ich bin der Herrscher; bis zu Erde Grenzen will als Held ich zieh'n"@de,
        "Ja, du bist Brama!"@de,
        "Nein weg, weg mit jedem weichen Traum!"@de,
        "O mildes Licht!"@de,
        "Schweigt! horchet meiner Lyra Tönen!"@de,
        "Sieh dort, sieh! Staubwolken thürmen sich im West"@de,
        "So fern, so fern von Ganges Strand"@de,
        "Streiter, ruht hier im Thale!"@de ;
    cnw:meter "6/4" ;
    cnw:performingForce "A.",
        "B.",
        "S.",
        "T.",
        "arp.",
        "cl.",
        "cor.",
        "fg.",
        "fl.",
        "ob.",
        "ptti.",
        "str.",
        "tb.",
        "timp.",
        "tr.",
        "trb.b.",
        "trb.t." ;
    cnw:tempo "Andantino" .

