    cnw:incipitText "Ach! laß mich im Kühlen deine Küsse fühlen"@de,
        "Ach! laß mich im Kühlen deine Küsse fühlen!"@de,
        "Es naht sich Procris in den Sträuchen"@de,
        "Es naht sich Prokris in den Sträuchen"@de,
        "Ihr Götter! Götter helft!"@de,
        "Ihr Götter! Ihr Götter helft"@de,
        "Seyd munter, ihr Jäger, das Jagdhorn erschallt"@de,
        "Seyd munter, ihr Jäger, das Jagdhorn schallt!"@de,
        "So rufet Cephalus"@de,
        "Verbannt aus euch des Argwohns Triebe"@de ;
    cnw:key "G major" ;
    cnw:meter "6/8" ;
    cnw:performingForce "T.",
        "Tenor",
        "bc.",
        "cor.",
        "fl.",
        "va.",
        "vl.1",
        "vl.2" ;
    cnw:tempo "Etwas lebhaft" .

