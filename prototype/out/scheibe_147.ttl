    cnw:incipitText "Tag nu, velsignede Konge! Din Krone"@da ;
    cnw:incipitText "Med uudsigelig Fornøyelse og Glæde"@en ;
    cnw:incipitText "En sød, en tryg, en stille Roe"@da ;
    cnw:incipitText "Er Du allene Rigets Støtte?"@da ;
    cnw:incipitText "Jeg er min Konges Vogtere"@da ;
    cnw:incipitText "Du Landets Magt, min Støtte, kom"@da ;
    cnw:incipitText "Ja, ja, alt dette er vel værd at prise"@da ;
    cnw:incipitText "Her ere vi Helte, vi os strax tillave"@da ;
    cnw:incipitText "Et Riges Herlighed vedvarer"@da ;
    cnw:incipitText "Du Nordens Soel skal sildig dale"@da ;
    cnw:incipitText "Bliv ved at tale, viise Mund!"@da ;
    cnw:incipitText "Der, hvor man baade seer og hører"@da ;
    cnw:incipitText "Det skal til Nordens Ære blive"@da ;
    cnw:incipitText "Ja billigen enhver sig fryder"@da ;
    cnw:incipitText "Du Landetsfader! Folkets Lyst!"@da ;
    cnw:incipitText "Men hisset Mildhed staaer og bier"@da ;
    cnw:incipitText "Den mildeste Konge, som findes paa Jorden"@da ;
    cnw:incipitText "At giøre got imod enhver"@da ;
    cnw:incipitText "Jeg staaer som henrykt ved at see"@da ;
    cnw:incipitText "O! mægtige Beskyttere!"@da ;
    cnw:incipitText "Her skal mit Øye altid vaage"@da ;
    cnw:incipitText "O Store Kongepar!"@da ;
    cnw:incipitText "Tag nu, Velsignede Konge! Din Krone"@da ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

