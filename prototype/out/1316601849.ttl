    cnw:incipitText "De Klokker ringe med Højtidsklang"@da ;
    cnw:incipitText "Lad drages Dig i Minde, vor ejegode Drot"@da ;
    cnw:incipitText "Ja, Kong Christian, i Danmarks Rige blev med Troskabs Ret Din Deel!"@da ;
    cnw:incipitText "Kronens Guld og Troskabs Guld"@da ;
    cnw:incipitText "De Sex sig tumled paa Bernstorffs Grund"@da ;
    cnw:incipitText "Fredensborg! i høstlig Glans"@da ;
    cnw:incipitText "De Klokker ringe med gylden Klang"@da ;
    cnw:incipitText "Vort Land som nu de Tusind Aar"@da ;
    cnw:incipitText "Vel har vi kun en liden Fløj"@da ;
    cnw:incipitText "Men Bønnen stiger i samme Stund"@da ;
