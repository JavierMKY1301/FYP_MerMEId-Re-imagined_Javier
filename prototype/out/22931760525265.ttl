    cnw:incipitText "Der voxed et Træ i min Moders Gaard"@da ;
    cnw:incipitText "Jeg veed et Slot dets Væg og Tag"@en ;
    cnw:incipitText "Agnete kjend mig i din Drøm"@da ;
    cnw:incipitText "Sol deroppe ganger under Lide"@da ;
    cnw:incipitText "Trara! Trara! Trara!"@da ;
    cnw:incipitText "Agnete var elsket, uskyldig og god"@da ;
    cnw:incipitText "Den fattige Fugl sad paa Grenen og sang"@da ;
    cnw:incipitText "Barn Jesus, Brudgom faur og fiin"@da ;
    cnw:incipitText "For Dig vort Knæ vi bøie!"@en ;
    cnw:incipitText "Lærken synger sin Morgensang"@da ;
    cnw:incipitText "Død er hun, død Agnete og jordet hendes Been"@da ;
    cnw:incipitImage "NWGW_151_1.png" ;
