    cnw:incipitText "Rinder i Taarer fra bundløse Floder"@da ;
    cnw:incipitText "I Nordens Tvilling-Riiger"@da ;
    cnw:incipitText "Ey noget Torden-Slag kand os saa bange giøre"@da ;
    cnw:incipitText "Ja see! Hvor Skiæbnen har forøget Eders Smerte"@da ;
    cnw:incipitText "Der er fornummet en Røst i det Høye"@da ;
    cnw:incipitText "Bort Leeg og Lyst, og hvad som giver Glæde"@da ;
    cnw:incipitText "Hvad nu? Hvad Graad! Hvad Jammer-Skriig?"@da ;
    cnw:incipitText "See Kongens Datter og Dronning er prydet"@da ;
    cnw:incipitText "See i Fred paakom mig en Bitterhed"@da ;
    cnw:incipitText "Parnasse! Sid i Støv!"@da ;
    cnw:incipitText "Nu sidde vi da og begræde"@da ;
    cnw:incipitText "Vel er den følesløs"@da ;
    cnw:incipitText "Høyst-Salige Luise!"@da ;
    cnw:incipitText "Du Kongers Konge giv vor Konge Fryd og Glæde"@da ;
    cnw:incipitImage "SchM_088_001a.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

