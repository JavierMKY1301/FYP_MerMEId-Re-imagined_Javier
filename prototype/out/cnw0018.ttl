    cnw:incipitText "Roselil og hendes Moder, de sad over Bord"@da ;
    cnw:incipitText "Stunden er nær, min Søn"@da ;
    cnw:incipitText "Vildt gaar Storm mod sorte Vande"@da ;
    cnw:incipitText "Min Pige er saa lys som Rav"@da ;
    cnw:incipitText "Ved Festen fik en Moder Bud"@da ;
    cnw:incipitText "Dengang Ørnen var flyveklar"@da ;
    cnw:incipitText "Tidselhøsten tegner godt"@da ;
    cnw:incipitText "Saa bittert var mit Hjerte"@da ;
    cnw:incipitText "Her vil ties, her vil bies"@en ;
    cnw:incipitText "Søndret Folk er vokset sammen"@da ;
    cnw:incipitText "Dengang Døden var i Vente"@da ;
    cnw:incipitText "Velkommen til Skoven"@da ;
    cnw:incipitText "Som en rejselysten Flaade"@da ;
