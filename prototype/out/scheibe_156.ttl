    cnw:incipitText "Non piu contese"@it ;
    cnw:incipitText "Ohne weiter streiten"@de ;
    cnw:incipitText "Nella Reggia di pace"@it ;
    cnw:incipitText "In dieser Königlichen Burg des Friedens"@de ;
    cnw:incipitText "Se di nozze si tratta"@it ;
    cnw:incipitText "Wenn die Rede von einer Hochzeit ist"@de ;
    cnw:incipitText "Non conosceano ancora"@it ;
    cnw:incipitText "Sie wußten noch nicht"@de ;
    cnw:incipitText "Felici amanti"@it ;
    cnw:incipitText "Glückliche Liebende!"@de ;
    cnw:incipitText "Di questi augusti sposi tu sommo Giove prendi"@it ;
    cnw:incipitText "Du grosser Jupiter, trage für diese erlauchten Vermählten"@de ;
    cnw:incipitText "Allor, che mi Sprezzate"@it ;
    cnw:incipitText "Auch indem ihr mich verachtet"@de ;
    cnw:incipitText "Alle straggi, alle morti volando"@it ;
    cnw:incipitText "Zum Verderben, zum Tödten eilend erfülle ich alles"@de ;
    cnw:incipitText "Bravo da ver, gran capitano sei"@it ;
    cnw:incipitText "Vortreflich! du bist ein grosser Held"@de ;
    cnw:incipitText "A rimirar quel viso"@it ;
    cnw:incipitText "Dieses Antlitz anzuschauen"@de ;
    cnw:incipitText "Dunque affrettiamo amici"@it ;
    cnw:incipitText "Itzt lasset uns eilen, meine Freunde!"@de ;
    cnw:incipitText "Vivan gli eccelsi sposi"@it ;
    cnw:incipitText "Es leben die erlauchten Vermählten"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

