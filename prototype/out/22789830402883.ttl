    cnw:incipitText "Aldrig din higende Attraa du stiller"@da ;
    cnw:incipitText "Fiskerdrengen leger ved salten Vesterhav"@da ;
    cnw:incipitText "Saa voxe tusind Spørgsmaal"@da ;
    cnw:incipitText "Men vil du have Svar, da spørg dig først: Hvad var din Længsel"@da ;
    cnw:incipitText "Thi Hver fik eget Kald og Kaar"@da ;
    cnw:incipitText "Det Ord, hun hørte bag Judæas Ranker"@da ;
    cnw:incipitText "Skjøndt ammet op i Sydens Marmorsale"@da ;
    cnw:incipitText "En Vingaardsmø med arbejdsvante Hænder"@da ;
    cnw:incipitText "Ad Tidens Strøm, hvis Kyster hun vil tegne"@da ;
    cnw:incipitText "Hun, vort Aarhundreds kjække Yndlingsterne"@da ;
    cnw:incipitText "Her saae vi gjennem Kundskabs Glar"@da ;
    cnw:incipitImage "NWGW_178_01.png" ;
