    cnw:incipitText "Ved høie Middagstid er saadant Mørke!"@da ;
    cnw:incipitText "Bort med jordisk Roe og Glæde!"@da ;
    cnw:incipitText "Uden Ophold bør vi græde"@da ;
    cnw:incipitText "Jeg veed, o Herre Jesu Christ!"@da ;
    cnw:incipitText "Nei, denne døende er meget mere, end en anden dødelig"@da ;
    cnw:incipitText "Tidens umættede Tænder"@da ;
    cnw:incipitText "Saa faldt den hele Last af Syndens Straf paa dig"@da ;
    cnw:incipitText "Ei Helved-Slangens List og Rænke"@da ;
    cnw:incipitText "Det er fuldendt – det glade Budskab"@da ;
    cnw:incipitText "Kierlighed vandt Seier"@da ;
    cnw:incipitText "Din Kamp er ude – og jeg staaer tilbage"@da ;
    cnw:incipitText "Det uvelkomne Skraal af Jøders Skare"@da ;
    cnw:incipitText "O Himmel! – hvilken Skare af Mirakler!"@da ;
    cnw:incipitText "Herefter skal da Død og Grav"@da ;
    cnw:incipitText "Jeg ønsker kun med Længsel"@da ;
    cnw:incipitText "Dertil hielp os Christus vor Trøst"@da ;
    cnw:incipitText "Jeg knurrer ei mod din dybe Viisdom"@da ;
    cnw:incipitText "Min Siæl er tændt af ædel Iver"@da ;
    cnw:incipitText "Nu aabnedes mit Øye giennem Taarer"@da ;
    cnw:incipitText "Dybt er mit ømme Hierte saaret"@da ;
    cnw:incipitText "I Korsets Skole, o korsfæstet Frelser!"@da ;
    cnw:incipitText "Salighed og Smerte"@da ;
    cnw:incipitText "Udvalgte Flok! – Ak! ved hans Blod udkaaret"@da ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

