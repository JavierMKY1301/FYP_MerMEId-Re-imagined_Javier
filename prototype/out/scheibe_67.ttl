    a frbr:Work, mo:MusicalWork ;
    dcterms:title "Die Auferstehung und Himmelfarth Jesu"@de ;
    dcterms:alternative "Die Auferstehung und Himmelfahrt Jesu"@de ;
    dcterms:identifier "SchW B2:301" ;
    cnw:cnwNumber "B2:301" ;
    cnw:catalogueCode "SchW" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    cnw:textAuthor <https://cnw-ld.org/agent/karl_wilhelm_ramler> ;
    dcterms:created "1760–64" ;
