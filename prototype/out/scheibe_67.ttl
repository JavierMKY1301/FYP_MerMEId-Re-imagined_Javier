    cnw:incipitText "Gott! Du wirst seine Seele nicht in der Hölle lassen!"@de ;
    cnw:incipitText "Judäa zittert! – seine Berge beben!"@de ;
    cnw:incipitText "Mein Geist, voll Furcht und Freude, bebet"@de ;
    cnw:incipitText "Triumph! Triumph!"@de ;
    cnw:incipitText "Die frommen Töchter Zions gehn verwundernd"@de ;
    cnw:incipitText "Sey gegrüßet, Fürst des Lebens!"@de ;
    cnw:incipitText "Wer ist die Sionitinn, die vom Grabe so schüchtern"@de ;
    cnw:incipitText "Vater deiner schwachen Kinder"@de ;
    cnw:incipitText "Freundinnen Jesu! sagt, woher so oft in diesen Garten?"@de ;
    cnw:incipitText "Ich folge dir verklärter Held!"@de ;
    cnw:incipitText "Tod! wo ist dein Stachel?"@de ;
    cnw:incipitText "Dort seh ich aus den Thoren Jerusalems"@de ;
    cnw:incipitText "Willkommen, Heyland! freut euch, Väter!"@de ;
    cnw:incipitText "Triumph! Triumph! Der Fürst des Lebens sieget!"@de ;
    cnw:incipitText "Eilf auserwählte Jünger"@de ;
    cnw:incipitText "Mein Herr! mein Gott! mein Herr! mein Gott!"@de ;
    cnw:incipitText "Triumph! Triumph! der Sohn des Höchsten sieget!"@de ;
    cnw:incipitText "Auf einem Hügel"@de ;
    cnw:incipitText "Ihr Thore Gottes öffnet euch!"@de ;
    cnw:incipitText "Gott fähret auf mit Jauchzen!"@de ;
    cnw:incipitImage "SchM_067_01.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

