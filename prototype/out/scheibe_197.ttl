<https://cnw-ld.org/work/SchWB2-303/expression/1>
    a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-303> ;
    cnw:performingForce "ob." ;
    cnw:performingForce "vl.1" ;
    cnw:performingForce "vl.2" ;
