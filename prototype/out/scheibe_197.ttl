    cnw:incipitText "Euch sage ich allen"@de ;
    cnw:incipitText "Wer trägt die Schuld"@de ;
    cnw:incipitText "Es ist das Heyl uns kommen her"@de ;
    cnw:incipitText "Der innre Feind, der meine Seele qvält"@de ;
    cnw:incipitText "Ach wir armen Sünder!"@de ;
    cnw:incipitText "Je mehr die Furcht das Hertz bewegt"@de ;
    cnw:incipitText "Was helffen mich die bittren Klagen"@de ;
    cnw:incipitText "Allein was mir unmöglich ist"@de ;
    cnw:incipitText "Er sprach zu mir, halt dich an mich"@de ;
    cnw:incipitText "Er ringt und kämpfft bis auf das Blut"@de ;
    cnw:incipitText "Seht! den Fürsten unsers Lebens"@de ;
    cnw:incipitText "Ach! das hat unser Sünd und Missethat verschuldet"@de ;
    cnw:incipitText "Erhebt ihr Sünder euer Hertz"@de ;
    cnw:incipitText "Ich ich und meine Sünden"@de ;
    cnw:incipitText "Ein ieder der vorüber geht"@de ;
    cnw:incipitText "Mein Gott, mein Gott warum hast du mich denn verlassen?"@de ;
    cnw:incipitText "Allein der Vater fähret fort"@de ;
    cnw:incipitText "Seht hier unsern Jesum sterben"@de ;
    cnw:incipitText "Wer will uns nun verdammen?"@de ;
    cnw:incipitText "Unter seinen Schirmen"@de ;
    cnw:incipitText "Wer wolte hier nicht seinen Nahmen preisen"@de ;
    cnw:incipitText "So kommt und last euch Jesum leiten"@de ;
    cnw:incipitText "Nun hab ich überwunden"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

