    cnw:incipitText "Du bringer Bud mig fra Olympens Konge?"@da ;
    cnw:incipitText "Du bringst mir Botschaft von Olymps Beherrscher?"@de ;
    cnw:incipitText "Snart, I Smaa, vi her kan hvile"@da ;
    cnw:incipitText "Bald, Ihr Kleinen, könnt Ihr ruhen"@de ;
    cnw:incipitText "Fremad! Hør, med sagte Susen"@da ;
    cnw:incipitText "Vorwärts! Hör, der Baüme Säuseln"@de ;
    cnw:incipitText "Hil Apollo! herlig steg fra Oven ned"@da ;
    cnw:incipitText "Heil Apollo! von den hohen Hallen"@de ;
    cnw:incipitText "Der er Phantasus, min lille Tjener"@da ;
    cnw:incipitText "Da ist Phantasus, mein kleiner Bote"@de ;
    cnw:incipitText "Gjennem Skovens dybe Stilhed"@da ;
    cnw:incipitText "Durch die Stille des Walds"@de ;
    cnw:incipitText "Du vor straalende Drot"@da ;
    cnw:incipitText "Unser strahlender Fürst"@de ;
    cnw:incipitText "Fornemmer Du Nymphernes Ord?"@da ;
    cnw:incipitText "Erfreuet der Klang nicht dein Ohr?"@de ;
    cnw:incipitText "Her er Nectarens skummende Bæger"@da ;
    cnw:incipitText "Dieser Becher voll schäumenden Nectars"@de ;
    cnw:incipitText "O faure Lyra! sidste Trøst i Nøden"@da ;
    cnw:incipitText "O traute Lyra! letzter Trost im Tode!"@de ;
    cnw:incipitText "Jeg skal bort fra Livet"@da ;
    cnw:incipitText "Ich soll fort vom Leben"@de ;
    cnw:incipitText "Fra hendes Læbe Sjælen bort er flygtet"@da ;
    cnw:incipitText "Von ihrer Lippe schon entweicht die Seele"@de ;
    cnw:incipitText "Nu flygter Dagens Glands"@da ;
    cnw:incipitText "Nun schwindet hinter Wald"@de ;
    cnw:incipitImage "hartw_163_00.png" ;
