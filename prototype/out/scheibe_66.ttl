    cnw:incipitText "Wo sind wir?"@de ;
    cnw:incipitText "Wer du auch seyst, den man dort angeheftet hat"@de ;
    cnw:incipitText "O! tödtet mich nur auch, vermeßne Schaaren!"@de ;
    cnw:incipitText "Ach Heiland! Sohn! ach tröste mich!"@de ;
    cnw:incipitText "Du Herrscher über Tod und Leben!"@de ;
    cnw:incipitText "Wie liebenswürdig sind die Triebe"@de ;
    cnw:incipitText "Fließt, zitternde Thränen, entdecket mein Leiden!"@de ;
    cnw:incipitText "Doch Herz! von manchen Wiedersprüchen voll!"@de ;
    cnw:incipitText "O! matter Trost bey so viel Kummer!"@de ;
    cnw:incipitText "Selge Hoffnung! wie stärkst du die Glieder!"@de ;
    cnw:incipitText "Was für ein Volk ist das?"@de ;
    cnw:incipitText "Wo bin ich? Was rühret mich?"@de ;
    cnw:incipitText "Doch träum ich? – wird es Tag? Hilf Himmel! welcher Schein!"@de ;
    cnw:incipitText "Was für Martern, was für Plagen"@de ;
    cnw:incipitText "Mich dürstet!"@de ;
    cnw:incipitText "Du wirst, o Herr! für unsre Sünden"@de ;
    cnw:incipitText "O! Wunder! seht, der HErr erhohlet sich!"@de ;
    cnw:incipitText "Meine Lieben, gute Nacht!"@de ;
    cnw:incipitText "O Gott! o Ruf! durchdringendes Geschrey!"@de ;
    cnw:incipitText "Entflieht! entflieht! die Welt vergeht!"@de ;
    cnw:incipitText "Es mag die Welt zertrümmern und vergehn"@de ;
    cnw:incipitText "Wie selig! daß wir hoffen können"@de ;
    cnw:incipitText "Wenn alle Elemente krachen"@de ;
    cnw:incipitText "Gekreuzigter! Ich deiner Gottheit Bekenner"@de ;
    cnw:incipitText "Entsetzliche Verändrung der Natur!"@de ;
    cnw:incipitText "Beleidigter Richter! Messias! erwache! –"@de ;
    cnw:incipitText "Undankbar Volk! wird nun dein Gott erkannt?"@de ;
    cnw:incipitText "Ach! da dieß Volk verzweifelnd zagt"@de ;
    cnw:incipitText "Ach! Zion! ach, wie tief bist du gebeugt!"@de ;
    cnw:incipitText "Ach! ist der Anblick zu ertragen?"@de ;
    cnw:incipitText "Ihr Lieben! die ihr hier vor Thränen"@de ;
    cnw:incipitText "Ihr heiligen, erblaßten Glieder!"@de ;
    cnw:incipitText "Mich auch, mich stärkt ein neues Licht"@de ;
    cnw:incipitText "Bald werden wir Ihn lebend sehen"@de ;
    cnw:incipitText "O! Trost! der auch in unsre Herzen fließet"@de ;
    cnw:incipitText "Der Tag soll ewig heilig seyn!"@de ;
    cnw:incipitImage "SchM_066_1_01.png" ;
