    cnw:incipitText "Herr Oluf standsed sin Ganger i Kvæld"@da ;
    cnw:incipitText "Herr Oluf Abends hielt an sein Ross"@de ;
    cnw:incipitText "Nu synker Sol i Luften blaa"@da ;
    cnw:incipitText "In's blaue Meer die Sonne sinkt"@de ;
    cnw:incipitText "Saa tidt jeg rider mig under Ø"@da ;
    cnw:incipitText "So oft mein Auge die Fluren schaut"@de ;
    cnw:incipitText "Læg Sadel paa min raske Hest"@da ;
    cnw:incipitText "Zäum' auf mein Ross mit goldner Kett'"@de ;
    cnw:incipitText "Natten er stille!"@da ;
    cnw:incipitText "Nacht, o wie stille!"@de ;
    cnw:incipitText "Dandsen gaaer saa let gjennem Lunden!"@da ;
    cnw:incipitText "Leicht nun schwebt der Tanz durch die Haine!"@de ;
    cnw:incipitText "Velkommen, Herr Oluf, lad fare din Fig"@en ;
    cnw:incipitText "Willkommen Herr Oluf, was eilst du von hier?"@de ;
    cnw:incipitText "I Øster stiger Solen op"@da ;
    cnw:incipitText "Im Osten geht die Sonne auf"@de ;
    cnw:incipitText "Alt vented jeg ved Borgeled"@da ;
    cnw:incipitText "Ich wartet' an des Hauses Thür"@de ;
    cnw:incipitText "Hør du, Herr Oluf, kjær Sønnen min!"@da ;
    cnw:incipitText "Hör' du, Herr Oluf, sag' an mir gleich"@de ;
    cnw:incipitText "Thi raader jeg hver dannis Svend"@da ;
    cnw:incipitText "Drum rath' ich jedem Jüngling an"@de ;
    cnw:incipitImage "NWGW_165_00.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

