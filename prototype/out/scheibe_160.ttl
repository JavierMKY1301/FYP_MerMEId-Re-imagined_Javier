    cnw:incipitText "Messagiero di Giove a te me vengo"@it ;
    cnw:incipitText "Ich, der Bothe Jupiters, komme zu dir"@de ;
    cnw:incipitText "Mio Pastorello"@it ;
    cnw:incipitText "Mein Schäfer"@de ;
    cnw:incipitText "Non ti lusinghi il vano splendor dell' oro"@it ;
    cnw:incipitText "Laß dich nicht den eitlen Glanz des Goldes verblenden"@de ;
    cnw:incipitText "E' il sapere quel gran Bene"@it ;
    cnw:incipitText "Weisheit ist das grosse Gut"@de ;
    cnw:incipitText "Paride, io m'arrossisco di cimentar"@it ;
    cnw:incipitText "Paris, ich erröthe vor Scham"@en ;
    cnw:incipitText "Se vedrai que' begli occhi lucenti"@it ;
    cnw:incipitText "Wenn du sehen wirst, daß jene schönen und glänzenden Augen"@de ;
    cnw:incipitText "Bella Venere"@it ;
    cnw:incipitText "Schöne Venus"@de ;
    cnw:incipitText "Bella Dea, che degli Dei"@it ;
    cnw:incipitText "Schöne Göttinn"@de ;
    cnw:incipitText "(Tutto occupate il cor, o sdegni miei)"@it ;
    cnw:incipitText "Der Zorn nimmt mein Herz ganz ein"@de ;
    cnw:incipitText "Della bellezza ho il vanto"@it ;
    cnw:incipitText "Ich besitze den Ruhm der Schönheit"@de ;
    cnw:incipitText "Paride caro, impallidir ti veggo"@it ;
    cnw:incipitText "Geliebter Paris! ich sehe, du erblassest"@de ;
    cnw:incipitText "Grato core a te permetto"@it ;
    cnw:incipitText "Dir verspreche ich ein erkenntliches Herz"@de ;
    cnw:incipitText "Or tu vedesti, o bella Regina"@it ;
    cnw:incipitText "Itzt hast du, schöne Königinn"@de ;
    cnw:incipitText "Reali Sposi Augusti!"@it ;
    cnw:incipitText "Ihr Königlichen Vermählten!"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

