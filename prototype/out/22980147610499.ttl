    cnw:performingForce "Voice" ;
    cnw:performingForce "Voice" ;
    cnw:performingForce "Voice" ;
    cnw:incipitText "Herrens Salvede"@da ;
    cnw:incipitText "Jeg seer de majestætisk tause Huuler"@da ;
    cnw:incipitText "Kan en Steen sin Stivhed glemme"@da ;
    cnw:incipitText "En Lyd af Suk blev hørt i Tausheds Bolig"@da ;
    cnw:incipitText "O Grav, du Ærens sikker Havn!"@da ;
    cnw:incipitText "Det Navn, som Frederik fortiente"@da ;
    cnw:incipitText "Naar Have tørres ud"@da ;
    cnw:incipitText "See du, som Slaget ikke rører"@da ;
    cnw:incipitText "Kan Viisdom selv ey holde Taarerne tilbage"@da ;
    cnw:incipitText "Græder Nordens Nationer"@da ;
    cnw:incipitText "O matte Skræk! – vi gyse – Tungen stræber"@da ;
    cnw:incipitText "Vor Harpe er bleven til Sorrig"@da ;
    cnw:incipitText "Derfor var vort Hierte svagt"@da ;
    cnw:incipitText "Han vandrede for dit Ansigt"@da ;
    cnw:incipitText "De skal udbrede din store Godheds Ihukommelse"@da ;
    cnw:incipitText "Hyyl Fyr"@da ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

