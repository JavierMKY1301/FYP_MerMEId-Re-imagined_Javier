<https://cnw-ld.org/work/SchWB2-414>
    a frbr:Work, mo:MusicalWork ;
    dcterms:title "Da den høysalige Konge, Frederik den Femte, blev samlet med sine Fædre, blev følgende Kantate opført"@da ;
    dcterms:identifier "SchW B2:414" ;
    cnw:cnwNumber "B2:414" ;
    cnw:catalogueCode "SchW" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    cnw:textAuthor <https://cnw-ld.org/agent/johannes_ewald> ;
    dcterms:created "1766" ;
    dcterms:language "English" ;
    dcterms:language "Danish" ;
    dcterms:subject "Cantata" ;
    dcterms:subject "Music for vocal soloists and instruments with or without choir" ;
    dcterms:subject "Vocal music" ;
    dcterms:subject "Occasional" ;
    cnw:editorialNote "'Aus diesem schönen Singgedichte, dessen Verf. Herr Joh. Ewald ist, wollen wir unsern Lesern diese Arie zur Probe mittheilen [...] Der Gedanke, daß das Grab ein sicherer Hafen der Ehre sey, ist eben nicht gewöhnlich; aber wie wahr ist er nicht! Und deswegen wird er vermuthlich auch vielen wohlgefallen.'" ;
    cnw:editorialNote "There is no indication of character, but since the previous movement was assigned to 'En Undersaat' it seems most likely that the aria was performed by the same character." ;
    cnw:editorialNote "There is no indication of character, but since the previous movement was assigned to 'En Stemme af Gravene' it seems most likely that the aria was performed by the same character." ;
    cnw:editorialNote "Text book: 'De Afskedstagende Undersaatter'." ;
    cnw:editorialNote "Text book, p. 13: 'Da den | Høysalige Konge | blev udført. | Motetto | Med Klage=Sange.'" ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-414/expression/1> ;
    cnw:performanceCount 1 .

<https://cnw-ld.org/work/SchWB2-414/expression/1>
    a frbr:Expression ;
