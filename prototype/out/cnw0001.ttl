    cnw:incipitText "Kommer han? Kommer Profeten?"@da ;
    cnw:incipitText "Is he come? See ye the Prophet?"@en ;
    cnw:incipitText "Herre, tag Skjold og Værge"@da ;
    cnw:incipitText "God be our shield and fortress"@en ;
    cnw:incipitText "Kong Saul, min Fader!"@da ;
    cnw:incipitText "King Saul, my father"@en ;
    cnw:incipitText "Kunde jeg rejse mig mod dig"@da ;
    cnw:incipitText "I would rebel against Thy word"@en ;
    cnw:incipitText "Jeg kommer fra Bethlehems Dale"@da ;
    cnw:incipitText "I come out of Bethlehem's vallys"@en ;
    cnw:incipitText "Hvem bragte dig hid?"@da ;
    cnw:incipitText "Who brought you to me?"@en ;
    cnw:incipitText "Jeg har set dig en Gang"@da ;
    cnw:incipitText "I saw you one day"@en ;
    cnw:incipitText "Glæde over Mandens Arm"@da ;
    cnw:incipitText "Praise the strength that men possess"@en ;
    cnw:incipitText "Saa I ham, Piger?"@da ;
    cnw:incipitText "Maidens, you saw him"@en ;
    cnw:incipitText "Sejr for Israel ved Davids Haand!"@da ;
    cnw:incipitText "Saved is Israel by David's hand!"@en ;
    cnw:incipitText "Frydesang, Paukeklang"@da ;
    cnw:incipitText "Shout for joy, sound the drums"@en ;
    cnw:incipitText "Kongen er syg!"@da ;
    cnw:incipitText "Saul is not well"@en ;
    cnw:incipitText "Se natten Mikal; et tindrende Dyb!"@da ;
    cnw:incipitText "Look upward, Michal; how deep is the night!"@en ;
    cnw:incipitText "Ser du - ? hans Vognborg"@da ;
    cnw:incipitText "Look there, Saul's stronghold!"@en ;
    cnw:incipitText "Hvem kalder? Hvem der?"@da ;
    cnw:incipitText "Who's calling? Who's there?"@en ;
    cnw:incipitText "Herren er Vidne, Pagten er sluttet paany"@da ;
    cnw:incipitText "God is our witnessm vows have been plighted again"@en ;
    cnw:incipitText "Svende giv Agt, giv Agt!"@da ;
    cnw:incipitText "Warriors, there, look there!"@en ;
    cnw:incipitText "Ja! Han er død!"@da ;
    cnw:incipitText "Yes, he is dead!"@en ;
    cnw:incipitText "Hvem banker?"@da ;
    cnw:incipitText "Who knocks there?"@en ;
    cnw:incipitText "Saul! Hvi løfter du Sveddugen bort fra min Pande"@da ;
    cnw:incipitText "Saul, why have you drawn the sweatcloth away from my forehead"@en ;
    cnw:incipitText "Er Slaget forbi?"@da ;
    cnw:incipitText "How goes it now?"@en ;
    cnw:incipitText "Samuel! Samuel! Hjælp mig at dø!"@da ;
    cnw:incipitText "Samuel! Samuel! help me to die"@en ;
    cnw:incipitText "Abner! Svar, er det dig?"@da ;
    cnw:incipitText "Abner! Say, is that you?"@en ;
    cnw:incipitImage "cnw_001_1_1.png" ;
