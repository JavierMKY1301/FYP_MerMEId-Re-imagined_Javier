    cnw:incipitText "Frolocke, glückliches Volk!"@de ;
    cnw:incipitText "Beglückte, ja, wir kommen"@de ;
    cnw:incipitText "Fürsten sind Götter! – Doch werden sie sterben!"@de ;
    cnw:incipitText "Tödtend flammt das Weltgericht"@de ;
    cnw:incipitText "Des Himmels schönste Kronen"@de ;
    cnw:incipitText "Ich, wenn er sich von dir beherrschen läßt"@de ;
    cnw:incipitText "Wie der Thau von Libanon"@de ;
    cnw:incipitText "Noch blühn wir durch Friedrichs Milde! –"@de ;
    cnw:incipitText "Eines Fürsten schönster Lohn"@de ;
    cnw:incipitText "Noch blühn wir durch Friedrichs Milde! –"@de ;
    cnw:incipitText "Er soll, was nun sein Vater thut"@de ;
    cnw:incipitText "Ich winde meine Kränze"@de ;
    cnw:incipitText "Er wähle sich nur dich, Religion"@de ;
    cnw:incipitText "Wie seelig kann nicht schon auf Erden"@de ;
    cnw:incipitText "Wir wollen alle Dich beglücken"@de ;
    cnw:incipitText "Er wandle nur der Tugend Bahn"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

