<https://cnw-ld.org/work/SchWB2-410/expression/1>
    a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/SchWB2-410> ;
    cnw:incipitText "Vær hædret, vær hellig du første blant CHRISTIANS Dage!"@da ;
    cnw:incipitText "Ja høit skal Glædskabs Sange lyde"@da ;
    cnw:incipitText "Roelig ved den Hæld som vinkes"@da ;
    cnw:incipitText "Dog ikke nok; at Freden, den vi see"@da ;
    cnw:incipitText "At nordiske Sønner skal hædres i Norden"@da ;
    cnw:incipitText "Himmel som vaager for Høihed"@da ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

