    cnw:incipitText "Död er vor Konge! Död Kong Frederik!"@da ;
    cnw:incipitText "Ved Sommerslottet suse Skovens Ege"@da ;
    cnw:incipitText "Kongen er död! hör over Vangen Sörgesangen"@da ;
    cnw:incipitText "Den danske Bonde bad"@da ;
    cnw:incipitText "Lad Floret hænge ned over Sørgestaven"@da ;
    cnw:incipitText "Hvad er mod Aandens Rige hist, den Pragt os Jorden viiste"@da ;
    cnw:incipitText "I Kirkens gamle, hvælvede Gange"@da ;
    cnw:incipitText "O, mangt et Træk, saa ærligt"@da ;
    cnw:incipitText "Det trætte Støv de Hvile gav"@da ;
