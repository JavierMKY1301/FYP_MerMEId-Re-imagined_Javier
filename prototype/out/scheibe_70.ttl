    a frbr:Work, mo:MusicalWork ;
    dcterms:title "Choral"@da ;
    dcterms:alternative "I Jesu Navn"@da ;
    dcterms:identifier "SchW B3:002" ;
    cnw:cnwNumber "B3:002" ;
    cnw:catalogueCode "SchW" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    cnw:textAuthor <https://cnw-ld.org/agent/thomas_kingo> ;
    dcterms:language "Danish" ;
    dcterms:language "English" ;
    dcterms:subject "Vocal music" ;
    dcterms:subject "Chorale" ;
    dcterms:subject "Choral music with instruments" ;
    dcterms:subject "Sacred" ;
    cnw:editorialNote "'Saasnart det første Vers af den Psalme: I JEsu Navn skal al vor Gierning skee, und Pauker og Trompeter var udsiunget, fremtrædde, efter givet Tegn af Ober-Hof-Marechallen, Hr. Hof-Prædikant Qvist til Brude-Skamlen, og forrettede Copulationen, hvortil Texten af Hendes Kongel. Høyhed den høye Brude selv var udvalgt af 67de Davids Psalme 2den Vers. Da samme var til Ende, og med det sidste Vers af bemeldte Psalme besluttet, begave sig det høye Brude-Par og samtlige Kongel. Herskaber i forrige Orden igien tilbage.'" ;
    cnw:editorialNote "The work was also performed at the wedding for Crown Prince Gustav of Sweden and Princess Sophie Magdalene of Denmark." ;
    cnw:editorialNote " Includes an extensive description of the event which took place on the 3 October 1766." ;
    cnw:editorialNote " 'Saasnart Sangen nemlig det første Vers af den Psalme: I Jesu Navn &c. under Pauker og Trompetter var udsiunget, traadde Hans Høyværdighed Hr. Biskop Harboe frem fra Alteret [...] Da Vielsen var til Ende og det sidste Vers af bemeldte Psalme med Instrumental- og Vocal-Musik var udsiunget, begav Hans Kongelige Majestæt tilligemed Hendes Majestet Dronningen, [...] tilbage.'" ;
    cnw:editorialNote " Regarding provenance (Ellen Bruhn)" ;
    frbr:realization <https://cnw-ld.org/work/SchWB3-002/expression/1> ;
    cnw:performanceCount 0 .

