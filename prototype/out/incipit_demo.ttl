@prefix ex:      <https://cnw-ld.org/> .
@prefix cnw:     <https://cnw-ld.org/ontology#> .
@prefix frbr:    <http://purl.org/vocab/frbr/core#> .
@prefix mo:      <http://purl.org/ontology/mo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://cnw-ld.org/work/incipit_demo>
    a frbr:Work, mo:MusicalWork ;
    dcterms:title "Incipit Demo"@en ;
    dcterms:identifier "Demo 10" ;
    dcterms:creator <https://cnw-ld.org/agent/carl_nielsen> ;
    dcterms:language "English" ;
    cnw:editorialNote "This file illustrates various ways of including incipits. Incipits are defined at the editor's 'Music' tab.Incipits encoded in MEI or Plaine And Easie Code are rendered in MerMEId with Verovio . Please note that Internet Explorer requires version 10 or newer for this to work.The incipits in this sample file show the beginning of Carl Nielsen's Romance for Violin and Piano, CNW 60 .Please note: The content of this file has been modified for demonstration purposes and does not represent accurate real-world data" ;
    frbr:realization <https://cnw-ld.org/work/incipit_demo/expression/1> ;
    cnw:performanceCount 0 .

<https://cnw-ld.org/work/incipit_demo/expression/1>
    a frbr:Expression ;
    frbr:realizationOf <https://cnw-ld.org/work/incipit_demo> ;
    cnw:hasNotatedIncipit true ;
    cnw:hasNotatedMusic false .

<https://cnw-ld.org/agent/carl_nielsen>
    a foaf:Agent ;
    foaf:name "[Carl Nielsen]" .

