    cnw:incipitText "Jehova! Jehova!"@da ;
    cnw:incipitText "Offerrøgen sig svinge gjennem Himlens Pauluner"@da ;
    cnw:incipitText "Nu er det skeet og ei var Tid at spørge"@da ;
    cnw:incipitText "Israels Gud, du os høre"@da ;
    cnw:incipitText "Ud i Leiren, ud til Seiren"@da ;
    cnw:incipitText "Det er Davids Harpespil"@da ;
    cnw:incipitText "Hos de raske Vaabendrenge vil jeg gribe Harpens Strenge"@da ;
    cnw:incipitText "Din Sjæl være ung, da er ingen Byrde Dig tung"@da ;
    cnw:incipitText "Fra Philisternes Hær atter Kæmpen staaer frem"@da ;
    cnw:incipitText "For din Fod jeg nedlægger Harpen"@da ;
    cnw:incipitText "Til Kamp med Ham til Striden"@da ;
    cnw:incipitImage "hartw_A_01_1.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

