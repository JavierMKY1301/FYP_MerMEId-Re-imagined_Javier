    cnw:incipitText "Kongens Tanke ligner Æther-Draaben"@da ;
    cnw:incipitText "Lad kun Livets Bølger stærke slaae mod Stranden"@da ;
    cnw:incipitText "Alhakem! Niama! Bække græder, Skoven sørger"@da ;
    cnw:incipitText "Dristigt fløi Alhambras Duer op"@da ;
    cnw:incipitText "Nattens Stjerner tindrer"@da ;
    cnw:incipitText "Naar det fra Bjergene blæste for koldt"@da ;
    cnw:incipitText "Glæde! Glæde! Glæde! Luftning fra ukjendte Bjerge"@da ;
    cnw:incipitText "Lyksalig er den Mand og Qvinde"@da ;
    cnw:incipitText "Gratias agimus tibi, propter magnam gloriam"@la ;
    cnw:incipitImage "hartw_015_1_1.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

