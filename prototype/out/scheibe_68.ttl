    cnw:incipitText "An diesem Ort bey meinem König"@de ;
    cnw:incipitText "Es ertöne durch Thäler"@de ;
    cnw:incipitText "Entzückter Lustgesang!"@de ;
    cnw:incipitText "Nach dunkeln Wolken strahlt die Sonne"@de ;
    cnw:incipitText "Ja ja! man singe nur von Lust und Wonne"@de ;
    cnw:incipitText "Alle Freude dieses Lebens"@de ;
    cnw:incipitText "Unglücklicher! was seufzest du?"@de ;
    cnw:incipitText "Es ertöne durch Thäler"@de ;
    cnw:incipitText "Glückselger Einzug!"@de ;
    cnw:incipitText "Zufrieden, in süssem in heitrem Vergnügen"@de ;
    cnw:incipitText "Ihr meines Tempels Stützen!"@de ;
    cnw:incipitText "Es donnert! nur ruhig!"@de ;
    cnw:incipitText "Doch wie? hier kommt die Zeit"@de ;
    cnw:incipitText "So wie wir abwechselnd"@de ;
    cnw:incipitText "Soll nun, o Schutzgeist!"@de ;
    cnw:incipitText "Mit rauschendem Schritte"@de ;
    cnw:incipitText "Glückselger Tag! holdselge Königinn!"@de ;
    cnw:incipitText "Die Wahrheit strahlt aus ihren Blicken"@de ;
    cnw:incipitText "Erhabne Tugenden!"@de ;
    cnw:incipitText "Monarch! wenn einst die späten Zeiten"@de ;
    cnw:incipitText "Wir tanzen, wir scherzen"@de ;
    cnw:incipitText "Wie? was ist doch mit mir geschehn?"@de ;
    cnw:incipitText "In Friedrichs Schatten will ich wohnen"@de ;
    cnw:incipitText "Wir preisen die erhabnen Triebe!"@de ;
    cnw:incipitText "Verwundernd sahen wir den prächtgen Einzug an"@da ;
    cnw:incipitText "Der Stammbaum verneue sich jährlich entzückend!"@de ;
    cnw:incipitImage "SchM_068_1_1.png" ;
