    cnw:incipitText "Ud og ind og ind og ud"@da ;
    cnw:incipitText "Tys! dér er Helhesten"@da ;
    cnw:incipitText "Det kalder...!"@da ;
    cnw:incipitText "Snart paa Loft og snart i Kælder"@da ;
    cnw:incipitText "Helleliden aksler sin Kofte graa"@da ;
    cnw:incipitText "O, hvilken Duft, naar Solen gaar ned"@da ;
    cnw:incipitText "God Kvæld, lille Pjevs!"@da ;
    cnw:incipitText "Tys! Kan du høre...?"@da ;
    cnw:incipitText "Vegen er Dagen"@da ;
    cnw:incipitText "Øjne i, og Øjne op"@da ;
    cnw:incipitText "Vor Mor - vor gamle Mor!"@da ;
    cnw:incipitText "Elvermø - Elvermø!"@da ;
    cnw:incipitText "Kommer Du, min Elskede?"@da ;
    cnw:incipitText "Men hvor Bølgen viger"@da ;
    cnw:incipitText "Hr. Oluf, der bredes Dig Dug paa Disk"@da ;
    cnw:incipitText "Stille! - vær dog stille!"@da ;
    cnw:incipitText "Saa kaster jeg mig for den Gamle paa Knæ"@da ;
    cnw:incipitText "Søvn har jeg kastet paa ham og hende"@da ;
    cnw:incipitText "Pater Anselm har læst dem"@da ;
    cnw:incipitImage "cnw_007_0_0.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

