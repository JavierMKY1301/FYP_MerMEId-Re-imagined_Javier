    cnw:incipitText "Gelobet sey der HERR"@de ;
    cnw:incipitText "Dir, Herr! weyht alles Volk den ehrfurchvollsten Dank"@de ;
    cnw:incipitText "Dort tobten des Krieges verzehrende Fluthen"@de ;
    cnw:incipitText "Betet an, betet an Nationen der Erde!"@en ;
    cnw:incipitText "Umkränzt mit Ruh und Frieden"@de ;
    cnw:incipitText "Wir sehn sie, die Psalmen des Friedens"@de ;
    cnw:incipitText "Lobet ihr Völker den Besten!"@de ;
    cnw:incipitText "Und Dir, Monarch! Gesalbter Friderich!"@de ;
    cnw:incipitText "Daß Fried und Ruh Dein Volk beglücken"@de ;
    cnw:incipitText "Nun, glücklichs Volk! Es soll dieß Friedensfest"@de ;
    cnw:incipitText "Gelobet sey der HERR"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

