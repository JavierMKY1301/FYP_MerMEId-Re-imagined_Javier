    cnw:textAuthor <https://cnw-ld.org/agent/johann_andreas_cramer> ;
    dcterms:created "1763" ;
    dcterms:language "Danish" ;
    dcterms:language "German" ;
    dcterms:language "English" ;
    dcterms:subject "Vocal music" ;
    dcterms:subject "Cantata" ;
    dcterms:subject "Music for vocal soloists and instruments with or without choir" ;
    dcterms:subject "Occasional" ;
    cnw:editorialNote "News mentioning that the cantata was first performed on the 28 June and then again on the 6 July with both music and text by Scheibe: 'Det til Freds-Fæsten den 28de Junii egentlige forfærdiget Cantate, som Onsdagen i forrige Uge af det Musicalske Selskab i Raadhuusstrædet blev opført, bliver i Dag ligeledes under Paukers og Trompetters Lyd igientagen, hvortil Poesien saa vel som Musiqven er forfattet af Capelmesteren Hr. Scheibe, og med saadan Flid udarbeydet, at Kiendere iblandt den talrige Forsamling, som derved har været tilstæde, har ey andet end kunde finde Behag i samme.'" ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-421/expression/1> ;
    cnw:performanceCount 0 .

