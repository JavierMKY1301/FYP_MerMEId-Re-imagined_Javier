    a frbr:Work, mo:MusicalWork ;
    dcterms:title "Kantate auf das Friedensfest in den königl. dänischen Reichen und Landen gefeyert ward"@de ;
    dcterms:identifier "SchW B2:421" ;
    cnw:cnwNumber "B2:421" ;
    cnw:catalogueCode "SchW" ;
