    cnw:incipitText "Ach! hvad Sorrig maa vi friste"@da ;
    cnw:incipitText "Ach! derfor sees paa alle Steder sort"@da ;
    cnw:incipitText "Stor Væ! stor Klage! nu i Dag"@da ;
    cnw:incipitText "Ach! hvad Sorrig maa vi friste"@da ;
    cnw:incipitText "Salig Konge! Landets Fader!"@da ;
    cnw:incipitText "Vor Salig Konge! Far vel da!"@da ;
