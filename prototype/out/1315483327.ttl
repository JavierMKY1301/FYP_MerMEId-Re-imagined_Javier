    cnw:incipitText "O Sorgens Syn!"@da ;
    cnw:incipitText "Ja, aand kun tungt, o Danmark!"@da ;
    cnw:incipitText "Hvad var hans Lod?"@da ;
    cnw:incipitText "Herlige Tid, da Brystet kun rummed hvad der var kjærligt og godt!"@da ;
    cnw:incipitText "Studenten lagde bort sin Bog"@da ;
    cnw:incipitText "Saa sving i Seiersklædebon til Himlen dig"@da ;
    cnw:incipitText "Hvad er Jordens Kongekroner?"@da ;
    cnw:incipitText "Kongernes Konge, hold dine Hænder skjærmende over vort Land!"@da ;
