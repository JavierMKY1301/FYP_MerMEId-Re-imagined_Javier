    cnw:incipitText "Ihr Söhne der Thonkunst!"@de ;
    cnw:incipitText "Ihr Schwestern meiner Kunst!"@de ;
    cnw:incipitText "Ueberzeugend / stark / bewegend"@de ;
    cnw:incipitText "Du rühmest dich"@de ;
    cnw:incipitText "Der zärtlichsten Thöne veränderndes Schallen"@de ;
    cnw:incipitText "Das schlechte Fabelwerk, womit Du dich erhebest"@de ;
    cnw:incipitText "Der Ursprung meiner Treflichkeiten"@de ;
    cnw:incipitText "Der Ursprung ist auch mein"@de ;
    cnw:incipitText "Dich / o Tugend! will ich fragen"@de ;
    cnw:incipitText "Die Zeiten sind vorbei - -"@de ;
    cnw:incipitText "Würden alle Wissenschaften"@de ;
    cnw:incipitText "Wahr ists, mein Ansehn ist zum Theil dahin"@de ;
    cnw:incipitText "Fürstin!"@de ;
    cnw:incipitText "Und ich soll keinen Theil an eurer Freundschaft haben?"@de ;
    cnw:incipitText "Großes Fürstenpaar / Dein Glücke"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

