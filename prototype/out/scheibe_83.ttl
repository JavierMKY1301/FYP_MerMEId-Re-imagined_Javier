<https://cnw-ld.org/work/SchWB2-401>
    a frbr:Work, mo:MusicalWork ;
    dcterms:title "An dem frohen Geburhtsfeste der Fürstin und Frau Christine Sophie, Marggräfin zu Brandenburg-Culmbach, ward folgende Serenate aufgeführet"@de ;
    dcterms:identifier "SchW B2:401" ;
    cnw:cnwNumber "B2:401" ;
    cnw:catalogueCode "SchW" ;
    dcterms:creator <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    cnw:textAuthor <https://cnw-ld.org/agent/johann_adolph_scheibe> ;
    dcterms:created "1740" ;
    dcterms:language "Danish" ;
    dcterms:language "German" ;
    dcterms:subject "Vocal music" ;
    dcterms:subject "Cantata" ;
    dcterms:subject "Music for vocal soloists and instruments with or without choir" ;
    dcterms:subject "Serenata" ;
    dcterms:subject "Occasional" ;
    dcterms:subject "Secular" ;
    cnw:editorialNote "'Ich bin den meisten Theil dieses Winters in Gottorf gewesen, und muste wieder meinen Willen die Personen eines Dichters und eines Componistens zugleich verwalten. Das erste Stück auf den Geburthstag des Marggrafens ist insonderheit noch in gröster Eil verfertiget, und ich hatte zu allen kaum 3 Tage Zeit dazu.'" ;
    cnw:editorialNote "'Inzwischen kommt hierbeÿ abermal ein Bogen Verse, den ich auf den Geburthstag der Fr Marggräffin verfertiget müßen.'" ;
    frbr:realization <https://cnw-ld.org/work/SchWB2-401/expression/1> ;
    cnw:performanceCount 0 .

