    cnw:incipitText "I Bjerget bygge de Gnomer smaae"@da ;
    cnw:incipitText "Im Berge bauen die Gnomen klein"@de ;
    cnw:incipitText "Kamp og Fare Øjet skuer"@da ;
    cnw:incipitText "Paa Stormens Vinge jeg svang mig hid"@da ;
    cnw:incipitText "Auf Sturmes Schwingen komm ich heran"@de ;
    cnw:incipitText "Var det den Rædsel, jeg i Aanden skued"@da ;
    cnw:incipitText "War das die That, die ich im Geiste schaute?"@de ;
    cnw:incipitText "Naar Bølgerne dandse om Merset lidt"@da ;
    cnw:incipitText "Wenn tanzende Wellen den Mast umzieh'n"@de ;
    cnw:incipitText "Moerlille sidder med Briller paa"@da ;
    cnw:incipitText "Am Ofen sitzet alt Mütterlein"@de ;
    cnw:incipitText "Sorg og Smerte aander i mit bange Hjerte"@da ;
    cnw:incipitText "Angst und Schmerzen wohnen in dem bangen Herzen"@de ;
    cnw:incipitText "Uforsonlig grum og kold"@da ;
    cnw:incipitText "Unversöhnlich hart und kalt"@de ;
    cnw:incipitText "Opfyldt er nu mit Haab min bittre Længsel"@da ;
    cnw:incipitText "Erfüllt ist jetzt mein Wunsch, mein banges Sehnen!"@de ;
    cnw:incipitText "Hvorfor kan jeg ei udsige Tanken i mit glade Bryst?"@da ;
    cnw:incipitText "Warum fühl' ich dieses Beben tief in meiner frohen Brust?"@de ;
    cnw:incipitText "Den stolte Falk, Du nylig fik skal ei din Broder glæde"@da ;
    cnw:incipitText "Der stolze Falk, den du ihm gabst"@de ;
    cnw:incipitText "Vee! hvad har jeg hørt? hvad har jeg hørt? Jeg Arme!"@da ;
    cnw:incipitText "Weh! ich hab's gehört! ich hab's gehört! ich Armer!"@de ;
    cnw:incipitText "Hil Dig Millo! Hil Jennaro!"@da ;
    cnw:incipitText "Heil dir Millo! Heil Jennaro!"@de ;
    cnw:incipitText "Underligt mit Hjerte slaaer!"@da ;
    cnw:incipitText "Sonderbar sich hebt die Brust!"@de ;
    cnw:incipitText "Bort fra Byens snævre Muur"@da ;
    cnw:incipitText "Lasst uns flieh'n das enge Zelt"@de ;
    cnw:incipitText "Hvo kan min Smerte lindre / Vi vare Brødre før i Fryd og Smerte"@da ;
    cnw:incipitText "Wer kann die Schmerzen lindern? / Wir waren Brüder ohne Scheu und Wanken"@de ;
    cnw:incipitText "Vi vare Brødre før i Fryd og Smerte"@da ;
    cnw:incipitText "Wir waren Brüder ohne Scheu und Wanken"@de ;
    cnw:incipitText "Kjærlighed du stærke Flamme"@da ;
    cnw:incipitText "Liebe deine Allmacht thronet"@de ;
    cnw:incipitText "Blodet flyder, Barmen brænder!"@da ;
    cnw:incipitText "Tief im Herzen fühl' ich's brennen!"@de ;
    cnw:incipitText "O Broder! Broder du er tabt for mig"@da ;
    cnw:incipitText "Ach Bruder! Bruder! Du bist rettungslos"@de ;
    cnw:incipitText "Altarilden straaler klar / Han frelses maa"@da ;
    cnw:incipitText "Dort durch die Kirchenfenster klar"@de ;
    cnw:incipitText "Under Sang og glade Dandse"@da ;
    cnw:incipitText "Schmückt den Saal mit Blumenkränzen"@de ;
    cnw:incipitText "Ja Glæde og Lykke vil slynge sin Ranke"@da ;
    cnw:incipitText "Ja Jubel und Freude es bringt seinen Glückwunsch die jauchzende Schar"@de ;
    cnw:incipitText "I susende Hvirvel, i summende Dands"@da ;
    cnw:incipitText "In sausendem Wirbel, in brausendem Tanz"@de ;
    cnw:incipitText "Dig Naadens Himmel! dette Slag jeg vier!"@da ;
    cnw:incipitText "Dich gnäd'ger Himmel! Deine Macht ich preise!"@de ;
    cnw:incipitText "Tro din Krigerskare vil dit Liv forsvare!"@da ;
    cnw:incipitText "Treu und fest ergeben schützen wir dein Leben"@de ;
    cnw:incipitText "Jeg er uskyldig, troe mit Ord"@da ;
    cnw:incipitText "Ich bin unschuldig glaubet mir!"@de ;
    cnw:incipitText "Dine Sorger, dine Glæder altid før jeg deelte tro!"@da ;
    cnw:incipitText "Deine Sorgen, deine Freuden theilt' ich immer gern mit dir"@de ;
    cnw:incipitText "Saa forklar mig da din sære Færd!"@da ;
    cnw:incipitText "Deine That ist mir doch nicht erklärt"@de ;
    cnw:incipitText "Den stolte Falk, du nylig fik"@da ;
    cnw:incipitText "Der stolze Falk, den du ihm gabst"@de ;
    cnw:incipitText "Skræk og Rædsel os betager!"@da ;
    cnw:incipitText "Ach, wie sollen wir's ertragen?"@de ;
    cnw:incipitText "Øjet er lukt! Lysets Flamme slukt!"@da ;
    cnw:incipitText "Tod! deine Nacht hüllt der Augen Pracht!"@de ;
    cnw:incipitText "Hjertet isner Tanken flammer!"@da ;
    cnw:incipitText "Tief im Jammer wir verzagen!"@de ;
    cnw:incipitText "Flammedrømme Hjertet gjennembæve!"@da ;
    cnw:incipitText "Neues Leben fühl ich mich durchbeben"@de ;
    cnw:incipitText "O Salighed! o Lykke!"@da ;
    cnw:incipitText "O Seligkeit! o Freude!"@de ;
    cnw:incipitText "Morgenens Skyer som Roser staae"@da ;
    cnw:incipitText "Prachtvoll sich hebt der Morgenglanz"@de ;
    cnw:incipitText "I Bjerget bygge de Gnomer smaae"@da ;
    cnw:incipitText "Kamp og Fare Øiet skuer"@da ;
    cnw:incipitText "Nu er den stærke Stormvind faret hen"@da ;
    cnw:incipitText "Moerlille sidder med Briller paa"@da ;
    cnw:incipitText "Sorg og Smerte aande i mit bange Hjerte"@da ;
    cnw:incipitText "Hør mig Prindsesse! hør mig denne Gang"@da ;
    cnw:incipitText "Arme Yngling, arme Yngling, du mig rører"@da ;
    cnw:incipitText "Min egen Prinds! ja, vi har Lykken med os!"@da ;
    cnw:incipitText "Inde bag ved Byens Mur"@da ;
    cnw:incipitText "Opfyldt er nu mit Haab, min bitre Længsel"@da ;
    cnw:incipitText "Vee Dig, Jennaro! Vee! Vee! Vee!"@da ;
    cnw:incipitText "Vee! hvad har jeg hørt, jeg Arme!"@da ;
    cnw:incipitText "Der er Fryd i Kongeborgen"@da ;
    cnw:incipitText "Underligt mit Hjerte slaaer"@da ;
    cnw:incipitText "Hil! Hil! Hil dig Millo Hil Jennaro"@da ;
    cnw:incipitText "Jeg, Hof-Overvaagemester, som en Søvnens Seraph staaer / Millos Hoved er atter klart"@da ;
    cnw:incipitText "Aa, min egen Dreng! min brave Prinds Jennaro!"@da ;
    cnw:incipitText "Nu har vi flettet dit deilige Haar"@da ;
    cnw:incipitText "Hvo kan min Smerte lindre!"@da ;
    cnw:incipitText "Vi vare Brødre før i Fryd og Smerte"@da ;
    cnw:incipitText "Som nu, saaledes var han aldrig før"@da ;
    cnw:incipitText "Kjærlighed, Du stærke Flamme, som gjør Himlen dobbelt stor"@da ;
    cnw:incipitText "Ved Dig opfyldes mine bedste Drømme!"@da ;
    cnw:incipitText "Hvor findes der en Frelsens Vei for ham?"@da ;
    cnw:incipitText "Blodet syder, Barmen brænder"@da ;
    cnw:incipitText "Vanvids vilde Flamme bølger i mit pinte Bryst"@da ;
    cnw:incipitText "Under Sang og glade Dandse for Kong Millo og hans Brud"@da ;
    cnw:incipitText "Stille! ingen Støi og Trætte"@da ;
    cnw:incipitText "Ja Glæde og Lykke vil slynge sin Ranke om Kjærligheds Bo"@da ;
    cnw:incipitText "I susende Hvirvel, i surrende Dands Vampyrerne flygte for Sollysets Glands!"@da ;
    cnw:incipitText "Du Evige, hav Tak, det lykkedes!"@da ;
    cnw:incipitText "Tro din Krigerskare vil dit Liv forsvare"@da ;
    cnw:incipitText "Jeg er uskyldig, tro mit Ord!"@da ;
    cnw:incipitText "Dine Sorger, Dine Glæder altid før jeg deelte troe"@da ;
    cnw:incipitText "Broder Livet er saa smukt"@da ;
    cnw:incipitText "Afsted, afsted!"@da ;
    cnw:incipitText "Døden vil Du jeg skal lide"@da ;
    cnw:incipitText "Norandos Magt det er! hør Afgrundens Stemme!"@da ;
    cnw:incipitText "Hvad er nu Millos Kongeborg? Tohuwabohu, Mørke og Sorg"@da ;
    cnw:incipitText "Er det Sandhed, er det Digt?"@da ;
    cnw:incipitText "Øiet er lukt, Lysets Flamme slukt"@da ;
    cnw:incipitText "Alt jeg hørte! Tanken flammer, grumme Fader skue vor Jammer!"@da ;
    cnw:incipitText "Kjærligheds Glæde, Kjærligheds Lyst"@da ;
    cnw:incipitImage "hartw_001_1832_0.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

<https://cnw-ld.org/agent/j_p_e_hartmann>
    a foaf:Agent ;
    foaf:name "J.P.E. Hartmann" .

<https://cnw-ld.org/agent/hans_christian_andersen_after_carlo_gozzi_s_il_corvo>
    a foaf:Agent ;
    foaf:name "Hans Christian Andersen after Carlo Gozzi's \"Il corvo\"" .

