    cnw:incipitText "Almægtige Gud!"@da ;
    cnw:incipitText "I Øst er under Palmeskygger vugget"@da ;
    cnw:incipitText "Alt hvad den reiste, bæver og raver"@da ;
    cnw:incipitText "Men alt en Stjerne er dukket frem"@da ;
    cnw:incipitText "Vikingseilet skinner over Sunde"@da ;
    cnw:incipitText "Prises skal Stamfaderens Navn"@da ;
    cnw:incipitText "Fra Wittenberg kom det løsende Ord"@da ;
    cnw:incipitText "Frem drager Slægternes lange Karavane"@da ;
    cnw:incipitText "Styrk alle dem, o store Gud"@da ;
    cnw:incipitImage "hartw_175_1.png" ;
