    cnw:performingForce "Voice" ;
    cnw:incipitText "Mein Haupt, vom Schnee der Zeit bedeckt"@de ;
    cnw:incipitText "Es lebe Augustus!"@de ;
    cnw:incipitText "Er lebe ja! Ich bin zu gleicher Freude da"@de ;
    cnw:incipitText "Du steigest, Herr! durch Dein erhabnes Wesen"@de ;
    cnw:incipitText "Wie gleichgesinnt, o Freundin! sind wir nicht"@de ;
    cnw:incipitText "Ein Gegenstand von so viel Schätzen"@de ;
    cnw:incipitText "So recht, mein Freund! wir können deutlich spüren"@de ;
    cnw:incipitText "Statt Tropffen quillt mein Fluß vom Glücke"@de ;
    cnw:incipitText "Doch welche Furcht nimmt meine Glieder ein?"@de ;
    cnw:incipitText "Helden, die der Himmel liebet"@de ;
    cnw:incipitText "So fest ist unser Wohl gegründet"@de ;
    cnw:incipitText "Herrsche, lebe, blühe, grüne"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

