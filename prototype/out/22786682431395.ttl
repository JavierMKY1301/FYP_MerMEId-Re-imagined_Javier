    cnw:incipitText "O mildes Licht!"@de ;
    cnw:incipitText "O milde Lys"@da ;
    cnw:incipitText "Sieh dort, sieh! Staubwolken thürmen sich im West"@de ;
    cnw:incipitText "See hist! see, Støvskyer taarne sig i Vest."@da ;
    cnw:incipitText "Streiter, ruht hier im Thale!"@de ;
    cnw:incipitText "Stands her i Dalen, Stridsmænd!"@da ;
    cnw:incipitText "Ich bin der Herrscher; bis zu Erde Grenzen will als Held ich zieh'n"@de ;
    cnw:incipitText "Jeg er den Stærke, see jeg gaaer til Havet"@da ;
    cnw:incipitText "Ja, du bist Brama!"@de ;
    cnw:incipitText "Ja du er Guden!"@da ;
    cnw:incipitText "Heil sei dem Fest!"@de ;
    cnw:incipitText "Festlige Hal!"@da ;
    cnw:incipitText "Schweigt! horchet meiner Lyra Tönen!"@de ;
    cnw:incipitText "Tys! Lytter til min Lyres Toner!"@da ;
    cnw:incipitText "Nein weg, weg mit jedem weichen Traum!"@de ;
    cnw:incipitText "Nei bort, bort hver blød, kvindagtig Drøm"@da ;
    cnw:incipitText "Dem Menschen ward ein Ziel gesetzt"@de ;
    cnw:incipitText "Al Jordens Slægt eet Maal er sat"@da ;
    cnw:incipitText "So fern, so fern von Ganges Strand"@de ;
    cnw:incipitText "Saa fjernt, saa fjernt fra Ganges Bred"@da ;
    cnw:incipitText "Doch still! wer stört des Abends Ruh?"@de ;
    cnw:incipitText "Men tys hvad bryder Aftnens Fred"@da ;
    cnw:incipitText "Die Todesnacht, sie öffnet den Weg zum Himmel ihm"@de ;
    cnw:incipitText "Nu Dødens Nat ham aabner bag tætte Søiler sin Port"@da ;
    cnw:incipitImage "NWGW_174_01.png" ;
