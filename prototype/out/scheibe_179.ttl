    cnw:incipitText "So ofte Jesus großer Nahme bald Sünden tilgt, bald Zeichen thut"@de ;
    cnw:incipitText "Zweifeln und Tadeln, verdrehen und schmähen"@de ;
    cnw:incipitText "Du thörichte Vernunft, die sich durch falsches Wissen blehet"@de ;
    cnw:incipitText "Gehe hin, und sprich zu diesem Volcke"@de ;
    cnw:incipitText "Mit Blindheit ist die Welt geschlagen"@de ;
    cnw:incipitText "Ach Gott ich hab nach solcher Arth, gar lang mit großen Schaden"@de ;
    cnw:incipitText "Ach ja, der Sünden lust, die stets das gute von sich stößet, die treibt noch immerfort zu alten lügen"@de ;
    cnw:incipitText "Ist nun unser Evangelium verdeckt"@de ;
    cnw:incipitText "Ihr Hertze rennt im Heuchel-Schein zur Höllen-Pful hienein"@de ;
    cnw:incipitText "Stehe auf, und wandle"@de ;
    cnw:incipitText "Wach auf! ô Mensch vom Sünden-Schlaf, ermuntre dich verlohrnes Schaaf"@de ;
    cnw:incipitImage "SchM_179_001.png" ;
