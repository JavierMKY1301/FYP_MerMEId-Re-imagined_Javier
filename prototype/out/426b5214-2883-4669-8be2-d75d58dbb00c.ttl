    cnw:performingForce "S." ;
    cnw:incipitText "Sey mir gegrüßt, auf Naxos Höhn"@de ;
    cnw:incipitText "Zwar hier, mein Theseus"@de ;
    cnw:incipitText "O du, wie kann ich dich zu zärtlich lieben?"@de ;
    cnw:incipitText "Zu weit entfernt das Meer den Frevler schon!"@de ;
    cnw:incipitText "Kannst du, mein Herz, unter diesem stechenden Schmerz"@de ;
    cnw:incipitText "Weh mir! warum mußt ich ihn sehn?"@de ;
    cnw:incipitText "Daß er der Fluch der Menschheit werde!"@de ;
    cnw:incipitText "Einst war ich schuldlos"@de ;
    cnw:incipitText "Sie brüllen, die Löwen"@de ;
    cnw:incipitText "Wohin? wo flieh ich hin?"@de ;
    cnw:incipitImage "SchM_072_01.png" ;
