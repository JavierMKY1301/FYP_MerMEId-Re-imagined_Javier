    cnw:incipitText "Før vi fra Hjemmet drage"@da ;
    cnw:incipitText "Modtag da vort Farvel! Himlen skjænke Jer Held!"@da ;
    cnw:incipitText "Ud i Livets Trængsler"@da ;
    cnw:incipitText "Min Barndoms svundne Glæder jeg gjenfinder i Dig"@da ;
    cnw:incipitText "O hvilken Fryd naar man en Ven fra den elskte Dal gjenfinder"@da ;
    cnw:incipitText "Dør fra Dør jeg maatte gaae"@da ;
    cnw:incipitText "Send, Madonna! fra det Høie Styrke til min Moder ned!"@da ;
    cnw:incipitText "Den Fryd at dele Venners Glæde"@da ;
    cnw:incipitText "Tre Sous jeg og tre Sous Du?"@da ;
    cnw:incipitText "Stjernerne tindre paa Himmelens blaa"@da ;
    cnw:incipitText "Leve Champagnens søde Druer"@da ;
    cnw:incipitText "Sødeste Nanette jeg i en Karet, laridette"@da ;
    cnw:incipitText "Vær gjenhilset, elskte Dale"@da ;
    cnw:incipitText "Beed til Gud og tænk paa mig"@da ;
    cnw:incipitText "Ud i Livets Trængsler og Farer"@da ;
    cnw:incipitImage "NWGW_150_01.png" ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

