    cnw:incipitText "Wo der Verstand regiert"@de ;
    cnw:incipitText "König! Wir danken vor dieses Ergetzen"@de ;
    cnw:incipitText "So recht! erkennt ihr nun die Führung meiner Hand"@en ;
    cnw:incipitText "Singet, scherzende Najaden"@de ;
    cnw:incipitText "Welch ein Triumph vor mich!"@de ;
    cnw:incipitText "Göttin der Liebe"@de ;
    cnw:incipitText "Der Schäfer, wenn mein Arm ihn bindet"@de ;
    cnw:incipitText "Wie schön vereinigt sich die Schickung und die Liebe!"@de ;
    cnw:incipitText "Qvell der Freude"@de ;
    cnw:incipitText "Die allgemeine Lust"@de ;
    cnw:incipitText "Mir folgen Wonne, Scherz und Liebe"@de ;
    cnw:incipitText "Prinzeßiin! Preis erhabner Schönen"@de ;
    cnw:incipitText "Die lockende Freude, das brünstige Scherzen"@de ;
    cnw:incipitText "Zärtliche Bande! Ergetzende Flammen!"@de ;
    cnw:incipitText "O König! dieses Fest dankt Dir Dein ganzes Reich"@de ;
    cnw:incipitText "Es jauchzen die Völker, es scherzen die Felder"@de ;
    cnw:hasNotatedIncipit false ;
    cnw:hasNotatedMusic false .

